FROM ubuntu:24.04 AS builder
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl build-essential pkg-config libssl-dev clang \
    && rm -rf /var/lib/apt/lists/*
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
ENV PATH=/root/.cargo/bin:${PATH}

WORKDIR /app
COPY services/fastembed_sidecar_rs/Cargo.toml ./Cargo.toml
COPY services/fastembed_sidecar_rs/src ./src
RUN cargo build --release

FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/fastembed-sidecar-rs /usr/local/bin/fastembed-sidecar-rs
EXPOSE 8080
CMD ["fastembed-sidecar-rs"]
