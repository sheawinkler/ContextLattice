#!/usr/bin/env python3
"""Build a compact, session-keyed ContextLattice compaction handoff payload."""

from __future__ import annotations

import argparse
import json
import os
import re
import select
import shutil
import subprocess
import sys
import time
from pathlib import Path
from typing import Any

from _common import REPO_ROOT, emit, now_iso, read_agent_session_state


TEXT_KEYS = (
    "summary",
    "task_summary",
    "objective",
    "goal",
    "prompt",
    "message",
    "reason",
)
SESSION_KEYS = ("session_id", "sessionId", "conversation_id", "conversationId", "id")
DEFAULT_MAX_STDIN_BYTES = 512 * 1024
CODEX_EVENTS = ("SessionStart", "PreCompact", "PostCompact")
CODEX_UUID = re.compile(r"[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}", re.I | re.ASCII)
MODEL_LABEL = re.compile(r"[A-Za-z0-9_./:-]{1,120}")
MODEL_PART = re.compile(r"[a-z][a-z0-9]{0,31}")
MODEL_VERSION = re.compile(r"[0-9]{1,4}(?:\.[0-9]{1,4}){0,2}")
UNKNOWN_MODELS = {"", "unknown", "default", "auto", "none", "null", "n/a"}
GO_SPACE = "\t\n\v\f\r \x85\xa0\u1680\u2000\u2001\u2002\u2003\u2004\u2005\u2006\u2007\u2008\u2009\u200a\u2028\u2029\u202f\u205f\u3000"
DEFAULT_MAX_SUMMARY_JSON_BYTES = 12_000
MAX_DEPTH = 8
MAX_DICT_ITEMS = 80
MAX_LIST_ITEMS = 64
MODEL_COMPATIBILITY_CONTRACT_PATH = REPO_ROOT / "config" / "model_compat" / "compaction_prompt_contract.json"
_MODEL_COMPATIBILITY_CONTRACT: dict[str, Any] | None = None
PROVIDER_OVERFLOW_PATTERNS = (
    "array_above_max_length",
    "context length exceeded",
    "maximum context length",
    "max context length",
    "input array is too long",
    "oversized input",
)


def env_int(name: str, default: int, min_value: int = 1, max_value: int = 10_000_000) -> int:
    raw = os.getenv(name, "").strip()
    if not raw:
        return default
    try:
        value = int(raw)
    except ValueError:
        return default
    return max(min_value, min(max_value, value))


def model_compatibility_contract() -> dict[str, Any]:
    global _MODEL_COMPATIBILITY_CONTRACT
    if _MODEL_COMPATIBILITY_CONTRACT is None:
        if not MODEL_COMPATIBILITY_CONTRACT_PATH.exists():
            _MODEL_COMPATIBILITY_CONTRACT = {}
            return {}
        with MODEL_COMPATIBILITY_CONTRACT_PATH.open(encoding="utf-8") as fh:
            parsed = json.load(fh)
        if not isinstance(parsed, dict):
            raise ValueError(f"{MODEL_COMPATIBILITY_CONTRACT_PATH} must contain a JSON object")
        _MODEL_COMPATIBILITY_CONTRACT = parsed
    return dict(_MODEL_COMPATIBILITY_CONTRACT)


def prompt_safe_text(value: str) -> str:
    text = str(value or "")
    lowered = text.lower()
    if any(pattern in lowered for pattern in PROVIDER_OVERFLOW_PATTERNS):
        text = "ContextLattice boundary reduced an oversized provider input before recording this compaction handoff."
    replacements = model_compatibility_contract().get("prompt_escape_replacements") or []
    for replacement in replacements:
        if not isinstance(replacement, dict):
            continue
        needle = str(replacement.get("find") or "")
        replacement_text = str(replacement.get("replace") or "")
        if not needle:
            continue
        text = text.replace(needle, replacement_text)
    return " ".join(text.split())


def compact_text(value: str, limit: int = 1200) -> str:
    return prompt_safe_text(value)[:limit]


def bounded_value(value: Any, depth: int = 0) -> Any:
    if depth >= MAX_DEPTH:
        return {"_truncated": "max_depth"}
    if isinstance(value, dict):
        out: dict[str, Any] = {}
        for index, (key, item) in enumerate(value.items()):
            if index >= MAX_DICT_ITEMS:
                out["_truncated_keys"] = max(0, len(value) - MAX_DICT_ITEMS)
                break
            out[str(key)[:160]] = bounded_value(item, depth + 1)
        return out
    if isinstance(value, list):
        out = [bounded_value(item, depth + 1) for item in value[:MAX_LIST_ITEMS]]
        if len(value) > MAX_LIST_ITEMS:
            out.append({"_truncated_items": len(value) - MAX_LIST_ITEMS})
        return out
    if isinstance(value, str):
        return compact_text(value, 1600)
    return value


def load_payload() -> Any:
    if sys.stdin.isatty():
        return {}
    max_bytes = env_int("CONTEXTLATTICE_COMPACTION_STDIN_MAX_BYTES", DEFAULT_MAX_STDIN_BYTES)
    raw_bytes = sys.stdin.buffer.read(max_bytes + 1)
    truncated = len(raw_bytes) > max_bytes
    if truncated:
        raw_bytes = raw_bytes[:max_bytes]
    raw = raw_bytes.decode("utf-8", errors="replace")
    if not raw.strip():
        return {}
    try:
        payload = bounded_value(json.loads(raw))
        if isinstance(payload, dict) and truncated:
            payload["_contextlattice_input_truncated"] = True
        return payload
    except Exception:
        return {"raw": raw[:1600], "input_truncated": truncated}


def codex_native_id(payload: Any, event: str) -> str:
    if not isinstance(payload, dict) or payload.get("hook_event_name") != event:
        return ""
    value = payload.get("session_id")
    return value if isinstance(value, str) and CODEX_UUID.fullmatch(value) else ""


def read_hook_input(limit: int) -> tuple[bytes, bool]:
    if sys.stdin.isatty():
        return b"", False
    fd = sys.stdin.fileno()
    deadline = time.monotonic() + 0.4
    raw = bytearray()
    while len(raw) <= limit:
        wait = max(0, deadline - time.monotonic())
        if not wait or not select.select([fd], [], [], wait)[0]:
            break
        chunk = os.read(fd, min(65536, limit + 1 - len(raw)))
        if not chunk:
            return bytes(raw), True
        raw.extend(chunk)
    return bytes(raw), False


def sanitize_model(value: Any) -> str:
    # Match internal/calleridentity.Model: trim, never truncate a slug.
    if not isinstance(value, str):
        return ""
    value = value.strip(GO_SPACE)
    if (value.lower() in UNKNOWN_MODELS or not MODEL_LABEL.fullmatch(value)
            or value.startswith(("/", "./")) or ":/" in value or "/../" in f"/{value}/"):
        return ""
    return value


def codex_hook_attribution(native_id: str, model: Any) -> dict[str, Any]:
    model = sanitize_model(model)
    fallback = {"source": "caller_reported", "harness": "codex", "model_known": bool(model)}
    if not model:
        return fallback
    fallback["model"] = model
    tool_home = Path(os.getenv("CONTEXTLATTICE_GLOBAL_HOME") or Path.home() / ".contextlattice")
    cli = shutil.which("contextlattice") or str(tool_home / "bin/contextlattice")
    try:
        result = subprocess.run(
            [cli, "identity", "--agent", "codex", "--model", model,
             "--native-session-id", native_id, "--raw"],
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            timeout=0.8, check=True,
        )
        if len(result.stdout) > 8192:
            return fallback
        response = json.loads(result.stdout)
        resolved = response.get("caller_attribution") if isinstance(response, dict) else None
        if (not isinstance(resolved, dict) or resolved.get("source") != "caller_reported"
                or resolved.get("harness") != "codex" or resolved.get("model_known") is not True
                or resolved.get("model") != model):
            return fallback
    except (OSError, ValueError, RecursionError, subprocess.SubprocessError):
        return fallback

    attribution = dict(fallback)
    for field, pattern in (("model_origin", MODEL_PART), ("model_family", MODEL_PART),
                           ("model_version", MODEL_VERSION)):
        value = sanitize_model(resolved.get(field))
        if pattern.fullmatch(value):
            attribution[field] = value
    if os.getenv("CODEX_THREAD_ID") == native_id:
        effort = resolved.get("reasoning_effort")
        if effort in ("none", "minimal", "low", "medium", "high", "xhigh", "max"):
            attribution["reasoning_effort"] = effort
    return attribution


def capture_codex_hook(event: str, replay_path: str) -> dict[str, Any]:
    limit = env_int("CONTEXTLATTICE_COMPACTION_STDIN_MAX_BYTES", DEFAULT_MAX_STDIN_BYTES)
    raw, complete = read_hook_input(limit)
    if replay_path:
        Path(replay_path).write_bytes(raw)
    if not complete:
        return {}
    try:
        payload = json.loads(raw)
    except (ValueError, RecursionError):
        return {}
    native_id = codex_native_id(payload, event)
    if not native_id:
        return {}
    return {
        "native_session_id": native_id,
        "caller_attribution": codex_hook_attribution(native_id, payload.get("model")),
    }


def first_string(value: Any, keys: tuple[str, ...], accept_bare: bool = False) -> str:
    if isinstance(value, str):
        return compact_text(value) if accept_bare else ""
    if isinstance(value, dict):
        for key in keys:
            if isinstance(value.get(key), str) and value[key].strip():
                return compact_text(value[key])
        for item in value.values():
            found = first_string(item, keys, False)
            if found:
                return found
    if isinstance(value, list):
        for item in value:
            found = first_string(item, keys, False)
            if found:
                return found
    return ""


def all_strings(value: Any, keys: tuple[str, ...], limit: int = 8) -> list[str]:
    out: list[str] = []

    def collect(item: Any) -> None:
        if len(out) >= limit:
            return
        if isinstance(item, str):
            text = compact_text(item, 360)
            if text:
                out.append(text)
        elif isinstance(item, dict):
            for nested in item.values():
                collect(nested)
        elif isinstance(item, list):
            for nested in item:
                collect(nested)

    def walk(item: Any) -> None:
        if len(out) >= limit:
            return
        if isinstance(item, dict):
            for key in keys:
                if len(out) >= limit:
                    return
                if key in item:
                    collect(item[key])
            for nested in item.values():
                walk(nested)
        elif isinstance(item, list):
            for nested in item:
                walk(nested)

    walk(value)
    seen = set()
    deduped = []
    for item in out:
        if item in seen:
            continue
        seen.add(item)
        deduped.append(item)
    return deduped[:limit]


def find_session_id(payload: Any) -> str:
    host_event = os.getenv("CONTEXTLATTICE_CODEX_HOOK_EVENT")
    if host_event in ("PreCompact", "PostCompact"):
        return codex_native_id(payload, host_event)
    for event in ("PreCompact", "PostCompact"):
        if native_id := codex_native_id(payload, event):
            return native_id
    env_value = os.getenv("CODEX_SESSION_ID") or os.getenv("CONTEXTLATTICE_SESSION_ID") or ""
    if env_value.strip():
        return compact_text(env_value, 160)
    payload_value = first_string(payload, SESSION_KEYS)[:160]
    if payload_value:
        return payload_value
    state = read_agent_session_state(os.getenv("CONTEXTLATTICE_PROJECT", "contextlattice"))
    return compact_text(str(state.get("session_id") or ""), 160)


def git_branch(cwd: Path) -> str:
    try:
        proc = subprocess.run(
            ["git", "rev-parse", "--abbrev-ref", "HEAD"],
            cwd=str(cwd),
            check=False,
            capture_output=True,
            text=True,
            timeout=2,
        )
    except Exception:
        return ""
    return proc.stdout.strip() if proc.returncode == 0 else ""


def git_changed_files(cwd: Path, limit: int = 40) -> list[str]:
    try:
        proc = subprocess.run(
            ["git", "status", "--short"],
            cwd=str(cwd),
            check=False,
            capture_output=True,
            text=True,
            timeout=3,
        )
    except Exception:
        return []
    if proc.returncode != 0:
        return []
    rows = []
    for raw in proc.stdout.splitlines():
        value = raw[3:].strip() if len(raw) > 3 else raw.strip()
        if value:
            rows.append(value)
        if len(rows) >= limit:
            break
    return rows


def commands_from_payload(payload: Any, limit: int = 12) -> list[str]:
    commands: list[str] = []

    def walk(value: Any) -> None:
        if len(commands) >= limit:
            return
        if isinstance(value, dict):
            for key in ("command", "cmd", "shell_command"):
                if isinstance(value.get(key), str) and value[key].strip():
                    commands.append(compact_text(value[key], 240))
            for key in ("commands", "commands_run", "command_history"):
                if key in value:
                    walk(value[key])
        elif isinstance(value, list):
            for item in value:
                walk(item)
        elif isinstance(value, str):
            text = compact_text(value, 240)
            if text and any(token in text for token in (" ", "/", "-", "go test", "pytest", "npm ")):
                commands.append(text)

    walk(payload)
    seen = set()
    out = []
    for command in commands:
        if command in seen:
            continue
        seen.add(command)
        out.append(command)
    return out[:limit]


def build_query(payload: dict[str, Any]) -> str:
    terms = [
        "context compaction handoff",
        str(payload.get("project") or ""),
        str(payload.get("session_id") or ""),
        str(payload.get("branch") or ""),
        Path(str(payload.get("cwd") or "")).name,
        str(payload.get("summary") or ""),
        str(payload.get("objective") or ""),
        str(payload.get("next_action") or ""),
    ]
    return compact_text(" ".join(item for item in terms if item), 700)


def build_payload(raw_payload: Any, fallback_summary: str) -> dict[str, Any]:
    cwd = Path(os.getenv("PWD") or os.getcwd()).resolve()
    project = os.getenv("CONTEXTLATTICE_PROJECT") or os.getenv("CONTEXTLATTICE_HOOK_PROJECT") or "contextlattice"
    summary = first_string(raw_payload, TEXT_KEYS, accept_bare=True) or compact_text(fallback_summary)
    if not summary:
        summary = "continue objective-aligned execution after context compaction"
    objective = first_string(raw_payload, ("objective", "goal", "task", "mission"))
    next_action = first_string(raw_payload, ("next_action", "nextAction", "todo", "plan"))
    blockers = all_strings(raw_payload, ("blocker", "blockers", "blocked", "failure", "error"), limit=8)
    payload: dict[str, Any] = {
        "schema_version": 1,
        "generated_at": now_iso(),
        "event": first_string(raw_payload, ("event", "event_name", "hook_event")) or "context_compaction",
        "session_id": find_session_id(raw_payload),
        "project": project,
        "cwd": str(cwd),
        "branch": git_branch(cwd),
        "summary": summary,
        "objective": objective,
        "next_action": next_action,
        "blockers": blockers,
        "changed_files": git_changed_files(cwd),
        "commands_run": commands_from_payload(raw_payload),
    }
    payload["query_terms"] = build_query(payload)
    return payload


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--fallback-summary", default="")
    parser.add_argument("--summary", action="store_true", help="Emit compact JSON for storage as the handoff summary.")
    parser.add_argument("--query", action="store_true", help="Emit only query terms for post-compaction readback.")
    parser.add_argument("--capture-codex-hook", choices=CODEX_EVENTS)
    parser.add_argument("--replay-stdin", default="")
    parser.add_argument("--pretty", action="store_true")
    args = parser.parse_args()

    if args.capture_codex_hook:
        # Private shell handoff: public CLI redaction masks the native ID.
        print(json.dumps(capture_codex_hook(args.capture_codex_hook, args.replay_stdin)))
        return 0

    payload = build_payload(load_payload(), args.fallback_summary)
    if args.query:
        print(payload["query_terms"])
        return 0
    if args.summary:
        print(json.dumps(payload, sort_keys=True, separators=(",", ":")))
        return 0
    emit(payload, args.pretty)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
