def oversized_boundary_findings(registry: dict[str, Any]) -> list[dict[str, Any]]:
    findings: list[dict[str, Any]] = []
    payload = oversized_context_pack_fixture(registry)
    findings.extend({"severity": "error", **item} for item in validate_agent_contract_payload("context_pack_response.v1", payload, registry))
    contract = (registry.get("contracts") or {}).get("context_pack_response.v1") or {}
    max_bytes = int(contract.get("max_total_json_bytes") or 0)
    actual = len(json.dumps(payload, sort_keys=True, separators=(",", ":")).encode("utf-8"))
    if max_bytes <= 0 or actual > max_bytes:
        findings.append({"severity": "error", "reason": "oversized_fixture_not_clipped", "bytes": actual, "max_bytes": max_bytes})
    lower = json.dumps(payload, sort_keys=True).lower()
    for forbidden in ("array_above_max_length", "context length exceeded", "maximum context length"):
        if forbidden in lower:
            findings.append({"severity": "error", "reason": "raw_provider_overflow_phrase_leaked", "phrase": forbidden})
    compact_stdout = enforce_contract_limits(
        "codex_compact_hook_stdout.v1",
        {
            "continue": True,
            "suppressOutput": False,
            "systemMessage": "array_above_max_length context length exceeded " * 200,
        },
        registry,
    )
    findings.extend({"severity": "error", **item} for item in validate_agent_contract_payload("codex_compact_hook_stdout.v1", compact_stdout, registry))
    if "array_above_max_length" in json.dumps(compact_stdout).lower():
        findings.append({"severity": "error", "reason": "compact_stdout_raw_provider_overflow_phrase_leaked"})
    return findings


