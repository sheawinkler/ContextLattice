def validate_expected_failure(contract_id: str, payload: dict[str, Any], reason: str) -> dict[str, Any] | None:
    findings = validate_agent_contract_payload(contract_id, payload)
    if not findings:
        return {"severity": "error", "reason": "expected_failure_passed", "contract_id": contract_id}
    reasons = {str(item.get("reason") or "") for item in findings}
    if reason not in reasons:
        return {
            "severity": "error",
            "reason": "expected_failure_reason_missing",
            "contract_id": contract_id,
            "expected": reason,
            "findings": findings[:5],
        }
    return None


def run_audit() -> list[dict[str, Any]]:
    findings: list[dict[str, Any]] = []
    try:
        registry = load_agent_contracts_registry()
    except Exception as exc:
        return [{"severity": "error", "reason": "registry_load_failed", "detail": str(exc)[:240]}]

    contracts = registry.get("contracts") if isinstance(registry.get("contracts"), dict) else {}
    for contract_id in REQUIRED_CONTRACTS:
        if contract_id not in contracts:
            findings.append({"severity": "error", "reason": "missing_required_contract", "contract_id": contract_id})
    generated = subprocess.run(
        [str(SCRIPT_DIR / "generate-agent-contract-types"), "--check"],
        check=False,
        capture_output=True,
        text=True,
    )
    if generated.returncode != 0:
        detail: Any
        try:
            detail = json.loads(generated.stdout or "{}")
        except json.JSONDecodeError:
            detail = {"stdout": generated.stdout[:1000], "stderr": generated.stderr[:1000]}
        findings.append({"severity": "error", "reason": "generated_contract_types_stale", "detail": detail})

    protocol = anti_scheming_protocol(registry)
    for item in validate_agent_contract_payload("anti_scheming_protocol.v1", protocol, registry):
        findings.append({"severity": "error", **item})

    context_pack = sample_context_pack()
    for item in validate_agent_contract_payload("context_pack_response.v1", context_pack, registry):
        findings.append({"severity": "error", **item})
    for item in validate_agent_contract_payload("run_advisor.v1", context_pack.get("run_advisor"), registry):
        findings.append({"severity": "error", **item})
    findings.extend(oversized_boundary_findings(registry))

    for contract_id, payload in (
        ("writeback_result.v1", sample_writeback_result()),
        ("agent_task_result.v1", sample_task_result()),
        ("contract_acknowledgement.v1", sample_contract_ack()),
        ("agent_span.v1", sample_agent_span()),
        ("agent_flight_recorder_event.v1", sample_flight_event()),
        ("a2a_readiness_profile.v1", sample_a2a_readiness()),
        ("context_overflow_recovery.v1", sample_context_overflow_recovery()),
        ("objective_runtime_state.v1", sample_objective_runtime(registry)),
        ("universal_agent_adapter_response.v1", sample_universal_agent_adapter_response(registry)),
        ("agent_session_rollup.v1", sample_agent_session_rollup(registry)),
        ("agent_prompt_context_package.v1", sample_agent_prompt_context_package(registry)),
        ("retrieval_progress.v1", sample_retrieval_progress()),
        ("steering_comment.v1", sample_steering_comment()),
    ):
        for item in validate_agent_contract_payload(contract_id, payload, registry):
            findings.append({"severity": "error", **item})
        validation = ((payload.get("format_contract") or {}).get("validation") or {}) if isinstance(payload, dict) else {}
        if validation.get("status") != "passed":
            findings.append({"severity": "error", "reason": "sample_validation_not_passed", "contract_id": contract_id, "validation": validation})

    policy = sample_policy_package(registry)
    for item in validate_agent_contract_payload("policy_context_package.v1", policy, registry):
        findings.append({"severity": "error", **item})
    validation = ((policy.get("format_contract") or {}).get("validation") or {}) if isinstance(policy, dict) else {}
    if validation.get("status") != "passed":
        findings.append({"severity": "error", "reason": "sample_policy_validation_not_passed", "validation": validation})

    preflight = {
        "ok": True,
        "service": "gateway-go",
        "agent": "codex",
        "agent_id": "codex_gpt5_test",
        "project": "contextlattice",
        "query": "agent output contract audit",
        "topic_path": "runbooks/codex-integration",
        "retrieval_mode": "fast",
        "context_pack": context_pack,
        "objective_runtime": policy.get("objective_runtime"),
        "policy_context_package": policy,
        "format_contracts": preflight_contracts_summary(),
    }
    before = json_bytes(preflight)
    preflight = enforce_contract_limits("agent_preflight_response.v1", preflight, registry)
    after = json_bytes(preflight)
    preflight_errors = validate_agent_contract_payload("agent_preflight_response.v1", preflight, registry)
    preflight["format_contracts"] = preflight_contracts_summary(preflight_errors, preflight, before, after)
    previous_counts = preflight["format_contracts"].get("omitted_counts") if isinstance(preflight.get("format_contracts"), dict) else None
    before = json_bytes(preflight)
    preflight = enforce_contract_limits("agent_preflight_response.v1", preflight, registry)
    after = json_bytes(preflight)
    preflight_errors = validate_agent_contract_payload("agent_preflight_response.v1", preflight, registry)
    preflight["format_contracts"] = preflight_contracts_summary(preflight_errors, preflight, before, after, previous_counts)
    for item in preflight_errors:
        findings.append({"severity": "error", **item})

    compact_stdout = {"continue": True, "suppressOutput": False, "systemMessage": "ContextLattice checkpoint ok."}
    for item in validate_agent_contract_payload("codex_compact_hook_stdout.v1", compact_stdout, registry):
        findings.append({"severity": "error", **item})

    bad_policy = dict(policy)
    bad_policy.pop("format_contract", None)
    bad_policy["hookSpecificOutput"] = {"bad": True}
    failure = validate_expected_failure("policy_context_package.v1", bad_policy, "missing_required_field")
    if failure:
        findings.append(failure)
    failure = validate_expected_failure("policy_context_package.v1", bad_policy, "forbidden_field_present")
    if failure:
        findings.append(failure)

    bad_compact = {"continue": True, "ok": True, "hookSpecificOutput": {"bad": True}}
    failure = validate_expected_failure("codex_compact_hook_stdout.v1", bad_compact, "unexpected_field")
    if failure:
        findings.append(failure)
    failure = validate_expected_failure("codex_compact_hook_stdout.v1", bad_compact, "forbidden_field_present")
    if failure:
        findings.append(failure)

    return findings


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--pretty", action="store_true")
    args = parser.parse_args()
    findings = run_audit()
    errors = [item for item in findings if item.get("severity") == "error"]
    emit(
        {
            "ok": not errors,
            "registry": str(REPO_ROOT / "config" / "agent_contracts" / "agent_output_contracts.json"),
            "required_contracts": list(REQUIRED_CONTRACTS),
            "findings": findings,
        },
        args.pretty,
    )
    return 1 if errors else 0


if __name__ == "__main__":
    raise SystemExit(main())
