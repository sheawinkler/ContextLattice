#!/usr/bin/env python3
"""Ask ContextLattice Review Mode for bounded repeat-pattern mitigation guidance."""

from __future__ import annotations

import argparse
import json
import os
import sys
from typing import Any

from _common import REPO_ROOT, emit, ensure_agent_session, request_json

sys.path.insert(0, str(REPO_ROOT / "scripts"))
from agent_contracts import attach_format_contract  # noqa: E402


def as_list(value: Any) -> list[Any]:
    return value if isinstance(value, list) else []


def encoded_len(value: Any) -> int:
    return len((json.dumps(value) + "\n").encode("utf-8"))


def compact_review(raw: dict[str, Any], budget_chars: int) -> dict[str, Any]:
    budget_chars = max(2048, int(budget_chars or 0))
    payload = attach_format_contract("review_mode_response.v1", raw)
    if encoded_len(payload) <= budget_chars:
        return payload

    payload["clipped"] = True
    payload["patterns"] = as_list(payload.get("patterns"))[:4]
    payload["agent_guidance"] = as_list(payload.get("agent_guidance"))[:4]
    payload["warnings"] = as_list(payload.get("warnings"))[:4]
    for pattern in as_list(payload.get("patterns")):
        if not isinstance(pattern, dict):
            continue
        pattern["evidence"] = as_list(pattern.get("evidence"))[:3]
        pattern["mitigation"] = as_list(pattern.get("mitigation"))[:3]
        if isinstance(pattern.get("agent_guidance"), str):
            pattern["agent_guidance"] = pattern["agent_guidance"][:900]
    payload = attach_format_contract("review_mode_response.v1", payload)
    if encoded_len(payload) <= budget_chars:
        return payload

    payload["patterns"] = as_list(payload.get("patterns"))[:2]
    payload["agent_guidance"] = as_list(payload.get("agent_guidance"))[:2]
    payload["review_context"] = {"omitted_by_boundary": True}
    payload["warnings"] = ["ContextLattice Review Mode clipped to local output budget."]
    return attach_format_contract("review_mode_response.v1", payload)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("query", nargs="?", default="review repeated ContextLattice memory patterns and mitigation steps")
    parser.add_argument("--project", default=os.getenv("CONTEXTLATTICE_PROJECT", "contextlattice"))
    parser.add_argument("--topic-path", default="")
    parser.add_argument("--window-hours", type=int, default=168)
    parser.add_argument("--max-patterns", type=int, default=6)
    parser.add_argument("--limit", type=int, default=160)
    parser.add_argument("--agent-id", default=os.getenv("CONTEXTLATTICE_AGENT_ID", ""))
    parser.add_argument("--session-id", default=os.getenv("CONTEXTLATTICE_SESSION_ID", ""))
    parser.add_argument("--auto-session", action=argparse.BooleanOptionalAction, default=True)
    parser.add_argument("--include-cold", action=argparse.BooleanOptionalAction, default=False)
    parser.add_argument("--include-ephemeral", action=argparse.BooleanOptionalAction, default=False)
    parser.add_argument("--budget-chars", type=int, default=12000)
    parser.add_argument("--timeout", type=float, default=30.0)
    parser.add_argument("--pretty", action="store_true")
    args = parser.parse_args()

    session_id = args.session_id
    if not session_id and args.auto_session:
        ensured = ensure_agent_session(
            project=args.project,
            objective=args.query,
            agent_id=args.agent_id,
            agent="agent-cli",
            metadata={"tool": "contextlattice-review", "topic_path": args.topic_path, "window_hours": args.window_hours},
            tags=["auto-session", "review"],
            timeout=10.0,
            soft=True,
        )
        session_id = str(ensured.get("session_id") or "")

    payload: dict[str, Any] = {
        "query": args.query,
        "project": args.project,
        "topic_path": args.topic_path,
        "window_hours": args.window_hours,
        "max_patterns": args.max_patterns,
        "limit": args.limit,
        "include_cold": args.include_cold,
        "include_ephemeral": args.include_ephemeral,
    }
    if args.agent_id:
        payload["agent_id"] = args.agent_id
    if session_id:
        payload["session_id"] = session_id

    raw = request_json("POST", "/memory/review", payload, args.timeout)
    emit(compact_review(raw, args.budget_chars), args.pretty)
    return 0 if raw.get("ok", False) else 1


if __name__ == "__main__":
    raise SystemExit(main())
