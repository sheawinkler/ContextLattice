def run_evaluation(
    artifact_payload: Mapping[str, Any],
    artifact_bytes: bytes,
    transport: Any,
    *,
    expected_source_commit: str = "",
    expected_source_tree: str = "",
    route: str = DEFAULT_ROUTE,
    timeout_seconds: float = DEFAULT_TIMEOUT_SECONDS,
    labels_payload: Mapping[str, Any] | None = None,
    labels_bytes: bytes | None = None,
    replay: bool = True,
) -> dict[str, Any]:
    artifact = validate_frozen_artifact(artifact_payload, artifact_bytes)
    labels = None
    label_issues: list[dict[str, Any]] = []
    if labels_payload is not None:
        labels = validate_authored_labels(labels_payload, artifact)
        label_issues.extend(labels.issues)
    report: dict[str, Any] = {
        "schema_id": EVAL_SCHEMA_ID,
        "version": 1,
        "ok": False,
        "status": "custody_rejected" if not artifact.valid else "pending",
        "route": route,
        "local_only": True,
        "provider_free": False,
        "provider_free_status": "unproven",
        "provider_free_blockers": [],
        "promotion_policy": {
            "schema_id": PROMOTION_POLICY_ID,
            "version": PROMOTION_POLICY_VERSION,
            "thresholds": dict(PROMOTION_THRESHOLDS),
        },
        "dataset": {
            "schema_id": CASE_SET_SCHEMA_ID,
            "source": artifact.payload.get("source"),
            "synthetic": artifact.payload.get("synthetic"),
            "case_set_digest": artifact.digests.get("case_set_digest"),
            "source_snapshot_digest": artifact.digests.get("source_snapshot_digest"),
            "custody_metadata_digest": artifact.digests.get("custody_metadata_digest"),
            "artifact_digest": artifact.digests.get("artifact_digest"),
            "all_case_ids_digest": artifact.digests.get("all_case_ids_digest"),
            "holdout_case_ids_digest": artifact.digests.get("holdout_case_ids_digest"),
            "holdout_cases_digest": artifact.digests.get("holdout_cases_digest"),
            "snapshot_digest_validation": artifact.digest_validation.get("snapshot"),
            "custody_digest_validation": artifact.digest_validation.get("custody"),
            "train_count": sum(1 for case in artifact.cases if str(case.get("split") or "").lower() == "train"),
            "holdout_count": len(artifact.holdout),
            "graph_claimed": artifact.graph_claimed,
            "graph_holdout_count": sum(1 for case in artifact.holdout if _case_is_graph(case)),
        },
        "labels": {"available": labels is not None and labels.valid, "labels_digest": labels.digests.get("labels_digest") if labels else None, "custody_metadata_digest": labels.digests.get("custody_metadata_digest") if labels else None},
        "runtime_identity": None,
        "cases": [],
        "metrics": {},
        "semantic_metrics": {},
        "reproducibility": {"requested": bool(replay), "status": "not_run", "exact_replay_count": 0, "mismatch_count": 0, "exact_digest_rate": None, "exact_snapshot_rate": None},
        "failure_ledger": {"total": 0, "by_code": {}},
        "promotion": {
            "promotion_eligible": False,
            "activation_eligible": False,
            "blocked_reasons": [],
            "answer_quality_claim_allowed": False,
            "answer_quality_claim_blockers": ["answer_quality_unmeasured"],
        },
    }
    if not artifact.valid:
        report["promotion"]["blocked_reasons"] = sorted({issue["code"] for issue in artifact.issues})
        report["failure_ledger"] = _failure_ledger([], artifact.issues)
        return report
    if label_issues:
        report["promotion"]["blocked_reasons"].extend(sorted({issue["code"] for issue in label_issues}))
    if route not in {RESPONSE_ROUTE, TOOL_RESPONSE_ROUTE}:
        report["status"] = "configuration_rejected"
        report["promotion"]["blocked_reasons"].append("route_not_allowlisted")
        report["failure_ledger"] = _failure_ledger([], ({"code": "route_not_allowlisted"},))
        return report
    try:
        timeout_seconds = float(timeout_seconds)
        if not math.isfinite(timeout_seconds) or timeout_seconds <= 0:
            raise ValueError
    except (TypeError, ValueError):
        report["status"] = "configuration_rejected"
        report["promotion"]["blocked_reasons"].append("timeout_invalid")
        report["failure_ledger"] = _failure_ledger([], ({"code": "timeout_invalid"},))
        return report
    health = transport.request("GET", HEALTH_ROUTE, None, timeout_seconds)
    if health.error or health.status < 200 or health.status >= 300:
        runtime, runtime_issues = ({}, [{"code": "runtime_health_unavailable", "detail": health.error or "non-success health status"}])
    else:
        runtime, runtime_issues = _runtime_identity(health.payload, expected_source_commit, expected_source_tree)
    report["runtime_identity"] = runtime
    if runtime_issues:
        report["status"] = "runtime_identity_rejected"
        report["promotion"]["blocked_reasons"].extend(sorted({issue["code"] for issue in runtime_issues}))
        report["cases"] = [_row_not_attempted(case, build_response_request(case), "runtime_identity_rejected", artifact.digests.get("source_snapshot_digest")) for case in artifact.holdout]
        report["failure_ledger"] = _failure_ledger(report["cases"], runtime_issues)
        return report

    rows: list[dict[str, Any]] = []
    replay_mismatches = 0
    for case in artifact.holdout:
        request = build_response_request(case)
        result = transport.request("POST", route, request, timeout_seconds)
        row = validate_response(request, case, result, source_snapshot_digest=artifact.digests.get("source_snapshot_digest"))
        if replay:
            replay_result = transport.request("POST", route, request, timeout_seconds)
            replay_row = validate_response(request, case, replay_result, source_snapshot_digest=artifact.digests.get("source_snapshot_digest"))
            row["replay"] = {"replay_requested": True, "response_digest": replay_row.get("response_digest"), "runtime_snapshot_digest": replay_row.get("runtime_snapshot_digest"), "exact_digest_match": bool(row.get("response_digest") and row.get("response_digest") == replay_row.get("response_digest")), "exact_snapshot_match": bool(row.get("runtime_snapshot_digest") and row.get("runtime_snapshot_digest") == replay_row.get("runtime_snapshot_digest"))}
            report["reproducibility"]["exact_replay_count"] += 1
            if not row["replay"]["exact_digest_match"] or not row["replay"]["exact_snapshot_match"]:
                replay_mismatches += 1
                row["failures"].append(_safe_failure("replay_digest_mismatch"))
        else:
            row["replay"] = {"replay_requested": False, "response_digest": None, "runtime_snapshot_digest": None, "exact_digest_match": None, "exact_snapshot_match": None}
        rows.append(row)
    report["reproducibility"]["mismatch_count"] = replay_mismatches
    report["reproducibility"]["status"] = "measured" if replay else "unmeasured"
    if replay and rows:
        report["reproducibility"]["exact_digest_rate"] = round(sum(1 for row in rows if _as_map(row.get("replay")).get("exact_digest_match") is True) / len(rows), 6)
        report["reproducibility"]["exact_snapshot_rate"] = round(sum(1 for row in rows if _as_map(row.get("replay")).get("exact_snapshot_match") is True) / len(rows), 6)
    report["cases"] = rows
    response_failures = [failure for row in rows for failure in _as_list(row.get("failures"))]
    metrics = {
        "contract_validity": _aggregate_boolean(rows, "contract_valid"),
        "proof_binding": _aggregate_boolean(rows, "proof_binding_valid"),
        "temporal_as_of_binding": _aggregate_boolean(rows, "temporal_binding_valid"),
        "fail_closed": _aggregate_boolean(rows, "fail_closed"),
        "latency": _aggregate_latency(rows),
        "unsupported_action_rate": _aggregate_rates(rows, "unsupported_action"),
        "refusal_rate": _aggregate_rates(rows, "refusal"),
        "tool_ref_rate": {"status": "measured" if rows else "unmeasured", "denominator": len(rows), "rows_with_tool_refs": sum(1 for row in rows if int(row.get("tool_ref_count") or 0) > 0), "rate": round(sum(1 for row in rows if int(row.get("tool_ref_count") or 0) > 0) / len(rows), 6) if rows else None},
        "citation_exactness": {**_aggregate_coverage(rows, "citation_exactness"), "structural_validity_rate": round(sum(1 for row in rows if row.get("citation_structural_valid") is True) / len(rows), 6) if rows else None, "rows_with_authored_identity": sum(1 for row in rows if _as_map(row.get("citation_exactness")).get("available"))},
        "expected_file_coverage": {**_aggregate_coverage(rows, "evidence_file_coverage"), "rows_with_public_file_identity": sum(1 for row in rows if _as_map(row.get("evidence_file_coverage")).get("available"))},
        "expected_record_coverage": {**_aggregate_coverage(rows, "evidence_record_coverage"), "rows_with_authored_record_identity": sum(1 for row in rows if _as_map(row.get("evidence_record_coverage")).get("available"))},
        "non_exclusion": {"status": "measured" if any(_as_map(row.get("non_exclusion")).get("available") for row in rows) else "unmeasured", "rows_with_disclosed_limits": sum(1 for row in rows if _as_map(row.get("non_exclusion")).get("available")), "preserved_rows": sum(1 for row in rows if _as_map(row.get("non_exclusion")).get("preserved") is True)},
        "continuation": {"status": "measured" if any(_as_map(row.get("continuation")).get("available") for row in rows) else "unmeasured", "rows_with_continuation": sum(1 for row in rows if _as_map(row.get("continuation")).get("observed") is True)},
        "observability": {
            "cost_microusd": _observability_summary(rows, "cost_microusd"),
            "provider_calls": _observability_summary(rows, "provider_calls"),
            "provider_tokens": _observability_summary(rows, "provider_tokens", optional=True),
            "external_network_calls": _observability_summary(rows, "external_network_calls"),
            "provider_network_calls": _observability_summary(rows, "provider_network_calls", optional=True),
            "tool_calls": _observability_summary(rows, "tool_calls", optional=True),
            "evaluator_localhost_requests": {
                "status": "measured",
                "health_requests": 1,
                "response_requests": len(rows) * (2 if replay else 1),
                "total_requests": 1 + len(rows) * (2 if replay else 1),
            },
        },
        "reproducibility": report["reproducibility"],
    }
    report["metrics"] = metrics
    semantic, semantic_blockers = _semantic_metrics(rows, labels, artifact.cases)
    report["semantic_metrics"] = semantic
    blockers = list(report["promotion"]["blocked_reasons"])
    observability_blockers = _observability_blockers(rows)
    report["provider_free"] = not observability_blockers
    report["provider_free_status"] = "proven_zero" if report["provider_free"] else "unproven"
    report["provider_free_blockers"] = observability_blockers
    blockers.extend(observability_blockers)
    blockers.extend(semantic_blockers)
    if replay and replay_mismatches:
        blockers.append("replay_digest_mismatch")
    if response_failures:
        blockers.append("case_failures_present")
    blockers.extend(_promotion_threshold_blockers(report))
    report["promotion"]["blocked_reasons"] = sorted(set(blockers))
    report["promotion"]["activation_eligible"] = not report["promotion"]["blocked_reasons"]
    report["promotion"]["promotion_eligible"] = report["promotion"]["activation_eligible"]
    answer_quality_blockers = _answer_quality_claim_blockers(report)
    report["promotion"]["answer_quality_claim_blockers"] = answer_quality_blockers
    report["promotion"]["answer_quality_claim_allowed"] = not answer_quality_blockers
    report["status"] = "pass" if report["promotion"]["promotion_eligible"] else "completed_with_failures"
    report["ok"] = True
    report["failure_ledger"] = _failure_ledger(rows, [{"code": code} for code in report["promotion"]["blocked_reasons"]])
    return report


def _emit(payload: Mapping[str, Any], pretty: bool) -> None:
    print(json.dumps(payload, indent=2 if pretty else None, sort_keys=pretty, ensure_ascii=False))


def main(argv: Sequence[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--artifact", type=Path, default=default_artifact_path())
    parser.add_argument("--labels", type=Path, default=None)
    parser.add_argument("--base-url", default=os.getenv("CONTEXTLATTICE_ORCHESTRATOR_URL") or os.getenv("MEMMCP_ORCHESTRATOR_URL") or "http://127.0.0.1:8075")
    parser.add_argument("--route", choices=(RESPONSE_ROUTE, TOOL_RESPONSE_ROUTE), default=DEFAULT_ROUTE)
    parser.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT_SECONDS, help="per-request timeout; timeout is an explicit case failure")
    parser.add_argument("--expected-source-commit", default=os.getenv("CONTEXTLATTICE_EXPECTED_SOURCE_COMMIT", ""))
    parser.add_argument("--expected-source-tree", default=os.getenv("CONTEXTLATTICE_EXPECTED_SOURCE_TREE", ""))
    parser.add_argument("--api-key", default=os.getenv("CONTEXTLATTICE_ORCHESTRATOR_API_KEY", ""))
    parser.add_argument("--no-replay", action="store_true", help="disable exact replay; reproducibility becomes unmeasured")
    parser.add_argument("--pretty", action="store_true")
    args = parser.parse_args(argv)
    try:
        artifact_payload, artifact_bytes = load_json_file(args.artifact)
        labels_payload, labels_bytes = (load_json_file(args.labels) if args.labels else (None, None))
        transport = LocalhostTransport(args.base_url, args.api_key)
        report = run_evaluation(
            artifact_payload,
            artifact_bytes,
            transport,
            expected_source_commit=str(args.expected_source_commit).strip(),
            expected_source_tree=str(args.expected_source_tree).strip(),
            route=args.route,
            timeout_seconds=args.timeout,
            labels_payload=labels_payload,
            labels_bytes=labels_bytes,
            replay=not args.no_replay,
        )
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        _emit({"schema_id": EVAL_SCHEMA_ID, "version": 1, "ok": False, "status": "input_rejected", "failure": {"code": type(exc).__name__}}, args.pretty)
        return 2
    _emit(report, args.pretty)
    return 0 if report.get("ok") is True and report.get("promotion", {}).get("promotion_eligible") is True else 1


if __name__ == "__main__":
    raise SystemExit(main())
