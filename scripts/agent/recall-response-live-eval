def _canonical(value: Any) -> bytes:
    """Canonical JSON compatible with the Go route's compact JSON digest."""

    raw = json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False)
    # encoding/json escapes HTML-sensitive bytes by default.
    return raw.replace("&", "\\u0026").replace("<", "\\u003c").replace(">", "\\u003e").encode("utf-8")


def digest(value: Any) -> str:
    return "sha256:" + hashlib.sha256(_canonical(value)).hexdigest()


def bytes_digest(value: bytes) -> str:
    return "sha256:" + hashlib.sha256(value).hexdigest()


def _sha(value: Any) -> bool:
    return isinstance(value, str) and bool(SHA256_RE.fullmatch(value.strip()))


def _opaque_id(value: Any, prefix: str) -> bool:
    text = str(value or "").strip()
    return text.startswith(prefix) and len(text) == len(prefix) + 24 and all(c in "0123456789abcdef" for c in text[len(prefix) :])


def _is_int(value: Any) -> bool:
    return isinstance(value, int) and not isinstance(value, bool)


def _is_number(value: Any) -> bool:
    return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(float(value))


def _as_map(value: Any) -> dict[str, Any]:
    return value if isinstance(value, dict) else {}


def _as_list(value: Any) -> list[Any]:
    return value if isinstance(value, list) else []


def _normal_text(value: Any) -> str:
    return " ".join(str(value or "").strip().lower().replace("\\", "/").split())


def _file_tokens(value: Any) -> set[str]:
    return {token.strip("\t\r\n .,;:!?()[]{}'\"`") for token in _normal_text(value).split() if token.strip()}


def _query_contains_file(query: str, file_name: str) -> bool:
    tokens = _file_tokens(query)
    normalized = _normal_text(file_name).strip("/")
    base_name = normalized.rsplit("/", 1)[-1]
    return any(token in tokens for token in (normalized, base_name) if len(token) >= 3)


def _case_is_graph(case: Mapping[str, Any]) -> bool:
    return str(case.get("case_kind") or "").strip().lower() == GRAPH_CASE_KIND or bool(
        _as_list(case.get("graph_expected_files")) or _as_list(case.get("graph_expected_substrings"))
    )


def _issue(issues: list[dict[str, Any]], code: str, detail: str) -> None:
    issues.append({"code": code, "detail": detail})


def _safe_case_digest(case: Mapping[str, Any]) -> str:
    return digest(dict(case))


@dataclass(frozen=True)
class ArtifactValidation:
    valid: bool
    issues: tuple[dict[str, Any], ...]
    payload: dict[str, Any]
    raw_bytes: bytes
    cases: tuple[dict[str, Any], ...]
    holdout: tuple[dict[str, Any], ...]
    digests: dict[str, str | None]
    graph_claimed: bool
    digest_validation: dict[str, dict[str, Any]]


def _declared_digest_validation(
    value: Mapping[str, Any],
    label: str,
    declared_keys: Sequence[str],
    issues: list[dict[str, Any]],
) -> dict[str, Any]:
    """Validate a producer-owned digest only when its canonical contract is present.

    Saved artifacts from older producers expose opaque snapshot/custody digests
    without the material needed to recompute them.  Those digests remain useful
    provenance bindings, but are not relabelled as independently canonicalized
    by this evaluator.
    """

    container = dict(value)
    rule_value = container.get("digest_rule")
    material = container.get("digest_material")
    if rule_value is None and material is None:
        return {"status": "provenance_bound", "provenance_bound_fields": list(declared_keys)}
    if rule_value is None or material is None:
        _issue(issues, f"{label}_digest_rule_incomplete", f"{label} supplied only part of its canonical digest contract")
        return {"status": "invalid"}
    rule = _as_map(rule_value)
    rule_id = rule_value if isinstance(rule_value, str) else rule.get("id") or rule.get("schema_id")
    if isinstance(rule_value, str):
        rule = {"id": rule_value, "algorithm": "sha256", "canonicalization": "sorted_compact_json"}
    algorithm = str(rule.get("algorithm") or "").strip().lower()
    canonicalization = str(rule.get("canonicalization") or rule.get("canonical") or "").strip().lower()
    if algorithm != "sha256" or canonicalization not in {"sorted_compact_json", "canonical_json", "json"}:
        _issue(issues, f"{label}_digest_rule_invalid", f"{label} digest rule is not a supported sha256 canonical JSON contract")
        return {"status": "invalid"}
    if not isinstance(material, Mapping):
        _issue(issues, f"{label}_digest_material_invalid", f"{label} digest material must be an object")
        return {"status": "invalid"}
    canonical_material = dict(material)
    excluded = rule.get("exclude_keys", rule.get("exclude", []))
    if excluded is None:
        excluded = []
    if not isinstance(excluded, list) or any(not isinstance(key, str) for key in excluded):
        _issue(issues, f"{label}_digest_rule_invalid", f"{label} digest exclusions must be a list of field names")
        return {"status": "invalid"}
    for key in excluded:
        canonical_material.pop(key, None)
    expected = digest(canonical_material)
    declared = next((container.get(key) for key in declared_keys if container.get(key) is not None), None)
    if not _sha(declared) or str(declared).lower() != expected.lower():
        _issue(issues, f"{label}_digest_canonical_mismatch", f"{label} digest does not match its declared canonical material")
        return {"status": "invalid", "expected_digest": expected}
    return {
        "status": "canonical_validated",
        "algorithm": "sha256",
        "canonicalization": "sorted_compact_json",
        "rule_id": str(rule_id) if rule_id else None,
        "excluded_fields": list(excluded),
    }


def validate_frozen_artifact(payload: Mapping[str, Any], raw_bytes: bytes) -> ArtifactValidation:
    data = dict(payload) if isinstance(payload, Mapping) else {}
    issues: list[dict[str, Any]] = []
    if data.get("schema_id") != CASE_SET_SCHEMA_ID or data.get("version") != 3:
        _issue(issues, "schema_version_mismatch", "artifact is not saved_recall_eval_case_set.v3 version 3")
    if data.get("synthetic") is not False:
        _issue(issues, "synthetic_case_set", "artifact must explicitly declare synthetic=false")
    raw_cases = data.get("cases")
    if not isinstance(raw_cases, list) or not raw_cases or len(raw_cases) > MAX_CASES:
        _issue(issues, "case_count_invalid", "complete bounded v3 case list is required")
    cases = tuple(row for row in raw_cases if isinstance(row, dict)) if isinstance(raw_cases, list) else ()
    if len(cases) != len(raw_cases or []):
        _issue(issues, "malformed_case", "every case must be an object")
    train = tuple(case for case in cases if str(case.get("split") or "").strip().lower() == "train")
    holdout = tuple(case for case in cases if str(case.get("split") or "").strip().lower() == "holdout")
    if not train or not holdout:
        _issue(issues, "incomplete_split_set", "complete artifact requires train and holdout cases")
    split_counts = data.get("split_counts")
    computed_counts = {"train": len(train), "holdout": len(holdout)}
    if not isinstance(split_counts, dict) or {"train": split_counts.get("train"), "holdout": split_counts.get("holdout")} != computed_counts:
        _issue(issues, "split_count_mismatch", "split_counts does not match the complete case list")
    source = str(data.get("source") or "").strip().lower()
    if source not in FROZEN_INDEX_SOURCES:
        _issue(issues, "source_provenance_invalid", "source must be a bounded current-state index")

    def source_stats_ok(label: str, stats: Any) -> None:
        value = _as_map(stats)
        if value.get("index_mode") != source:
            _issue(issues, f"{label}_source_mode_mismatch", f"{label} source_stats index_mode does not match source")
        if value.get("bounded") is not True or value.get("index_integrity") is not True or value.get("context_cancelled") is not False:
            _issue(issues, f"{label}_source_integrity_invalid", f"{label} source_stats is not an intact bounded index receipt")

    source_stats_ok("artifact", data.get("source_stats"))
    case_set_digest = data.get("case_set_digest")
    if not _sha(case_set_digest) or str(case_set_digest).lower() != digest(list(cases)).lower():
        _issue(issues, "case_set_digest_mismatch", "case_set_digest does not match the complete persisted cases")

    snapshot = _as_map(data.get("snapshot"))
    if snapshot.get("schema_id") != SNAPSHOT_SCHEMA_ID:
        _issue(issues, "snapshot_schema_mismatch", "snapshot schema is not saved_recall_eval_snapshot.v1")
    if str(snapshot.get("source") or "").strip().lower() != source:
        _issue(issues, "snapshot_source_mismatch", "snapshot source does not match artifact source")
    snapshot_digest = snapshot.get("digest")
    if not _sha(snapshot_digest):
        _issue(issues, "snapshot_digest_missing", "frozen source snapshot digest is required")
    source_stats_ok("snapshot", snapshot.get("source_stats"))
    if not _is_int(snapshot.get("selected_case_count")) or int(snapshot.get("selected_case_count")) != len(cases):
        _issue(issues, "snapshot_case_count_mismatch", "snapshot selected_case_count does not match cases")
    if not _is_int(_as_map(snapshot.get("sample")).get("count")) or int(_as_map(snapshot.get("sample")).get("count")) != len(cases):
        _issue(issues, "snapshot_sample_count_mismatch", "snapshot sample count does not match cases")
    if not _is_int(_as_map(snapshot.get("population")).get("count")) or int(_as_map(snapshot.get("population")).get("count")) < len(cases):
        _issue(issues, "snapshot_population_invalid", "snapshot population denominator is invalid")
    if _as_map(snapshot.get("diversity")).get("valid") is not True:
        _issue(issues, "snapshot_diversity_invalid", "frozen snapshot diversity.valid must be true")
    snapshot_digest_validation = _declared_digest_validation(snapshot, "snapshot", ("digest",), issues)

    custody = _as_map(data.get("custody"))
    if custody.get("schema_id") != CUSTODY_SCHEMA_ID or custody.get("owner") != "gateway-go" or custody.get("mode") != "frozen_live_index":
        _issue(issues, "custody_identity_invalid", "custody must be the gateway-go frozen_live_index receipt")
    if custody.get("synthetic") is not False:
        _issue(issues, "synthetic_custody", "custody must explicitly declare synthetic=false")
    contamination = str(custody.get("contamination_state") or "").strip().lower()
    if contamination and ("contamin" in contamination or contamination in {"invalid", "synthetic", "local_regression"}):
        _issue(issues, "contradictory_custody", "custody contamination state is not promotion-safe")
    source_stats_ok("custody", custody.get("source_stats"))
    if custody.get("source_snapshot_digest") != snapshot_digest:
        _issue(issues, "custody_snapshot_mismatch", "custody source snapshot digest does not match snapshot")
    if custody.get("case_set_digest") != case_set_digest:
        _issue(issues, "custody_case_set_mismatch", "custody case-set digest does not match artifact")
    if custody.get("promotional_claims_allowed") is not True:
        _issue(issues, "custody_promotional_claims_unproven", "custody must explicitly allow promotional claims")
    population_count = custody.get("population_count")
    if not _is_int(population_count) or int(population_count) != _as_map(snapshot.get("population")).get("count"):
        _issue(issues, "custody_population_mismatch", "custody population denominator does not match snapshot")
    if custody.get("sample_count") != len(cases) or custody.get("diversity_valid") is not True:
        _issue(issues, "custody_sample_or_diversity_invalid", "custody sample and diversity proof are incomplete")
    if "filename_removed" not in str(custody.get("oracle_leakage") or ""):
        _issue(issues, "oracle_separation_unproven", "custody does not prove filename-redacted case derivation")
    custody_digest_validation = _declared_digest_validation(custody, "custody", ("custody_digest", "digest", "metadata_digest"), issues)

    ids: set[str] = set()
    graph_count = 0
    for case in cases:
        case_id = str(case.get("id") or "").strip()
        if not case_id or case_id.lower() in ids:
            _issue(issues, "case_identity_invalid", "case ids must be non-empty and unique")
        ids.add(case_id.lower())
        query = str(case.get("query") or "").strip()
        project = str(case.get("project") or "").strip()
        topic = str(case.get("topic_path") or "").strip().strip("/")
        expected_files = [str(value).strip().strip("/") for value in _as_list(case.get("expected_files")) if str(value).strip()]
        split = str(case.get("split") or "").strip().lower()
        if not query or not project or not topic or topic in {"root", "."}:
            _issue(issues, "case_scope_invalid", "case query, project, and concrete topic are required")
        if not _is_int(case.get("limit")) or not 1 <= int(case.get("limit")) <= 100:
            _issue(issues, "case_limit_invalid", "case limit must be in [1,100]")
        if len(expected_files) != 1:
            _issue(issues, "expected_file_denominator_invalid", "each direct case must name exactly one expected file")
        if split not in {"train", "holdout"} or (split == "holdout" and not str(case.get("source_updated_at") or "").strip()):
            _issue(issues, "case_split_invalid", "case split and holdout timestamp are required")
        provenance = " ".join(str(case.get(key) or "").strip().lower() for key in ("source", "source_kind", "fixture", "fixture_kind", "traffic_class"))
        if any(marker in provenance for marker in ("synthetic", "built-in", "fallback")):
            _issue(issues, "synthetic_case_marker", "case provenance is synthetic or fallback")
        if expected_files and _query_contains_file(query, expected_files[0]):
            _issue(issues, "query_contains_expected_file", "query leaks the expected filename")
        if _case_is_graph(case):
            graph_count += 1
            graph_files = [str(value).strip().strip("/") for value in _as_list(case.get("graph_expected_files")) if str(value).strip()]
            if len(graph_files) != 1 or graph_files[0].lower() == (expected_files[0].lower() if expected_files else ""):
                _issue(issues, "graph_cohort_invalid", "graph case must name one distinct neighboring target")
        for field in ("expected_record_digests", "expected_content_digests"):
            values = _as_list(case.get(field))
            if any(not _sha(value) for value in values) or len({str(value).lower() for value in values}) != len(values):
                _issue(issues, "expected_record_digest_invalid", "optional expected record identities must be unique sha256 refs")

    graph_holdout_count = sum(1 for case in holdout if _case_is_graph(case))
    graph_claimed = bool(data.get("graphCasesEnabled") is True or graph_count > 0)
    if graph_claimed and graph_holdout_count == 0:
        _issue(issues, "graph_cohort_missing", "graph was claimed without a graph holdout cohort")
    digests = {
        "artifact_digest": bytes_digest(raw_bytes),
        "case_set_digest": str(case_set_digest) if _sha(case_set_digest) else None,
        "source_snapshot_digest": str(snapshot_digest) if _sha(snapshot_digest) else None,
        "custody_metadata_digest": digest(custody) if custody else None,
        "all_case_ids_digest": digest([str(case.get("id") or "") for case in cases]),
        "holdout_case_ids_digest": digest([str(case.get("id") or "") for case in holdout]),
        "holdout_cases_digest": digest(list(holdout)),
    }
    return ArtifactValidation(
        valid=not issues and bool(holdout),
        issues=tuple(issues),
        payload=data,
        raw_bytes=raw_bytes,
        cases=cases,
        holdout=holdout,
        digests=digests,
        graph_claimed=graph_claimed,
        digest_validation={"snapshot": snapshot_digest_validation, "custody": custody_digest_validation},
    )


def _contains_private_material(value: Any) -> bool:
    if isinstance(value, dict):
        for key, child in value.items():
            if str(key).lower() in {"path", "paths", "file", "file_name", "content", "text", "query", "project", "topic_path"}:
                return True
            if _contains_private_material(child):
                return True
        return False
    if isinstance(value, list):
        return any(_contains_private_material(child) for child in value)
    return isinstance(value, str) and bool(PRIVATE_VALUE_RE.search(value))


@dataclass(frozen=True)
class LabelValidation:
    valid: bool
    issues: tuple[dict[str, Any], ...]
    labels_by_case: dict[str, dict[str, Any]]
    digests: dict[str, str | None]


def validate_authored_labels(payload: Mapping[str, Any], artifact: ArtifactValidation) -> LabelValidation:
    data = dict(payload) if isinstance(payload, Mapping) else {}
    issues: list[dict[str, Any]] = []
    if data.get("schema_id") != LABEL_SCHEMA_ID or data.get("version") != 1:
        _issue(issues, "label_schema_mismatch", "labels must use recall_response_live_labels.v1")
    if data.get("synthetic") is not False or data.get("authoring") != "human_authored":
        _issue(issues, "synthetic_or_unowned_labels", "semantic labels must be human-authored and synthetic=false")
    if data.get("case_set_digest") != artifact.digests.get("case_set_digest"):
        _issue(issues, "label_case_set_mismatch", "labels are not bound to the frozen case-set digest")
    if data.get("snapshot_digest") != artifact.digests.get("source_snapshot_digest"):
        _issue(issues, "label_snapshot_mismatch", "labels are not bound to the frozen source snapshot digest")
    if _contains_private_material(data):
        _issue(issues, "label_private_material", "labels contain raw paths or content rather than opaque identities")
    custody = _as_map(data.get("custody"))
    if custody.get("schema_id") != LABEL_CUSTODY_SCHEMA_ID or custody.get("synthetic") is not False or custody.get("owner") != "human_authored":
        _issue(issues, "label_custody_invalid", "label custody must be a non-synthetic human-authored receipt")
    if custody.get("promotional_claims_allowed") is not True:
        _issue(issues, "label_promotional_claims_unproven", "label custody must explicitly allow semantic promotional claims")
    if custody.get("case_set_digest") != artifact.digests.get("case_set_digest") or custody.get("snapshot_digest") != artifact.digests.get("source_snapshot_digest"):
        _issue(issues, "label_custody_binding_invalid", "label custody digests do not match the frozen artifact")
    contamination = str(custody.get("contamination_state") or "").strip().lower()
    if contamination not in {"sealed_holdout", "uncontaminated"}:
        _issue(issues, "label_custody_contaminated", "label custody does not prove a sealed uncontaminated holdout")
    for oracle_key in ("oracle", "oracle_custody", "holdout_oracle"):
        if _as_map(data.get(oracle_key)).get("synthetic") is True or _as_map(custody.get(oracle_key)).get("synthetic") is True:
            _issue(issues, "contradictory_oracle_custody", "synthetic oracle evidence cannot override the canonical custody receipt")
    labels = data.get("labels")
    if not isinstance(labels, list) or not labels:
        _issue(issues, "labels_missing", "authored labels must contain at least one row")
        labels = []
    case_by_id = {str(case.get("id")): case for case in artifact.cases}
    seen: set[str] = set()
    split_counts = {"development": 0, "holdout": 0}
    by_case: dict[str, dict[str, Any]] = {}
    for label in labels:
        if not isinstance(label, dict):
            _issue(issues, "label_row_invalid", "each label must be an object")
            continue
        case_id = str(label.get("case_id") or "").strip()
        split = str(label.get("split") or "").strip().lower()
        if not case_id or case_id not in case_by_id or case_id in seen:
            _issue(issues, "label_case_identity_invalid", "label case identity must be unique and belong to the artifact")
        if split not in {"development", "holdout"}:
            _issue(issues, "label_split_invalid", "labels must declare development or holdout")
        expected_split = "holdout" if str(case_by_id.get(case_id, {}).get("split") or "").lower() == "holdout" else "development"
        if case_id and split and split != expected_split:
            _issue(issues, "label_split_case_mismatch", "label split does not match the frozen case split")
        if case_id:
            seen.add(case_id)
            split_counts[split] = split_counts.get(split, 0) + 1
            by_case[case_id] = label
        for field in ("expected_record_digests", "expected_content_digests", "expected_proof_refs"):
            values = _as_list(label.get(field))
            if field != "expected_proof_refs" and any(not _sha(value) for value in values):
                _issue(issues, "label_evidence_identity_invalid", "label evidence identities must be sha256 refs")
            if field == "expected_proof_refs" and any(not isinstance(value, str) or not value.strip() for value in values):
                _issue(issues, "label_proof_identity_invalid", "label proof identities must be non-empty opaque refs")
        temporal = _as_map(label.get("temporal"))
        if temporal.get("expected_temporal_state") is not None and not isinstance(temporal.get("expected_temporal_state"), str):
            _issue(issues, "label_temporal_invalid", "temporal ground truth must be scalar and authored")
        abstention = _as_map(label.get("abstention"))
        if "expected" in abstention and not isinstance(abstention.get("expected"), bool):
            _issue(issues, "label_abstention_invalid", "abstention ground truth must be boolean")
    declared_counts = data.get("split_counts")
    if declared_counts != split_counts or not split_counts["development"] or not split_counts["holdout"]:
        _issue(issues, "label_split_counts_invalid", "development and holdout label denominators must reconcile")
    labels_digest = data.get("labels_digest")
    canonical_labels = [label for label in labels if isinstance(label, dict)]
    if not _sha(labels_digest) or str(labels_digest).lower() != digest(canonical_labels).lower():
        _issue(issues, "label_digest_mismatch", "labels_digest does not match authored labels")
    custody_labels_digest = custody.get("labels_digest")
    if custody_labels_digest != labels_digest:
        _issue(issues, "label_custody_digest_mismatch", "label custody does not bind labels_digest")
    digests = {"labels_digest": str(labels_digest) if _sha(labels_digest) else None, "custody_metadata_digest": digest(custody) if custody else None}
    return LabelValidation(not issues, tuple(issues), by_case if not issues else {}, digests)


def default_artifact_path() -> Path:
    override = os.getenv("ORCH_RECALL_EVAL_CASES_PATH", "").strip()
    if override:
        return Path(override).expanduser()
    return DEFAULT_ARTIFACT if DEFAULT_ARTIFACT.exists() else FALLBACK_ARTIFACT


def load_json_file(path: Path) -> tuple[dict[str, Any], bytes]:
    raw = path.expanduser().resolve().read_bytes()
    if len(raw) > 4 * 1024 * 1024:
        raise ValueError("artifact exceeds bounded input size")
    value = json.loads(raw.decode("utf-8"))
    if not isinstance(value, dict):
        raise ValueError("artifact must be a JSON object")
    return value, raw


def _normalise_as_of(value: Any) -> tuple[str, bool]:
    raw = str(value or "").strip()
    if not raw or raw.lower() == "latest_available":
        return "latest_available", True
    try:
        parsed = datetime.fromisoformat(raw.replace("Z", "+00:00"))
        if parsed.tzinfo is None:
            raise ValueError
        now = datetime.now(timezone.utc)
        if parsed > now + timedelta(minutes=1):
            return "latest_available", False
        normalized = parsed.astimezone(timezone.utc).isoformat(timespec="microseconds").replace("+00:00", "Z")
        if normalized.endswith("Z"):
            normalized = normalized[:-1].rstrip("0").rstrip(".") + "Z"
        return normalized, True
    except (TypeError, ValueError, OverflowError):
        return "latest_available", False


