class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req: urllib.request.Request, fp: Any, code: int, msg: str, headers: Any, newurl: str) -> None:
        raise urllib.error.URLError("redirects are forbidden for the provider-free evaluator")


@dataclass(frozen=True)
class TransportResponse:
    status: int
    payload: dict[str, Any]
    latency_ms: float
    error: str = ""
    headers: dict[str, str] | None = None


class LocalhostTransport:
    """HTTP transport whose URL and redirects are hard-loopback constrained."""

    def __init__(self, base_url: str, api_key: str = "") -> None:
        self.base_url = self._literal_loopback_origin(base_url)
        self.api_key = api_key.strip()
        self.request_count = 0
        # Supplying an empty ProxyHandler is required: build_opener otherwise
        # installs an environment-derived proxy handler alongside NoRedirect.
        self.opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())

    @staticmethod
    def _literal_loopback_origin(base_url: str) -> str:
        raw = str(base_url or "").strip()
        parsed = urllib.parse.urlparse(raw)
        try:
            port = parsed.port
        except ValueError as exc:
            raise ValueError("base URL port is invalid") from exc
        hostname = parsed.hostname
        if (
            parsed.scheme != "http"
            or hostname not in LOOPBACK_LITERAL_HOSTS
            or parsed.username
            or parsed.password
            or parsed.path not in {"", "/"}
            or parsed.params
            or parsed.query
            or parsed.fragment
        ):
            raise ValueError("base URL must be a literal http loopback origin without credentials, path, or query")
        host = f"[{hostname}]" if ":" in hostname else hostname
        return f"http://{host}" + (f":{port}" if port is not None else "")

    @staticmethod
    def _validate_literal_loopback_url(url: str) -> None:
        parsed = urllib.parse.urlparse(url)
        if parsed.scheme != "http" or parsed.hostname not in LOOPBACK_LITERAL_HOSTS or parsed.username or parsed.password or parsed.path not in {HEALTH_ROUTE, RESPONSE_ROUTE, TOOL_RESPONSE_ROUTE} or parsed.params or parsed.query or parsed.fragment:
            raise ValueError("request URL must remain a literal http loopback route")

    def request(self, method: str, path: str, payload: Mapping[str, Any] | None, timeout_seconds: float) -> TransportResponse:
        if path not in {HEALTH_ROUTE, RESPONSE_ROUTE, TOOL_RESPONSE_ROUTE}:
            return TransportResponse(0, {}, 0.0, "route_not_allowlisted", {})
        if not math.isfinite(float(timeout_seconds)) or float(timeout_seconds) <= 0:
            return TransportResponse(0, {}, 0.0, "timeout_invalid", {})
        body = None if payload is None else _canonical(dict(payload))
        if body is not None and len(body) > MAX_REQUEST_BYTES:
            return TransportResponse(0, {}, 0.0, "request_too_large", {})
        url = self.base_url + path
        try:
            self._validate_literal_loopback_url(url)
        except ValueError:
            return TransportResponse(0, {}, 0.0, "non_loopback_url", {})
        request = urllib.request.Request(url, data=body, method=method.upper(), headers={"content-type": "application/json", "accept": "application/json"})
        if self.api_key:
            request.add_header("x-api-key", self.api_key)
        started = time.perf_counter()
        self.request_count += 1
        try:
            with self.opener.open(request, timeout=float(timeout_seconds)) as response:
                raw = response.read(MAX_RESPONSE_BYTES + 1)
                headers = {str(key).lower(): str(value) for key, value in response.headers.items()}
                status = int(response.status)
        except (socket.timeout, TimeoutError):
            return TransportResponse(0, {}, round((time.perf_counter() - started) * 1000, 3), "timeout", {})
        except urllib.error.HTTPError as exc:
            try:
                raw = exc.read(MAX_RESPONSE_BYTES + 1)
            except OSError:
                raw = b""
            headers = {str(key).lower(): str(value) for key, value in exc.headers.items()} if exc.headers else {}
            status = int(exc.code)
        except urllib.error.URLError as exc:
            reason = str(getattr(exc, "reason", exc)).lower()
            error = "timeout" if "timed out" in reason or "timeout" in reason else "transport_error"
            return TransportResponse(0, {}, round((time.perf_counter() - started) * 1000, 3), error, {})
        except OSError:
            return TransportResponse(0, {}, round((time.perf_counter() - started) * 1000, 3), "transport_error", {})
        latency = round((time.perf_counter() - started) * 1000, 3)
        if len(raw) > MAX_RESPONSE_BYTES:
            return TransportResponse(status, {}, latency, "response_too_large", headers)
        try:
            decoded = json.loads(raw.decode("utf-8")) if raw.strip() else {}
        except (UnicodeDecodeError, json.JSONDecodeError):
            return TransportResponse(status, {}, latency, "malformed_json", headers)
        return TransportResponse(status, decoded if isinstance(decoded, dict) else {}, latency, "" if isinstance(decoded, dict) else "malformed_payload", headers)


def _response_material(response: Mapping[str, Any]) -> dict[str, Any]:
    return {key: value for key, value in response.items() if key not in {"format_contract", "response_digest", "_fallback_stage_receipt"}}


def _response_id_material(response: Mapping[str, Any]) -> dict[str, Any]:
    return {key: value for key, value in response.items() if key not in {"response_id", "response_digest", "format_contract", "_fallback_stage_receipt"}}


def _response_digest(response: Mapping[str, Any]) -> str:
    return digest(_response_material(response))


def _response_id(response: Mapping[str, Any]) -> str:
    return "rr_" + hashlib.sha256(_canonical(_response_id_material(response))).hexdigest()[:24]


def _component_digest(component: Mapping[str, Any]) -> str:
    copied = dict(component)
    copied.pop("component_digest", None)
    binding = _as_map(copied.get("binding"))
    if binding:
        binding = dict(binding)
        binding.pop("component_digest", None)
        copied["binding"] = binding
    return digest(copied)


def _all_values(value: Any) -> Iterable[Any]:
    if isinstance(value, dict):
        yield value
        for child in value.values():
            yield from _all_values(child)
    elif isinstance(value, list):
        for child in value:
            yield from _all_values(child)


def _gap_codes(response: Mapping[str, Any]) -> set[str]:
    return {str(_as_map(raw).get("code") or "").strip() for raw in _as_list(response.get("gaps")) if str(_as_map(raw).get("code") or "").strip()}


def _extract_observability(result: TransportResponse, response: Mapping[str, Any]) -> dict[str, Any]:
    headers = {str(key).lower(): str(value) for key, value in (result.headers or {}).items()}
    body = _as_map(response.get("observability"))

    def number(names: Sequence[str], header_names: Sequence[str]) -> dict[str, Any]:
        value: Any = None
        field = ""
        for name in names:
            if name in body:
                value, field = body[name], name
                break
            if name in response:
                value, field = response[name], name
                break
        if value is None:
            for name in header_names:
                if name in headers:
                    value, field = headers[name], name
                    break
        try:
            parsed = float(value) if not isinstance(value, bool) else math.nan
        except (TypeError, ValueError):
            parsed = math.nan
        if not math.isfinite(parsed) or parsed < 0:
            return {"available": False, "value": None, "field": field}
        return {"available": True, "value": parsed, "field": field}

    return {
        "cost_microusd": number(("cost_microusd", "provider_cost_micros", "total_cost_micros"), ("x-contextlattice-cost-microusd", "x-contextlattice-provider-cost-micros")),
        "provider_calls": number(("provider_calls", "provider_call_count"), ("x-contextlattice-provider-calls",)),
        "provider_tokens": number(("provider_tokens", "provider_token_count"), ("x-contextlattice-provider-tokens",)),
        "tool_calls": number(("tool_calls", "tool_call_count"), ("x-contextlattice-tool-calls",)),
        "external_network_calls": number(("external_network_calls", "external_network_call_count"), ("x-contextlattice-external-network-calls",)),
        "provider_network_calls": number(("provider_network_calls", "provider_network_call_count"), ("x-contextlattice-provider-network-calls",)),
        "evaluator_localhost_requests": {"available": True, "value": 1, "field": "evaluator_transport_request"},
    }


def _expected_record_coverage(case: Mapping[str, Any], response: Mapping[str, Any]) -> dict[str, Any]:
    evidence = [_as_map(raw) for raw in _as_list(response.get("evidence"))]
    expected = [str(value).strip().lower() for field in ("expected_record_digests", "expected_content_digests") for value in _as_list(case.get(field)) if str(value).strip()]
    if not expected:
        return {"available": False, "matched": None, "expected": 0, "observed": 0, "reason": "no_authored_expected_record_identity"}
    observed = {str(row.get("content_digest") or "").lower() for row in evidence if _sha(row.get("content_digest"))}
    matched = len(set(expected) & observed)
    return {"available": True, "matched": matched, "expected": len(set(expected)), "observed": len(observed), "complete": matched == len(set(expected))}


def _expected_file_coverage(case: Mapping[str, Any], response: Mapping[str, Any]) -> dict[str, Any]:
    expected = [str(value).strip() for value in _as_list(case.get("expected_files")) if str(value).strip()]
    if len(expected) != 1:
        return {"available": False, "matched": None, "reason": "expected_file_denominator_invalid"}
    # Production response v1 intentionally omits file identity.  Only an
    # explicitly public opaque file identity can make this metric measured.
    public_values: list[str] = []
    for row in (_as_map(raw) for raw in _as_list(response.get("evidence"))):
        for key in ("file_ref", "file_digest", "record_ref"):
            value = row.get(key)
            if isinstance(value, str) and value.strip():
                public_values.append(value.strip())
    if not public_values:
        return {"available": False, "matched": None, "reason": "response_contract_uses_opaque_evidence_refs"}
    return {"available": True, "matched": any(value == expected[0] for value in public_values), "expected": 1, "observed": len(public_values)}


def _safe_failure(code: str, detail: str = "") -> dict[str, str]:
    row = {"code": code}
    if detail:
        row["detail"] = detail
    return row


def validate_response(request: Mapping[str, Any], case: Mapping[str, Any], result: TransportResponse, *, source_snapshot_digest: str | None) -> dict[str, Any]:
    response = result.payload if isinstance(result.payload, dict) else {}
    case_id_digest = _safe_case_digest(case)
    row: dict[str, Any] = {
        "case_id_digest": case_id_digest,
        "case_digest": case_id_digest,
        "request_digest": digest(dict(request)),
        "source_snapshot_digest": source_snapshot_digest,
        "attempted": True,
        "http_status": result.status,
        "latency_ms": round(max(0.0, float(result.latency_ms)), 3),
        "response_observed": bool(response),
        "response_digest": response.get("response_digest") if isinstance(response.get("response_digest"), str) else None,
        "runtime_snapshot_digest": None,
        "receipt_digest": None,
        "contract_valid": False,
        "proof_binding_valid": False,
        "temporal_binding_valid": False,
        "fail_closed": False,
        "evidence_count": 0,
        "observed_record_digests": [],
        "evidence_record_coverage": _expected_record_coverage(case, response),
        "evidence_file_coverage": _expected_file_coverage(case, response),
        "citation_exactness": {"available": False, "matched": None, "reason": "no_authored_citation_identity"},
        "citation_structural_valid": False,
        "unsupported_action": False,
        "tool_ref_count": 0,
        "refusal": False,
        "abstained": None,
        "non_exclusion": {"available": False, "preserved": None, "gap_codes": []},
        "continuation": {"available": False, "observed": None},
        "observed_projection_digest": None,
        "observability": _extract_observability(result, response),
        "failures": [],
    }
    if result.error:
        row["failures"].append(_safe_failure(result.error))
        return row
    if result.status < 200 or result.status >= 300:
        row["failures"].append(_safe_failure("http_status"))
        return row
    if not response:
        row["failures"].append(_safe_failure("empty_response"))
        return row
    if response.get("schema_id") != RESPONSE_SCHEMA_ID or response.get("ok") is not True or response.get("version") != 1:
        row["failures"].append(_safe_failure("response_contract_invalid"))
    forbidden = [str(key) for value in _all_values(response) if isinstance(value, dict) for key in value if str(key).lower() in FORBIDDEN_PUBLIC_KEYS]
    if forbidden:
        row["failures"].append(_safe_failure("forbidden_public_field"))
    contract = _as_map(response.get("format_contract"))
    if contract.get("schema_id") != RESPONSE_SCHEMA_ID or contract.get("contract_valid") is not True or contract.get("truncated") is not False:
        row["failures"].append(_safe_failure("format_contract_invalid"))
    if not _sha(response.get("response_digest")) or response.get("response_digest") != _response_digest(response):
        row["failures"].append(_safe_failure("response_digest_mismatch"))
    if not _opaque_id(response.get("response_id"), "rr_") or response.get("response_id") != _response_id(response):
        row["failures"].append(_safe_failure("response_id_mismatch"))

    scope = _as_map(response.get("request_scope"))
    expected_query_digest = "sha256:" + hashlib.sha256(str(request.get("query") or "").encode("utf-8")).hexdigest()
    if scope.get("query_digest") != expected_query_digest:
        row["failures"].append(_safe_failure("request_scope_query_mismatch"))
    snapshot_digest = scope.get("snapshot_digest")
    receipt_digest = scope.get("receipt_digest")
    row["runtime_snapshot_digest"] = snapshot_digest if _sha(snapshot_digest) else None
    row["receipt_digest"] = receipt_digest if _sha(receipt_digest) else None
    if not _sha(snapshot_digest):
        row["failures"].append(_safe_failure("snapshot_digest_missing"))
    elif source_snapshot_digest and snapshot_digest != source_snapshot_digest:
        row["failures"].append(_safe_failure("source_snapshot_digest_mismatch"))
    if not _sha(receipt_digest):
        row["failures"].append(_safe_failure("receipt_digest_missing"))
    proof = _as_map(_as_map(response.get("answer")).get("proof_spine"))
    temporal_digest = scope.get("temporal_premise_digest")
    row["temporal_binding_valid"] = bool(
        _sha(temporal_digest)
        and proof.get("temporal_premise_digest") == temporal_digest
        and proof.get("as_of") == scope.get("as_of")
    )
    if not row["temporal_binding_valid"]:
        row["failures"].append(_safe_failure("temporal_binding_invalid"))
    expected_as_of, as_of_valid = _normalise_as_of(request.get("as_of"))
    if scope.get("as_of") != expected_as_of:
        row["temporal_binding_valid"] = False
        row["failures"].append(_safe_failure("as_of_mismatch"))
    if not as_of_valid:
        row["temporal_binding_valid"] = False
    gaps = _gap_codes(response)
    evidence = [_as_map(raw) for raw in _as_list(response.get("evidence"))]
    row["evidence_count"] = len(evidence)
    evidence_refs: set[str] = set()
    evidence_valid = True
    for item in evidence:
        ref_id = str(item.get("ref_id") or "")
        evidence_refs.add(ref_id)
        if not _sha(item.get("source_ref")) or not _sha(item.get("content_digest")) or not ref_id:
            evidence_valid = False
    row["citation_structural_valid"] = evidence_valid
    row["observed_record_digests"] = sorted({str(item.get("content_digest")).lower() for item in evidence if _sha(item.get("content_digest"))})
    proof_refs = {str(value) for value in _as_list(proof.get("proof_refs")) if str(value)}
    classification = _as_map(response.get("classification"))
    row["proof_binding_valid"] = bool(
        _sha(scope.get("snapshot_digest"))
        and _sha(scope.get("receipt_digest"))
        and proof.get("temporal_premise_digest") == scope.get("temporal_premise_digest")
        and evidence_valid
        and evidence_refs.issubset(proof_refs)
    )
    if not row["proof_binding_valid"]:
        row["failures"].append(_safe_failure("proof_binding_invalid"))
    facets = _as_map(classification.get("facets"))
    row["observed_request_shape"] = {
        "retrieval_intent": scope.get("retrieval_intent"),
        "task_class": scope.get("task_class"),
        "evidence_state": facets.get("evidence_state"),
        "temporal_state": facets.get("temporal_state"),
        "proof_union_digest": digest(sorted(evidence_refs | proof_refs)),
    }
    for component in (_as_map(raw) for raw in _as_list(_as_map(response.get("answer")).get("components"))):
        binding = _as_map(component.get("binding"))
        row["tool_ref_count"] += sum(1 for key in ("tool_ref", "intended_tool_ref") if str(_as_map(component.get("payload")).get(key) or "").strip())
        if binding and (binding.get("snapshot_digest") != snapshot_digest or binding.get("receipt_digest") != receipt_digest or binding.get("temporal_premise_digest") != temporal_digest or component.get("component_digest") != _component_digest(component)):
            row["failures"].append(_safe_failure("component_binding_invalid"))
    next_action = _as_map(response.get("next_action"))
    action_kind = str(next_action.get("kind") or "").strip().lower()
    row["unsupported_action"] = action_kind in UNSUPPORTED_ACTIONS or (action_kind and action_kind not in ALLOWED_NEXT_ACTIONS)
    if row["unsupported_action"]:
        row["failures"].append(_safe_failure("unsupported_action"))
    posture = str(classification.get("posture") or "").strip().lower()
    answer = _as_map(response.get("answer"))
    answer_mode = str(answer.get("answer_mode") or "").strip().lower()
    row["abstained"] = posture == "abstain" or answer_mode == "abstention" or action_kind in {"retrieve_or_verify", "verify_conflict", "verify_currentness", "none"}
    row["refusal"] = row["abstained"] is True and bool(_as_list(_as_map(response.get("action_boundary")).get("forbidden")))
    boundary = _as_map(response.get("action_boundary"))
    outcome = _as_map(response.get("outcome"))
    row["fail_closed"] = bool(boundary.get("can_act") is False and boundary.get("execution_performed") is False and outcome.get("execution_performed") is False and next_action.get("execution_performed") is False)
    if not row["fail_closed"]:
        row["failures"].append(_safe_failure("fail_closed_boundary_invalid"))
    row["non_exclusion"] = {"available": bool(gaps & NON_EXCLUSION_GAP_CODES), "preserved": bool(gaps & NON_EXCLUSION_GAP_CODES) and bool(proof_refs), "gap_codes": sorted(gaps & NON_EXCLUSION_GAP_CODES)}
    row["continuation"] = {"available": bool(gaps & CONTINUATION_GAP_CODES) or action_kind == "project_continuation", "observed": bool(gaps & CONTINUATION_GAP_CODES) or action_kind == "project_continuation"}
    row["observed_action"] = {"next_action": action_kind, "tool_ref_count": row["tool_ref_count"], "refusal": row["refusal"]}
    row["observed_temporal"] = {"as_of": scope.get("as_of"), "temporal_state": facets.get("temporal_state"), "premise_digest": temporal_digest}
    expected_snapshot = next((case.get(key) for key in ("expected_runtime_snapshot_digest", "expected_response_snapshot_digest") if case.get(key) is not None), None)
    if expected_snapshot is not None and snapshot_digest != expected_snapshot:
        row["failures"].append(_safe_failure("snapshot_drift"))
    expected_as_of_failure = (not as_of_valid) and ("invalid_temporal_premise" not in gaps or evidence)
    if expected_as_of_failure:
        row["failures"].append(_safe_failure("invalid_as_of_not_failed_closed"))
    expected_citation = [str(value).strip().lower() for value in _as_list(case.get("expected_citation_digests")) if str(value).strip()]
    if expected_citation:
        observed_citation = {str(item.get("content_digest") or "").lower() for item in evidence if _sha(item.get("content_digest"))}
        matched = len(set(expected_citation) & observed_citation)
        row["citation_exactness"] = {"available": True, "matched": matched, "expected": len(set(expected_citation)), "complete": matched == len(set(expected_citation))}
    row["observed_projection_digest"] = digest({"request_scope": scope, "evidence": evidence, "proof_refs": sorted(proof_refs), "gaps": sorted(gaps), "next_action": action_kind})
    row["contract_valid"] = not any(failure["code"] in {"response_contract_invalid", "format_contract_invalid", "forbidden_public_field", "response_digest_mismatch", "response_id_mismatch"} for failure in row["failures"])
    return row


def _observability_blockers(rows: Sequence[Mapping[str, Any]]) -> list[str]:
    required = (
        ("cost_microusd", "missing_cost_observability", "nonzero_provider_cost"),
        ("provider_calls", "missing_provider_call_observability", "provider_calls_observed"),
        ("external_network_calls", "missing_external_network_observability", "external_network_calls_observed"),
    )
    blockers: list[str] = []
    for field, missing_code, nonzero_code in required:
        values = [_as_map(_as_map(row.get("observability")).get(field)) for row in rows]
        if not values or any(value.get("available") is not True for value in values):
            blockers.append(missing_code)
        elif any(value.get("value") != 0 for value in values):
            blockers.append(nonzero_code)

    token_values = [_as_map(_as_map(row.get("observability")).get("provider_tokens")) for row in rows]
    token_exposed = any(str(value.get("field") or "").strip() for value in token_values)
    if token_exposed:
        if not token_values or any(value.get("available") is not True for value in token_values):
            blockers.append("missing_provider_token_observability")
        elif any(value.get("value") != 0 for value in token_values):
            blockers.append("provider_tokens_observed")

    provider_network_values = [_as_map(_as_map(row.get("observability")).get("provider_network_calls")) for row in rows]
    provider_network_exposed = any(str(value.get("field") or "").strip() for value in provider_network_values)
    if provider_network_exposed:
        if not provider_network_values or any(value.get("available") is not True for value in provider_network_values):
            blockers.append("missing_provider_network_observability")
        elif any(value.get("value") != 0 for value in provider_network_values):
            blockers.append("provider_network_calls_observed")
    return sorted(set(blockers))


def _observability_summary(rows: Sequence[Mapping[str, Any]], field: str, *, optional: bool = False) -> dict[str, Any]:
    values = [_as_map(_as_map(row.get("observability")).get(field)) for row in rows]
    available = sum(1 for value in values if value.get("available") is True)
    exposed = sum(1 for value in values if str(value.get("field") or "").strip())
    if optional and exposed == 0:
        status = "not_exposed"
    elif values and available == len(values):
        status = "measured"
    else:
        status = "unmeasured"
    total = round(sum(float(value.get("value") or 0) for value in values if value.get("available") is True), 6) if available else None
    return {"status": status, "rows": len(values), "available_rows": available, "exposed_rows": exposed, "total": total}


def _aggregate_boolean(rows: Sequence[Mapping[str, Any]], field: str) -> dict[str, Any]:
    values = [row.get(field) for row in rows if isinstance(row.get(field), bool)]
    if len(values) != len(rows) or not rows:
        return {"status": "unmeasured", "denominator": len(rows), "observed": len(values), "rate": None}
    return {"status": "measured", "denominator": len(rows), "observed": len(values), "rate": round(sum(values) / len(values), 6)}


def _aggregate_latency(rows: Sequence[Mapping[str, Any]]) -> dict[str, Any]:
    values = [float(row.get("latency_ms")) for row in rows if _is_number(row.get("latency_ms"))]
    if len(values) != len(rows) or not values:
        return {"status": "unmeasured", "denominator": len(rows), "observed": len(values), "mean_ms": None, "p50_ms": None, "p95_ms": None}
    ordered = sorted(values)
    return {"status": "measured", "denominator": len(rows), "observed": len(values), "mean_ms": round(statistics.fmean(values), 3), "p50_ms": round(ordered[max(0, math.ceil(len(ordered) * 0.50) - 1)], 3), "p95_ms": round(ordered[max(0, math.ceil(len(ordered) * 0.95) - 1)], 3)}


def _aggregate_rates(rows: Sequence[Mapping[str, Any]], field: str) -> dict[str, Any]:
    values = [bool(row.get(field)) for row in rows]
    return {"status": "measured" if rows else "unmeasured", "denominator": len(rows), "count": sum(values), "rate": round(sum(values) / len(values), 6) if values else None}


def _aggregate_coverage(rows: Sequence[Mapping[str, Any]], field: str) -> dict[str, Any]:
    values = [_as_map(row.get(field)) for row in rows if _as_map(row.get(field)).get("available") is True]
    complete = [value.get("complete") is True or value.get("matched") is True for value in values]
    return {
        "status": "measured" if values else "unmeasured",
        "denominator": len(values),
        "complete": sum(complete),
        "rate": round(sum(complete) / len(complete), 6) if complete else None,
    }


def _semantic_metrics(rows: Sequence[Mapping[str, Any]], labels: LabelValidation | None, cases: Sequence[Mapping[str, Any]]) -> tuple[dict[str, Any], list[str]]:
    holdout_ids = {str(case.get("id")) for case in cases if str(case.get("split") or "").lower() == "holdout"}
    if labels is None or not labels.valid or not holdout_ids.issubset(labels.labels_by_case):
        return {
            "status": "unmeasured",
            "reason": "missing_authored_holdout_labels",
            "answer_correctness": {"status": "unmeasured", "reason": "retrieval scores are not answer ground truth"},
            "request_shape": {"status": "unmeasured"},
            "action": {"status": "unmeasured"},
            "temporal": {"status": "unmeasured"},
            "abstention_appropriateness": {"status": "unmeasured"},
            "citation_exactness": {"status": "unmeasured"},
            "answer_quality_claim_allowed": False,
        }, ["missing_authored_labels"]
    comparisons: dict[str, list[bool]] = {"request_shape": [], "action": [], "temporal": [], "abstention_appropriateness": [], "citation_exactness": []}
    case_lookup = {str(case.get("id")): case for case in cases}
    for row in rows:
        case_id = next((case_id for case_id, case in case_lookup.items() if _safe_case_digest(case) == row.get("case_id_digest")), "")
        label = labels.labels_by_case.get(case_id)
        if not label:
            continue
        expected_shape = _as_map(label.get("request_shape"))
        expected_action = _as_map(label.get("action"))
        expected_temporal = _as_map(label.get("temporal"))
        expected_abstention = _as_map(label.get("abstention"))
        observed_shape = _as_map(row.get("observed_request_shape"))
        observed_action = _as_map(row.get("observed_action"))
        observed_temporal = _as_map(row.get("observed_temporal"))
        if expected_shape:
            comparisons["request_shape"].append(all(observed_shape.get(key) == value for key, value in expected_shape.items()))
        action_checks: list[bool] = []
        for key, value in expected_action.items():
            if key == "expected_next_action":
                action_checks.append(observed_action.get("next_action") == value)
            elif key == "requires_refusal":
                action_checks.append(observed_action.get("refusal") == value)
            elif key == "expected_tool_ref":
                action_checks.append(int(observed_action.get("tool_ref_count") or 0) > 0)
        if expected_action:
            comparisons["action"].append(bool(action_checks) and all(action_checks))
        if expected_temporal:
            comparisons["temporal"].append(all(
                (observed_temporal.get("as_of") == value if key == "expected_as_of" else observed_temporal.get("temporal_state") == value if key in {"expected_temporal_state", "expected_currentness"} else True)
                for key, value in expected_temporal.items()
            ))
        if "expected" in expected_abstention:
            comparisons["abstention_appropriateness"].append(bool(row.get("abstained")) == bool(expected_abstention.get("expected")))
        expected_citations = {str(value).lower() for value in _as_list(label.get("expected_record_digests")) + _as_list(label.get("expected_content_digests"))}
        observed_citations = {str(value).lower() for value in _as_list(row.get("observed_record_digests"))}
        if expected_citations:
            comparisons["citation_exactness"].append(expected_citations.issubset(observed_citations))
    metrics: dict[str, Any] = {"status": "measured" if any(comparisons.values()) else "unmeasured"}
    for key, values in comparisons.items():
        metrics[key] = {
            "status": "measured" if values else "unmeasured",
            "applicable": bool(values),
            "denominator": len(values),
            "correct": sum(values),
            "rate": round(sum(values) / len(values), 6) if values else None,
        }
    metrics["answer_correctness"] = {"status": "unmeasured", "reason": "no answer-correctness oracle in this contract"}
    metrics["answer_quality_claim_allowed"] = False
    return metrics, []


def _promotion_threshold_blockers(report: Mapping[str, Any]) -> list[str]:
    metrics = _as_map(report.get("metrics"))
    blockers: list[str] = []
    structural = {
        "contract_validity": "contract_validity_min_rate",
        "proof_binding": "proof_binding_min_rate",
        "temporal_as_of_binding": "temporal_as_of_binding_min_rate",
        "fail_closed": "fail_closed_min_rate",
    }
    for metric_name, threshold_name in structural.items():
        metric = _as_map(metrics.get(metric_name))
        threshold = PROMOTION_THRESHOLDS[threshold_name]
        rate = metric.get("rate")
        if metric.get("status") != "measured" or not _is_number(rate):
            blockers.append(f"{metric_name}_unmeasured")
        elif float(rate) < threshold:
            blockers.append(f"{metric_name}_threshold_failed")

    unsupported = _as_map(metrics.get("unsupported_action_rate"))
    if unsupported.get("status") != "measured":
        blockers.append("unsupported_action_unmeasured")
    elif float(unsupported.get("rate") or 0) > PROMOTION_THRESHOLDS["unsupported_action_max_rate"]:
        blockers.append("unsupported_action_observed")

    reproducibility = _as_map(report.get("reproducibility"))
    if reproducibility.get("status") != "measured":
        blockers.append("reproducibility_unmeasured")
    else:
        for field, threshold_name, code in (
            ("exact_digest_rate", "replay_exact_digest_min_rate", "replay_digest_threshold_failed"),
            ("exact_snapshot_rate", "replay_exact_snapshot_min_rate", "replay_snapshot_threshold_failed"),
        ):
            rate = reproducibility.get(field)
            if not _is_number(rate) or float(rate) < PROMOTION_THRESHOLDS[threshold_name]:
                blockers.append(code)

    semantic = _as_map(report.get("semantic_metrics"))
    semantic_metric_names = ("request_shape", "action", "temporal", "abstention_appropriateness", "citation_exactness")
    for metric_name in semantic_metric_names:
        metric = _as_map(semantic.get(metric_name))
        if metric.get("applicable") is not True:
            blockers.append(f"semantic_{metric_name}_unmeasured")
            continue
        if metric.get("status") != "measured" or not _is_number(metric.get("rate")):
            blockers.append(f"semantic_{metric_name}_unmeasured")
        elif float(metric.get("rate")) < PROMOTION_THRESHOLDS["authored_semantic_min_rate"]:
            blockers.append(f"semantic_threshold_failed:{metric_name}")
    return sorted(set(blockers))


def _answer_quality_claim_blockers(report: Mapping[str, Any]) -> list[str]:
    semantic = _as_map(report.get("semantic_metrics"))
    if semantic.get("answer_correctness", {}).get("status") != "measured" or semantic.get("answer_quality_claim_allowed") is not True:
        return ["answer_quality_unmeasured"]
    return []


def _failure_ledger(rows: Sequence[Mapping[str, Any]], extra: Iterable[Mapping[str, Any]] = ()) -> dict[str, Any]:
    counts: dict[str, int] = {}
    total = 0
    for row in rows:
        failures = _as_list(row.get("failures"))
        for failure in failures:
            code = str(_as_map(failure).get("code") or "unknown")
            counts[code] = counts.get(code, 0) + 1
            total += 1
    for failure in extra:
        code = str(_as_map(failure).get("code") or "unknown")
        counts[code] = counts.get(code, 0) + 1
        total += 1
    return {"total": total, "by_code": dict(sorted(counts.items()))}


def _runtime_identity(payload: Mapping[str, Any], expected_commit: str, expected_tree: str) -> tuple[dict[str, Any], list[dict[str, Any]]]:
    build = _as_map(payload.get("build"))
    memory = _as_map(payload.get("memoryStore"))
    identity = {key: build.get(key) for key in ("schema_id", "version", "channel", "source_bound", "source_commit", "source_tree", "boot_nonce")}
    safe_memory = {key: memory.get(key) for key in ("ready", "phase", "writer_policy", "processed_entries", "batch_count")}
    safe_memory["store_ref_digest"] = digest(str(memory.get("store_ref") or "")) if str(memory.get("store_ref") or "").strip() else None
    issues: list[dict[str, Any]] = []
    if payload.get("ok") is not True or identity.get("schema_id") != "contextlattice_build_identity.v1" or identity.get("source_bound") is not True:
        _issue(issues, "runtime_identity_invalid", "health did not prove a source-bound runtime")
    if not HEX40_RE.fullmatch(str(identity.get("source_commit") or "")):
        _issue(issues, "runtime_source_commit_invalid", "runtime source commit is not a 40-hex identity")
    if not HEX40_RE.fullmatch(str(identity.get("source_tree") or "")):
        _issue(issues, "runtime_source_tree_invalid", "runtime source tree is not a 40-hex identity")
    if not expected_commit or not expected_tree:
        _issue(issues, "runtime_source_expectation_missing", "expected rebuilt runtime source commit and tree are required")
    if expected_commit and identity.get("source_commit") != expected_commit:
        _issue(issues, "runtime_source_commit_mismatch", "runtime source commit does not match expected rebuilt source")
    if expected_tree and identity.get("source_tree") != expected_tree:
        _issue(issues, "runtime_source_tree_mismatch", "runtime source tree does not match expected rebuilt source")
    if safe_memory.get("ready") is not True or safe_memory.get("phase") != "ready" or safe_memory.get("writer_policy") != "owner_only_writer.v2" or safe_memory.get("store_ref_digest") is None or not isinstance(memory.get("store_ref"), str):
        _issue(issues, "runtime_memory_store_not_ready", "health did not prove a ready owner-only memory store")
    return {"identity": identity, "memory_store": safe_memory, "identity_digest": digest({"identity": identity, "memory_store": safe_memory})}, issues


