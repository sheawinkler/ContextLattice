#!/usr/bin/env python3
"""Audit agent-facing ContextLattice output boundaries."""

from __future__ import annotations

import argparse
import copy
import json
from typing import Any

from _common import emit, request_json


SCHEMA_ID = "contextlattice_context_boundary.v1"
REQUIRED_PATHS = (
    "/memory/context-pack",
    "/tools/context_pack",
    "/memory/continuity/reconcile",
    "/memory/objectives/transition",
    "/memory/objectives/graph",
    "/memory/decision-changes",
    "/v1/agents/preflight",
    "/v1/codex/preflight",
    "policy_context_package",
    "scripts/agent/contextlattice-pack",
    "contextlattice_continuity_reconcile",
    "contextlattice_objective_transition",
    "contextlattice_objective_graph",
    "contextlattice_decision_change",
    "contextlattice_decision_change list",
    "scripts/agent/compaction-handoff-payload",
    "scripts/agent_hooks/contextlattice_pre_compaction_write.sh",
    "scripts/agent_hooks/contextlattice_post_compaction_read.sh",
)
REQUIRED_METADATA_FIELDS = (
    "contract_valid",
    "truncated",
    "omitted_counts",
    "actual_json_bytes",
    "max_total_json_bytes",
    "max_string_bytes",
    "max_list_items",
)
REQUIRED_CONTRACT_SURFACES = (
    ("/memory/continuity/reconcile", "task_identity_reconciliation.v1"),
    ("/memory/objectives/transition", "objective_transition.v1"),
    ("/memory/objectives/graph", "objective_graph.v1"),
    ("/memory/decision-changes", "decision_change.v1"),
    ("/memory/decision-changes", "decision_change_query.v1"),
    ("contextlattice_continuity_reconcile", "task_identity_reconciliation.v1"),
    ("contextlattice_objective_transition", "objective_transition.v1"),
    ("contextlattice_objective_graph", "objective_graph.v1"),
    ("contextlattice_decision_change", "decision_change.v1"),
    ("contextlattice_decision_change list", "decision_change_query.v1"),
)


def as_dict(value: Any) -> dict[str, Any]:
    return value if isinstance(value, dict) else {}


def as_list(value: Any) -> list[Any]:
    return value if isinstance(value, list) else []


def as_int(value: Any, fallback: int = 0) -> int:
    try:
        return int(value)
    except (TypeError, ValueError):
        return fallback


def payload_without_marker_manifest(payload: dict[str, Any]) -> dict[str, Any]:
    redacted = copy.deepcopy(payload)
    redacted["forbidden_error_markers"] = []
    agent_ready = as_dict(redacted.get("agent_ready"))
    if agent_ready:
        agent_ready.pop("recommended", None)
        redacted["agent_ready"] = agent_ready
    return redacted


def audit_payload(payload: dict[str, Any]) -> dict[str, Any]:
    findings: list[dict[str, Any]] = []
    if payload.get("schema_id") != SCHEMA_ID:
        findings.append({"reason": "schema_id_mismatch", "expected": SCHEMA_ID, "actual": payload.get("schema_id")})
    if payload.get("ok") is not True:
        findings.append({"reason": "context_boundary_not_ok", "status": payload.get("status")})
    if as_int(payload.get("violationCount")) != 0:
        findings.append({"reason": "boundary_violations_present", "count": as_int(payload.get("violationCount"))})

    routes = [as_dict(route) for route in as_list(payload.get("routes"))]
    by_path: dict[str, list[dict[str, Any]]] = {}
    for route in routes:
        by_path.setdefault(str(route.get("path") or ""), []).append(route)
    missing = [path for path in REQUIRED_PATHS if not by_path.get(path)]
    if missing:
        findings.append({"reason": "required_boundaries_missing", "paths": missing})
    for path in REQUIRED_PATHS:
        for route in by_path.get(path, []):
            identity = {"path": path, "contract_id": route.get("contract_id"), "name": route.get("name")}
            if route.get("bounded") is not True:
                findings.append({"reason": "required_boundary_not_bounded", **identity, "route": route})
            for field in ("max_total_json_bytes", "max_string_bytes", "max_list_items"):
                if as_int(route.get(field)) <= 0:
                    findings.append({"reason": "boundary_limit_missing", **identity, "field": field})
            fields = {str(item) for item in as_list(route.get("metadata_fields"))}
            missing_fields = [field for field in REQUIRED_METADATA_FIELDS if field not in fields]
            if missing_fields:
                findings.append({"reason": "metadata_fields_missing", **identity, "fields": missing_fields})

    for path, contract_id in REQUIRED_CONTRACT_SURFACES:
        if not any(str(route.get("contract_id") or "") == contract_id for route in by_path.get(path, [])):
            findings.append(
                {
                    "reason": "required_contract_boundary_missing",
                    "path": path,
                    "contract_id": contract_id,
                }
            )

    marker_source = json.dumps(payload_without_marker_manifest(payload), sort_keys=True).lower()
    marker_hits = [
        marker
        for marker in as_list(payload.get("forbidden_error_markers"))
        if isinstance(marker, str) and marker.strip() and marker.lower() in marker_source
    ]
    if marker_hits:
        findings.append({"reason": "forbidden_error_markers_leaked", "markers": marker_hits})

    return {
        "ok": not findings,
        "schema_id": "contextlattice_context_boundary_audit.v1",
        "source_schema_id": payload.get("schema_id"),
        "status": payload.get("status"),
        "registry_id": payload.get("registry_id"),
        "registry_version": payload.get("registry_version"),
        "requiredSurfaceCount": payload.get("requiredSurfaceCount"),
        "boundedSurfaceCount": payload.get("boundedSurfaceCount"),
        "violationCount": payload.get("violationCount"),
        "checkedRequiredPaths": list(REQUIRED_PATHS),
        "checkedRequiredContracts": [
            {"path": path, "contract_id": contract_id} for path, contract_id in REQUIRED_CONTRACT_SURFACES
        ],
        "findings": findings,
        "raw": payload,
    }


def main() -> int:
    parser = argparse.ArgumentParser(description="Audit agent-facing ContextLattice output boundary contracts.")
    parser.add_argument("--timeout", type=float, default=10)
    parser.add_argument("--pretty", action="store_true")
    args = parser.parse_args()

    payload = request_json("GET", "/ops/context-boundary", None, args.timeout)
    result = audit_payload(payload)
    emit(result, args.pretty)
    return 0 if result["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
