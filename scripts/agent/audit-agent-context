#!/usr/bin/env python3
"""Run the agent context audit gate."""

from __future__ import annotations

import argparse
import json
import subprocess
from pathlib import Path
from typing import Any

from _common import emit


SCRIPT_DIR = Path(__file__).resolve().parent


def run_json(name: str, argv: list[str]) -> dict[str, Any]:
    proc = subprocess.run(argv, check=False, capture_output=True, text=True)
    try:
        payload = json.loads(proc.stdout or "{}")
    except json.JSONDecodeError:
        payload = {"ok": False, "error": "invalid_json_output", "stdout": proc.stdout[:2000]}
    payload.setdefault("ok", proc.returncode == 0)
    return {"name": name, "returncode": proc.returncode, "payload": payload}


def summarize_check(check: dict[str, Any], include_details: bool) -> dict[str, Any]:
    name = str(check["name"])
    payload = check["payload"]
    summary: dict[str, Any] = {
        "name": name,
        "returncode": check["returncode"],
        "ok": bool(payload.get("ok", False)),
    }
    if name == "context_size":
        over_budget = payload.get("over_budget") or []
        summary.update(
            {
                "count": payload.get("count", 0),
                "over_budget_count": len(over_budget),
                "over_budget": over_budget[:10],
            }
        )
    elif name == "skill_frontmatter":
        findings = payload.get("findings") or []
        errors = [item for item in findings if item.get("severity") == "error"]
        warnings = [item for item in findings if item.get("severity") != "error"]
        summary.update(
            {
                "error_count": len(errors),
                "warning_count": len(warnings),
                "errors": errors[:10],
                "warnings": warnings[:10],
            }
        )
    elif name == "compaction_hooks":
        summary.update({"results": payload.get("results", [])})
    elif name == "codex_hook_trust":
        summary.update(
            {
                "managed_hook_count": payload.get("managed_hook_count", 0),
                "mismatch_count": len(payload.get("mismatches") or []),
                "mismatches": (payload.get("mismatches") or [])[:10],
                "skipped": payload.get("skipped", False),
            }
        )
    elif name == "codex_session_store":
        findings = payload.get("findings") or []
        errors = [item for item in findings if item.get("severity") == "error"]
        warnings = [item for item in findings if item.get("severity") == "warn"]
        summary.update(
            {
                "advanced_mode": payload.get("advanced_mode", False),
                "default_local_safe": payload.get("default_local_safe", False),
                "external_volume": payload.get("external_volume", False),
                "tcc_managed": payload.get("tcc_managed", False),
                "sessions_realpath": payload.get("sessions_realpath"),
                "error_count": len(errors),
                "warning_count": len(warnings),
                "errors": errors[:10],
                "warnings": warnings[:10],
            }
        )
    elif name == "context_pack_schema":
        findings = payload.get("findings") or []
        summary.update({"finding_count": len(findings), "findings": findings[:10]})
    elif name == "agent_output_contracts":
        findings = payload.get("findings") or []
        errors = [item for item in findings if item.get("severity") == "error"]
        summary.update(
            {
                "registry": payload.get("registry"),
                "required_contract_count": len(payload.get("required_contracts") or []),
                "error_count": len(errors),
                "errors": errors[:10],
            }
        )
    elif name == "context_overflow_recovery":
        findings = payload.get("findings") or []
        summary.update(
            {
                "case_count": payload.get("case_count", 0),
                "finding_count": len(findings),
                "findings": findings[:10],
            }
        )

    elif name == "agent_preflight_matrix":
        findings = payload.get("findings") or []
        summary.update(
            {
                "case_count": payload.get("case_count", 0),
                "agents": payload.get("agents", []),
                "finding_count": len(findings),
                "findings": findings[:10],
            }
        )
    elif name == "agent_profile_parity":
        findings = payload.get("findings") or []
        summary.update(
            {
                "available_refs": payload.get("available_refs", []),
                "skipped_ref_count": len(payload.get("skipped_refs") or []),
                "finding_count": len(findings),
                "findings": findings[:10],
            }
        )
    elif name == "agent_global_install_smoke":
        failed = payload.get("failed") or []
        summary.update(
            {
                "global_home": payload.get("global_home"),
                "check_count": len(payload.get("checks") or []),
                "failed_count": len(failed),
                "failed": failed[:10],
            }
        )
    elif name == "universal_agent_adapter":
        findings = payload.get("findings") or []
        summary.update(
            {
                "case_count": payload.get("case_count", 0),
                "agents": payload.get("agents", []),
                "live": payload.get("live", False),
                "finding_count": len(findings),
                "findings": findings[:10],
            }
        )
    elif name == "skill_policy_eval":
        cases = payload.get("cases") or []
        failed = [item for item in cases if not item.get("ok")]
        summary.update({"case_count": payload.get("case_count", len(cases)), "failed_cases": failed[:10]})
    elif name == "instruction_conflicts":
        findings = payload.get("findings") or []
        summary.update({"finding_count": len(findings), "top_findings": findings[:10]})
    elif name == "instruction_duplicates":
        duplicates = payload.get("duplicates") or []
        summary.update(
            {
                "total_duplicates": payload.get("total_duplicates", len(duplicates)),
                "top_duplicates": duplicates[:10],
            }
        )
    if include_details:
        summary["details"] = payload
    return summary


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--pretty", action="store_true")
    parser.add_argument("--scope", choices=["active-user", "all"], default="active-user")
    parser.add_argument(
        "--strict-findings",
        action="store_true",
        help="Fail on conflict or duplicate findings in addition to hard validation errors.",
    )
    parser.add_argument("--include-details", action="store_true")
    args = parser.parse_args()

    checks = [
        run_json("context_size", [str(SCRIPT_DIR / "audit-context-size"), "--scope", args.scope]),
        run_json("skill_frontmatter", [str(SCRIPT_DIR / "audit-skill-frontmatter")]),
        run_json("compaction_hooks", [str(SCRIPT_DIR / "audit-compaction-hooks")]),
        run_json("codex_hook_trust", [str(SCRIPT_DIR / "audit-codex-hook-trust")]),
        run_json("codex_session_store", [str(SCRIPT_DIR / "audit-codex-session-store")]),
        run_json("context_pack_schema", [str(SCRIPT_DIR / "audit-context-pack-schema")]),
        run_json("agent_output_contracts", [str(SCRIPT_DIR / "audit-agent-output-contracts")]),
        run_json("context_overflow_recovery", [str(SCRIPT_DIR / "audit-context-overflow-recovery")]),

        run_json("agent_preflight_matrix", [str(SCRIPT_DIR / "audit-agent-preflight-matrix")]),
        run_json("agent_profile_parity", [str(SCRIPT_DIR / "audit-agent-profile-parity"), "--refs", "WORKTREE"]),
        run_json("agent_global_install_smoke", [str(SCRIPT_DIR / "audit-agent-global-install-smoke")]),
        run_json("universal_agent_adapter", [str(SCRIPT_DIR / "audit-universal-agent-adapter")]),
        run_json("skill_policy_eval", [str(SCRIPT_DIR / "eval-skill-policy")]),
        run_json("instruction_conflicts", [str(SCRIPT_DIR / "audit-conflicts")]),
        run_json("instruction_duplicates", [str(SCRIPT_DIR / "audit-instruction-duplicates")]),
    ]

    hard_check_names = {
        "context_size",
        "skill_frontmatter",
        "compaction_hooks",
        "codex_hook_trust",
        "codex_session_store",
        "context_pack_schema",
        "agent_output_contracts",
        "context_overflow_recovery",

        "agent_preflight_matrix",
        "agent_profile_parity",
        "agent_global_install_smoke",
        "universal_agent_adapter",
        "skill_policy_eval",
    }
    hard_failures = [
        check
        for check in checks
        if check["name"] in hard_check_names
        if check["returncode"] != 0 or not bool(check["payload"].get("ok", False))
    ]
    if args.strict_findings:
        for check in checks:
            if check["name"] in hard_check_names:
                continue
            payload = check["payload"]
            if payload.get("findings") or payload.get("duplicates"):
                hard_failures.append(check)

    summary = {
        "ok": not hard_failures,
        "scope": args.scope,
        "hard_failures": [check["name"] for check in hard_failures],
        "checks": [summarize_check(check, args.include_details) for check in checks],
    }
    emit(summary, args.pretty)
    return 1 if hard_failures else 0


if __name__ == "__main__":
    raise SystemExit(main())
