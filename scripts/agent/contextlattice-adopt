    context_visibility = as_dict(case.get("context_visibility"))
    return {
        "agent": case.get("agent"),
        "agent_id": case.get("agent_id"),
        "ok": bool(case.get("ok")),
        "session_id": case.get("session_id"),
        "phase_count": case.get("phase_count"),
        "skills_index_returned": case.get("skills_index_returned"),
        "skills_index_top": as_list(case.get("skills_index_top"))[:5],
        "context_visibility": {
            "context_package_validation": context_visibility.get("context_package_validation"),
            "rollup_validation": context_visibility.get("rollup_validation"),
            "recommended_surface": context_visibility.get("recommended_surface"),
            "confidence": context_visibility.get("confidence"),
            "reference_prompt_chars": context_visibility.get("reference_prompt_chars"),
            "recent_event_count": context_visibility.get("recent_event_count"),
            "graph_touches": context_visibility.get("graph_touches"),
            "handoff_count": context_visibility.get("handoff_count"),
            "checkpoint_count": context_visibility.get("checkpoint_count"),
