def cmd_matrix(args: argparse.Namespace) -> int:
    scenarios = [item.strip() for item in args.scenarios.split(",") if item.strip()]
    rows: list[dict[str, Any]] = []
    for scenario in scenarios:
        if scenario == "current-home":
            status_args = argparse.Namespace(home=args.home, global_home=args.global_home, timeout=args.timeout, include_doctor=True, include_session_store=True, pretty=False)
            status = build_status(status_args) if args.execute else {"planned": True, "command": "contextlattice_adopt status --pretty"}
            rows.append({"scenario": scenario, "ok": status.get("ok", True) is not False, "status": status})
        elif scenario == "fresh-home":
            with tempfile.TemporaryDirectory(prefix="contextlattice-adopt-home-") as tmp:
                gh = str(Path(tmp) / ".contextlattice")
                if args.execute:
                    status_args = argparse.Namespace(home=tmp, global_home=gh, timeout=args.timeout, include_doctor=False, include_session_store=False, pretty=False)
                    status = build_status(status_args)
                else:
                    status = {"planned": True, "home": tmp, "global_home": gh, "expected": "missing tools, gateway check only"}
                rows.append({"scenario": scenario, "ok": True, "status": status})
        elif scenario == "external-sessions":
            rows.append({"scenario": scenario, "ok": True, "status": {"planned": True, "checks": ["realpath ~/.codex/sessions", "warn on /Volumes", "warn on symlink", "write probe"]}})
        elif scenario == "all-profiles-proof":
            cmd = f"contextlattice_adopt proof --agents {args.agents or ','.join(profile_order())} --skip-provider-smoke --pretty"
            rows.append({"scenario": scenario, "ok": True, "status": {"planned": True, "command": cmd}})
        else:
            rows.append({"scenario": scenario, "ok": False, "status": {"error": "unknown_scenario"}})
    payload = {"ok": all(row.get("ok") for row in rows), "schema_id": ADOPT_MATRIX_SCHEMA, "generated_at": now_iso(), "scenarios": rows}
    emit(payload, args.pretty)
    return 0 if payload["ok"] else 1


def add_common(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--home", default=str(Path.home()))
    parser.add_argument("--global-home", default=os.getenv("CONTEXTLATTICE_GLOBAL_HOME", str(Path.home() / ".contextlattice")))
    parser.add_argument("--timeout", type=float, default=10)
    parser.add_argument("--pretty", action="store_true")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Adopt ContextLattice into any local agent/account/machine setup.")
    sub = parser.add_subparsers(dest="command", required=True)

    status = sub.add_parser("status", help="Inspect local adoption readiness.")
    add_common(status)
    status.add_argument("--include-doctor", action=argparse.BooleanOptionalAction, default=True)
    status.add_argument("--include-session-store", action=argparse.BooleanOptionalAction, default=True)
    status.set_defaults(func=cmd_status)

    install = sub.add_parser("install", help="Install global tools, optional hooks, then run adoption status.")
    add_common(install)
    install.add_argument("--install-codex-hooks", action=argparse.BooleanOptionalAction, default=True)
    install.add_argument("--no-codex-hooks", action="store_true")
    install.add_argument("--no-shell-profile", action="store_true")
    install.add_argument("--skip-venv", action="store_true")
    install.add_argument("--quiet", action="store_true")
    install.add_argument("--dry-run", action="store_true")
    install.add_argument("--run-proof", action="store_true")
    install.add_argument("--agent", default="codex")
    install.add_argument("--project", default="contextlattice")
    install.add_argument("--proof-timeout", type=float, default=30)
    install.set_defaults(func=cmd_install)

    proof = sub.add_parser("proof", help="Run adoption proof matrix over selected profiles.")
    proof.add_argument("--agents", default=",".join(profile_order()))
    proof.add_argument("--project", default="contextlattice")
    proof.add_argument("--base-url", default=os.getenv("CONTEXTLATTICE_ORCHESTRATOR_URL", "http://127.0.0.1:8075"))
    proof.add_argument("--proof-timeout", type=float, default=180)
    proof.add_argument("--phase-timeout", type=float, default=35)
    proof.add_argument("--skip-provider-smoke", action=argparse.BooleanOptionalAction, default=True)
    proof.add_argument("--progress", action="store_true")
    proof.add_argument("--pretty", action="store_true")
    proof.set_defaults(func=cmd_proof)

    doctor = sub.add_parser("doctor", help="Run local readiness, adoption proof, and trace visibility in one bounded report.")
    add_common(doctor)
    doctor.add_argument("--agents", default="codex")
    doctor.add_argument("--project", default="contextlattice")
    doctor.add_argument("--base-url", default=os.getenv("CONTEXTLATTICE_ORCHESTRATOR_URL", "http://127.0.0.1:8075"))
    doctor.add_argument("--proof-timeout", type=float, default=180)
    doctor.add_argument("--phase-timeout", type=float, default=35)
    doctor.add_argument("--skip-provider-smoke", action=argparse.BooleanOptionalAction, default=True)
    doctor.add_argument("--progress", action="store_true")
    doctor.add_argument("--trace", action=argparse.BooleanOptionalAction, default=True)
    doctor.add_argument("--trace-limit", type=int, default=1)
    doctor.add_argument("--trace-timeout", type=float, default=20)
    doctor.add_argument("--include-runtime-doctor", action=argparse.BooleanOptionalAction, default=True)
    doctor.add_argument("--include-session-store", action=argparse.BooleanOptionalAction, default=True)
    doctor.add_argument("--include-raw", action="store_true")
    doctor.set_defaults(func=cmd_doctor)

    export = sub.add_parser("export", help="Create a portable no-secrets agent pack.")
    export.add_argument("--name", default="contextlattice-agent-pack")
    export.add_argument("--profiles", default=",".join(profile_order()))
    export.add_argument("--base-url", default="http://127.0.0.1:8075")
    export.add_argument("--output", default="")
    export.add_argument("--dry-run", action="store_true")
    export.add_argument("--include-pack", action="store_true")
    export.add_argument("--pretty", action="store_true")
    export.set_defaults(func=cmd_export)

    import_cmd = sub.add_parser("import", help="Import a portable no-secrets agent pack.")
    import_cmd.add_argument("path")
    import_cmd.add_argument("--global-home", default=os.getenv("CONTEXTLATTICE_GLOBAL_HOME", str(Path.home() / ".contextlattice")))
    import_cmd.add_argument("--dry-run", action="store_true")
    import_cmd.add_argument("--pretty", action="store_true")
    import_cmd.set_defaults(func=cmd_import)

    profile = sub.add_parser("profile-template", help="Generate a template for a generic/new agent.")
    profile.add_argument("--name", required=True)
    profile.add_argument("--kind", choices=["cli", "desktop", "web", "mcp", "http", "repo"], default="cli")
    profile.add_argument("--agent-id", default="")
    profile.add_argument("--output", default="")
    profile.add_argument("--include-markdown", action="store_true")
    profile.add_argument("--pretty", action="store_true")
    profile.set_defaults(func=cmd_profile_template_with_default)

    matrix = sub.add_parser("matrix", help="Run or plan adoption CI scenarios.")
    add_common(matrix)
    matrix.add_argument("--scenarios", default="current-home,fresh-home,external-sessions,all-profiles-proof")
    matrix.add_argument("--agents", default="")
    matrix.add_argument("--execute", action="store_true")
    matrix.set_defaults(func=cmd_matrix)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
