def as_dict(value: Any) -> dict[str, Any]:
    return value if isinstance(value, dict) else {}


def as_list(value: Any) -> list[Any]:
    return value if isinstance(value, list) else []


def as_int(value: Any, fallback: int = 0) -> int:
    try:
        return int(value)
    except (TypeError, ValueError):
        return fallback


def short_text(value: Any, limit: int = 240) -> str:
    text = str(value or "").strip()
    if len(text) <= limit:
        return text
    return text[: max(0, limit - 3)].rstrip() + "..."


def load_profiles() -> dict[str, Any]:
    try:
        parsed = json.loads(AGENT_CONFIG.read_text(encoding="utf-8"))
    except Exception:
        return {}
    profiles = parsed.get("profiles") if isinstance(parsed, dict) else {}
    return profiles if isinstance(profiles, dict) else {}


def profile_order() -> list[str]:
    preferred = [
        "codex",
        "claude-code",
        "opencode",
        "hermes-agent",
        "hermes-ultra",
        "pi",
        "chatgpt-web",
        "chatgpt-desktop",
        "claude-web",
        "claude-desktop",
    ]
    profiles = load_profiles()
    ordered = [item for item in preferred if item in profiles]
    ordered.extend(sorted(set(profiles) - set(ordered)))
    return ordered


def selected_profiles(raw: str) -> list[str]:
    if raw.strip():
        return [item.strip() for item in raw.split(",") if item.strip()]
    return profile_order()


def run_command(argv: list[str], timeout: float, env: dict[str, str] | None = None) -> dict[str, Any]:
    try:
        proc = subprocess.run(
            argv,
            cwd=str(REPO_ROOT),
            env=env or os.environ.copy(),
            check=False,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired as exc:
        return {
            "ok": False,
            "reason": "timeout",
            "command": compact_command(argv),
            "timeout": timeout,
            "stdout": str(exc.stdout or "")[:1600],
            "stderr": str(exc.stderr or "")[:1600],
        }
    except OSError as exc:
        return {
            "ok": False,
            "reason": "exec_failed",
            "command": compact_command(argv),
            "stderr": str(exc)[:1600],
        }
    payload: Any = None
    if proc.stdout.strip().startswith(("{", "[")):
        try:
            payload = json.loads(proc.stdout)
        except json.JSONDecodeError:
            payload = None
    return {
        "ok": proc.returncode == 0,
        "returncode": proc.returncode,
        "command": compact_command(argv),
        "stdout": proc.stdout[:2400],
        "stderr": proc.stderr[:2400],
        "json": payload,
    }


def compact_command(argv: list[str]) -> list[str]:
    root = str(REPO_ROOT)
    home = str(Path.home())
    out: list[str] = []
    for item in argv:
        text = str(item)
        if text.startswith(root):
            text = text.replace(root, ".", 1)
        elif text.startswith(home):
            text = text.replace(home, "$HOME", 1)
        out.append(text)
    return out


def compact_path(path: Path) -> str:
    text = str(path)
    root = str(REPO_ROOT)
    home = str(Path.home())
    if text.startswith(root):
        return text.replace(root, ".", 1)
    if text.startswith(home):
        return text.replace(home, "$HOME", 1)
    return text


def install_argv(global_home: Path, args: argparse.Namespace | None = None) -> list[str]:
    skip_venv = bool(getattr(args, "skip_venv", False))
    if platform.system().lower() == "windows":
        runner = shutil.which("pwsh") or shutil.which("powershell") or "powershell"
        argv = [runner, "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", str(INSTALLER_PS1), "-GlobalHome", str(global_home)]
        if skip_venv:
            argv.append("-SkipVenv")
        return argv

    argv = [str(INSTALLER_SH), "--global-home", str(global_home)]
    if bool(getattr(args, "no_shell_profile", False)):
        argv.append("--no-shell-profile")
    if skip_venv:
        argv.append("--skip-venv")
    if bool(getattr(args, "install_codex_hooks", False)) and not bool(getattr(args, "no_codex_hooks", False)):
        argv.append("--install-codex-hooks")
    if bool(getattr(args, "quiet", False)):
        argv.append("--quiet")
    return argv


def tool_status(global_home: Path) -> list[dict[str, Any]]:
    bin_dir = global_home / "bin"
    rows: list[dict[str, Any]] = []
    for name in GLOBAL_TOOL_NAMES:
        path = bin_dir / name
        rows.append({"name": name, "path": str(path), "installed": path.is_file(), "executable": os.access(path, os.X_OK)})
    return rows


def detect_agents(home: Path) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    profiles = load_profiles()
    for profile in profile_order():
        command_hits = [cmd for cmd in AGENT_COMMANDS.get(profile, []) if shutil.which(cmd)]
        app_hits = [path for path in APP_PATHS.get(profile, []) if Path(path).exists()]
        if profile.endswith("-web") or profile in {"pi"}:
            install_state = "copy_template"
        elif command_hits or app_hits:
            install_state = "detected"
        else:
            install_state = "not_detected"
        template = template_path(profile)
        rows.append(
            {
                "profile": profile,
                "agent_id": str(as_dict(profiles.get(profile)).get("agent_id") or ""),
                "surfaces": as_list(as_dict(profiles.get(profile)).get("surfaces")),
                "install_state": install_state,
                "commands": command_hits,
                "apps": app_hits,
                "template": compact_path(template) if template.exists() else "",
            }
        )
    codex_sessions = home / ".codex" / "sessions"
    if codex_sessions.exists():
        rows.append({"profile": "codex-session-store", "install_state": "detected", "path": str(codex_sessions)})
    return rows


def template_path(profile: str) -> Path:
    mapping = {
        "chatgpt-web": "chatgpt-web-desktop.md",
        "chatgpt-desktop": "chatgpt-web-desktop.md",
        "claude-web": "claude-web-desktop.md",
        "claude-desktop": "claude-web-desktop.md",
    }
    return TEMPLATE_DIR / mapping.get(profile, f"{profile}.md")


def storage_checks(home: Path) -> list[dict[str, Any]]:
    checks: list[dict[str, Any]] = []
    candidates = [home / ".codex" / "sessions", home / ".contextlattice"]
    tcc_markers = ["/Documents/", "/Desktop/", "/Downloads/", "/Library/Mobile Documents/", "/Dropbox/", "/Google Drive/"]
    for path in candidates:
        exists = path.exists()
        try:
            real = path.resolve(strict=False)
        except Exception:
            real = path
        warnings: list[str] = []
        real_text = str(real)
        if path.is_symlink():
            warnings.append("symlinked_path")
        if real_text.startswith("/Volumes/"):
            warnings.append("external_volume")
        if any(marker in real_text for marker in tcc_markers):
            warnings.append("macos_tcc_managed_path")
        access_ok = True
        detail = ""
        if exists:
            access_ok = os.access(real, os.R_OK | os.W_OK | os.X_OK)
            if path.is_dir() and access_ok:
                try:
                    probe = path / f".contextlattice-write-check-{os.getpid()}"
                    probe.write_text("ok\n", encoding="utf-8")
                    probe.unlink(missing_ok=True)
                except Exception as exc:
                    access_ok = False
                    detail = str(exc)[:280]
        checks.append(
            {
                "path": str(path),
                "realpath": real_text,
                "exists": exists,
                "access_ok": access_ok,
                "warnings": warnings,
                "detail": detail,
            }
        )
    return checks


def shell_checks(global_home: Path, home: Path) -> list[dict[str, Any]]:
    bin_dir = str(global_home / "bin")
    checks = []
    for rc in [home / ".zshrc", home / ".bashrc"]:
        text = rc.read_text(encoding="utf-8", errors="replace") if rc.exists() else ""
        checks.append({"path": str(rc), "exists": rc.exists(), "path_entry": ".contextlattice/bin" in text or bin_dir in text})
    checks.append({"path": "PATH", "path_entry_live": bin_dir in os.getenv("PATH", "").split(os.pathsep)})
    return checks


def gateway_check(timeout: float) -> dict[str, Any]:
    try:
        health = request_json("GET", "/health", None, timeout)
    except BaseException as exc:  # request_json may SystemExit on HTTPError.
        return {"ok": False, "base_url": contextlattice_base_url(), "error": str(exc)[:480]}
    return {"ok": bool(health.get("ok")), "base_url": contextlattice_base_url(), "service": health.get("service")}


def doctor_check(global_home: Path, timeout: float) -> dict[str, Any]:
    if not DOCTOR.exists():
        return {"ok": False, "error": "runtime doctor script missing"}
    result = run_command([str(DOCTOR), "--global-home", str(global_home), "--timeout", str(timeout)], timeout + 10)
    return {"ok": result.get("ok"), "command": result.get("command"), "payload": result.get("json"), "stderr": result.get("stderr")}


def session_store_check(home: Path, timeout: float) -> dict[str, Any]:
    if not SESSION_STORE_DOCTOR.exists():
        return {"ok": True, "skipped": True, "reason": "session_store_doctor_missing"}
    path = home / ".codex" / "sessions"
    if not path.exists():
        return {"ok": True, "skipped": True, "reason": "codex_sessions_absent", "path": str(path)}
    result = run_command([str(SESSION_STORE_DOCTOR), "--pretty"], timeout + 10)
    payload = as_dict(result.get("json"))
    return {"ok": result.get("ok"), "path": str(path), "command": result.get("command"), "payload": payload, "stderr": result.get("stderr")}


def build_status(args: argparse.Namespace) -> dict[str, Any]:
    home = Path(args.home).expanduser()
    global_home = Path(args.global_home).expanduser()
    tools = tool_status(global_home)
    storage = storage_checks(home)
    shell = shell_checks(global_home, home)
    gateway = gateway_check(args.timeout)
    doctor = doctor_check(global_home, args.timeout) if args.include_doctor else {"skipped": True}
    session_store = session_store_check(home, args.timeout) if args.include_session_store else {"skipped": True}
    profiles = detect_agents(home)
    required_tools_ok = all(item.get("installed") and item.get("executable") for item in tools if item["name"] not in FRONT_DOOR_TOOL_NAMES)
    warnings = []
    for item in storage:
        warnings.extend({"path": item["path"], "warning": warning} for warning in item.get("warnings", []))
    failures = []
    if not gateway.get("ok"):
        failures.append({"reason": "gateway_unhealthy", "detail": gateway})
    if not required_tools_ok:
        failures.append({"reason": "global_tools_incomplete"})
    if any(item.get("exists") and not item.get("access_ok") for item in storage):
        failures.append({"reason": "storage_access_failed"})
    if doctor.get("ok") is False:
        failures.append({"reason": "runtime_doctor_failed"})
    repair_args = argparse.Namespace(
        install_codex_hooks=True,
        no_codex_hooks=False,
        no_shell_profile=True,
        skip_venv=True,
        quiet=False,
    )
    payload = {
        "ok": not failures,
        "schema_id": ADOPT_STATUS_SCHEMA,
        "generated_at": now_iso(),
        "machine": {
            "platform": platform.platform(),
            "system": platform.system(),
            "release": platform.release(),
            "python": sys.version.split()[0],
            "home": str(home),
            "global_home": str(global_home),
        },
        "gateway": gateway,
        "tools": tools,
        "agents": profiles,
        "storage": storage,
        "shell": shell,
        "doctor": doctor,
        "session_store": session_store,
        "warnings": warnings,
        "failures": failures,
        "repair_command": " ".join(compact_command(install_argv(global_home, repair_args))),
    }
    return payload


def cmd_status(args: argparse.Namespace) -> int:
    payload = build_status(args)
    emit(payload, args.pretty)
    return 0 if payload["ok"] else 1


def cmd_install(args: argparse.Namespace) -> int:
    global_home = Path(args.global_home).expanduser()
    argv = install_argv(global_home, args)
    if args.dry_run:
        install_result = {"ok": True, "dry_run": True, "command": compact_command(argv)}
    else:
        install_result = run_command(argv, args.timeout + 180)
    status_args = argparse.Namespace(
        home=args.home,
        global_home=args.global_home,
        timeout=args.timeout,
        include_doctor=True,
        include_session_store=True,
        pretty=False,
    )
    status = build_status(status_args) if not args.dry_run else {"skipped": True, "reason": "dry_run"}
    proof = {"skipped": True}
    if args.run_proof and not args.dry_run:
        proof = run_command(
            [
                str(RUNTIME_PROOF),
                "--agent",
                args.agent,
                "--project",
                args.project,
                "--timeout",
                str(args.proof_timeout),
            ],
            args.proof_timeout + 120,
        )
    payload = {
        "ok": bool(install_result.get("ok")) and (status.get("ok", True) is not False) and (proof.get("ok", True) is not False),
        "schema_id": "contextlattice_agent_adoption_install.v1",
        "generated_at": now_iso(),
        "install": install_result,
        "status": status,
        "proof": proof,
        "next_commands": [
            "contextlattice_adopt status --pretty",
            "contextlattice_adopt proof --agents codex --skip-provider-smoke --pretty",
            "contextlattice_agent_adapter profiles",
        ],
    }
    emit(payload, args.pretty)
    return 0 if payload["ok"] else 1


def proof_argv(args: argparse.Namespace) -> list[str]:
    argv = [
        str(ADOPTION_PROOF),
        "--project",
        args.project,
        "--agents",
        args.agents,
        "--base-url",
        args.base_url,
        "--proof-timeout",
        str(args.proof_timeout),
        "--phase-timeout",
        str(args.phase_timeout),
    ]
    if args.skip_provider_smoke:
        argv.append("--skip-provider-smoke")
    if args.progress:
        argv.append("--progress")
    return argv


def proof_command_timeout(args: argparse.Namespace) -> float:
    return args.proof_timeout * max(1, len(selected_profiles(args.agents))) + 180


def run_adoption_proof(args: argparse.Namespace) -> tuple[dict[str, Any], dict[str, Any]]:
    argv = proof_argv(args)
    result = run_command(argv, proof_command_timeout(args))
    payload = as_dict(result.get("json")) or {"ok": False, "error": result.get("stderr") or result.get("stdout")}
    payload["adopt_command"] = compact_command(argv)
    return payload, result


def cmd_proof(args: argparse.Namespace) -> int:
    payload, _result = run_adoption_proof(args)
    emit(payload, args.pretty)
    return 0 if payload.get("ok") else 1


def summarize_status_for_doctor(status: dict[str, Any]) -> dict[str, Any]:
    tools = as_list(status.get("tools"))
    missing_tools = [item.get("name") for item in tools if isinstance(item, dict) and not (item.get("installed") and item.get("executable"))]
    storage = as_list(status.get("storage"))
    return {
        "ok": bool(status.get("ok")),
        "gateway": status.get("gateway"),
        "tools": {
            "installed_count": sum(1 for item in tools if isinstance(item, dict) and item.get("installed") and item.get("executable")),
            "checked_count": len(tools),
            "missing_or_not_executable": missing_tools,
        },
        "storage_warnings": status.get("warnings", [])[:12],
        "storage_access": [
            {
                "path": item.get("path"),
                "exists": item.get("exists"),
                "access_ok": item.get("access_ok"),
                "warnings": item.get("warnings", []),
            }
            for item in storage
            if isinstance(item, dict)
        ],
        "doctor_ok": as_dict(status.get("doctor")).get("ok", as_dict(status.get("doctor")).get("skipped")),
        "session_store_ok": as_dict(status.get("session_store")).get("ok", as_dict(status.get("session_store")).get("skipped")),
        "failures": status.get("failures", [])[:12],
        "repair_command": status.get("repair_command", ""),
    }


