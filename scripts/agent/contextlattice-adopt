def shell_env_value(path: Path, key: str) -> str:
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except Exception:
        return ""
    prefix = f"{key}="
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[len("export ") :].strip()
        if not line.startswith(prefix):
            continue
        value = line.split("=", 1)[1].strip()
        try:
            parts = shlex.split(value)
        except ValueError:
            return value.strip("'\"")
        return parts[0] if parts else ""
    return ""


def add_candidate(candidates: list[Path], value: str | os.PathLike[str] | None) -> None:
    if not value:
        return
    path = Path(value).expanduser()
    if path not in candidates:
        candidates.append(path)


def resolve_repo_root(script_root: Path, global_home: Path) -> Path:
    candidates: list[Path] = []
    add_candidate(candidates, os.getenv("CONTEXTLATTICE_REPO_ROOT"))
    for env_path in [
        script_root / "agent_hooks.env",
        global_home / "agent_hooks.env",
        Path.home() / ".codex" / "contextlattice_hooks.env",
    ]:
        add_candidate(candidates, shell_env_value(env_path, "CONTEXTLATTICE_REPO_ROOT"))
    add_candidate(candidates, script_root)

    for candidate in candidates:
        has_installer = (candidate / "scripts" / "install_global_agent_tools.sh").is_file() or (
            candidate / "scripts" / "install_global_agent_tools.ps1"
        ).is_file()
        if has_installer and (candidate / "config" / "agents" / "agent_profiles.json").is_file():
            return candidate
    return script_root


def first_existing_path(paths: list[Path]) -> Path:
    for path in paths:
        if path.exists():
            return path
    return paths[0]


