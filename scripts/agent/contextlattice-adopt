        "runtime_visible": bool(case.get("runtime_visible")),
        "trace": case.get("trace"),
    }


def summarize_proof_for_doctor(proof: dict[str, Any]) -> dict[str, Any]:
    cases = [summarize_proof_case_for_doctor(as_dict(case)) for case in as_list(proof.get("cases"))]
    return {
        "ok": bool(proof.get("ok")),
        "agents": proof.get("agents", []),
        "case_count": proof.get("case_count", len(cases)),
        "passed_count": proof.get("passed_count", sum(1 for case in cases if case.get("ok"))),
        "failed_count": proof.get("failed_count", sum(1 for case in cases if not case.get("ok"))),
        "provider_smoke": proof.get("provider_smoke"),
        "findings": as_list(proof.get("findings"))[:20],
        "cases": cases,
        "adopt_command": proof.get("adopt_command"),
    }


def proof_session_ids(proof: dict[str, Any], limit: int) -> list[str]:
    session_ids: list[str] = []
    if limit <= 0:
        return session_ids
    for case in as_list(proof.get("cases")):
        row = as_dict(case)
        session_id = str(row.get("session_id") or "").strip()
        if session_id and session_id not in session_ids:
            session_ids.append(session_id)
        if len(session_ids) >= limit:
            break
    return session_ids


def summarize_trace_for_doctor(trace: dict[str, Any], session_id: str) -> dict[str, Any]:
    run_shaping = as_dict(trace.get("run_shaping"))
    context = as_dict(run_shaping.get("context"))
    skills = as_dict(run_shaping.get("skills"))
    sources = as_dict(run_shaping.get("sources"))
    graph = as_dict(run_shaping.get("graph"))
    handoffs = as_dict(run_shaping.get("handoffs"))
    checkpoints = as_dict(run_shaping.get("checkpoints"))
    advisor = as_dict(trace.get("run_advisor")) or as_dict(run_shaping.get("run_advisor"))
    session = as_dict(trace.get("session"))
    contract_validation = as_dict(as_dict(trace.get("format_contract")).get("validation"))
    return {
        "ok": bool(trace.get("ok")),
        "schema_id": trace.get("schema_id"),
        "session_id": session_id,
        "status": session.get("status"),
        "objective": short_text(session.get("objective"), 260),
        "next_action": short_text(session.get("next_action"), 260),
        "contract_validation": contract_validation.get("status"),
        "context": {
            "validation": context.get("validation"),
            "prompt_ready": bool(context.get("prompt_ready")),
            "reference_prompt_chars": as_int(context.get("reference_prompt_chars")),
            "recommended_surface": context.get("recommended_surface"),
        },
        "skills_that_may_be_helpful": [
            {
                "name": as_dict(item).get("name"),
                "source": as_dict(item).get("source"),
                "score": as_dict(item).get("score"),
            }
            for item in as_list(skills.get("items"))[:6]
        ],
        "sources": {
            "returned": as_list(sources.get("returned_sources"))[:12],
            "pending": as_list(sources.get("pending_sources"))[:12],
            "failed": as_list(sources.get("failed_sources"))[:8],
        },
        "run_shaping": {
            "graph_touches": as_int(graph.get("touches")),
            "handoffs": as_int(handoffs.get("count")),
            "checkpoints": as_int(checkpoints.get("count")),
        },
        "advisor": {
            "posture": advisor.get("posture"),
            "recommended_surface": as_dict(advisor.get("retrieval_advice")).get("recommended_surface"),
            "recommended_mode": as_dict(advisor.get("retrieval_advice")).get("recommended_mode"),
            "repair_instruction": short_text(as_dict(advisor.get("continuation")).get("repair_instruction") or as_dict(advisor.get("objective_coherence")).get("repair_instruction"), 260),
            "followup_command": short_text(as_dict(advisor.get("continuation")).get("agent_followup_command"), 260),
        },
        "commands": {
            "tree": f"contextlattice_agent_trace --session-id {session_id} --tree",
            "json": f"contextlattice_agent_trace --session-id {session_id} --json --pretty",
            "markdown": f"contextlattice_agent_trace --session-id {session_id} --markdown",
        },
    }


def run_trace_summaries(args: argparse.Namespace, proof: dict[str, Any]) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    if not args.trace:
        return [], []
    traces: list[dict[str, Any]] = []
    findings: list[dict[str, Any]] = []
    for session_id in proof_session_ids(proof, args.trace_limit):
        result = run_command(
            [str(TRACE), "--session-id", session_id, "--json"],
            args.trace_timeout + 10,
        )
        trace_payload = as_dict(result.get("json"))
        if result.get("ok") and trace_payload:
            traces.append(summarize_trace_for_doctor(trace_payload, session_id))
            continue
        finding = {
            "reason": "trace_failed",
            "session_id": session_id,
            "command": result.get("command"),
            "stderr": result.get("stderr"),
            "stdout": result.get("stdout"),
        }
        findings.append(finding)
        traces.append({"ok": False, "session_id": session_id, "finding": finding})
    if not traces:
        findings.append({"reason": "no_trace_session_id", "detail": "adoption proof did not return a session_id"})
    return traces, findings


def cmd_doctor(args: argparse.Namespace) -> int:
    status_args = argparse.Namespace(
        home=args.home,
        global_home=args.global_home,
        timeout=args.timeout,
        include_doctor=args.include_runtime_doctor,
        include_session_store=args.include_session_store,
        pretty=False,
    )
    status = build_status(status_args)
    proof, proof_result = run_adoption_proof(args)
    traces, trace_findings = run_trace_summaries(args, proof)
    status_summary = summarize_status_for_doctor(status)
    proof_summary = summarize_proof_for_doctor(proof)
    failures: list[dict[str, Any]] = []
    failures.extend(as_list(status_summary.get("failures")))
    failures.extend(as_list(proof_summary.get("findings")))
    failures.extend(trace_findings)
    ok = bool(status_summary.get("ok")) and bool(proof_summary.get("ok")) and not trace_findings
    first_session = ""
    for trace in traces:
        first_session = str(trace.get("session_id") or "")
        if first_session:
            break
    repair_commands = []
    if not status_summary.get("ok") and status_summary.get("repair_command"):
        repair_commands.append(status_summary["repair_command"])
    if not proof_summary.get("ok"):
        repair_commands.append(" ".join(compact_command(proof_argv(args))))
    if trace_findings and first_session:
        repair_commands.append(f"contextlattice_agent_trace --session-id {first_session} --json --pretty")
    payload = {
        "ok": ok,
        "schema_id": ADOPT_DOCTOR_SCHEMA,
        "generated_at": now_iso(),
        "project": args.project,
        "base_url": args.base_url,
        "status": status_summary,
        "proof": proof_summary,
        "traces": traces,
        "failures": failures[:30],
        "repair_commands": repair_commands,
        "next_commands": [
            "contextlattice_adopt status --pretty",
            " ".join(compact_command(proof_argv(args))),
            f"contextlattice_agent_trace --session-id {first_session} --tree" if first_session else "contextlattice_agent_trace --session-id <session_id> --tree",
            "contextlattice_skills_index search '<task>' --pretty",
        ],
        "commands": {
            "status": "contextlattice_adopt status --pretty",
            "proof": " ".join(compact_command(proof_argv(args))),
            "doctor": f"contextlattice_doctor --agents {args.agents} --skip-provider-smoke --pretty",
        },
        "raw": {
            "status": status if args.include_raw else {"omitted": True},
            "proof_stdout": proof_result.get("stdout") if args.include_raw else "",
            "proof_stderr": proof_result.get("stderr") if args.include_raw else "",
        },
    }
    emit(payload, args.pretty)
    return 0 if ok else 1


def read_template(profile: str) -> str:
    path = template_path(profile)
    if path.exists():
        return path.read_text(encoding="utf-8", errors="replace")
    return profile_template_text(profile, "cli", f"{profile.replace('-', '_')}_agent")


def pack_has_secret(value: Any, path: str = "") -> list[str]:
    findings: list[str] = []
    if isinstance(value, dict):
        for key, child in value.items():
            key_text = str(key).lower()
            child_path = f"{path}.{key}" if path else str(key)
            if key_text in {"secrets_policy"}:
                continue
            if any(marker in key_text for marker in SECRET_MARKERS):
                rendered = json.dumps(child)[:80] if not isinstance(child, str) else child[:80]
                if rendered and rendered not in {"", "<redacted>", "REDACTED", "set-locally"}:
                    findings.append(child_path)
            findings.extend(pack_has_secret(child, child_path))
    elif isinstance(value, list):
        for index, child in enumerate(value):
            findings.extend(pack_has_secret(child, f"{path}[{index}]"))
    return findings


def build_pack(args: argparse.Namespace) -> dict[str, Any]:
    profiles = load_profiles()
    chosen = selected_profiles(args.profiles)
    selected = {name: profiles[name] for name in chosen if name in profiles}
    missing = [name for name in chosen if name not in profiles]
    templates = {name: read_template(name) for name in chosen}
    return {
        "schema_id": PACK_SCHEMA,
        "version": 1,
        "created_at": now_iso(),
        "name": args.name,
        "source": {
            "repo": git_value(["git", "config", "--get", "remote.origin.url"]),
            "commit": git_value(["git", "rev-parse", "--short", "HEAD"]),
        },
        "orchestrator": {
            "default_url": args.base_url,
            "auth": "set CONTEXTLATTICE_ORCHESTRATOR_API_KEY locally if your gateway requires it",
        },
        "profiles": selected,
        "missing_profiles": missing,
        "templates": templates,
        "commands": {
            "install": "contextlattice_adopt install --pretty",
            "install_from_repo": "scripts/agent/contextlattice-adopt install --pretty",
            "status": "contextlattice_adopt status --pretty",
            "proof": "contextlattice_adopt proof --skip-provider-smoke --pretty",
            "bootstrap": "contextlattice_agent_adapter bootstrap --agent <profile> --project <project> --pretty",
            "trace": "contextlattice_agent_trace --session-id <session_id> --tree",
        },
        "secrets_policy": "No secrets are embedded. Re-auth each machine/account locally.",
    }


def git_value(args: list[str]) -> str:
    try:
        return subprocess.check_output(args, cwd=str(REPO_ROOT), stderr=subprocess.DEVNULL, text=True, timeout=2).strip()
    except Exception:
        return ""


def cmd_export(args: argparse.Namespace) -> int:
    pack = build_pack(args)
    secret_findings = pack_has_secret(pack)
    if secret_findings:
        payload = {"ok": False, "schema_id": PACK_SCHEMA, "error": "secret_like_fields_detected", "findings": secret_findings}
        emit(payload, args.pretty)
        return 1
    output = Path(args.output).expanduser() if args.output else Path.cwd() / f"{args.name}.agent-pack.json"
    if not args.dry_run:
        output.parent.mkdir(parents=True, exist_ok=True)
        output.write_text(json.dumps(pack, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    payload = {
        "ok": True,
        "schema_id": PACK_SCHEMA,
        "output": str(output),
        "dry_run": args.dry_run,
        "pack": pack if args.include_pack else {
            "name": pack["name"],
            "profiles": list(pack["profiles"].keys()),
            "missing_profiles": pack["missing_profiles"],
            "template_count": len(pack["templates"]),
        },
    }
    emit(payload, args.pretty)
    return 0


def cmd_import(args: argparse.Namespace) -> int:
    source = Path(args.path).expanduser()
    try:
        pack = json.loads(source.read_text(encoding="utf-8"))
    except Exception as exc:
        emit({"ok": False, "error": str(exc)}, args.pretty)
        return 1
    if as_dict(pack).get("schema_id") != PACK_SCHEMA:
        emit({"ok": False, "error": "unsupported_pack_schema", "schema_id": as_dict(pack).get("schema_id")}, args.pretty)
        return 1
    secret_findings = pack_has_secret(pack)
    if secret_findings:
        emit({"ok": False, "error": "secret_like_fields_detected", "findings": secret_findings}, args.pretty)
        return 1
    global_home = Path(args.global_home).expanduser()
    pack_dir = global_home / "agent_packs"
    target = pack_dir / source.name
    template_dir = pack_dir / source.stem / "templates"
    if not args.dry_run:
        pack_dir.mkdir(parents=True, exist_ok=True)
        target.write_text(json.dumps(pack, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        template_dir.mkdir(parents=True, exist_ok=True)
        for profile, text in as_dict(pack.get("templates")).items():
            safe = str(profile).replace("/", "-")
            (template_dir / f"{safe}.md").write_text(str(text).rstrip() + "\n", encoding="utf-8")
    payload = {
        "ok": True,
        "schema_id": "contextlattice_agent_pack_import.v1",
        "dry_run": args.dry_run,
        "source": str(source),
        "target": str(target),
        "template_dir": str(template_dir),
        "profiles": list(as_dict(pack.get("profiles")).keys()),
        "next_commands": ["contextlattice_adopt status --pretty", "contextlattice_agent_adapter profiles"],
    }
    emit(payload, args.pretty)
    return 0


def profile_template_text(name: str, kind: str, agent_id: str) -> str:
    topic = f"runbooks/{name}-integration"
    command_surface = {
        "cli": "Run shell commands directly before/after model calls.",
        "desktop": "Paste the setup block into the desktop app's custom instructions, then run CLI commands from Terminal when available.",
        "web": "Paste the setup block into the web agent's instructions; use the HTTP fallback when no local CLI is callable.",
        "mcp": "Prefer MCP tool calls for search/write/session lifecycle; keep CLI as local recovery path.",
        "http": "Call the HTTP endpoints directly from the host application.",
        "repo": "Commit this block into the repo-local AGENTS.md or equivalent runner instruction file.",
    }.get(kind, "Use the universal ContextLattice contract.")
    return f"""# ContextLattice Agent Template: {name}

Agent id: `{agent_id}`
Profile kind: `{kind}`
Surface rule: {command_surface}

## Mandatory Contract

1. Before planning, call ContextLattice for scoped memory: `contextlattice_agent_adapter bootstrap --agent {name} --agent-id {agent_id} --project <project> --topic-path {topic} --pretty`.
2. Preserve the returned `CONTEXTLATTICE_SESSION_ID` and reuse it for context packs, checkpoints, traces, and completion.
3. If CLI is unavailable, use HTTP: `POST http://127.0.0.1:8075/v1/agents/preflight`, then `POST /memory/context-pack`.
4. During work, checkpoint durable decisions with `contextlattice_agent_adapter checkpoint --session-id <session_id> --content "<decision/evidence>"`.
5. Before handoff/compaction, run `contextlattice_agent_adapter handoff --session-id <session_id> --summary "<state>"`.
6. Before the next hard model call, run `contextlattice_run_advisor --session-id <session_id> --pretty`.
7. To explain the run, run `contextlattice_agent_trace --session-id <session_id> --tree`.
8. On completion, run `contextlattice_agent_adapter complete --session-id <session_id> --summary "<result>"`.
9. If capabilities are unclear, use `contextlattice_skills_index search "<task/tool need>" --pretty`.
10. Report degraded memory explicitly; do not pretend recall succeeded.

## Bootstrap Commands

```bash
contextlattice_adopt status --pretty
contextlattice_agent_adapter bootstrap --agent {name} --agent-id {agent_id} --project <project> --topic-path {topic} --pretty
contextlattice_run_advisor "<current task>" --project <project> --agent-id {agent_id} --pretty
```
"""


