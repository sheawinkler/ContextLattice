#!/usr/bin/env python3
"""Check machine-local ContextLattice agent runtime install drift."""

from __future__ import annotations

import argparse
import json
import os
import subprocess
from pathlib import Path
from typing import Any

from _common import contextlattice_base_url, emit, request_json


HOME = Path.home()


def run_json(args: list[str], timeout: float, env: dict[str, str] | None = None) -> tuple[bool, dict[str, Any], str]:
    try:
        proc = subprocess.run(args, check=False, capture_output=True, text=True, timeout=timeout, env=env)
    except Exception as exc:
        return False, {}, str(exc)
    if proc.returncode != 0:
        return False, {}, (proc.stderr or proc.stdout or f"returncode={proc.returncode}")[:1000]
    try:
        parsed = json.loads(proc.stdout or "{}")
    except json.JSONDecodeError as exc:
        return False, {}, f"invalid json: {exc}"
    return True, parsed if isinstance(parsed, dict) else {}, ""


def run_text(args: list[str], timeout: float, env: dict[str, str] | None = None) -> tuple[bool, str]:
    try:
        proc = subprocess.run(args, check=False, capture_output=True, text=True, timeout=timeout, env=env)
    except Exception as exc:
        return False, str(exc)
    if proc.returncode != 0:
        return False, (proc.stderr or proc.stdout or f"returncode={proc.returncode}")[:1000]
    return True, (proc.stdout or "").strip()[:1000]


def record(name: str, ok: bool, detail: str = "", **extra: Any) -> dict[str, Any]:
    out: dict[str, Any] = {"name": name, "ok": bool(ok)}
    if detail:
        out["detail"] = detail
    out.update(extra)
    return out


def skill_file_count(root: Path) -> int:
    try:
        return sum(1 for _ in root.rglob("SKILL.md")) if root.exists() else 0
    except Exception:
        return 0


def skills_index_results(payload: dict[str, Any]) -> list[Any]:
    results = payload.get("results")
    if isinstance(results, list):
        return results
    parsed = payload.get("parsed")
    if isinstance(parsed, dict) and isinstance(parsed.get("results"), list):
        return parsed["results"]
    return []


def json_payload_schema(payload: dict[str, Any]) -> str:
    schema = payload.get("schema_id")
    return str(schema or "")


def as_int(value: Any, fallback: int = 0) -> int:
    try:
        return int(value)
    except (TypeError, ValueError):
        return fallback


def go_native_wrapper(path: Path, go_tool: Path) -> bool:
    if not path.exists():
        return False
    try:
        if path.samefile(go_tool):
            return True
    except Exception:
        pass
    if path.is_symlink():
        try:
            target = os.readlink(path)
        except OSError:
            target = ""
        if Path(target).name == go_tool.name:
            return True
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except Exception:
        return False
    lowered = text.lower()
    return go_tool.name.lower() in lowered and "python" not in lowered and "venv-agent-tools" not in lowered


def hook_status(hooks_path: Path) -> dict[str, Any]:
    try:
        parsed = json.loads(hooks_path.read_text(encoding="utf-8"))
    except Exception as exc:
        return {"ok": False, "detail": str(exc)[:500]}
    hooks = parsed.get("hooks") if isinstance(parsed, dict) else {}
    required = {
        "SessionStart": "contextlattice_agent_start.sh",
        "PreCompact": "contextlattice_pre_compaction_write.sh",
        "PostCompact": "contextlattice_post_compaction_read.sh",
    }
    missing: list[str] = []
    bad_timeout: list[str] = []
    for event, suffix in required.items():
        groups = hooks.get(event) if isinstance(hooks, dict) else None
        found = False
        if isinstance(groups, list):
            for group in groups:
                if not isinstance(group, dict):
                    continue
                for hook in group.get("hooks") or []:
                    if not isinstance(hook, dict):
                        continue
                    command = str(hook.get("command") or "")
                    if command.endswith(suffix):
                        found = True
                        if int(hook.get("timeout") or 0) < 120:
                            bad_timeout.append(event)
        if not found:
            missing.append(event)
    return {"ok": not missing and not bad_timeout, "missing": missing, "bad_timeout": bad_timeout}


def main() -> int:
    parser = argparse.ArgumentParser(description="Audit local ContextLattice agent runtime helper install.")
    parser.add_argument("--global-home", default=os.getenv("CONTEXTLATTICE_GLOBAL_HOME", str(HOME / ".contextlattice")))
    parser.add_argument("--timeout", type=float, default=10)
    parser.add_argument("--pretty", action="store_true")
    args = parser.parse_args()

    global_home = Path(args.global_home).expanduser()
    bin_dir = global_home / "bin"
    go_tool = bin_dir / "contextlattice-agent-tools"
    runtime_env = os.environ.copy()
    runtime_env["CONTEXTLATTICE_GLOBAL_HOME"] = str(global_home)
    runtime_env["PATH"] = f"{bin_dir}:{runtime_env.get('PATH', '')}"
    expected = {
        "contextlattice-agent-tools": go_tool,
        "contextlattice_search": bin_dir / "contextlattice_search",
        "contextlattice_pack": bin_dir / "contextlattice_pack",
        "contextlattice_recall_response": bin_dir / "contextlattice_recall_response",
        "contextlattice_packet_reconstruct": bin_dir / "contextlattice_packet_reconstruct",
        "contextlattice_synthesis_pack": bin_dir / "contextlattice_synthesis_pack",
        "contextlattice_write": bin_dir / "contextlattice_write",
        "contextlattice_adopt": bin_dir / "contextlattice_adopt",
        "contextlattice_doctor": bin_dir / "contextlattice_doctor",
        "contextlattice_agent_adapter": bin_dir / "contextlattice_agent_adapter",
        "contextlattice_agent_runtime_proof": bin_dir / "contextlattice_agent_runtime_proof",
        "contextlattice_agent_adoption_proof": bin_dir / "contextlattice_agent_adoption_proof",
        "contextlattice_agent_session": bin_dir / "contextlattice_agent_session",
        "contextlattice_agent_trace": bin_dir / "contextlattice_agent_trace",
        "contextlattice_run_advisor": bin_dir / "contextlattice_run_advisor",
        "contextlattice_agent_runtime_doctor": bin_dir / "contextlattice_agent_runtime_doctor",
        "contextlattice_strict_runtime_native_ownership": bin_dir / "contextlattice_strict_runtime_native_ownership",
        "contextlattice_context_boundary": bin_dir / "contextlattice_context_boundary",
        "contextlattice_memory_topology": bin_dir / "contextlattice_memory_topology",
        "contextlattice_skills_index": bin_dir / "contextlattice_skills_index",
    }
    shell_wrappers = {
        "contextlattice_agent_start": bin_dir / "contextlattice_agent_start",
        "contextlattice_async_inbox_hook": bin_dir / "contextlattice_async_inbox_hook",
        "contextlattice_checkpoint": bin_dir / "contextlattice_checkpoint",
        "contextlattice_pre_compaction_write": bin_dir / "contextlattice_pre_compaction_write",
        "contextlattice_post_compaction_read": bin_dir / "contextlattice_post_compaction_read",
    }
    hook_runtime_files = {
        "scripts/agent/_common.py": global_home / "scripts" / "agent" / "_common.py",
        "scripts/agent/audit-codex-session-store": global_home / "scripts" / "agent" / "audit-codex-session-store",
        "scripts/agent/compaction-handoff-payload": global_home / "scripts" / "agent" / "compaction-handoff-payload",
        "scripts/agent/contextlattice-session": global_home / "scripts" / "agent" / "contextlattice-session",
        "scripts/agent/contextlattice-recall-response": global_home / "scripts" / "agent" / "contextlattice-recall-response",
        "scripts/agent_contracts.py": global_home / "scripts" / "agent_contracts.py",
        "scripts/agent_orchestration.py": global_home / "scripts" / "agent_orchestration.py",
        "scripts/contextlattice_client.py": global_home / "scripts" / "contextlattice_client.py",
    }
    optional_dev = {
        "contextlattice_agent_orchestration": bin_dir / "contextlattice_agent_orchestration",
        "contextlattice_source_backfill": bin_dir / "contextlattice_source_backfill",
        "contextlattice_codex_session_store_doctor": bin_dir / "contextlattice_codex_session_store_doctor",
    }
    checks: list[dict[str, Any]] = []
    for name, path in expected.items():
        installed = path.is_file() and os.access(path, os.X_OK)
        native = True if name == "contextlattice-agent-tools" else go_native_wrapper(path, go_tool)
        extra: dict[str, Any] = {"path": str(path), "go_native": native}
        if not installed:
            extra["suggested_fix"] = "Run scripts/install_global_agent_tools.sh from a ContextLattice checkout."
        checks.append(record(name, installed and native, **extra))

    for name, path in shell_wrappers.items():
        installed = path.is_file() and os.access(path, os.X_OK)
        extra = {"path": str(path), "shell_wrapper": True}
        if not installed:
            extra["suggested_fix"] = "Run scripts/install_global_agent_tools.sh from a current ContextLattice checkout."
        checks.append(record(name, installed, **extra))

    for label, path in hook_runtime_files.items():
        installed = path.is_file() and (os.access(path, os.X_OK) or path.suffix == ".py")
        extra = {"path": str(path), "runtime_dependency": True}
        if not installed:
            extra["suggested_fix"] = "Run scripts/install_global_agent_tools.sh from a current ContextLattice checkout."
        checks.append(record(f"hook_runtime:{label}", installed, **extra))

    for name, path in optional_dev.items():
        installed = path.is_file() and os.access(path, os.X_OK)
        checks.append(record(
            name,
            True,
            "development-only Python helper not installed by default" if not installed else "development-only Python helper installed",
            path=str(path),
            installed=installed,
            dev_python_tool=True,
        ))

    adapter = str(expected["contextlattice_agent_adapter"])
    if expected["contextlattice_agent_adapter"].exists():
        ok, payload, err = run_json([adapter, "profiles"], args.timeout, runtime_env)
        result = payload.get("result") if isinstance(payload.get("result"), dict) else {}
        checks.append(record(
            "adapter_profiles_contract",
            ok and payload.get("ok") is True and json_payload_schema(payload) == "contextlattice_universal_agent_adapter_profiles.v1",
            err,
            profiles=len((result or {}).get("profiles") or {}) if isinstance(result, dict) else 0,
            schema=json_payload_schema(payload),
        ))

    adopt = str(expected["contextlattice_adopt"])
    if expected["contextlattice_adopt"].exists():
        ok, detail = run_text([adopt, "--help"], args.timeout, runtime_env)
        checks.append(record("adopt_help", ok, detail))
        ok, payload, err = run_json([adopt, "status"], args.timeout, runtime_env)
        checks.append(record(
            "adopt_status",
            ok and payload.get("ok") is True and json_payload_schema(payload) == "contextlattice_agent_adoption_status.v1",
            err,
            profiles=as_int(payload.get("profile_count")) if isinstance(payload, dict) else 0,
            schema=json_payload_schema(payload),
        ))
        ok, payload, err = run_json([adopt, "profiles"], args.timeout, runtime_env)
        result = payload.get("result") if isinstance(payload, dict) else {}
        checks.append(record(
            "adopt_profiles",
            ok and payload.get("ok") is True and json_payload_schema(payload) == "contextlattice_universal_agent_adapter_profiles.v1",
            err,
            profiles=len((result or {}).get("profiles") or {}) if isinstance(result, dict) else 0,
            schema=json_payload_schema(payload),
        ))

    proof = str(expected["contextlattice_agent_runtime_proof"])
    if expected["contextlattice_agent_runtime_proof"].exists():
        ok, detail = run_text([proof, "--help"], args.timeout, runtime_env)
        checks.append(record("runtime_proof_help", ok, detail))

    adoption_proof = str(expected["contextlattice_agent_adoption_proof"])
    if expected["contextlattice_agent_adoption_proof"].exists():
        ok, detail = run_text([adoption_proof, "--help"], args.timeout, runtime_env)
        checks.append(record("adoption_proof_help", ok, detail))

    agent_trace = str(expected["contextlattice_agent_trace"])
    if expected["contextlattice_agent_trace"].exists():
        ok, detail = run_text([agent_trace, "--help"], args.timeout, runtime_env)
        checks.append(record("agent_trace_help", ok, detail))

    run_advisor = str(expected["contextlattice_run_advisor"])
    if expected["contextlattice_run_advisor"].exists():
        ok, detail = run_text([run_advisor, "--help"], args.timeout, runtime_env)
        checks.append(record("run_advisor_help", ok, detail))

    hooks = hook_status(HOME / ".codex" / "hooks.json")
    checks.append(record("codex_hooks", bool(hooks.get("ok")), **{k: v for k, v in hooks.items() if k != "ok"}))

    try:
        health = request_json("GET", "/health", None, args.timeout)
    except Exception as exc:
        health = {"ok": False, "error": str(exc)[:500]}
    checks.append(record("gateway_health", bool(health.get("ok")), service=str(health.get("service") or ""), base_url=contextlattice_base_url()))

    primary_skills_root = HOME / ".codex" / "skills"
    primary_count = skill_file_count(primary_skills_root)
    checks.append(record(
        "primary_codex_skills_root",
        True if not primary_skills_root.exists() else primary_count > 0,
        "optional root absent" if not primary_skills_root.exists() else "",
        path=str(primary_skills_root),
        skill_files=primary_count,
    ))
    skills_index = str(expected["contextlattice_skills_index"])
    if primary_count > 0 and expected["contextlattice_skills_index"].exists():
        ok, payload, err = run_json([skills_index, "search", "objective loop", "--limit", "8"], args.timeout, runtime_env)
        results = skills_index_results(payload)
        active_visible = any(
            "/.codex/skills/" in str((item or {}).get("path") or "")
            or str((item or {}).get("source") or "") == "active"
            for item in results
            if isinstance(item, dict)
        )
        checks.append(record(
            "skills_index_primary_root_visible",
            ok and active_visible,
            err,
            result_count=len(results),
            expected_root=str(primary_skills_root),
        ))

    failed = [item for item in checks if not item.get("ok")]
    payload = {
        "ok": not failed,
        "schema_id": "contextlattice_agent_runtime_install_audit.v1",
        "global_home": str(global_home),
        "checks": checks,
        "failed": failed,
        "repair_command": "scripts/install_global_agent_tools.sh --no-shell-profile",
    }
    emit(payload, args.pretty)
    return 0 if payload["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
