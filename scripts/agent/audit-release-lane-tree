#!/usr/bin/env bash
set -euo pipefail
umask 077

SCRIPT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
AUDIT_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
REPO_ROOT="${CONTEXTLATTICE_RELEASE_TREE_ROOT:-${SCRIPT_ROOT}}"
REPO_ROOT="$(cd "${REPO_ROOT}" && pwd)"
LANE=""
REF="HEAD"
EXPECTED_COMMIT=""
RELEASE_REF=""
PROOF_OUT=""
PERFORMANCE_MODE="${CONTEXTLATTICE_RELEASE_PERFORMANCE_MODE:-strict}"

usage() {
  cat <<'USAGE'
Usage: audit-release-lane-tree --lane public|public-paid [options]

Materialize and test the exact committed release-lane tree without relying on
the caller's working tree.

Options:
  --ref REF                  Exact candidate ref (default: HEAD)
  --expected-commit SHA      Require REF to resolve to this full commit
  --release-ref REF          Optional release/tag ref recorded in proof
  --proof-out PATH           Write deterministic JSON proof after every gate passes
  -h, --help                 Show this help
USAGE
}

fail() {
  echo "[release-lane-tree] ERROR: $*" >&2
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --lane) LANE="${2:-}"; shift 2 ;;
    --ref) REF="${2:-}"; shift 2 ;;
    --expected-commit) EXPECTED_COMMIT="${2:-}"; shift 2 ;;
    --release-ref) RELEASE_REF="${2:-}"; shift 2 ;;
    --proof-out) PROOF_OUT="${2:-}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) fail "unknown argument: $1" ;;
  esac
done

case "${LANE}" in
  public) guard_lane="public" ;;
  paid|public-paid) LANE="public-paid"; guard_lane="public-paid" ;;
  *) fail "--lane must be public or public-paid" ;;
esac
case "${PERFORMANCE_MODE}" in
  strict) strict_latency_gate=1; performance_gate_status=pass ;;
  shared_runner) strict_latency_gate=0; performance_gate_status=correctness_pass_latency_observed ;;
  *) fail "CONTEXTLATTICE_RELEASE_PERFORMANCE_MODE must be strict or shared_runner" ;;
esac

for command_name in git go python3; do
  command -v "${command_name}" >/dev/null 2>&1 || fail "required command is missing: ${command_name}"
done
git -C "${REPO_ROOT}" rev-parse --is-inside-work-tree >/dev/null 2>&1 || \
  fail "repository root is not a Git worktree: ${REPO_ROOT}"

commit="$(git -C "${REPO_ROOT}" rev-parse --verify "${REF}^{commit}" 2>/dev/null)" || \
  fail "candidate ref does not resolve to a commit: ${REF}"
[[ "${commit}" =~ ^[0-9a-f]{40}$ ]] || fail "candidate commit is not a full SHA-1: ${commit}"
if [[ -n "${EXPECTED_COMMIT}" ]]; then
  [[ "${EXPECTED_COMMIT}" =~ ^[0-9a-f]{40}$ ]] || \
    fail "--expected-commit must be a full lowercase SHA-1"
  [[ "${commit}" == "${EXPECTED_COMMIT}" ]] || \
    fail "candidate commit mismatch: ref=${commit} expected=${EXPECTED_COMMIT}"
fi
tree="$(git -C "${REPO_ROOT}" rev-parse --verify "${commit}^{tree}")"

guard="${REPO_ROOT}/scripts/agent_hooks/branch_lane_guard.sh"
[[ -f "${guard}" ]] || fail "lane guard is absent from candidate repository"
active_paths=(
  "scripts/agent/audit-release-lane-tree:${AUDIT_PATH}"
  "scripts/agent_hooks/branch_lane_guard.sh:${guard}"
  "scripts/agent_hooks/common.sh:${REPO_ROOT}/scripts/agent_hooks/common.sh"
)
if [[ "${LANE}" == "public" ]]; then
  active_paths+=("scripts/public_leak_guard.py:${REPO_ROOT}/scripts/public_leak_guard.py")
fi
for active_path in "${active_paths[@]}"; do
  relative="${active_path%%:*}"
  local_path="${active_path#*:}"
  candidate_blob="$(git -C "${REPO_ROOT}" rev-parse --verify "${commit}:${relative}" 2>/dev/null)" || \
    fail "active gate is absent from candidate commit: ${relative}"
  active_blob="$(git -C "${REPO_ROOT}" hash-object "${local_path}")"
  [[ "${active_blob}" == "${candidate_blob}" ]] || \
    fail "active gate differs from candidate commit: ${relative}"
done

tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/contextlattice-release-tree.XXXXXX")"
cleanup() {
  rm -rf "${tmp_dir}"
}
trap cleanup EXIT
if [[ -z "${GOCACHE:-}" && -z "${XDG_CACHE_HOME:-}" && -z "${HOME:-}" ]]; then
  export GOCACHE="${tmp_dir}/go-cache"
  mkdir -p "${GOCACHE}"
fi
if [[ -z "${GOMODCACHE:-}" && -z "${GOPATH:-}" && -z "${HOME:-}" ]]; then
  export GOMODCACHE="${tmp_dir}/go-mod"
  mkdir -p "${GOMODCACHE}"
fi
candidate_blocklist="${tmp_dir}/public_sync_blocklist.txt"
git -C "${REPO_ROOT}" show "${commit}:config/public_sync_blocklist.txt" >"${candidate_blocklist}" || \
  fail "candidate public sync blocklist cannot be materialized"
CONTEXTLATTICE_PUBLIC_SYNC_BLOCKLIST="${candidate_blocklist}" \
  bash "${guard}" --lane "${guard_lane}" --ref "${commit}"
stage="${tmp_dir}/tree"
index="${tmp_dir}/index"
mkdir -p "${stage}"

# A temporary index materializes every tracked path exactly as committed. Unlike
# git archive, this intentionally ignores export-ignore attributes so tests are
# compiled from the same source tree reviewers approved.
GIT_INDEX_FILE="${index}" git -C "${REPO_ROOT}" read-tree "${commit}"
GIT_INDEX_FILE="${index}" git -C "${REPO_ROOT}" checkout-index --all --prefix="${stage}/"

required=(
  "config/commercial_truth.v1.json"
  "config/public_sync_blocklist.txt"
  "scripts/agent/audit-release-lane-tree"
  "scripts/generate_commercial_truth.py"
  "scripts/agent_hooks/branch_lane_guard.sh"
  "scripts/agent_hooks/common.sh"
  "services/gateway-go/go.mod"
  "services/gateway-go/continuity_identity.go"
  "services/gateway-go/objective_continuity.go"
  "services/gateway-go/agent_packet_delta_test.go"
  "services/gateway-go/frontier_t2_delta_eval_test.go"
  "services/gateway-go/frontier_t2_proof_timeline_eval_test.go"
  "services/orchestrator-go/go.mod"
)
if [[ "${LANE}" == "public" ]]; then
  required+=("scripts/public_leak_guard.py")
elif [[ "${LANE}" == "public-paid" ]]; then
  required+=(
    ".github/workflows/release-installers.yml"
    "docs/evals/v3.18-frontier-t1-paid-activation.json"
    "docs/evals/v3.19-frontier-t2-paid-activation.json"
    "docs/evals/v3.21-frontier-t4-paid-activation.json"
    "docs/evals/v3.22-frontier-t5-paid-activation.json"
    "docs/evals/v3.23-frontier-t6-paid-activation.json"
    "packaging/linux/ContextLattice-Install.sh"
    "packaging/windows/Install-ContextLattice.ps1"
    "scripts/agent/audit-paid-artifact-integrity"
    "services/gateway-go/frontier_t1_eval_test.go"
    "services/gateway-go/frontier_t1_governance_entitled.go"
    "services/gateway-go/frontier_t1_governance_entitled_test.go"
  )
fi
if [[ "${LANE}" != "public" ]]; then
  required+=(
    "services/gateway-go/frontier_t2_proof_timeline_entitled.go"
    "services/gateway-go/frontier_t2_proof_timeline_entitled_test.go"
    "services/gateway-go/frontier_t4_retrieval_entitled.go"
    "services/gateway-go/frontier_t4_retrieval_entitled_test.go"
    "services/gateway-go/frontier_t5_policy_lab_entitled.go"
    "services/gateway-go/frontier_t5_policy_lab_entitled_test.go"
    "services/gateway-go/frontier_t6_agent_fit_entitled.go"
    "services/gateway-go/frontier_t6_agent_fit_entitled_test.go"
  )
fi

blob_rows="${tmp_dir}/required-blobs.tsv"
: >"${blob_rows}"
for relative in "${required[@]}"; do
  [[ -f "${stage}/${relative}" ]] || fail "required ${LANE} candidate path is absent: ${relative}"
  blob="$(git -C "${REPO_ROOT}" rev-parse --verify "${commit}:${relative}" 2>/dev/null)" || \
    fail "required path is not a committed blob: ${relative}"
  [[ "$(git -C "${REPO_ROOT}" cat-file -t "${blob}")" == "blob" ]] || \
    fail "required path is not a blob: ${relative}"
  size="$(git -C "${REPO_ROOT}" cat-file -s "${blob}")"
  [[ "${size}" =~ ^[0-9]+$ && "${size}" -gt 0 ]] || fail "required blob is empty: ${relative}"
  printf '%s\t%s\t%s\n' "${relative}" "${blob}" "${size}" >>"${blob_rows}"
done

gate_rows="${tmp_dir}/gates.tsv"
printf '%s\t%s\n' "branch_lane_guard" "pass" >"${gate_rows}"

if [[ "${LANE}" == "public" ]]; then
  (cd "${stage}" && python3 scripts/public_leak_guard.py --summary)
  printf '%s\t%s\n' "public_leak_guard" "pass" >>"${gate_rows}"
fi

for module in services/gateway-go services/orchestrator-go; do
  gate_name="$(printf '%s' "${module}" | tr '/-' '__')_test"
  if [[ -f "${stage}/${module}/go.mod" ]]; then
    go -C "${stage}/${module}" test ./...
    printf '%s\t%s\n' "${gate_name}" "pass" >>"${gate_rows}"
  else
    printf '%s\t%s\n' "${gate_name}" "not_present" >>"${gate_rows}"
  fi
done

frontier_t2_projection_test="${stage}/services/gateway-go/agent_packet_delta_test.go"
frontier_t2_holdout_test="${stage}/services/gateway-go/frontier_t2_delta_eval_test.go"
frontier_t2_eval="${tmp_dir}/frontier-t2-item2-eval.json"
if [[ -f "${frontier_t2_projection_test}" && -f "${frontier_t2_holdout_test}" ]]; then
  env \
    CONTEXTLATTICE_AGENT_PACKET_DELTA_PERFORMANCE_GATE=1 \
    CONTEXTLATTICE_FRONTIER_STRICT_LATENCY_GATE="${strict_latency_gate}" \
    FRONTIER_T2_TESTED_COMMIT="${commit}" \
    FRONTIER_T2_ITEM2_EVAL_OUTPUT="${frontier_t2_eval}" \
    go -C "${stage}/services/gateway-go" test \
      -run '^(TestFrontierT2AgentPacketProjectionLatencyGate|TestFrontierT2DeltaPacketHoldout)$' \
      -count=1 .
  [[ -f "${frontier_t2_eval}" ]] || fail "isolated Frontier T2 gate did not emit its evidence artifact"
  python3 - "${frontier_t2_eval}" "${commit}" "${PERFORMANCE_MODE}" <<'PY'
import json
import math
import sys
from pathlib import Path

path, commit, performance_mode = sys.argv[1:]
payload = json.loads(Path(path).read_text(encoding="utf-8"))
if payload.get("schema_id") != "frontier_t2_delta_packet_eval.v1":
    raise SystemExit("isolated Frontier T2 evidence schema is invalid")
if payload.get("tested_commit") != commit:
    raise SystemExit("isolated Frontier T2 evidence is not bound to the candidate commit")
if payload.get("correct_count") != payload.get("sample_count"):
    raise SystemExit("isolated Frontier T2 holdout correctness gate failed")
gates = payload.get("release_gates") or {}
if gates.get("corrupt_reconstruction_count") != 0 or gates.get("unsafe_delta_on_invalid_base_count") != 0:
    raise SystemExit("isolated Frontier T2 safety gate failed")
maximum = gates.get("synchronous_projection_p95_ms_max")
observed = gates.get("synchronous_projection_p95_ms_observed")
if maximum != 20 or not isinstance(observed, (int, float)) or isinstance(observed, bool) or not math.isfinite(observed) or observed < 0:
    raise SystemExit("isolated Frontier T2 20ms p95 observation is invalid")
if gates.get("synchronous_projection_p95_estimator") != "median_of_3_batch_p95":
    raise SystemExit("isolated Frontier T2 p95 estimator is not the required sustained-regression gate")
batches = gates.get("synchronous_projection_batch_p95_ms")
if not isinstance(batches, list) or len(batches) != 3 or not all(
    isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value) and value >= 0 for value in batches
):
    raise SystemExit("isolated Frontier T2 p95 batch evidence is invalid")
passing_batches = sum(value <= maximum for value in batches)
if gates.get("synchronous_projection_passing_batches") != passing_batches:
    raise SystemExit("isolated Frontier T2 p95 passing-batch count is invalid")
latency_enforced = gates.get("synchronous_projection_latency_enforced")
if latency_enforced is not (performance_mode == "strict"):
    raise SystemExit("isolated Frontier T2 latency enforcement mode is invalid")
if performance_mode == "strict" and (observed > maximum or passing_batches < 2):
    raise SystemExit("isolated Frontier T2 20ms p95 gate failed")
allocation_max = gates.get("synchronous_projection_allocs_max")
allocation_observed = gates.get("synchronous_projection_allocs_observed")
if allocation_max != 40000 or not isinstance(allocation_observed, (int, float)) or isinstance(allocation_observed, bool) or not math.isfinite(allocation_observed) or not 0 <= allocation_observed <= allocation_max:
    raise SystemExit("isolated Frontier T2 deterministic allocation gate failed")
PY
  printf '%s\t%s\n' "frontier_t2_item2_isolated_performance" "${performance_gate_status}" >>"${gate_rows}"
else
  fail "${LANE} candidate is missing the Frontier T2 item 2 performance-gate tests"
fi

frontier_t2_proof_test="${stage}/services/gateway-go/frontier_t2_proof_timeline_eval_test.go"
frontier_t2_proof_eval="${tmp_dir}/frontier-t2-item24-eval.json"
if [[ -f "${frontier_t2_proof_test}" ]]; then
  env \
    CONTEXTLATTICE_FRONTIER_STRICT_LATENCY_GATE="${strict_latency_gate}" \
    FRONTIER_T2_TESTED_COMMIT="${commit}" \
    FRONTIER_T2_PROOF_TIMELINE_EVIDENCE_PATH="${frontier_t2_proof_eval}" \
    go -C "${stage}/services/gateway-go" test \
      -run '^TestFrontierT2ProofTimelineHoldout$' \
      -count=1 .
  [[ -f "${frontier_t2_proof_eval}" ]] || fail "isolated Frontier T2 item 24 gate did not emit its evidence artifact"
  python3 - "${frontier_t2_proof_eval}" "${commit}" "${PERFORMANCE_MODE}" <<'PY'
import json
import math
import sys
from pathlib import Path

path, commit, performance_mode = sys.argv[1:]
payload = json.loads(Path(path).read_text(encoding="utf-8"))
if payload.get("schema_id") != "frontier_t2_proof_timeline_eval.v1":
    raise SystemExit("isolated Frontier T2 item 24 evidence schema is invalid")
if payload.get("tested_commit") != commit:
    raise SystemExit("isolated Frontier T2 item 24 evidence is not bound to the candidate commit")
if payload.get("correct_count") != payload.get("sample_count") or payload.get("sample_count") != 15:
    raise SystemExit("isolated Frontier T2 item 24 holdout correctness gate failed")
gates = payload.get("release_gates") or {}
for key in ("case_classification_accuracy", "eligible_exact_link_coverage", "ordering_fidelity", "cross_scope_rejection_rate"):
    if gates.get(key) != 1:
        raise SystemExit(f"isolated Frontier T2 item 24 gate failed: {key}")
if gates.get("redaction_failure_count") != 0 or gates.get("silent_gap_count") != 0:
    raise SystemExit("isolated Frontier T2 item 24 redaction or explicit-gap gate failed")
if gates.get("provider_calls") != 0 or gates.get("external_network_calls") != 0 or gates.get("authoritative_ledger_mutations") != 0:
    raise SystemExit("isolated Frontier T2 item 24 read-only boundary gate failed")
maximum = gates.get("projection_p95_ms_max")
observed = gates.get("projection_p95_ms")
if maximum != 20 or not isinstance(observed, (int, float)) or isinstance(observed, bool) or not math.isfinite(observed) or observed < 0:
    raise SystemExit("isolated Frontier T2 item 24 p95 observation is invalid")
latency_enforced = gates.get("projection_latency_gate_enforced")
if latency_enforced is not (performance_mode == "strict"):
    raise SystemExit("isolated Frontier T2 item 24 latency enforcement mode is invalid")
if performance_mode == "strict" and observed > maximum:
    raise SystemExit("isolated Frontier T2 item 24 20ms p95 gate failed")
PY
  printf '%s\t%s\n' "frontier_t2_item24_isolated_proof_timeline" "${performance_gate_status}" >>"${gate_rows}"
else
  fail "${LANE} candidate is missing the Frontier T2 item 24 proof-timeline gate"
fi

frontier_t2_shared_proof_test="${stage}/services/gateway-go/frontier_t2_proof_timeline_entitled_test.go"
frontier_t2_shared_proof_eval="${tmp_dir}/frontier-t2-item24-shared-retention-eval.json"
if [[ -f "${frontier_t2_shared_proof_test}" ]]; then
  env \
    CONTEXTLATTICE_FRONTIER_T2_SHARED_PROOF_PERFORMANCE_GATE=1 \
    CONTEXTLATTICE_FRONTIER_STRICT_LATENCY_GATE="${strict_latency_gate}" \
    FRONTIER_T2_TESTED_COMMIT="${commit}" \
    FRONTIER_T2_SHARED_PROOF_EVIDENCE_PATH="${frontier_t2_shared_proof_eval}" \
    go -C "${stage}/services/gateway-go" test \
      -run '^(TestFrontierT2SharedProofConcurrentRetainRead|TestFrontierT2SharedProofRetentionLatencyHoldout)$' \
      -count=1 .
  [[ -f "${frontier_t2_shared_proof_eval}" ]] || fail "isolated Frontier T2 shared proof retention gate did not emit its evidence artifact"
  python3 - "${frontier_t2_shared_proof_eval}" "${commit}" "${PERFORMANCE_MODE}" <<'PY'
import json
import math
import sys
from pathlib import Path

path, commit, performance_mode = sys.argv[1:]
payload = json.loads(Path(path).read_text(encoding="utf-8"))
if payload.get("schema_id") != "frontier_t2_shared_proof_retention_eval.v1":
    raise SystemExit("isolated Frontier T2 shared proof retention evidence schema is invalid")
if payload.get("tested_commit") != commit:
    raise SystemExit("isolated Frontier T2 shared proof retention evidence is not bound to the candidate commit")
if payload.get("sample_count") != 72 or payload.get("success_count") != 72 or payload.get("concurrent_read_count") != 72:
    raise SystemExit("isolated Frontier T2 shared proof concurrency gate failed")
if payload.get("performance_batch_count") != 3 or payload.get("samples_per_batch") != 24:
    raise SystemExit("isolated Frontier T2 shared proof batch evidence is invalid")
durability = payload.get("durability") or {}
if durability.get("fsync") is not True or durability.get("percentile_method") != "nearest_rank_per_batch":
    raise SystemExit("isolated Frontier T2 shared proof durability evidence is invalid")
gates = payload.get("release_gates") or {}
maximum = gates.get("retention_p95_ms_max")
observed = gates.get("retention_p95_ms")
if maximum != 250 or not isinstance(observed, (int, float)) or isinstance(observed, bool) or not math.isfinite(observed) or observed < 0:
    raise SystemExit("isolated Frontier T2 shared proof p95 observation is invalid")
if gates.get("retention_p95_estimator") != "median_of_3_batch_p95":
    raise SystemExit("isolated Frontier T2 shared proof p95 estimator is invalid")
batches = gates.get("retention_batch_p95_ms")
if not isinstance(batches, list) or len(batches) != 3 or not all(
    isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value) and value >= 0 for value in batches
):
    raise SystemExit("isolated Frontier T2 shared proof batch p95 evidence is invalid")
median_observed = sorted(batches)[1]
if not math.isclose(observed, median_observed, rel_tol=0, abs_tol=1e-9):
    raise SystemExit("isolated Frontier T2 shared proof median p95 evidence is invalid")
passing_batches = sum(value <= maximum for value in batches)
if gates.get("retention_passing_batches") != passing_batches or gates.get("retention_required_passes") != 2:
    raise SystemExit("isolated Frontier T2 shared proof passing-batch evidence is invalid")
latency_enforced = gates.get("retention_latency_gate_enforced")
if latency_enforced is not (performance_mode == "strict"):
    raise SystemExit("isolated Frontier T2 shared proof latency enforcement mode is invalid")
if performance_mode == "strict" and (observed > maximum or passing_batches < 2):
    raise SystemExit("isolated Frontier T2 shared proof 250ms p95 gate failed")
if gates.get("provider_calls") != 0 or gates.get("external_network_calls") != 0 or gates.get("authoritative_ledger_mutations") != 0:
    raise SystemExit("isolated Frontier T2 shared proof side-effect boundary gate failed")
PY
  printf '%s\t%s\n' "frontier_t2_item24_shared_retention" "${performance_gate_status}" >>"${gate_rows}"
elif [[ "${LANE}" == "public" ]]; then
  printf '%s\t%s\n' "frontier_t2_item24_shared_retention" "not_present" >>"${gate_rows}"
else
  fail "${LANE} candidate is missing the Frontier T2 shared proof retention gate"
fi

if [[ -f "${stage}/scripts/generate_commercial_truth.py" ]]; then
  (cd "${stage}" && python3 scripts/generate_commercial_truth.py --check)
  printf '%s\t%s\n' "commercial_truth_generation" "pass" >>"${gate_rows}"
else
  printf '%s\t%s\n' "commercial_truth_generation" "not_present" >>"${gate_rows}"
fi

proof_json="${tmp_dir}/proof.json"
python3 - "${LANE}" "${commit}" "${tree}" "${REF}" "${RELEASE_REF}" "${PERFORMANCE_MODE}" \
  "${blob_rows}" "${gate_rows}" "${proof_json}" <<'PY'
from __future__ import annotations

import json
import sys
from pathlib import Path

lane, commit, tree, source_ref, release_ref, performance_mode, blob_path, gate_path, output_path = sys.argv[1:]
required_blobs = []
for row in Path(blob_path).read_text(encoding="utf-8").splitlines():
    path, oid, size = row.split("\t")
    required_blobs.append({"path": path, "oid": oid, "size": int(size)})
gates = {}
for row in Path(gate_path).read_text(encoding="utf-8").splitlines():
    name, status = row.split("\t")
    gates[name] = status
payload = {
    "schema_id": "contextlattice_release_tree_proof.v1",
    "lane": lane,
    "source_commit": commit,
    "source_tree": tree,
    "source_ref": source_ref,
    "release_ref": release_ref or None,
    "performance_mode": performance_mode,
    "materialization": "temporary_git_index_checkout",
    "gates": gates,
    "required_blobs": required_blobs,
}
Path(output_path).write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
PY

if [[ -n "${PROOF_OUT}" ]]; then
  mkdir -p "$(dirname "${PROOF_OUT}")"
  cp "${proof_json}" "${PROOF_OUT}"
fi
cat "${proof_json}"
