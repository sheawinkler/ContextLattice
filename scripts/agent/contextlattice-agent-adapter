    list_cmd.add_argument("--pretty", action="store_true")
    list_cmd.set_defaults(func=cmd_profiles)

    args = parser.parse_args()
    return int(args.func(args))


def _entrypoint() -> int:
    try:
        return main()
    except SystemExit as exc:
        # Network/UTF-8/JSON failures from the trusted validation transport use
        # a JSON SystemExit payload. Convert that internal transport signal to
        # the same bounded universal v2 envelope as every other adapter path.
        # Preserve argparse's ordinary numeric help/usage exits unchanged.
        if isinstance(exc.code, int) or exc.code is None:
            raise
        argv = sys.argv[1:]
        command = argv[0] if argv and not argv[0].startswith("-") else "adapter"
        values: dict[str, str] = {}
        for index, item in enumerate(argv[:-1]):
            if item in {"--project", "--agent", "--agent-id", "--session-id"}:
                values[item] = argv[index + 1]
        output = adapter_response(
            command=command,
            ok=False,
            project=values.get("--project", "contextlattice"),
            session_id=values.get("--session-id", ""),
            agent=values.get("--agent", "unknown-agent"),
            agent_id=values.get("--agent-id", ""),
            result={"status": "gateway_response_invalid"},
            findings=[{"reason": "gateway_response_invalid"}],
        )
        emit(output, "--pretty" in argv)
        return 1
    except (subprocess.TimeoutExpired, OSError, UnicodeError, json.JSONDecodeError, RecursionError):
        argv = sys.argv[1:]
        command = argv[0] if argv and not argv[0].startswith("-") else "adapter"
        values: dict[str, str] = {}
        for index, item in enumerate(argv[:-1]):
            if item in {"--project", "--agent", "--agent-id", "--session-id"}:
                values[item] = argv[index + 1]
        output = adapter_response(
            command=command,
            ok=False,
            project=values.get("--project", "contextlattice"),
            session_id=values.get("--session-id", ""),
            agent=values.get("--agent", "unknown-agent"),
            agent_id=values.get("--agent-id", ""),
            result={"status": "adapter_command_failed"},
            findings=[{"reason": "adapter_command_failed"}],
        )
        emit(output, "--pretty" in argv)
        return 1


if __name__ == "__main__":
    raise SystemExit(_entrypoint())
