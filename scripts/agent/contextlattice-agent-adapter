    parser.add_argument("--agent", default="codex")
    parser.add_argument("--agent-id", default="")
    parser.add_argument("--project", default="contextlattice")
    parser.add_argument("--session-id", default=os.getenv("CONTEXTLATTICE_SESSION_ID", ""))
    parser.add_argument("--mission", default="")
    parser.add_argument("--objective", default="")
    parser.add_argument("--goal", default="")
    parser.add_argument("--base-url", default=os.getenv("CONTEXTLATTICE_ORCHESTRATOR_URL", "http://127.0.0.1:8075"))
    parser.add_argument("--timeout", type=float, default=30)
    parser.add_argument("--strict", action="store_true")
    parser.add_argument("--pretty", action="store_true")


def add_outcome_args(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--context-pack-quality-sample-id", "--sample-id", default="", dest="context_pack_quality_sample_id")
    parser.add_argument("--first-pass-success", default="")
    parser.add_argument("--repair-required", default="")
    parser.add_argument("--retry-count", "--retries", type=int, default=0, dest="retry_count")
    parser.add_argument("--followup-tokens", type=int, default=0)
    parser.add_argument("--provider-prompt-tokens", type=int, default=0)
    parser.add_argument("--provider-completion-tokens", type=int, default=0)
    parser.add_argument("--provider-total-tokens", type=int, default=0)
    parser.add_argument("--provider-usage-json", default="")
    parser.add_argument("--task-class", default="agent_workflow")
    parser.add_argument("--outcome-source", default="")
    parser.add_argument("--report-context-pack-outcome", action="store_true")


def main() -> int:
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="command", required=True)

    bootstrap = sub.add_parser("bootstrap")
    add_common(bootstrap)
    bootstrap.add_argument("--topic-path", default="")
    bootstrap.add_argument("--query", default="")
    bootstrap.add_argument("--mode", default="")
    bootstrap.set_defaults(func=cmd_bootstrap)

    checkpoint = sub.add_parser("checkpoint")
    add_common(checkpoint)
    checkpoint.add_argument("--topic-path", default="")
    checkpoint.add_argument("--query", default="")
    checkpoint.add_argument("--mode", default="")
    checkpoint.add_argument("--file", default="notes/agent-adapters/checkpoint.md")
    checkpoint.add_argument("--content", default="")
    checkpoint.add_argument("--stdin", action="store_true")
    checkpoint.set_defaults(func=cmd_checkpoint)

    context_pack = sub.add_parser("context-pack")
    add_common(context_pack)
    context_pack.add_argument("--topic-path", default="")
    context_pack.add_argument("--query", default="")
    context_pack.add_argument("--mode", default="")
    context_pack.add_argument("--limit", type=int, default=6)
    context_pack.add_argument("--max-facts", type=int, default=8)
    context_pack.add_argument("--include-retrieval-debug", action="store_true")
    context_pack.set_defaults(func=cmd_context_pack)

    handoff = sub.add_parser("handoff")
    add_common(handoff)
    handoff.add_argument("--summary", default="")
    handoff.add_argument("--next-action", default="")
    handoff.set_defaults(func=cmd_handoff)

    event = sub.add_parser("event")
    add_common(event)
    event.add_argument("event_type")
    event.add_argument("--summary", default="")
    event.add_argument("--status", default="")
    event.add_argument("--metadata-json", default="")
    event.set_defaults(func=cmd_event)

    complete = sub.add_parser("complete")
    add_common(complete)
    complete.add_argument("--summary", default="session completed")
    complete.add_argument("--status", default="")
    complete.add_argument("--metadata-json", default="")
    add_outcome_args(complete)
    complete.set_defaults(func=cmd_complete)

    outcome = sub.add_parser("outcome")
    add_common(outcome)
    outcome.add_argument("--topic-path", default="")
    outcome.add_argument("--query", default="")
    outcome.add_argument("--mode", default="")
    add_outcome_args(outcome)
    outcome.set_defaults(func=cmd_outcome)

    list_cmd = sub.add_parser("profiles")
    list_cmd.add_argument("--project", default="contextlattice")
    list_cmd.add_argument("--pretty", action="store_true")
    list_cmd.set_defaults(func=cmd_profiles)

    args = parser.parse_args()
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
