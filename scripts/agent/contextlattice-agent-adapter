def bounded_public_identity(value: Any, public_field: str, limit: int = 256) -> tuple[str, bool]:
    if value in (None, ""):
        return "", False
    if not isinstance(value, str):
        return "", True
    try:
        encoded_bytes = len(value.encode("utf-8"))
    except UnicodeEncodeError:
        return "", True
    if len(value) > limit or encoded_bytes > limit:
        return "", True
    projected = redact_public_value({public_field: value})
    if not isinstance(projected, dict) or projected.get(public_field) != value:
        return "", True
    return value, False


def public_context_pack_identities(
    value: Any,
    *,
    omitted_fields: set[str] | None = None,
    authoritative_fields: dict[str, str] | None = None,
    preserve_canonical_proofs: bool = False,
) -> dict[str, Any]:
    """Project context-pack identities before attaching its public contract."""

    authorities = authoritative_fields or {}

    proof_field_names = {"memory_trust_assessment", "retrieval_decision_trace"}
    proof_paths = {
        ("memory_trust_assessment",),
        ("retrieval_decision_trace",),
        ("context_pack", "memory_trust_assessment"),
        ("context_pack", "retrieval_decision_trace"),
        ("context_compiler", "memory_trust_assessment"),
        ("context_compiler", "retrieval_decision_trace"),
        ("context_pack", "context_compiler", "memory_trust_assessment"),
        ("context_pack", "context_compiler", "retrieval_decision_trace"),
    }
    structural_forbidden = {
        "hookspecificoutput",
        "messages",
        "toolcalls",
        "functioncall",
        "rawcontextlatticejson",
        "rawprompt",
    }

    def project(node: Any, *, root: bool = False, depth: int = 0, path: tuple[str, ...] = ()) -> Any:
        if depth > 64:
            return None
        if isinstance(node, list):
            return [project(item, depth=depth + 1, path=path) for item in node]
        if not isinstance(node, dict):
            return node
        # Retrieval proof content is hashed before public projection; candidate
        # metadata inside that immutable receipt must never be rewritten as an
        # adapter identity. The proof projector replaces this subtree later.
        if preserve_canonical_proofs and path in proof_paths and path[-1] in proof_field_names:
            return dict(node)
        result = {
            key: project(item, depth=depth + 1, path=(*path, str(key)))
            for key, item in node.items()
            if "".join(character for character in str(key).lower() if character.isalnum())
            not in structural_forbidden
            if "".join(character for character in str(key).lower() if character.isalnum())
            not in {"sessionid", "agentid"}
            or key in {"session_id", "agent_id"}
        }
        omitted = {
            item
            for item in result.get("identity_omitted", [])
            if isinstance(item, str) and item in {"session_id", "agent_id"}
        } if isinstance(result.get("identity_omitted"), list) else set()
        if root:
            omitted.update(omitted_fields or set())
        for field in ("session_id", "agent_id"):
            had_identity = any(
                "".join(character for character in str(key).lower() if character.isalnum())
                == field.replace("_", "")
                for key in node
            ) or field in omitted
            if authoritative_fields is not None and (root or had_identity):
                authority = authorities.get(field, "")
                if authority:
                    result[field] = authority
                    omitted.discard(field)
                else:
                    result.pop(field, None)
                    omitted.add(field)
                continue
            if field not in result:
                continue
            identity, identity_omitted = bounded_public_identity(result.get(field), field)
            if identity and not identity_omitted and field not in omitted:
                result[field] = identity
                continue
            result.pop(field, None)
            omitted.add(field)
        if omitted:
            result["identity_omitted"] = sorted(omitted)
        else:
            result.pop("identity_omitted", None)
        return result

    projected = project(value, root=True)
    return projected if isinstance(projected, dict) else {}


def public_contract_payload_once(contract_id: str, value: Any) -> dict[str, Any]:
    if not isinstance(value, dict):
        return {}
    if not agent_contract_json_domain_valid(value):
        return {}
    # Attach first so a full retrieval receipt is digest-projected while it is
    # still untouched. Only then apply the canonical public projection.
    projected = attach_format_contract(contract_id, value)
    if contract_id == "context_pack_response.v1":
        pack = projected.get("context_pack") if isinstance(projected.get("context_pack"), dict) else {}
        advisor = projected.get("run_advisor") or pack.get("run_advisor")
        advisor = public_contract_payload_once("run_advisor.v1", advisor if isinstance(advisor, dict) else {})
        projected["run_advisor"] = advisor
        if pack:
            pack["run_advisor"] = advisor
            projected["context_pack"] = pack
    projected = redact_public_value(projected)
    if not isinstance(projected, dict):
        return {}
    if not agent_contract_json_domain_valid(projected):
        return {}
    projected, nested_contracts_valid = restamp_nested_public_contracts(projected, root=True)
    contract = projected.get("format_contract")
    if not isinstance(contract, dict):
        return projected
    for _ in range(8):
        canonical_bytes = len(
            json.dumps(
                projected,
                allow_nan=False,
                sort_keys=True,
                separators=(",", ":"),
            ).encode("utf-8")
        )
        if contract.get("actual_json_bytes") == canonical_bytes:
            break
        contract["actual_json_bytes"] = canonical_bytes
    findings = validate_agent_contract_payload(contract_id, projected)
    if not nested_contracts_valid:
        findings.append({"reason": "nested_public_contract_invalid", "contract_id": contract_id})
    contract["contract_valid"] = not findings
    contract["validation"] = {
        "status": "passed" if not findings else "failed",
        "errors": findings[:12],
    }
    for _ in range(8):
        canonical_bytes = len(
            json.dumps(
                projected,
                allow_nan=False,
                sort_keys=True,
                separators=(",", ":"),
            ).encode("utf-8")
        )
        if contract.get("actual_json_bytes") == canonical_bytes:
            break
        contract["actual_json_bytes"] = canonical_bytes
    return projected


def restamp_nested_public_contracts(value: Any, *, root: bool = False) -> tuple[Any, bool]:
    """Refresh public nested contracts or remove stale, non-authoritative stamps."""

    if isinstance(value, list):
        valid = True
        result: list[Any] = []
        for item in value:
            projected, child_valid = restamp_nested_public_contracts(item)
            result.append(projected)
            valid = valid and child_valid
        return result, valid
    if not isinstance(value, dict):
        return value, True
    result: dict[str, Any] = {}
    valid = True
    for key, item in value.items():
        projected, child_valid = restamp_nested_public_contracts(item)
        result[key] = projected
        valid = valid and child_valid
    if root:
        return result, valid
    format_contract = result.get("format_contract")
    contract_id = str(format_contract.get("schema_id") or "") if isinstance(format_contract, dict) else ""
    if contract_id not in {
        "agent_preflight_response.v1",
        "objective_runtime_state.v1",
        "policy_context_package.v1",
        "run_advisor.v1",
    }:
        return result, valid
    stamped = public_contract_payload_once(contract_id, result)
    nested_findings = validate_agent_contract_payload(contract_id, stamped)
    nested_status = validation_status(stamped)
    if not nested_findings and nested_status == "passed":
        return stamped, valid
    result.pop("format_contract", None)
    if contract_id == "run_advisor.v1":
        valid = False
    return result, valid


def public_contract_valid(value: Any) -> bool:
    if not isinstance(value, dict):
        return False
    if not agent_contract_json_domain_valid(value):
        return False
    contract = value.get("format_contract")
    if not isinstance(contract, dict) or contract.get("contract_valid") is not True:
        return False
    contract_id = str(contract.get("schema_id") or "").strip()
    if not contract_id or validate_agent_contract_payload(contract_id, value):
        return False
    return True


def public_contract_fits(value: Any) -> bool:
    if not public_contract_valid(value):
        return False
    contract = value["format_contract"]
    try:
        actual = int(contract.get("actual_json_bytes") or 0)
        maximum = int(contract.get("max_total_json_bytes") or 0)
    except (TypeError, ValueError, OverflowError):
        return False
    return 0 < actual <= maximum


def bounded_context_pack_failure() -> dict[str, Any]:
    compiler = {
        "schema_id": "contextlattice_context_compiler.v1",
        "version": 1,
        "strategy": "adapter_public_boundary_failure",
        "intended_use": "return a bounded typed failure without raw response data",
        "recommended_surface": "cli_for_local_agents",
        "ranked_evidence_count": 0,
    }
    return {
        "ok": False,
        "context_pack": {
            "facts": [],
            "results": [],
            "citations": [],
            "ranked_evidence": [],
            "prompt_sections": {},
            "context_compiler": compiler,
            "relevant_decisions": [],
            "files_to_read": [],
            "files_to_avoid": [],
            "capabilities_to_use": [],
            "runbooks": [],
            "known_failure_modes": [],
            "commands": [],
            "acceptance_criteria": [],
        },
        "source_coverage": {"configured": [], "returned": [], "complete": False},
        "context_compiler": compiler,
        "reference_prompt": "",
        "writeback_required": True,
        "warnings": ["Context pack was rejected at the adapter public boundary."],
    }


def public_contract_payload(contract_id: str, value: Any) -> dict[str, Any]:
    projected = public_contract_payload_once(contract_id, value)
    if public_contract_fits(projected):
        return projected
    if contract_id == "context_pack_response.v1":
        fallback = public_contract_payload_once(contract_id, bounded_context_pack_failure())
    elif contract_id == "universal_agent_adapter_response.v1":
        omitted = {"session_id", "agent_id"}
        if isinstance(value, dict) and isinstance(value.get("identity_omitted"), list):
            omitted.update(
                item for item in value["identity_omitted"] if item in {"session_id", "agent_id"}
            )
        fallback = public_contract_payload_once(
            contract_id,
            {
                "ok": False,
                "command": str(value.get("command") or "context-pack") if isinstance(value, dict) else "context-pack",
                "project": str(value.get("project") or "") if isinstance(value, dict) else "",
                "adapter_contract": adapter_contract(),
                "result": {"status": "bounded_public_boundary_failure"},
                "findings": [{"reason": "adapter_public_boundary_failure"}],
                "identity_omitted": sorted(omitted),
            },
        )
    else:
        return projected
    return fallback if public_contract_fits(fallback) else {}


def validated_context_pack_quality_state_receipt(value: Any) -> dict[str, Any]:
    quality = value if isinstance(value, dict) else {}
    sample_id = str(quality.get("sample_id") or "").strip()
    query_hash = str(quality.get("query_hash") or "").strip().lower()
    quality_score = quality.get("quality_score")
    captured_at = str(quality.get("capturedAt") or quality.get("captured_at") or "").strip()
    try:
        sample_id_bytes = len(sample_id.encode("utf-8"))
    except UnicodeEncodeError:
        return {}
    if not sample_id or len(sample_id) > 200 or sample_id_bytes > 200:
        return {}
    if not sample_id.startswith("cpq_") or any(ch not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-" for ch in sample_id):
        return {}
    projected_sample_id, sample_id_omitted = bounded_public_identity(sample_id, "sample_id", 200)
    if sample_id_omitted or projected_sample_id != sample_id:
        return {}
    if len(query_hash) != 16 or any(ch not in "0123456789abcdef" for ch in query_hash):
        return {}
    if isinstance(quality_score, bool) or not isinstance(quality_score, (int, float)):
        return {}
    if isinstance(quality_score, int):
        if not 0 <= quality_score <= 100:
            return {}
    elif not math.isfinite(quality_score) or not 0 <= quality_score <= 100:
        return {}
    try:
        parsed_at = datetime.fromisoformat(captured_at.replace("Z", "+00:00"))
        if parsed_at.tzinfo is None:
            return {}
    except ValueError:
        return {}
    return {
        "sample_id": sample_id,
        "query_hash": query_hash,
        "quality_score": quality_score,
        "capturedAt": captured_at,
    }


def context_pack_outcome_report(session_id: str, sample_id: str) -> dict[str, Any]:
    session_id, session_id_omitted = bounded_public_identity(session_id, "session_id")
    sample_id, sample_id_omitted = bounded_public_identity(sample_id, "sample_id", 200)
    if session_id_omitted or sample_id_omitted or not session_id or not sample_id:
        return {}
    return {
        "schema_id": "contextlattice_context_pack_outcome_report.v1",
        "sample_id": sample_id,
        "endpoint": "/telemetry/context-pack-quality/outcome",
        "command": (
            "contextlattice_agent_adapter outcome "
            f"--session-id {json.dumps(session_id)} "
            f"--context-pack-quality-sample-id {json.dumps(sample_id)} "
            "--first-pass-success true --repair-required false --retry-count 0"
        ),
        "fields": [
            "first_pass_success",
            "repair_required",
            "retry_count",
            "followup_tokens",
            "provider_prompt_tokens",
            "provider_completion_tokens",
            "provider_total_tokens",
        ],
        "privacy": "stores compact counters only; do not send prompts, completions, source text, or secrets",
    }


def record_context_pack_quality_pending(project: str, session_id: str, agent_id: str, objective: str, quality: dict[str, Any]) -> None:
    session_id, session_id_omitted = bounded_public_identity(session_id, "session_id")
    agent_id, agent_id_omitted = bounded_public_identity(agent_id, "agent_id")
    quality = validated_context_pack_quality_state_receipt(quality)
    sample_id = str(quality.get("sample_id") or "").strip()
    if session_id_omitted or agent_id_omitted or not sample_id or not session_id:
        return
    from _common import read_agent_session_state, write_agent_session_state

    state = read_agent_session_state(project)
    state.update(
        {
            "session_id": session_id,
            "project": project,
            "agent_id": agent_id,
            "objective": objective,
            "source": "contextlattice-agent-adapter",
            "latest_context_pack_quality": {
                "sample_id": sample_id,
                "query_hash": quality.get("query_hash"),
                "quality_score": quality.get("quality_score"),
                "captured_at": quality.get("capturedAt") or quality.get("captured_at") or now_iso(),
                "reported": False,
            },
        }
    )
    write_agent_session_state(project, state)


def parse_bool_arg(raw: str, name: str) -> tuple[bool, bool]:
    if raw == "":
        return False, False
    value = raw.strip().lower()
    if value in {"1", "true", "yes", "on"}:
        return True, True
    if value in {"0", "false", "no", "off"}:
        return False, True
    raise SystemExit(f"--{name} must be true or false")


def pending_quality_sample_id(args: argparse.Namespace) -> str:
    sample_id = str(getattr(args, "context_pack_quality_sample_id", "") or "").strip()
    if sample_id:
        return sample_id
    sample_id = os.getenv("CONTEXTLATTICE_CONTEXT_PACK_QUALITY_SAMPLE_ID", "").strip()
    if sample_id:
        return sample_id
    from _common import read_agent_session_state

    state = read_agent_session_state(args.project)
    quality = state.get("latest_context_pack_quality") if isinstance(state.get("latest_context_pack_quality"), dict) else {}
    if quality.get("reported") is True:
        return ""
    return str(quality.get("sample_id") or "").strip()


def mark_context_pack_quality_reported(project: str, session_id: str, outcome: dict[str, Any]) -> None:
    outcome_id = str(outcome.get("outcome_id") or "").strip()
    sample_id = str(outcome.get("sample_id") or "").strip()
    if not session_id or not outcome_id or not sample_id:
        return
    from _common import read_agent_session_state, write_agent_session_state

    state = read_agent_session_state(project)
    if str(state.get("session_id") or "") != session_id:
        return
    quality = state.get("latest_context_pack_quality") if isinstance(state.get("latest_context_pack_quality"), dict) else {}
    if str(quality.get("sample_id") or "") != sample_id or quality.get("reported") is True:
        return
    quality = dict(quality)
    quality.update({"reported": True, "reported_at": now_iso(), "outcome_id": outcome_id})
    state["latest_context_pack_quality"] = quality
    write_agent_session_state(project, state)


def outcome_payload_from_args(args: argparse.Namespace, session_id: str, profile_key: str, agent_id: str, source: str) -> dict[str, Any]:
    sample_id = pending_quality_sample_id(args)
    if not sample_id:
        raise SystemExit("context pack quality sample id is required; run context-pack first or pass --context-pack-quality-sample-id")
    first_pass, first_pass_present = parse_bool_arg(args.first_pass_success, "first-pass-success")
    repair_required, repair_present = parse_bool_arg(args.repair_required, "repair-required")
    provider_usage = metadata_from_args(args.provider_usage_json)
    payload: dict[str, Any] = {
        "sample_id": sample_id,
        "context_pack_quality_sample_id": sample_id,
        "session_id": session_id,
        "agent": profile_key,
        "agent_id": agent_id,
        "project": args.project,
        "task_class": args.task_class or "agent_workflow",
        "outcome_source": args.outcome_source or source,
        "retry_count": max(0, int(args.retry_count or 0)),
        "followup_tokens": max(0, int(args.followup_tokens or 0)),
        "provider_prompt_tokens": max(0, int(args.provider_prompt_tokens or 0)),
        "provider_completion_tokens": max(0, int(args.provider_completion_tokens or 0)),
        "provider_total_tokens": max(0, int(args.provider_total_tokens or 0)),
    }
    if provider_usage:
        payload["provider_usage"] = provider_usage
    if first_pass_present:
        payload["first_pass_success"] = first_pass
    if repair_present:
        payload["repair_required"] = repair_required
    has_signal = (
        first_pass_present
        or repair_present
        or payload["retry_count"] > 0
        or payload["followup_tokens"] > 0
        or payload["provider_prompt_tokens"] > 0
        or payload["provider_completion_tokens"] > 0
        or payload["provider_total_tokens"] > 0
        or bool(provider_usage)
    )
    if not has_signal:
        raise SystemExit("outcome requires at least one explicit outcome or usage signal")
    return {key: value for key, value in payload.items() if value not in ("", None, {})}


def compact_outcome_metadata(outcome: dict[str, Any]) -> dict[str, Any]:
    compact: dict[str, Any] = {"schema_id": "contextlattice_context_pack_outcome.v1"}
    for field, limit in (("outcome_id", 240), ("sample_id", 200), ("task_class", 120), ("outcome_source", 120)):
        value = outcome.get(field)
        if not isinstance(value, str):
            continue
        projected = redact_public_value({field: value})
        public_value = projected.get(field) if isinstance(projected, dict) else None
        try:
            public_bytes = len(public_value.encode("utf-8")) if isinstance(public_value, str) else limit + 1
        except UnicodeEncodeError:
            public_bytes = limit + 1
        if isinstance(public_value, str) and public_value == value and 0 < public_bytes <= limit:
            compact[field] = public_value
    for field in ("first_pass_success", "repair_required"):
        if isinstance(outcome.get(field), bool):
            compact[field] = outcome[field]
    for field in (
        "retry_count",
        "observed_followup_tokens",
        "provider_prompt_tokens",
        "provider_completion_tokens",
        "provider_total_tokens",
    ):
        value = outcome.get(field)
        if isinstance(value, int) and not isinstance(value, bool) and 0 <= value <= (1 << 63) - 1:
            compact[field] = value
    return compact


def validated_context_pack_outcome_receipt(value: Any, expected_sample_id: str) -> dict[str, Any]:
    outcome = value if isinstance(value, dict) else {}
    if outcome.get("schema_id") != "contextlattice_context_pack_outcome.v1":
        return {}
    compact = compact_outcome_metadata(outcome)
    outcome_id = compact.get("outcome_id")
    sample_id = compact.get("sample_id")
    if not isinstance(outcome_id, str) or not re.fullmatch(r"[A-Za-z0-9._:@-]{1,240}", outcome_id):
        return {}
    if (
        not isinstance(sample_id, str)
        or sample_id != expected_sample_id
        or not sample_id.startswith("cpq_")
        or not re.fullmatch(r"[A-Za-z0-9_-]{5,200}", sample_id)
    ):
        return {}
    return compact


def post_context_pack_outcome(args: argparse.Namespace, session_id: str, profile_key: str, agent_id: str, source: str) -> tuple[dict[str, Any], dict[str, Any], list[dict[str, Any]]]:
    payload = outcome_payload_from_args(args, session_id, profile_key, agent_id, source)
    payload = attach_task_binding(payload, args)
    raw = request_json("POST", "/telemetry/context-pack-quality/outcome", payload, args.timeout)
    event: dict[str, Any] = {}
    findings: list[dict[str, Any]] = []
    outcome = validated_context_pack_outcome_receipt(raw.get("outcome"), str(payload.get("sample_id") or ""))
    if raw.get("ok") is not True:
        findings.append({"reason": "outcome_report_rejected"})
        return raw, event, findings
    if not outcome:
        findings.append({"reason": "outcome_receipt_invalid"})
        return raw, event, findings
    raw = dict(raw)
    raw["outcome"] = outcome
    if session_id:
        event = request_json(
            "POST",
            "/v1/agents/sessions/event",
            {
                "session_id": session_id,
                "agent": profile_key,
                "agent_id": agent_id,
                "project": args.project,
                "type": "context_pack.outcome_reported",
                "summary": "context pack outcome reported",
                "metadata": {
                    "adapter": "contextlattice-agent-adapter",
                    "outcome": compact_outcome_metadata(outcome),
                    "task_binding": binding_metadata(args),
                },
            },
            args.timeout,
        )
        if event.get("ok") is not True:
            findings.append({"reason": "outcome_event_failed"})
    if not findings and session_id and event.get("ok") is True:
        mark_context_pack_quality_reported(args.project, session_id, outcome)
    return raw, event, findings


