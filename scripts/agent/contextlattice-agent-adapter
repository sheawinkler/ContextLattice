def task_binding(args: argparse.Namespace) -> dict[str, str]:
    values = {
        "session_id": getattr(args, "session_id", "") or os.getenv("CONTEXTLATTICE_SESSION_ID", ""),
        "task_id": getattr(args, "task_id", "") or os.getenv("CONTEXTLATTICE_TASK_ID", ""),
        "attempt_id": getattr(args, "attempt_id", "") or os.getenv("CONTEXTLATTICE_ATTEMPT_ID", ""),
        "lease_id": getattr(args, "lease_id", "") or os.getenv("CONTEXTLATTICE_LEASE_ID", ""),
        "worker_id": os.getenv("TASK_WORKER_ID", ""),
        "worker_instance_id": os.getenv("TASK_WORKER_INSTANCE_ID", ""),
        "generation": os.getenv("TASK_LEASE_GENERATION", ""),
        "snapshot_id": getattr(args, "snapshot_id", "") or os.getenv("CONTEXTLATTICE_CONTEXT_SNAPSHOT_ID", ""),
        "context_pack_hash": getattr(args, "context_pack_hash", "") or os.getenv("CONTEXTLATTICE_CONTEXT_PACK_HASH", ""),
    }
    return {key: str(value or "").strip() for key, value in values.items()}


def binding_metadata(args: argparse.Namespace) -> dict[str, Any]:
    binding = task_binding(args)
    metadata: dict[str, Any] = {key: value for key, value in binding.items() if value}
    fence_keys = ("task_id", "attempt_id", "lease_id", "worker_id", "worker_instance_id", "generation")
    if all(metadata.get(key) for key in fence_keys):
        try:
            generation = int(str(metadata["generation"]))
        except (TypeError, ValueError):
            generation = 0
        if generation > 0:
            metadata["fence"] = {
                "task_id": metadata["task_id"],
                "attempt_id": metadata["attempt_id"],
                "lease_id": metadata["lease_id"],
                "worker_id": metadata["worker_id"],
                "worker_instance_id": metadata["worker_instance_id"],
                "generation": generation,
            }
    return metadata


def attach_task_binding(payload: dict[str, Any], args: argparse.Namespace) -> dict[str, Any]:
    binding = binding_metadata(args)
    for key, value in binding.items():
        if key not in payload and value:
            payload[key] = value
    metadata = payload.get("metadata") if isinstance(payload.get("metadata"), dict) else {}
    if binding:
        metadata = dict(metadata)
        metadata["task_binding"] = binding
        payload["metadata"] = metadata
    return payload


def shell_exports(values: dict[str, str]) -> list[str]:
    out = []
    for key, value in values.items():
        safe = str(value).replace("'", "'\"'\"'")
        out.append(f"export {key}='{safe}'")
    return out


def compact_skills_index(payload: Any) -> dict[str, Any]:
    if not isinstance(payload, dict):
        return {}
    raw_results = payload.get("results")
    results = raw_results if isinstance(raw_results, list) else []
    top: list[dict[str, Any]] = []
    for item in results[:5]:
        if not isinstance(item, dict):
            continue
        top.append(
            {
                "name": str(item.get("name") or ""),
                "source": str(item.get("source") or ""),
                "path": str(item.get("path") or ""),
                "score": item.get("score"),
            }
        )
    return {
        "ok": payload.get("ok", True),
        "index": payload.get("index"),
        "returned": payload.get("returned", len(results)),
        "total_matches": payload.get("total_matches"),
        "top": top,
    }


def compact_adapter_server_receipt(payload: Any, kind: str) -> dict[str, Any]:
    """Return a closed, public receipt for post-mutation server evidence."""

    value = payload if isinstance(payload, dict) else {}
    receipt: dict[str, Any] = {"ok": value.get("ok") is True, "kind": kind}
    sources = [value]
    for nested_field in ("event", "outcome", "receipt", "result", "write"):
        nested = value.get(nested_field)
        if isinstance(nested, dict):
            sources.append(nested)
    for field in (
        "schema_id",
        "id",
        "event_id",
        "outcome_id",
        "sample_id",
        "content_ref",
        "digest",
        "status",
        "type",
    ):
        candidate = next((source[field] for source in sources if field in source), None)
        if isinstance(candidate, bool):
            receipt[field] = candidate
            continue
        if isinstance(candidate, int) and not isinstance(candidate, bool):
            if -(1 << 63) <= candidate <= (1 << 63) - 1:
                receipt[field] = candidate
            continue
        if not isinstance(candidate, str):
            continue
        projected = redact_public_value({field: candidate})
        public_value = projected.get(field) if isinstance(projected, dict) else None
        if (
            isinstance(public_value, str)
            and public_value == candidate
            and len(public_value.encode("utf-8")) <= 256
        ):
            receipt[field] = public_value
    return receipt


def compact_adapter_handoff(payload: Any) -> dict[str, Any]:
    value = payload if isinstance(payload, dict) else {}
    compact: dict[str, Any] = {
        "ok": True,
        "schema_id": "contextlattice_adapter_handoff.v1",
    }
    for field, limit in (("summary", 1200), ("objective", 1200), ("next_action", 1200), ("created_at", 80)):
        candidate = value.get(field)
        if not isinstance(candidate, str):
            continue
        projected = redact_public_value({field: candidate})
        public_value = projected.get(field) if isinstance(projected, dict) else None
        if not isinstance(public_value, str):
            continue
        encoded = public_value.encode("utf-8")
        if len(encoded) <= limit:
            compact[field] = public_value
    return compact


def adapter_output_accepted(output: Any) -> bool:
    return isinstance(output, dict) and output.get("ok") is True and public_contract_fits(output)


def adapter_response(
    *,
    command: str,
    ok: bool,
    project: str,
    session_id: str,
    result: dict[str, Any],
    findings: list[dict[str, Any]] | None = None,
    agent: str = "",
    agent_id: str = "",
) -> dict[str, Any]:
    public_session_id, session_id_omitted = bounded_public_identity(session_id, "session_id")
    public_agent_id, agent_id_omitted = bounded_public_identity(agent_id, "agent_id")
    payload = {
        "ok": bool(ok),
        "command": command,
        "agent": str(agent or "").strip(),
        "project": str(project or "").strip(),
        "adapter_contract": adapter_contract(),
        "result": result,
        "findings": findings or [],
    }
    omitted: list[str] = []
    if public_session_id:
        payload["session_id"] = public_session_id
    else:
        omitted.append("session_id")
    if public_agent_id:
        payload["agent_id"] = public_agent_id
    else:
        omitted.append("agent_id")
    if session_id_omitted or agent_id_omitted or omitted:
        payload["identity_omitted"] = omitted
    payload = public_context_pack_identities(
        payload,
        omitted_fields=set(omitted),
        authoritative_fields={"session_id": public_session_id, "agent_id": public_agent_id},
    )
    return public_contract_payload("universal_agent_adapter_response.v1", payload)


def contract_findings_for_bootstrap(response: dict[str, Any]) -> list[dict[str, Any]]:
    findings: list[dict[str, Any]] = []
    if response.get("ok") is not True:
        findings.append({"reason": "preflight_rejected"})
    findings.extend(validate_agent_contract_payload("agent_preflight_response.v1", response))
    runtime = response.get("objective_runtime") if isinstance(response.get("objective_runtime"), dict) else {}
    findings.extend(validate_agent_contract_payload("objective_runtime_state.v1", runtime))
    policy = response.get("policy_context_package") if isinstance(response.get("policy_context_package"), dict) else {}
    findings.extend(validate_agent_contract_payload("policy_context_package.v1", policy))
    policy_runtime = policy.get("objective_runtime") if isinstance(policy.get("objective_runtime"), dict) else {}
    findings.extend(validate_agent_contract_payload("objective_runtime_state.v1", policy_runtime))
    if validation_status(runtime) != "passed":
        findings.append({"reason": "objective_runtime_validation_not_passed", "validation": runtime.get("format_contract")})
    if validation_status(policy_runtime) != "passed":
        findings.append({"reason": "policy_objective_runtime_validation_not_passed", "validation": policy_runtime.get("format_contract")})
    if validation_status(policy) != "passed":
        findings.append({"reason": "policy_context_package_validation_not_passed", "validation": policy.get("format_contract")})
    if not registered_contract_attestation_valid("objective_runtime_state.v1", runtime):
        findings.append({"reason": "objective_runtime_contract_attestation_invalid"})
    if not registered_contract_attestation_valid("policy_context_package.v1", policy):
        findings.append({"reason": "policy_context_package_contract_attestation_invalid"})
    if not registered_contract_attestation_valid("objective_runtime_state.v1", policy_runtime):
        findings.append({"reason": "policy_objective_runtime_contract_attestation_invalid"})
    format_contracts = response.get("format_contracts") if isinstance(response.get("format_contracts"), dict) else {}
    validation = format_contracts.get("validation") if isinstance(format_contracts.get("validation"), dict) else {}
    errors = validation.get("errors")
    registry = load_agent_contracts_registry()
    preflight_contract = (
        registry.get("contracts", {}).get("agent_preflight_response.v1", {})
        if isinstance(registry.get("contracts"), dict)
        else {}
    )
    try:
        actual_json_bytes = len(agent_contract_go_json(response))
    except (TypeError, ValueError, OverflowError, UnicodeEncodeError, RecursionError):
        actual_json_bytes = -1
    contract_ids = format_contracts.get("contracts")
    required_contract_ids = {
        "agent_preflight_response.v1",
        "objective_runtime_state.v1",
        "policy_context_package.v1",
    }
    if (
        format_contracts.get("registry_id") != registry.get("registry_id")
        or format_contracts.get("registry_version") != registry.get("registry_version")
        or format_contracts.get("contract_valid") is not True
        or validation.get("status") != "passed"
        or not isinstance(errors, list)
        or errors
        or not isinstance(contract_ids, list)
        or not required_contract_ids.issubset({item for item in contract_ids if isinstance(item, str)})
        or format_contracts.get("max_total_json_bytes") != preflight_contract.get("max_total_json_bytes")
        or format_contracts.get("max_string_bytes") != preflight_contract.get("max_string_bytes")
        or format_contracts.get("max_list_items") != preflight_contract.get("max_list_items")
        or format_contracts.get("actual_json_bytes") != actual_json_bytes
    ):
        findings.append({"reason": "preflight_contract_attestation_invalid"})
    if contains_provider_overflow(response):
        findings.append({"reason": "provider_overflow_phrase_leaked"})
    if not str(response.get("session_id") or "").strip():
        findings.append({"reason": "missing_session_id"})
    return findings


def bootstrap_authority_findings(
    response: dict[str, Any],
    *,
    agent: str,
    agent_id: str,
    project: str,
    query: str,
    topic_path: str,
    retrieval_mode: str,
    reuse_key: str,
) -> list[dict[str, Any]]:
    findings: list[dict[str, Any]] = []
    expected = {
        "agent": agent,
        "agent_id": agent_id,
        "project": project,
        "query": query,
        "topic_path": topic_path,
        "retrieval_mode": retrieval_mode,
    }
    for field, value in expected.items():
        if response.get(field) != value:
            findings.append({"reason": "preflight_authority_mismatch", "field": field})
    if not session_identity_valid(response.get("session_id")):
        findings.append({"reason": "preflight_session_identity_invalid"})
    session_id = str(response.get("session_id") or "").strip()
    agent_runtime = response.get("agent_runtime") if isinstance(response.get("agent_runtime"), dict) else {}
    session = agent_runtime.get("session") if isinstance(agent_runtime.get("session"), dict) else {}
    if not agent_session_matches_authority(
        session,
        expected_id=session_id,
        project=project,
        agent=agent,
        agent_id=agent_id,
        reuse_key=reuse_key,
    ):
        findings.append({"reason": "preflight_session_authority_mismatch"})
    return findings


def cmd_bootstrap(args: argparse.Namespace) -> int:
    configure_base_url(args)
    profile_key, profile, agent_id, topic_path, query, mode = profile_payload(args)
    payload = {
        "agent": profile_key,
        "agent_id": agent_id,
        "project": args.project,
        "topic_path": topic_path,
        "query": query,
        "retrieval_mode": mode,
        "mission": args.mission,
        "objective": args.objective or query,
        "goal": args.goal,
    }
    payload = attach_task_binding(payload, args)
    reuse_key = agent_session_reuse_key(
        args.project,
        profile_key,
        agent_id,
        str(payload.get("objective") or query),
        {"adapter": "contextlattice-agent-adapter", "task_binding": binding_metadata(args)},
    )
    payload["reuse_key"] = reuse_key
    payload = {key: value for key, value in payload.items() if value not in ("", None)}
    raw_response = request_json_for_validation("POST", "/v1/agents/preflight", payload, args.timeout)
    findings = contract_findings_for_bootstrap(raw_response)
    findings.extend(
        bootstrap_authority_findings(
            raw_response,
            agent=profile_key,
            agent_id=agent_id,
            project=args.project,
            query=query,
            topic_path=topic_path,
            retrieval_mode=mode,
            reuse_key=reuse_key,
        )
    )
    session_id = str(raw_response.get("session_id") or "").strip() if not findings else ""
    if findings:
        output = adapter_response(
            command="bootstrap",
            ok=False,
            agent=profile_key,
            agent_id=agent_id,
            project=args.project,
            session_id="",
            result={"status": "bounded_public_boundary_failure"},
            findings=[{"reason": "bootstrap_contract_or_authority_invalid"}],
        )
        emit(output, args.pretty)
        return 1
    response = enforce_contract_limits("agent_preflight_response.v1", raw_response)
    binding = task_binding(args)
    if session_id:
        binding["session_id"] = session_id
    export_binding = {key: binding.get(key, "") for key in ("task_id", "attempt_id", "lease_id", "snapshot_id", "context_pack_hash")}
    exports = env_exports(args.base_url, profile_key, agent_id, session_id, **export_binding)
    output = adapter_response(
        command="bootstrap",
        ok=not findings,
        agent=profile_key,
        agent_id=agent_id,
        project=args.project,
        session_id=session_id,
        result={
            "topic_path": topic_path,
            "query": query,
            "retrieval_mode": mode,
            "profile": profile,
            "exports": exports,
            "shell_exports": shell_exports(exports),
            "objective_runtime": response.get("objective_runtime"),
            "policy_context_package": response.get("policy_context_package"),
            "format_contracts": response.get("format_contracts"),
            "preflight": {
                "ok": response.get("ok"),
                "service": response.get("service"),
                "orchestrator_url": response.get("orchestrator_url"),
                "session_id": response.get("session_id"),
                "skills_index": compact_skills_index(response.get("skills_index")),
            },
            "task_binding": binding,
        },
        findings=findings,
    )
    emit(output, args.pretty)
    return 0 if adapter_output_accepted(output) else 1


def ensure_session_for_args(args: argparse.Namespace, objective: str) -> str:
    if args.session_id:
        return args.session_id
    ensured = ensure_agent_session(
        project=args.project,
        objective=objective,
        agent=args.agent,
        agent_id=args.agent_id,
        mission=args.mission,
        goal=args.goal,
        metadata={
            "adapter": "contextlattice-agent-adapter",
            "task_binding": binding_metadata(args),
        },
        tags=["universal-agent-adapter"],
        timeout=min(float(args.timeout), 10.0),
        soft=not args.strict,
    )
    return str(ensured.get("session_id") or "")


def cmd_event(args: argparse.Namespace) -> int:
    configure_base_url(args)
    session_id = ensure_session_for_args(args, args.summary or args.event_type)
    payload = {
        "session_id": session_id,
        "agent": args.agent,
        "agent_id": args.agent_id,
        "project": args.project,
        "type": args.event_type,
        "summary": args.summary,
        "status": args.status,
        "metadata": metadata_from_args(args.metadata_json),
    }
    payload = attach_task_binding(payload, args)
    payload = {key: value for key, value in payload.items() if value not in ("", None, {})}
    preflight = adapter_response(
        command="event",
        ok=True,
        agent=args.agent,
        agent_id=args.agent_id,
        project=args.project,
        session_id=session_id,
        result={"event": {"ok": True, "kind": "event"}},
    )
    if not adapter_output_accepted(preflight):
        emit(preflight, args.pretty)
        return 1
    response = request_json("POST", "/v1/agents/sessions/event", payload, args.timeout)
    output = adapter_response(
        command="event",
        ok=response.get("ok") is True,
        agent=args.agent,
        agent_id=args.agent_id,
        project=args.project,
        session_id=session_id,
        result={"event": compact_adapter_server_receipt(response, "event")},
    )
    emit(output, args.pretty)
    return 0 if adapter_output_accepted(output) else 1


def metadata_from_args(raw: str) -> dict[str, Any]:
    if not raw:
