def cmd_checkpoint(args: argparse.Namespace) -> int:
    configure_base_url(args)
    profile_key, profile, agent_id, topic_path, query, mode = profile_payload(args)
    session_id = ensure_session_for_args(args, args.content or query)
    content = args.content
    if args.stdin:
        content = sys.stdin.read()
    content = (content or "").strip()
    if len(content) < 12:
        raise SystemExit("checkpoint content must be at least 12 characters")
    body = {
        "projectName": args.project,
        "fileName": args.file,
        "topicPath": args.topic_path or topic_path or "agent/checkpoints",
        "content": content,
        "agent_id": agent_id,
        "session_id": session_id,
        "created_at": now_iso(),
        "tags": ["agent-writeback", "checkpoint", "universal-agent-adapter"],
    }
    body = attach_task_binding(body, args)
    public_session_id, _session_omitted = bounded_public_identity(session_id, "session_id")
    preflight_writeback: dict[str, Any] = {
        "ok": True,
        "kind": "checkpoint",
        "project": args.project,
        "file": args.file,
        "topic_path": body["topicPath"],
        "write": {"ok": True, "kind": "write"},
        "event": {"ok": True, "kind": "event"},
        "adapter_contract": adapter_contract(),
    }
    if public_session_id:
        preflight_writeback["session_id"] = public_session_id
    preflight = adapter_response(
        command="checkpoint",
        ok=True,
        agent=profile_key,
        agent_id=agent_id,
        project=args.project,
        session_id=session_id,
        result={"writeback": preflight_writeback, "retrieval_mode": mode, "profile": profile},
    )
    if not adapter_output_accepted(preflight):
        emit(preflight, args.pretty)
        return 1
    write = request_json("POST", "/memory/write", body, args.timeout)
    event: dict[str, Any] = {}
    findings: list[dict[str, Any]] = []
    if write.get("ok") is True:
        event = request_json(
            "POST",
            "/v1/agents/sessions/event",
            {
                "session_id": session_id,
                "agent": profile_key,
                "agent_id": agent_id,
                "project": args.project,
                "type": "writeback.completed",
                "summary": content[:240],
                "metadata": {
                    "file": args.file,
                    "topic_path": body["topicPath"],
                    "adapter": "contextlattice-agent-adapter",
                    "task_binding": binding_metadata(args),
                },
            },
            args.timeout,
        )
        if event.get("ok") is not True:
            findings.append({"reason": "writeback_event_failed"})
    else:
        findings.append({"reason": "writeback_rejected"})
    writeback_payload = {
        "ok": write.get("ok") is True and event.get("ok") is True,
        "kind": "checkpoint",
        "project": args.project,
        "file": args.file,
        "topic_path": body["topicPath"],
        "write": compact_adapter_server_receipt(write, "write"),
        "event": compact_adapter_server_receipt(event, "event"),
        "adapter_contract": adapter_contract(),
    }
    if public_session_id:
        writeback_payload["session_id"] = public_session_id
    writeback = public_contract_payload_once("writeback_result.v1", writeback_payload)
    output = adapter_response(
        command="checkpoint",
        ok=writeback.get("ok") is True and not findings and public_contract_valid(writeback),
        agent=profile_key,
        agent_id=agent_id,
        project=args.project,
        session_id=session_id,
        result={"writeback": writeback, "retrieval_mode": mode, "profile": profile},
        findings=findings,
    )
    emit(output, args.pretty)
    return 0 if adapter_output_accepted(output) else 1


def cmd_context_pack(args: argparse.Namespace) -> int:
    configure_base_url(args)
    profile_key, profile, agent_id, topic_path, query, mode = profile_payload(args)
    session_id = ensure_session_for_args(args, args.objective or query)
    request = {
        "query": query,
        "project": args.project,
        "topic_path": args.topic_path or topic_path,
        "retrieval_mode": mode,
        "limit": int(args.limit),
        "max_facts": int(args.max_facts),
        "include_retrieval_debug": bool(args.include_retrieval_debug),
        "agent_id": agent_id,
        "session_id": session_id,
        "traffic_class": "user",
    }
    request = attach_task_binding(request, args)
    request = {key: value for key, value in request.items() if value not in ("", None)}
    raw_context_pack = request_json_for_validation("POST", "/memory/context-pack", request, args.timeout)
    quality_sample = context_pack_quality_sample(raw_context_pack if isinstance(raw_context_pack, dict) else {})
    public_session_id, _session_id_omitted = bounded_public_identity(session_id, "session_id")
    public_agent_id, _agent_id_omitted = bounded_public_identity(agent_id, "agent_id")
    omitted_context_pack_identities = {
        field
        for field, public_value in (
            ("session_id", public_session_id),
            ("agent_id", public_agent_id),
        )
        if not public_value
    }
    raw_context_pack_for_public = public_context_pack_identities(
        raw_context_pack,
        omitted_fields=omitted_context_pack_identities,
        authoritative_fields={"session_id": public_session_id, "agent_id": public_agent_id},
        preserve_canonical_proofs=True,
    )
    context_pack = public_contract_payload("context_pack_response.v1", raw_context_pack_for_public)
    findings = validate_agent_contract_payload("context_pack_response.v1", context_pack)
    raw_success = (
        isinstance(raw_context_pack, dict)
        and raw_context_pack.get("ok") is True
        and isinstance(raw_context_pack.get("context_pack"), dict)
    )
    if not raw_success or context_pack.get("ok") is not True:
        findings.append({"reason": "context_pack_public_boundary_failure"})
    if contains_provider_overflow(context_pack):
        findings.append({"reason": "context_pack_provider_overflow_phrase_leaked"})
    accepted_context_pack = not findings and public_contract_fits(context_pack)
    quality_state_receipt = (
        validated_context_pack_quality_state_receipt(quality_sample) if accepted_context_pack else {}
    )
    quality_sample_id = str(quality_state_receipt.get("sample_id") or "").strip()
    def build_output(event_value: dict[str, Any]) -> dict[str, Any]:
        candidate = adapter_response(
            command="context-pack",
            ok=accepted_context_pack and event_value.get("ok") is True,
            agent=profile_key,
            agent_id=public_agent_id,
            project=args.project,
            session_id=public_session_id,
            result={
                "profile": profile,
                "topic_path": request.get("topic_path"),
                "query": query,
                "retrieval_mode": mode,
                "context_pack": enforce_contract_limits("context_pack_response.v1", context_pack),
                "outcome_report": (
                    context_pack_outcome_report(session_id, quality_sample_id)
                    if accepted_context_pack and quality_sample_id
                    else {}
                ),
                "event": event_value,
            },
            findings=findings,
        )
        return public_contract_payload("universal_agent_adapter_response.v1", candidate)

    preflight_event = {"ok": True}
    output = build_output(preflight_event)
    envelope_accepted = output.get("ok") is True and public_contract_fits(output)
    if not envelope_accepted:
        accepted_context_pack = False
        quality_state_receipt = {}
        quality_sample_id = ""
        if not any(finding.get("reason") == "adapter_public_boundary_failure" for finding in findings):
            findings.append({"reason": "adapter_public_boundary_failure"})
    if accepted_context_pack:
        raw_event = request_json(
            "POST",
            "/v1/agents/sessions/event",
            {
                "session_id": session_id,
                "agent": profile_key,
                "agent_id": agent_id,
                "project": args.project,
                "type": "context_pack.completed",
                "summary": f"context pack completed for {query[:160]}",
                "metadata": {
                    "adapter": "contextlattice-agent-adapter",
                    "topic_path": request.get("topic_path"),
                    "retrieval_mode": mode,
                    "contract_ok": True,
                    "context_pack_quality_sample_id": quality_sample_id,
                    "task_binding": binding_metadata(args),
                },
            },
            args.timeout,
        )
        event = {"ok": raw_event.get("ok") is True}
    else:
        event = {"ok": False, "skipped": True, "reason": "context_pack_public_boundary_failure"}
    output = build_output(event)
    final_accepted = (
        accepted_context_pack
        and event.get("ok") is True
        and output.get("ok") is True
        and public_contract_fits(output)
    )
    if final_accepted:
        record_context_pack_quality_pending(
            args.project,
            public_session_id,
            public_agent_id,
            query,
            quality_state_receipt,
        )
    emit(output, args.pretty)
    return 0 if final_accepted else 1


def cmd_handoff(args: argparse.Namespace) -> int:
    configure_base_url(args)
    session_id = ensure_session_for_args(args, args.summary or "handoff")
    payload = {
        "schema_version": 1,
        "event": "adapter_handoff",
        "project": args.project,
        "session_id": session_id,
        "summary": args.summary or "universal agent adapter handoff",
        "objective": args.objective,
        "next_action": args.next_action,
    }
    payload = attach_task_binding(payload, args)
    env = os.environ.copy()
    env["CONTEXTLATTICE_SESSION_ID"] = session_id
    env["CONTEXTLATTICE_PROJECT"] = args.project
    proc = subprocess.run(
        [str(REPO_ROOT / "scripts" / "agent" / "compaction-handoff-payload"), "--summary"],
        input=json.dumps(payload),
        cwd=str(REPO_ROOT),
        env=env,
        check=False,
        capture_output=True,
        text=True,
        timeout=max(5.0, float(args.timeout)),
    )
    try:
        handoff = json.loads(proc.stdout) if proc.stdout.strip() else None
    except (json.JSONDecodeError, UnicodeError):
        handoff = None
    findings = []
    if proc.returncode != 0:
        findings.append({"reason": "handoff_payload_failed", "returncode": proc.returncode})
    handoff_valid = (
        isinstance(handoff, dict)
        and handoff.get("schema_version") == 1
        and handoff.get("event") == "context_compaction"
        and isinstance(handoff.get("summary"), str)
        and bool(handoff["summary"].strip())
        and isinstance(handoff.get("portable_prompt"), str)
        and bool(handoff["portable_prompt"].strip())
    )
    if not handoff_valid:
        findings.append({"reason": "handoff_payload_invalid"})
        handoff = {}
    if contains_provider_overflow(handoff):
        findings.append({"reason": "handoff_provider_overflow_phrase_leaked"})
    public_handoff = compact_adapter_handoff(handoff)
    preflight = adapter_response(
        command="handoff",
        ok=not findings,
        agent=args.agent,
        agent_id=args.agent_id,
        project=args.project,
        session_id=session_id,
        result={"handoff": public_handoff, "event": {"ok": True, "kind": "event"}},
        findings=findings,
    )
    if not adapter_output_accepted(preflight):
        emit(preflight, args.pretty)
        return 1
    event = request_json(
        "POST",
        "/v1/agents/sessions/event",
        {
            "session_id": session_id,
            "agent": args.agent,
            "agent_id": args.agent_id,
            "project": args.project,
            "type": "handoff.created",
            "summary": args.summary,
            "metadata": {
                "adapter": "contextlattice-agent-adapter",
                "handoff_ok": not findings,
                "task_binding": binding_metadata(args),
            },
        },
        args.timeout,
    )
    output = adapter_response(
        command="handoff",
        ok=not findings and event.get("ok") is True,
        agent=args.agent,
        agent_id=args.agent_id,
        project=args.project,
        session_id=session_id,
        result={
            "handoff": public_handoff,
            "event": compact_adapter_server_receipt(event, "event"),
        },
        findings=findings,
    )
    emit(output, args.pretty)
    return 0 if adapter_output_accepted(output) else 1


