)


def load_agent_config() -> dict[str, Any]:
    try:
        parsed = json.loads(AGENT_CONFIG_PATH.read_text(encoding="utf-8"))
    except Exception:
        return {}
    return parsed if isinstance(parsed, dict) else {}


def adapter_contract() -> dict[str, Any]:
    config = load_agent_config()
    contract = config.get("adapter_contract") if isinstance(config.get("adapter_contract"), dict) else {}
    if contract:
        return dict(contract)
    return {
        "schema_id": "contextlattice_universal_agent_adapter.v1",
        "version": "2026-06-05",
        "required_phases": ["preflight", "auto_session", "agent_state", "context_pack", "context_pack_outcome", "checkpoint", "handoff", "completion"],
        "required_exports": [
            "CONTEXTLATTICE_ORCHESTRATOR_URL",
            "MEMMCP_ORCHESTRATOR_URL",
            "CONTEXTLATTICE_AGENT",
            "CONTEXTLATTICE_AGENT_ID",
            "MEMMCP_AGENT_ID",
            "CONTEXTLATTICE_SESSION_ID",
        ],
        "task_binding_exports": [
            "CONTEXTLATTICE_TASK_ID",
            "CONTEXTLATTICE_ATTEMPT_ID",
            "CONTEXTLATTICE_LEASE_ID",
            "CONTEXTLATTICE_CONTEXT_SNAPSHOT_ID",
            "CONTEXTLATTICE_CONTEXT_PACK_HASH",
        ],
        "preflight_route": "/v1/agents/preflight",
        "event_route": "/v1/agents/sessions/event",
        "context_pack_route": "/memory/context-pack",
        "context_pack_outcome_route": "/telemetry/context-pack-quality/outcome",
        "checkpoint_route": "/memory/write",
        "handoff_helper": "scripts/agent/compaction-handoff-payload",
    }


def validation_status(payload: Any, key: str = "format_contract") -> str:
    if not isinstance(payload, dict):
        return ""
    contract = payload.get(key)
    if not isinstance(contract, dict):
        return ""
    validation = contract.get("validation")
    if not isinstance(validation, dict):
        return ""
    return str(validation.get("status") or "")


def registered_contract_attestation_valid(contract_id: str, payload: Any) -> bool:
    if not isinstance(payload, dict):
        return False
    registry = load_agent_contracts_registry()
    contracts = registry.get("contracts") if isinstance(registry.get("contracts"), dict) else {}
    contract = contracts.get(contract_id) if isinstance(contracts.get(contract_id), dict) else {}
    metadata = payload.get("format_contract") if isinstance(payload.get("format_contract"), dict) else {}
    validation = metadata.get("validation") if isinstance(metadata.get("validation"), dict) else {}
    errors = validation.get("errors")
    try:
        actual_json_bytes = len(agent_contract_go_json(payload))
    except (TypeError, ValueError, OverflowError, UnicodeEncodeError, RecursionError):
        return False

    def exact_integer(value: Any, expected: Any) -> bool:
        return (
            isinstance(value, int)
            and not isinstance(value, bool)
            and isinstance(expected, int)
            and not isinstance(expected, bool)
            and value == expected
        )

    return (
        not validate_agent_contract_payload(contract_id, payload, registry)
        and metadata.get("registry_id") == registry.get("registry_id")
        and exact_integer(metadata.get("registry_version"), registry.get("registry_version"))
        and metadata.get("schema_id") == contract_id
        and exact_integer(metadata.get("contract_version"), contract.get("contract_version"))
        and metadata.get("required_output_mode") == contract.get("required_output_mode")
        and metadata.get("validator") == "contextlattice.boundary.v1"
        and metadata.get("contract_valid") is True
        and exact_integer(metadata.get("max_total_json_bytes"), contract.get("max_total_json_bytes"))
        and exact_integer(metadata.get("max_string_bytes"), contract.get("max_string_bytes"))
        and exact_integer(metadata.get("max_list_items"), contract.get("max_list_items"))
        and exact_integer(metadata.get("actual_json_bytes"), actual_json_bytes)
        and validation.get("status") == "passed"
        and isinstance(errors, list)
        and not errors
    )


def configure_base_url(args: argparse.Namespace) -> None:
    base_url = str(getattr(args, "base_url", "") or "").strip().rstrip("/")
    if not base_url:
        return
    os.environ["CONTEXTLATTICE_ORCHESTRATOR_URL"] = base_url
    os.environ["MEMMCP_ORCHESTRATOR_URL"] = base_url


def contains_provider_overflow(payload: Any) -> bool:
    rendered = json.dumps(payload, sort_keys=True).lower()
    return any(pattern in rendered for pattern in PROVIDER_OVERFLOW_PATTERNS)


def resolve_profile(agent: str) -> tuple[str, dict[str, Any]]:
    profile_key, profile = _resolve_agent_preflight_profile(agent)
    return profile_key, dict(profile)


def profile_payload(args: argparse.Namespace) -> tuple[str, dict[str, Any], str, str, str, str]:
    profile_key, profile = resolve_profile(args.agent)
    agent_id = str(args.agent_id or profile.get("agent_id") or "").strip()
    topic_path = str(args.topic_path or profile.get("topic_path") or "").strip()
    query = str(args.query or args.objective or profile.get("query") or "").strip()
    mode = str(args.mode or profile.get("retrieval_mode") or "balanced").strip().lower() or "balanced"
    return profile_key, profile, agent_id, topic_path, query, mode


