#!/usr/bin/env python3
"""Smoke-test the default global agent install without dev Python tools."""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import tempfile
from pathlib import Path
from typing import Any

from _common import emit


REPO_ROOT = Path(__file__).resolve().parents[2]
INSTALLER = REPO_ROOT / "scripts" / "install_global_agent_tools.sh"
MANAGED_ENV_HEADER = "# Local-only ContextLattice hook policy. Not part of any repo."
DEFAULT_AGENTS = "codex,claude-code,opencode,hermes-agent,hermes-ultra,omp,mercury-agent,pi,droid"
REQUIRED_RUNTIME_FILES = [
    "scripts/agent/_common.py",
    "scripts/agent/audit-codex-session-store",
    "scripts/agent/compaction-handoff-payload",
    "scripts/agent/contextlattice-session",
    "scripts/agent_contracts.py",
    "scripts/agent_orchestration.py",
    "scripts/contextlattice_client.py",
]
OPTIONAL_DEV_WRAPPERS = [
    "contextlattice_agent_orchestration",
    "contextlattice_source_backfill",
    "contextlattice_codex_session_store_doctor",
]
EXPECTED_PROFILES = [
    "codex",
    "claude-code",
    "opencode",
    "hermes-agent",
    "hermes-ultra",
    "omp",
    "mercury-agent",
    "pi",
    "droid",
    "chatgpt-web",
    "chatgpt-desktop",
    "claude-web",
    "claude-desktop",
]
EXPECTED_INTEGRATION_FILES = ["AGENTS.md", "CLAUDE.md", "HERMES.md", "MERCURY.md", "PI.md", "DROID.md"]


def run(argv: list[str], timeout: float, env: dict[str, str] | None = None) -> dict[str, Any]:
    try:
        proc = subprocess.run(argv, check=False, capture_output=True, text=True, timeout=timeout, env=env)
    except Exception as exc:
        return {"ok": False, "argv": argv, "error": str(exc)}
    payload: dict[str, Any] | None = None
    if proc.stdout.strip().startswith("{"):
        try:
            parsed = json.loads(proc.stdout)
            if isinstance(parsed, dict):
                payload = parsed
        except json.JSONDecodeError:
            payload = None
    return {
        "ok": proc.returncode == 0,
        "argv": argv,
        "returncode": proc.returncode,
        "stdout": proc.stdout[-2000:],
        "stderr": proc.stderr[-2000:],
        "json": payload,
    }


def check(name: str, ok: bool, **extra: Any) -> dict[str, Any]:
    row = {"name": name, "ok": bool(ok)}
    row.update(extra)
    return row


def executable(path: Path) -> bool:
    return path.is_file() and os.access(path, os.X_OK)


def parse_json_file(path: Path) -> dict[str, Any]:
    try:
        parsed = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {}
    return parsed if isinstance(parsed, dict) else {}


def main() -> int:
    parser = argparse.ArgumentParser(description="Audit default ContextLattice global install smoke.")
    parser.add_argument("--global-home", default="", help="Use an existing temp/global home instead of creating one.")
    parser.add_argument("--timeout", type=float, default=120)
    parser.add_argument("--keep-temp", action="store_true")
    parser.add_argument("--pretty", action="store_true")
    args = parser.parse_args()

    created_temp = False
    if args.global_home:
        global_home = Path(args.global_home).expanduser().resolve()
        global_home.mkdir(parents=True, exist_ok=True)
    else:
        global_home = Path(tempfile.mkdtemp(prefix="contextlattice-global-install-smoke."))
        created_temp = True

    checks: list[dict[str, Any]] = []
    test_home = global_home / "home"
    (test_home / ".omp" / "agent").mkdir(parents=True, exist_ok=True)
    (test_home / ".mercury").mkdir(parents=True, exist_ok=True)
    env_file = global_home / "agent_hooks.env"
    env_file.parent.mkdir(parents=True, exist_ok=True)
    env_file.write_text(
        "\n".join(
            [
                MANAGED_ENV_HEADER,
                "export CONTEXTLATTICE_REPO_ROOT=/tmp/stale-contextlattice-root",
                MANAGED_ENV_HEADER,
                "export CONTEXTLATTICE_ORCHESTRATOR_URL=http://127.0.0.1:9999",
                "export CONTEXTLATTICE_EXTERNAL_DATA_ROOT=/tmp/contextlattice-external",
                "# custom operator note must survive",
                "export CONTEXTLATTICE_PUBLIC_FORBIDDEN_PATH_RE='(/tmp/private)'",
                "",
            ]
        ),
        encoding="utf-8",
    )

    install_env = os.environ.copy()
    install_env["HOME"] = str(test_home)
    install = run(
        [str(INSTALLER), "--global-home", str(global_home), "--no-shell-profile", "--skip-venv", "--quiet"],
        args.timeout,
        install_env,
    )
    checks.append(check("installer_exit", bool(install["ok"]), returncode=install.get("returncode"), stderr=install.get("stderr")))

    env_text = env_file.read_text(encoding="utf-8", errors="replace") if env_file.exists() else ""
    checks.extend(
        [
            check("hook_env_header_single", env_text.count(MANAGED_ENV_HEADER) == 1, count=env_text.count(MANAGED_ENV_HEADER)),
            check("hook_env_stale_root_removed", "/tmp/stale-contextlattice-root" not in env_text),
            check("hook_env_custom_line_preserved", "CONTEXTLATTICE_EXTERNAL_DATA_ROOT=/tmp/contextlattice-external" in env_text),
            check("hook_env_custom_comment_preserved", "custom operator note must survive" in env_text),
        ]
    )

    bin_dir = global_home / "bin"
    checks.append(check("go_tool_installed", executable(bin_dir / "contextlattice-agent-tools"), path=str(bin_dir / "contextlattice-agent-tools")))
    for rel in REQUIRED_RUNTIME_FILES:
        path = global_home / rel
        checks.append(check(f"hook_runtime:{rel}", path.is_file(), path=str(path)))
    for name in [
        "contextlattice_pre_compaction_write",
        "contextlattice_post_compaction_read",
        "contextlattice_adopt",
        "contextlattice_agent_adapter",
        "contextlattice_synthesis_pack",
        "contextlattice_synthesis_pack_v2",
        "contextlattice_retrieval_plan",
        "contextlattice_claim_write",
        "contextlattice_claim_query",
        "contextlattice_policy_candidate",
        "contextlattice_policy_evaluate",
        "contextlattice_policy_status",
        "contextlattice_skill_draft",
        "contextlattice_skill_evaluate",
        "contextlattice_skill_export",
        "contextlattice_skill_foundry_status",
        "contextlattice_passport_export",
        "contextlattice_passport_verify",
        "contextlattice_passport_diff",
        "contextlattice_passport_replay",
        "contextlattice_passport_import",
        "contextlattice_passport_status",
        "contextlattice_mesh_identity",
        "contextlattice_mesh_grant",
        "contextlattice_mesh_export",
        "contextlattice_mesh_import",
        "contextlattice_mesh_status",
    ]:
        path = bin_dir / name
        checks.append(check(f"wrapper:{name}", executable(path), path=str(path)))
    for name in OPTIONAL_DEV_WRAPPERS:
        path = bin_dir / name
        checks.append(check(f"dev_wrapper_absent:{name}", not path.exists(), path=str(path)))
    agent_hook_files = {
        "omp": test_home / ".omp" / "agent" / "AGENTS.md",
        "mercury-agent": test_home / ".mercury" / "soul.md",
    }
    for agent, path in agent_hook_files.items():
        text = path.read_text(encoding="utf-8", errors="replace") if path.exists() else ""
        checks.append(
            check(
                f"agent_instruction_hook:{agent}",
                f"contextlattice-agent-install:{agent}" in text,
                path=str(path),
            )
        )

    smoke_env = install_env.copy()
    smoke_env["CONTEXTLATTICE_GLOBAL_HOME"] = str(global_home)
    pre_env = smoke_env | {"CONTEXTLATTICE_PRECOMPACT_SCHEMA_SMOKE": "1"}
    post_env = smoke_env | {"CONTEXTLATTICE_POSTCOMPACT_SCHEMA_SMOKE": "1"}
    pre = run([str(bin_dir / "contextlattice_pre_compaction_write")], 20, pre_env)
    post = run([str(bin_dir / "contextlattice_post_compaction_read")], 20, post_env)
    checks.append(check("pre_compaction_schema_smoke", bool(pre.get("ok")) and pre.get("json", {}).get("continue") is True, output=pre.get("json"), stderr=pre.get("stderr")))
    checks.append(check("post_compaction_schema_smoke", bool(post.get("ok")) and post.get("json", {}).get("continue") is True, output=post.get("json"), stderr=post.get("stderr")))

    profiles = run([str(bin_dir / "contextlattice_agent_adapter"), "profiles", "--pretty"], 20, smoke_env)
    profile_names = []
    result = (profiles.get("json") or {}).get("result") if isinstance(profiles.get("json"), dict) else {}
    if isinstance(result, dict):
        profile_names = [str(item) for item in result.get("profile_names") or []]
    checks.append(check("adapter_profiles", bool(profiles.get("ok")) and set(EXPECTED_PROFILES).issubset(profile_names), profiles=profile_names, stderr=profiles.get("stderr")))

    repo_smoke = global_home / "repo-smoke"
    integrate = run(
        [
            str(bin_dir / "contextlattice_adopt"),
            "integrate",
            "--repo",
            str(repo_smoke),
            "--agents",
            DEFAULT_AGENTS,
            "--project",
            "smoke",
            "--pretty",
        ],
        20,
        smoke_env,
    )
    checks.append(check("integrate_exit", bool(integrate.get("ok")) and bool((integrate.get("json") or {}).get("ok")), payload=integrate.get("json"), stderr=integrate.get("stderr")))
    integrate_check = run(
        [
            str(bin_dir / "contextlattice_adopt"),
            "integrate",
            "--repo",
            str(repo_smoke),
            "--agents",
            DEFAULT_AGENTS,
            "--check",
            "--pretty",
        ],
        20,
        smoke_env,
    )
    checks.append(check("integrate_check", bool(integrate_check.get("ok")) and bool((integrate_check.get("json") or {}).get("ok")), payload=integrate_check.get("json"), stderr=integrate_check.get("stderr")))
    for file_name in EXPECTED_INTEGRATION_FILES:
        path = repo_smoke / file_name
        text = path.read_text(encoding="utf-8", errors="replace") if path.exists() else ""
        checks.append(check(f"integrated_file:{file_name}", "contextlattice-agent-integration" in text, path=str(path)))

    failed = [item for item in checks if not item.get("ok")]
    payload = {
        "ok": not failed,
        "schema_id": "contextlattice_agent_global_install_smoke.v1",
        "global_home": str(global_home),
        "created_temp": created_temp,
        "checks": checks,
        "failed": failed,
    }
    emit(payload, args.pretty)
    if created_temp and not args.keep_temp:
        shutil.rmtree(global_home, ignore_errors=True)
    return 0 if payload["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
