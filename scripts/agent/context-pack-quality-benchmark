SHA256_RE = "sha256:"


class RequestTransport(Protocol):
    def request(
        self, method: str, path: str, payload: Mapping[str, Any] | None, timeout_seconds: float
    ) -> "TransportResponse": ...


@dataclass(frozen=True)
class TransportResponse:
    status: int
    payload: dict[str, Any]
    latency_ms: float = 0.0
    error: str = ""


@dataclass(frozen=True)
class ArtifactLoad:
    payload: dict[str, Any]
    raw_bytes: bytes
    path: Path


def _canonical_json(value: Any) -> bytes:
    """Canonical JSON close to Go's encoding/json map ordering.

    v3 case fields are scalar/ASCII in production.  Escaping HTML characters
    keeps the digest compatible with Go's default encoder for those fields.
    """

    raw = json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False)
    return raw.replace("&", "\\u0026").replace("<", "\\u003c").replace(">", "\\u003e").encode("utf-8")


def digest(value: Any) -> str:
    return SHA256_RE + hashlib.sha256(_canonical_json(value)).hexdigest()


def bytes_digest(raw: bytes) -> str:
    return SHA256_RE + hashlib.sha256(raw).hexdigest()


def _is_hex40(value: Any) -> bool:
    text = str(value or "").strip().lower()
    return len(text) == 40 and all(character in "0123456789abcdef" for character in text)


def _is_nonempty_string(value: Any) -> bool:
    return isinstance(value, str) and bool(value.strip())


def _is_bool(value: Any) -> bool:
    return isinstance(value, bool)


def _is_int(value: Any) -> bool:
    return isinstance(value, int) and not isinstance(value, bool)


def _is_finite_number(value: Any) -> bool:
    return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(float(value))


def _as_map(value: Any) -> dict[str, Any]:
    return value if isinstance(value, dict) else {}


def _as_list(value: Any) -> list[Any]:
    return value if isinstance(value, list) else []


def _issue(issues: list[dict[str, Any]], code: str, detail: str, *, case_id: str = "") -> None:
    row = {"code": code, "detail": detail}
    if case_id:
        row["case_id"] = case_id
    issues.append(row)


def _normal_text(value: Any) -> str:
    return " ".join(str(value or "").strip().lower().replace("\\", "/").split())


def _file_tokens(value: Any) -> set[str]:
    text = _normal_text(value)
    return {token.strip("\t\r\n .,;:!?()[]{}'\"`") for token in text.split() if token.strip()}


def _query_contains_file(query: str, file_name: str) -> bool:
    tokens = _file_tokens(query)
    normalized = _normal_text(file_name).strip("/")
    base_name = normalized.rsplit("/", 1)[-1]
    return any(token in tokens for token in (normalized, base_name) if len(token) >= 3)


def _sha256_ref(value: Any) -> bool:
    return isinstance(value, str) and value.startswith(SHA256_RE) and len(value) == len(SHA256_RE) + 64 and all(
        char in "0123456789abcdefABCDEF" for char in value[len(SHA256_RE) :]
    )


def _case_is_graph(case: Mapping[str, Any]) -> bool:
    return str(case.get("case_kind") or "").strip().lower() == "graph_neighbor" or bool(
        _as_list(case.get("graph_expected_files")) or _as_list(case.get("graph_expected_substrings"))
    )


def _computed_split_counts(cases: Iterable[Mapping[str, Any]]) -> dict[str, int]:
    counts = {"train": 0, "holdout": 0}
    for case in cases:
        split = str(case.get("split") or "").strip().lower()
        if split in counts:
            counts[split] += 1
    return counts


def _metadata_digest(value: Any) -> str:
    return digest(value)


def configured_timeout_seconds(explicit: float | None = None) -> float:
    """Resolve the established client timeout without inventing a short kill window."""

    if explicit is not None:
        value = float(explicit)
        if not math.isfinite(value) or value <= 0:
            raise ValueError("timeout must be finite and positive")
        return value
    raw = os.getenv("CONTEXTLATTICE_CLIENT_TIMEOUT_SECS", "").strip()
    try:
        value = float(raw) if raw else DEFAULT_REQUEST_TIMEOUT_SECONDS
    except ValueError:
        value = DEFAULT_REQUEST_TIMEOUT_SECONDS
    if not math.isfinite(value) or value <= 0:
        return DEFAULT_REQUEST_TIMEOUT_SECONDS
    return value


def default_artifact_path() -> Path:
    override = os.getenv("ORCH_RECALL_EVAL_CASES_PATH", "").strip()
    if override:
        return Path(override).expanduser()
    primary = REPO_ROOT / DEFAULT_ARTIFACT
    if primary.exists():
        return primary
    return REPO_ROOT / FALLBACK_ARTIFACT


def validate_frozen_v3_artifact(payload: Mapping[str, Any], raw_bytes: bytes | None = None) -> dict[str, Any]:
    """Validate the complete saved-recall v3 custody contract.

    The returned holdout list is the only case collection accepted by the
    executor.  Validation deliberately rejects an artifact that contains only
    a cherry-picked holdout, even when its local denominator is self-consistent.
    """

    data = dict(payload) if isinstance(payload, Mapping) else {}
    issues: list[dict[str, Any]] = []
    schema_id = data.get("schema_id")
    version = data.get("version")
    if schema_id != SAVED_RECALL_SCHEMA_ID or version != 3:
        _issue(issues, "schema_version_mismatch", "artifact is not saved_recall_eval_case_set.v3 version 3")

    if "synthetic" not in data or not _is_bool(data.get("synthetic")):
        _issue(issues, "synthetic_flag_missing", "artifact must explicitly declare synthetic=false")
    elif data.get("synthetic"):
        _issue(issues, "synthetic_case_set", "synthetic or built-in cases are not promotion evidence")

    cases = _as_list(data.get("cases"))
    if not cases:
        _issue(issues, "empty_case_set", "saved v3 artifact contains no cases")
    elif any(not isinstance(case, dict) for case in cases):
        _issue(issues, "malformed_case", "every saved v3 case must be an object")

    case_maps = [case for case in cases if isinstance(case, dict)]
    holdout = [case for case in case_maps if str(case.get("split") or "").strip().lower() == "holdout"]
    train = [case for case in case_maps if str(case.get("split") or "").strip().lower() == "train"]
    if not train or not holdout:
        _issue(issues, "incomplete_split_set", "complete v3 artifact must contain both train and holdout cases")

    split_counts = data.get("split_counts")
    computed_counts = _computed_split_counts(case_maps)
    if not isinstance(split_counts, dict):
        _issue(issues, "missing_split_denominator", "split_counts is required for exact holdout reconciliation")
    else:
        observed_counts = {key: split_counts.get(key) for key in ("train", "holdout")}
        if observed_counts != computed_counts:
            _issue(issues, "split_count_mismatch", "split_counts does not match the complete case list")
        if not _is_int(split_counts.get("holdout")) or int(split_counts.get("holdout")) != len(holdout):
            _issue(issues, "missing_holdout_denominator", "holdout denominator does not match the frozen artifact")

    source = str(data.get("source") or "").strip().lower()
    if not source:
        _issue(issues, "missing_source_provenance", "artifact source provenance is required")
    elif "fallback" in source or "synthetic" in source:
        _issue(issues, "fallback_source", "fallback or synthetic source is not promotion evidence")
    elif source not in FROZEN_INDEX_SOURCES:
        _issue(issues, "unsupported_index_source", "promotion requires a closed current-state indexed source")

    def validate_source_stats(label: str, stats: Mapping[str, Any]) -> None:
        if not stats:
            _issue(issues, f"missing_{label}_source_stats", f"{label} source_stats are required for custody")
            return
        if stats.get("index_mode") != source:
            _issue(issues, f"{label}_source_stats_mode_mismatch", f"{label} source_stats index_mode does not match source")
        if stats.get("bounded") is not True:
            _issue(issues, f"{label}_source_not_bounded", f"{label} source_stats bounded must be true")
        if stats.get("index_integrity") is not True:
            _issue(issues, f"{label}_source_index_integrity_invalid", f"{label} source_stats index_integrity must be true")
        if stats.get("context_cancelled") is not False:
            _issue(issues, f"{label}_source_context_cancelled", f"{label} source_stats context_cancelled must be false")

    validate_source_stats("artifact", _as_map(data.get("source_stats")))

    case_set_digest = data.get("case_set_digest")
    if not _sha256_ref(case_set_digest):
        _issue(issues, "missing_case_set_digest", "frozen case_set_digest is required")
    elif case_set_digest.lower() != digest(case_maps).lower():
        _issue(issues, "case_set_digest_mismatch", "case_set_digest does not match the persisted cases")

    snapshot = _as_map(data.get("snapshot"))
    if not snapshot:
        _issue(issues, "missing_snapshot_metadata", "frozen source snapshot metadata is required")
    else:
        if snapshot.get("schema_id") != SAVED_RECALL_SNAPSHOT_SCHEMA_ID:
            _issue(issues, "snapshot_schema_mismatch", "snapshot schema is not saved_recall_eval_snapshot.v1")
        snapshot_source = str(snapshot.get("source") or "").strip().lower()
        if not snapshot_source:
            _issue(issues, "missing_snapshot_source", "snapshot source provenance is required")
        elif snapshot_source != source:
            _issue(issues, "snapshot_source_mismatch", "top-level source does not match snapshot source")
        validate_source_stats("snapshot", _as_map(snapshot.get("source_stats")))
        if not _sha256_ref(snapshot.get("digest")):
            _issue(issues, "missing_snapshot_digest", "snapshot digest is required")
        if not _is_int(snapshot.get("selected_case_count")) or int(snapshot.get("selected_case_count")) != len(case_maps):
            _issue(issues, "snapshot_case_count_mismatch", "snapshot selected_case_count does not match complete cases")
        population = _as_map(snapshot.get("population"))
        sample = _as_map(snapshot.get("sample"))
        if not _is_int(population.get("count")) or int(population.get("count")) <= 0:
            _issue(issues, "missing_population_denominator", "snapshot population.count is required")
        if not _is_int(sample.get("count")) or int(sample.get("count")) != len(case_maps):
            _issue(issues, "snapshot_sample_count_mismatch", "snapshot sample.count does not match complete cases")
        diversity = _as_map(snapshot.get("diversity"))
        if diversity.get("valid") is not True:
            _issue(issues, "insufficient_diversity", "frozen snapshot diversity.valid must be true")

    custody = _as_map(data.get("custody"))
    if not custody:
        _issue(issues, "missing_custody", "frozen live-index custody metadata is required")
    else:
        if custody.get("schema_id") != SAVED_RECALL_CUSTODY_SCHEMA_ID:
            _issue(issues, "custody_schema_mismatch", "custody schema is not saved_recall_eval_custody.v1")
        if custody.get("owner") != "gateway-go" or custody.get("mode") != "frozen_live_index":
            _issue(issues, "custody_owner_mismatch", "custody must be owned by gateway-go frozen_live_index")
        if custody.get("synthetic") is not False:
            _issue(issues, "synthetic_custody", "custody must explicitly declare synthetic=false")
        contamination = str(custody.get("contamination_state") or "").strip().lower()
        if "contamin" in contamination or contamination in {"invalid", "synthetic", "local_regression"}:
            _issue(issues, "contaminated_custody", "contaminated custody cannot support promotion")
        if custody.get("promotional_claims_allowed") is False:
            _issue(issues, "promotional_claims_disallowed", "custody explicitly disallows promotional claims")
        validate_source_stats("custody", _as_map(custody.get("source_stats")))
        if not _sha256_ref(custody.get("source_snapshot_digest")) or custody.get("source_snapshot_digest") != snapshot.get("digest"):
            _issue(issues, "custody_snapshot_mismatch", "custody source snapshot digest does not match snapshot")
        if not _sha256_ref(custody.get("case_set_digest")) or custody.get("case_set_digest") != case_set_digest:
            _issue(issues, "custody_case_set_mismatch", "custody case-set digest does not match artifact")
        if not _is_int(custody.get("population_count")) or int(custody.get("population_count")) < len(case_maps):
            _issue(issues, "invalid_population_denominator", "custody population_count is absent or below sample count")
        elif _is_int(_as_map(snapshot.get("population")).get("count")) and int(custody.get("population_count")) != int(_as_map(snapshot.get("population")).get("count")):
            _issue(issues, "population_denominator_mismatch", "custody and snapshot population counts differ")
        if not _is_int(custody.get("sample_count")) or int(custody.get("sample_count")) != len(case_maps):
            _issue(issues, "custody_sample_count_mismatch", "custody sample_count does not match complete cases")
        if custody.get("diversity_valid") is not True:
            _issue(issues, "custody_diversity_invalid", "custody diversity_valid must be true")
        if "filename_removed" not in str(custody.get("oracle_leakage") or ""):
            _issue(issues, "oracle_leakage_unproven", "custody does not prove filename-redacted oracle separation")

    ids: set[str] = set()
    direct_files: set[str] = set()
    direct_queries: set[str] = set()
    for index, case in enumerate(case_maps):
        case_id = str(case.get("id") or "").strip()
        if not case_id:
            _issue(issues, "missing_case_id", f"case {index} has no stable id")
        elif case_id.lower() in ids:
            _issue(issues, "duplicate_case_id", "case id is duplicated", case_id=case_id)
        else:
            ids.add(case_id.lower())
        query = str(case.get("query") or "").strip()
        project = str(case.get("project") or "").strip()
        topic = str(case.get("topic_path") or "").strip().strip("/")
        expected = [str(item).strip().strip("/") for item in _as_list(case.get("expected_files")) if str(item).strip()]
        split = str(case.get("split") or "").strip().lower()
        if not query:
            _issue(issues, "missing_query", "case query is empty", case_id=case_id)
        if not project:
            _issue(issues, "missing_project", "case project is empty", case_id=case_id)
        if not topic or topic in {"root", "."}:
            _issue(issues, "invalid_topic", "case topic_path must be concrete", case_id=case_id)
        if not _is_int(case.get("limit")) or not 1 <= int(case.get("limit")) <= 100:
            _issue(issues, "invalid_limit", "case limit must be an integer in [1,100]", case_id=case_id)
        if len(expected) != 1:
            _issue(issues, "expected_file_denominator", "each direct case must name exactly one expected file", case_id=case_id)
        if split not in {"train", "holdout"}:
            _issue(issues, "invalid_split", "case split must be train or holdout", case_id=case_id)
        if split == "holdout" and not str(case.get("source_updated_at") or "").strip():
            _issue(issues, "holdout_missing_timestamp", "holdout case has no source_updated_at", case_id=case_id)
        case_provenance = " ".join(
            str(case.get(field) or "").strip().lower()
            for field in ("source", "source_kind", "fixture", "fixture_kind", "traffic_class")
        )
        if any(marker in case_provenance for marker in ("synthetic", "built-in", "fallback")):
            _issue(issues, "synthetic_case_marker", "case provenance is synthetic or fallback", case_id=case_id)
        if expected and _query_contains_file(query, expected[0]):
            _issue(issues, "query_contains_expected_file", "query leaks its expected filename", case_id=case_id)
        if not _case_is_graph(case) and len(expected) == 1:
            file_key = f"{project.lower()}\x00{expected[0].lower()}"
            query_key = f"{project.lower()}\x00{' '.join(query.lower().split())}"
            if file_key in direct_files:
                _issue(issues, "duplicate_expected_file", "direct expected file is reused", case_id=case_id)
            else:
                direct_files.add(file_key)
            if query_key in direct_queries:
                _issue(issues, "duplicate_query", "direct query is reused", case_id=case_id)
            else:
                direct_queries.add(query_key)

    snapshot_digest = snapshot.get("digest")
    digests = {
        "dataset_digest": bytes_digest(raw_bytes) if raw_bytes is not None else None,
        "case_set_digest": case_set_digest,
        "snapshot_digest": snapshot_digest,
        "custody_metadata_digest": _metadata_digest(custody) if custody else None,
        "holdout_case_ids_digest": digest([str(case.get("id") or "") for case in holdout]),
        "holdout_cases_digest": digest(holdout),
    }
    valid = not issues and bool(holdout)
    return {
        "valid": valid,
        "status": "valid" if valid else "rejected",
        "issues": issues,
        "case_count": len(case_maps),
        "train_count": len(train),
        "holdout_count": len(holdout),
        "split_counts": computed_counts,
        "cases": case_maps,
        "holdout_cases": holdout,
        "snapshot": snapshot,
        "custody": custody,
        "digests": digests,
    }


def load_artifact(path: Path) -> ArtifactLoad:
    resolved = path.expanduser().resolve()
    raw = resolved.read_bytes()
    parsed = json.loads(raw.decode("utf-8"))
    if not isinstance(parsed, dict):
        raise ValueError("frozen v3 artifact must contain a JSON object")
    return ArtifactLoad(payload=parsed, raw_bytes=raw, path=resolved)


def build_context_pack_request(case: Mapping[str, Any]) -> dict[str, Any]:
    request: dict[str, Any] = {
        "query": str(case.get("query") or "").strip(),
        "project": str(case.get("project") or "").strip(),
        "topic_path": str(case.get("topic_path") or "").strip(),
        "limit": int(case.get("limit", 10)),
        "include_grounding": True,
        "include_retrieval_debug": False,
        "traffic_class": "benchmark",
    }
    for field in ("retrieval_mode", "retrieval_intent", "agent_id", "session_id", "query_expansion"):
        if field in case:
            request[field] = case[field]
    return request


def _get_path(mapping: Mapping[str, Any], paths: Iterable[tuple[str, ...]]) -> tuple[Any, str]:
    for path in paths:
        current: Any = mapping
        for key in path:
            if not isinstance(current, Mapping) or key not in current:
                break
            current = current[key]
        else:
            return current, ".".join(path)
    return None, ""


def _telemetry_value(response: Mapping[str, Any], paths: Iterable[tuple[str, ...]]) -> dict[str, Any]:
    value, path = _get_path(response, paths)
    if value is None:
        return {"available": False, "value": None, "field": ""}
    if not _is_finite_number(value):
        return {"available": False, "value": None, "field": path, "error": "non_numeric"}
    return {"available": True, "value": float(value), "field": path}


def _cost_and_tools(response: Mapping[str, Any]) -> dict[str, Any]:
    return {
        "cost": _telemetry_value(
            response,
            (
                ("cost_microusd",),
                ("provider_cost_micros",),
                ("total_cost_micros",),
                ("economics", "cost_microusd"),
                ("economics", "provider_cost_micros"),
                ("cost", "microusd"),
            ),
        ),
        "tool_calls": _telemetry_value(
            response,
            (("tool_calls",), ("tool_call_count",), ("economics", "tool_calls"), ("cost", "tool_calls")),
        ),
    }


