def as_list(value: Any) -> list[Any]:
    return value if isinstance(value, list) else []


def as_dict(value: Any) -> dict[str, Any]:
    return value if isinstance(value, dict) else {}


def first_dict(*values: Any) -> dict[str, Any]:
    for value in values:
        row = as_dict(value)
        if row:
            return row
    return {}


def first_list(*values: Any) -> list[Any]:
    for value in values:
        items = as_list(value)
        if items:
            return items
    return []


def encoded_len(value: Any) -> int:
    return len((json.dumps(value) + "\n").encode("utf-8"))


def compact_items(value: Any, limit: int) -> list[Any]:
    out = []
    for item in as_list(value)[:limit]:
        if isinstance(item, dict):
            compact = {}
            for key in (
                "text",
                "file",
                "source",
                "topic_path",
                "project",
                "score",
                "impact_score",
                "value_density",
                "estimated_tokens",
                "confidence",
                "rank",
                "kind",
                "reason",
                "why_selected",
                "omitted_reason",
                "summary",
                "timestamp",
                "memory_id",
                "relation",
                "edge_direction",
                "seed_memory_id",
            ):
                if key in item and item[key] not in ("", None):
                    compact[key] = item[key]
            out.append(compact or item)
        else:
            out.append(item)
    return out


def slim_source_coverage(value: Any) -> dict[str, Any]:
    coverage = value if isinstance(value, dict) else {}
    return {
        "configured": as_list(coverage.get("configured"))[:8],
        "returned": as_list(coverage.get("returned"))[:8],
        "pending": as_list(coverage.get("pending"))[:8],
        "warming": as_list(coverage.get("warming"))[:8],
        "failed": as_list(coverage.get("failed"))[:4],
        "timed_out": as_list(coverage.get("timed_out"))[:4],
        "budget_exceeded": as_list(coverage.get("budget_exceeded"))[:4],
        "complete": bool(coverage.get("complete")),
        "retrieval_lifecycle": coverage.get("retrieval_lifecycle") if isinstance(coverage.get("retrieval_lifecycle"), dict) else {},
    }


