#!/usr/bin/env python3
"""Fetch a budgeted task context pack from ContextLattice."""

from __future__ import annotations

import argparse
import json
from typing import Any

from _common import emit, request_json


CAMEL_TO_SNAKE = {
    "relevantDecisions": "relevant_decisions",
    "filesToRead": "files_to_read",
    "filesToAvoid": "files_to_avoid",
    "capabilitiesToUse": "capabilities_to_use",
    "runbooks": "runbooks",
    "knownFailureModes": "known_failure_modes",
    "commands": "commands",
    "acceptanceCriteria": "acceptance_criteria",
}


def as_list(value: Any) -> list[Any]:
    return value if isinstance(value, list) else []


def compact_items(value: Any, limit: int) -> list[Any]:
    out = []
    for item in as_list(value)[:limit]:
        if isinstance(item, dict):
            compact = {}
            for key in ("text", "file", "source", "topic_path", "project", "score", "summary", "timestamp"):
                if key in item and item[key] not in ("", None):
                    compact[key] = item[key]
            out.append(compact or item)
        else:
            out.append(item)
    return out


def compact_context_pack(raw: dict[str, Any], query: str, budget_chars: int) -> dict[str, Any]:
    pack = raw.get("context_pack") if isinstance(raw.get("context_pack"), dict) else {}
    source_coverage = raw.get("source_coverage") or pack.get("sourceCoverage") or {}
    facts = compact_items(pack.get("facts"), 8)
    numeric_facts = compact_items(pack.get("numericFacts"), 8)
    results = compact_items(pack.get("results"), 10)
    context_pack: dict[str, Any] = {
        "query": pack.get("query") or raw.get("query") or query,
        "retrieval_mode": raw.get("retrieval_mode") or pack.get("retrievalMode"),
        "retrieval_intent": raw.get("retrieval_intent") or pack.get("retrievalIntent"),
        "source_coverage": source_coverage,
        "facts": facts,
        "numeric_facts": numeric_facts,
        "citations": compact_items(pack.get("citations"), 12),
        "results": results,
    }
    for camel, snake in CAMEL_TO_SNAKE.items():
        context_pack[snake] = compact_items(pack.get(camel), 12)
    payload = {
        "ok": True,
        "task_summary": query[:240],
        "context_budget_chars": budget_chars,
        "clipped": False,
        "fact_count": len(as_list(pack.get("facts"))),
        "result_count": len(as_list(pack.get("results"))),
        "source_coverage": source_coverage,
        "warnings": as_list(raw.get("warnings"))[:10],
        "context_pack": context_pack,
        "writeback_required": True,
    }
    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":"))
    if len(encoded) <= budget_chars:
        return payload
    payload["clipped"] = True
    context_pack["facts"] = facts[:4]
    context_pack["numeric_facts"] = numeric_facts[:4]
    context_pack["citations"] = context_pack["citations"][:6]
    context_pack["results"] = results[:5]
    for snake in CAMEL_TO_SNAKE.values():
        context_pack[snake] = context_pack[snake][:6]
    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":"))
    if len(encoded) > budget_chars:
        context_pack["results"] = []
        context_pack["citations"] = []
        context_pack["facts"] = context_pack["facts"][:2]
        context_pack["numeric_facts"] = context_pack["numeric_facts"][:2]
    return payload


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("query")
    parser.add_argument("--project", default="contextlattice")
    parser.add_argument("--topic-path", default="")
    parser.add_argument("--mode", default="balanced")
    parser.add_argument("--budget-chars", type=int, default=10000)
    parser.add_argument("--limit", type=int, default=12)
    parser.add_argument("--max-facts", type=int, default=24)
    parser.add_argument("--nonblocking", action="store_true", help="Do not wait for slow sources in /memory/context-pack.")
    parser.add_argument("--strict", action="store_true", help="Exit non-zero when ContextLattice is unavailable.")
    parser.add_argument("--timeout", type=float, default=30)
    parser.add_argument("--pretty", action="store_true")
    args = parser.parse_args()

    payload = {
        "query": args.query,
        "project": args.project,
        "projectName": args.project,
        "topic_path": args.topic_path or None,
        "topicPath": args.topic_path or None,
        "retrieval_mode": args.mode,
        "include_grounding": True,
        "include_retrieval_debug": True,
        "combined_sources": not args.nonblocking,
        "wait_for_slow_sources": not args.nonblocking,
        "sync_slow_sources": not args.nonblocking,
        "limit": args.limit,
        "max_facts": args.max_facts,
    }
    try:
        raw = request_json("POST", "/memory/context-pack", payload, args.timeout)
    except SystemExit as exc:
        emit(
            {
                "ok": False,
                "task_summary": args.query[:240],
                "context_budget_chars": args.budget_chars,
                "degraded": True,
                "error": str(exc.code)[:1000],
                "context_pack": {
                    "query": args.query,
                    "facts": [],
                    "results": [],
                    "source_coverage": {"configured": [], "returned": [], "complete": False},
                },
                "writeback_required": True,
            },
            args.pretty,
        )
        return 1 if args.strict else 0
    except Exception as exc:
        emit(
            {
                "ok": False,
                "task_summary": args.query[:240],
                "context_budget_chars": args.budget_chars,
                "degraded": True,
                "error": str(exc)[:1000],
                "context_pack": {
                    "query": args.query,
                    "facts": [],
                    "results": [],
                    "source_coverage": {"configured": [], "returned": [], "complete": False},
                },
                "writeback_required": True,
            },
            args.pretty,
        )
        return 1 if args.strict else 0
    emit(compact_context_pack(raw, args.query, args.budget_chars), args.pretty)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
