    if omitted_high_value_refs:
        payload["omitted_high_value_refs"] = omitted_high_value_refs
        context_pack["omitted_high_value_refs"] = omitted_high_value_refs
    payload = attach_context_pack_contract(payload)
    if context_pack_output_fits(payload, budget_chars):
        return payload

    payload["clipped"] = True
