def finalize_context_pack_payload(payload: dict[str, Any], budget_chars: int) -> dict[str, Any]:
    requested_budget_chars, budget_rejected = normalized_context_budget_chars(budget_chars)
    if budget_rejected:
        payload = {
            "ok": False,
            "structured_failure": True,
            "status": "invalid_context_budget",
            "warnings": ["Requested context budget was outside the supported signed-integer range."],
        }
    budget_chars = max(MIN_CONTEXT_PACK_CONTRACT_BUDGET_CHARS, requested_budget_chars)
    payload["context_budget_chars"] = budget_chars
    payload["requested_context_budget_chars"] = requested_budget_chars
    payload["budget_floor_applied"] = requested_budget_chars < MIN_CONTEXT_PACK_CONTRACT_BUDGET_CHARS
    prior_omitted_identity_fields = {
        str(item) for item in as_list(payload.get("identity_omitted")) if str(item or "")
    }
    omitted_identity_fields: list[str] = []
    for field in ("session_id", "agent_id"):
        identity, omitted = bounded_identity(payload.get(field), field)
        if identity:
            payload[field] = identity
        else:
            payload.pop(field, None)
        if omitted or (not identity and field in prior_omitted_identity_fields):
            omitted_identity_fields.append(field)
    if omitted_identity_fields:
        payload["identity_omitted"] = omitted_identity_fields
    else:
        payload.pop("identity_omitted", None)
    context_pack = payload.get("context_pack") if isinstance(payload.get("context_pack"), dict) else {}
    token_budget = compact_token_budget(first_dict(payload.get("token_budget"), context_pack.get("token_budget"), context_pack.get("tokenBudget")))
    omitted_high_value_refs = compact_items(
        first_list(
            payload.get("omitted_high_value_refs"),
            context_pack.get("omitted_high_value_refs"),
            context_pack.get("omittedHighValueRefs"),
        ),
        8,
    )
    ranked_evidence = compact_items(
        first_list(context_pack.get("ranked_evidence"), context_pack.get("rankedEvidence")),
        4,
    )
    compiler_proofs = first_dict(payload.get("context_compiler"), context_pack.get("context_compiler"))
    memory_trust_assessment, retrieval_decision_trace = select_retrieval_proof_pair(
        payload,
        context_pack,
        compiler_proofs,
