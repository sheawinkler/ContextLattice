def delegate_recall_response(argv: list[str]) -> None:
    """Keep the compatibility pack surface on the owned Go-native path."""

    delegate = Path(__file__).with_name("contextlattice-recall-response")
    if not delegate.is_file():
        raise SystemExit("contextlattice-pack --response requires contextlattice-recall-response")
    delegated_args = [arg for arg in argv if arg != "--response" and not arg.startswith("--response=")]
    os.execv(sys.executable, [sys.executable, str(delegate), *delegated_args])


def as_list(value: Any) -> list[Any]:
    return value if isinstance(value, list) else []


def as_dict(value: Any) -> dict[str, Any]:
    return value if isinstance(value, dict) else {}


def first_dict(*values: Any) -> dict[str, Any]:
    for value in values:
        row = as_dict(value)
        if row:
            return row
    return {}


def first_list(*values: Any) -> list[Any]:
    for value in values:
        items = as_list(value)
        if items:
            return items
    return []


def encoded_len(value: Any) -> int:
    return len((json.dumps(value) + "\n").encode("utf-8"))


def emitted_len(value: Any, *, pretty: bool = False) -> int:
    safe = redact_public_value(value)
    if not agent_contract_json_domain_valid(safe):
        raise ValueError("public output is outside the JSON contract domain")
    return len(
        (
            json.dumps(safe, allow_nan=False, indent=2 if pretty else None, sort_keys=pretty)
            + "\n"
        ).encode("utf-8")
    )


def stabilize_public_contract_accounting(value: Any) -> None:
    if not isinstance(value, dict):
        return
    contract = value.get("format_contract")
    if not isinstance(contract, dict):
        return
    for _ in range(8):
        safe = redact_public_value(value)
        canonical_bytes = len(
            json.dumps(safe, sort_keys=True, separators=(",", ":")).encode("utf-8")
        )
        if contract.get("actual_json_bytes") == canonical_bytes:
            return
        contract["actual_json_bytes"] = canonical_bytes


def public_attached_contract(contract_id: str, value: Any) -> dict[str, Any]:
    projected = redact_public_value(value)
    if not isinstance(projected, dict):
        projected = {}
    projected = attach_format_contract(contract_id, projected)
    projected = redact_public_value(projected)
    if not isinstance(projected, dict):
        return {}
    projected = restamp_nested_public_contracts(projected, root=True)
    stabilize_public_contract_accounting(projected)
    return projected


def public_run_advisor(value: Any) -> dict[str, Any]:
    return public_attached_contract("run_advisor.v1", slim_run_advisor(value))


def public_route(field: str, value: Any) -> str:
    """Return an exact public product route or omit the untrusted value."""

    if not isinstance(value, str):
        return ""
    projected = redact_public_value({field: value})
    if isinstance(projected, dict) and projected.get(field) == value:
        return value
    return ""


def attach_context_pack_contract(payload: dict[str, Any]) -> dict[str, Any]:
    pack = payload.get("context_pack") if isinstance(payload.get("context_pack"), dict) else {}
    reconcile_context_pack_token_budget(payload)
    advisor = public_run_advisor(payload.get("run_advisor") or pack.get("run_advisor"))
    payload["run_advisor"] = advisor
    if pack and "run_advisor" in pack:
        pack["run_advisor"] = advisor
        payload["context_pack"] = pack
    projected = redact_public_value(payload)
    if not isinstance(projected, dict):
        projected = {"ok": False}
    payload = restamp_nested_public_contracts(projected, root=True)
    return attach_format_contract("context_pack_response.v1", payload)


def restamp_nested_public_contracts(value: Any, *, root: bool = False) -> Any:
    """Refresh nested public contracts or remove metadata invalidated by projection."""

    if isinstance(value, list):
        return [restamp_nested_public_contracts(item) for item in value]
    if not isinstance(value, dict):
        return value
    result = {key: restamp_nested_public_contracts(item) for key, item in value.items()}
    if root:
        return result
    format_contract = result.get("format_contract")
    contract_id = str(format_contract.get("schema_id") or "") if isinstance(format_contract, dict) else ""
    if contract_id not in {
        "agent_preflight_response.v1",
        "objective_runtime_state.v1",
        "policy_context_package.v1",
        "run_advisor.v1",
    }:
        return result
    stamped = public_attached_contract(contract_id, result)
    contract = stamped.get("format_contract")
    if (
        isinstance(contract, dict)
        and contract.get("contract_valid") is True
        and not validate_agent_contract_payload(contract_id, stamped)
    ):
        return stamped
    result.pop("format_contract", None)
    return result


def context_pack_output_fits(value: Any, budget_chars: int, *, pretty: bool = False) -> bool:
    if not isinstance(value, dict):
        return False
    stabilize_public_contract_accounting(value)
    contract = value.get("format_contract")
    try:
        actual_bytes = int(contract.get("actual_json_bytes") or 0) if isinstance(contract, dict) else 0
        maximum_bytes = int(contract.get("max_total_json_bytes") or 0) if isinstance(contract, dict) else 0
    except (TypeError, ValueError, OverflowError):
        return False
    try:
        public_value = redact_public_value(value)
        public_domain_valid = agent_contract_json_domain_valid(public_value)
        public_contract_valid = (
            isinstance(public_value, dict)
            and not validate_agent_contract_payload("context_pack_response.v1", public_value)
        )
        wire_bytes = emitted_len(value, pretty=pretty) if public_domain_valid else budget_chars + 1
    except (TypeError, ValueError, OverflowError, UnicodeEncodeError, RecursionError):
        return False
    return (
        isinstance(contract, dict)
        and contract.get("contract_valid") is True
        and 0 < actual_bytes <= maximum_bytes
        and public_domain_valid
        and public_contract_valid
        and wire_bytes <= budget_chars
    )


def nonnegative_int(value: Any) -> int:
    return bounded_nonnegative_int(value)[0]


def normalized_context_budget_chars(value: Any) -> tuple[int, bool]:
    """Return a JSON-domain-safe requested budget and whether it was rejected."""

    if isinstance(value, bool):
        return 1, True
    try:
        requested = int(value or 0)
    except (TypeError, ValueError, OverflowError):
        return 1, True
    if requested > MAX_CONTEXT_PACK_REQUEST_BUDGET_CHARS:
        return 1, True
    return max(1, requested), False


def bounded_nonnegative_int(value: Any) -> tuple[int, bool]:
    if value in (None, ""):
        return 0, False
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return 0, True
    if isinstance(value, float) and (not math.isfinite(value) or not value.is_integer()):
        return 0, True
    try:
        parsed = int(value)
    except (TypeError, ValueError, OverflowError):
        return 0, value not in (None, "")
    if parsed < 0 or parsed > MAX_CONTEXT_PACK_COUNT:
        return 0, True
    return parsed, False


def proof_exceeds_context_contract_list_limit(value: Any) -> bool:
    if isinstance(value, dict):
        return any(proof_exceeds_context_contract_list_limit(item) for item in value.values())
    if isinstance(value, list):
        return len(value) > MAX_CONTEXT_PACK_CONTRACT_LIST_ITEMS or any(
            proof_exceeds_context_contract_list_limit(item) for item in value
        )
    return False


def proof_contains_outer_boundary_mutable_text(value: Any) -> bool:
    if isinstance(value, dict):
        return any(proof_contains_outer_boundary_mutable_text(item) for item in value.values())
    if isinstance(value, list):
        return any(proof_contains_outer_boundary_mutable_text(item) for item in value)
    if isinstance(value, str):
        lowered = value.lower()
        return len(value.encode("utf-8")) > 6000 or any(pattern in lowered for pattern in PROVIDER_OVERFLOW_PATTERNS)
    return False


def bounded_retrieval_proof(value: Any, kind: str, max_bytes: int = 1800) -> dict[str, Any]:
    proof = dict(value) if isinstance(value, dict) else {}
    if not proof:
        return {}
    if kind == "memory_trust_assessment":
        count_fields = (
            "assessed_count",
            "quarantine_count",
            "deduplicated_count",
            "policy_omitted_count",
            "input_truncated_count",
        )
        compact = {
            "schema_id": "memory_trust_assessment.v1",
            "canonical_path": "$.memory_trust_assessment",
        }
    else:
        count_fields = ("candidate_count", "decision_count", "input_truncated_count")
        trace_id, trace_id_omitted = public_trace_identity(proof.get("trace_id"))
        compact = {
            "schema_id": "retrieval_decision_trace.v1",
            "canonical_path": "$.retrieval_decision_trace",
            "trace_id": trace_id,
            "coverage_complete": bool(proof.get("coverage_complete")),
        }
        if trace_id_omitted:
            compact["trace_id_omitted"] = True
    count_fields_omitted: list[str] = []
    for field in count_fields:
        compact[field], omitted = bounded_nonnegative_int(proof.get(field))
        if omitted:
            count_fields_omitted.append(field)
    if count_fields_omitted:
        compact["count_fields_omitted"] = count_fields_omitted
    existing_digest = str(proof.get("canonical_digest") or "")
    existing_bounded = (
        proof.get("bounded_projection") is True
        and len(existing_digest) == 71
        and existing_digest.startswith("sha256:")
        and existing_digest == existing_digest.lower()
    )
    if existing_bounded:
        try:
            int(existing_digest[7:], 16)
        except ValueError:
            existing_bounded = False
    if existing_bounded:
        compact.update(
            {
                "available": bool(proof.get("available", True)),
                "bounded_projection": True,
                "canonical_digest": existing_digest,
            }
        )
        if proof.get("trace_id_omitted") is True:
            compact["trace_id_omitted"] = True
        if proof.get("count_fields_omitted"):
            compact["count_fields_omitted"] = bounded_text_list(proof.get("count_fields_omitted"), len(count_fields), 40)
        return compact
    proof_list_exceeds_context_contract = proof_exceeds_context_contract_list_limit(proof)
    proof_changes_at_public_boundary = redact_public_value(proof) != proof
    proof_changes_at_outer_context_boundary = proof_contains_outer_boundary_mutable_text(proof)
    if encoded_len(proof) <= max_bytes and not proof_list_exceeds_context_contract and not proof_changes_at_public_boundary and not proof_changes_at_outer_context_boundary and not count_fields_omitted and not (kind == "retrieval_decision_trace" and trace_id_omitted):
        return proof
    canonical = json.dumps(proof, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode("utf-8")
    compact.update(
        {
            "available": bool(proof.get("available", True)),
            "bounded_projection": True,
            "canonical_digest": "sha256:" + hashlib.sha256(canonical).hexdigest(),
        }
    )
    return compact


def exact_contract_integer(value: Any, expected: Any) -> bool:
    return (
        isinstance(value, int)
        and not isinstance(value, bool)
        and -(1 << 63) <= value <= (1 << 63) - 1
        and isinstance(expected, int)
        and not isinstance(expected, bool)
        and value == expected
    )


def canonical_retrieval_proof(value: Any, kind: str, *, allow_reference: bool = False) -> dict[str, Any]:
    proof = dict(value) if isinstance(value, dict) else {}
    expected_schema = "memory_trust_assessment.v1" if kind == "memory_trust_assessment" else "retrieval_decision_trace.v1"
    receipt_list = "assessments" if kind == "memory_trust_assessment" else "decisions"
    if proof.get("schema_id") != expected_schema:
        return {}
    if receipt_list in proof:
        full_count_fields = (
            (
                "version",
                "input_candidate_count",
                "processed_candidate_count",
                "input_truncated_count",
                "assessed_count",
                "quarantine_count",
                "deduplicated_count",
                "policy_omitted_count",
            )
            if kind == "memory_trust_assessment"
            else ("version", "candidate_count", "processed_candidate_count", "input_truncated_count", "decision_count")
        )
        try:
            registry = load_agent_contracts_registry()
        except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError):
            return {}
        if (
            isinstance(proof.get(receipt_list), list)
            and proof.get("ok") is True
            and proof.get("bounded") is True
            and proof.get("version") == 1
            and proof.get("assessed_count" if kind == "memory_trust_assessment" else "decision_count") == len(proof[receipt_list])
            and agent_contract_envelope_attestation_valid(expected_schema, proof, registry)
            and not validate_agent_contract_payload(expected_schema, proof)
            and all(
                isinstance(proof.get(field), int)
                and not isinstance(proof.get(field), bool)
                and 0 <= proof[field] <= MAX_CONTEXT_PACK_COUNT
                for field in full_count_fields
            )
        ):
            return proof
        return {}
    if proof.get("available") is False and proof.get("canonical_path") == f"$.{kind}":
        return {
            "schema_id": expected_schema,
            "canonical_path": f"$.{kind}",
            "available": False,
            "reason": "retrieval proof was unavailable at this boundary",
        }
    digest = str(proof.get("canonical_digest") or "")
    if proof.get("bounded_projection") is True and proof.get("canonical_path") == f"$.{kind}" and len(digest) == 71 and digest.startswith("sha256:") and digest == digest.lower():
        try:
            int(digest[7:], 16)
        except ValueError:
            return {}
        count_fields = (
            ("assessed_count", "quarantine_count", "deduplicated_count", "policy_omitted_count", "input_truncated_count")
            if kind == "memory_trust_assessment"
            else ("candidate_count", "decision_count", "input_truncated_count")
        )
        expected_fields = {
            "schema_id",
            "canonical_path",
            "available",
            "bounded_projection",
            "canonical_digest",
            *count_fields,
        }
        if proof.get("available") is not True or not all(
            isinstance(proof.get(field), int)
            and not isinstance(proof.get(field), bool)
            and 0 <= proof[field] <= MAX_CONTEXT_PACK_COUNT
            for field in count_fields
        ):
            return {}
        if kind == "retrieval_decision_trace":
            expected_fields.update(("trace_id", "coverage_complete"))
            trace_id = proof.get("trace_id")
            if not isinstance(proof.get("coverage_complete"), bool) or not isinstance(trace_id, str):
                return {}
            if proof.get("trace_id_omitted") is True:
                expected_fields.add("trace_id_omitted")
                if trace_id:
                    return {}
            else:
                bounded_trace_id, trace_id_omitted = public_trace_identity(trace_id)
                if trace_id_omitted or not trace_id or bounded_trace_id != trace_id:
                    return {}
        if set(proof) == expected_fields:
            return proof
        return {}
    if allow_reference and proof.get("canonical_path") == f"$.{kind}":
        if kind == "memory_trust_assessment":
            required_counts = (
                "assessed_count",
                "quarantine_count",
                "deduplicated_count",
                "policy_omitted_count",
                "input_truncated_count",
            )
            if set(proof) == {"schema_id", "canonical_path", *required_counts} and all(
                isinstance(proof.get(field), int) and not isinstance(proof.get(field), bool) and 0 <= proof[field] <= MAX_CONTEXT_PACK_COUNT
                for field in required_counts
            ):
                return proof
        else:
            required_counts = ("candidate_count", "decision_count", "input_truncated_count")
            trace_id = proof.get("trace_id")
            bounded_trace_id, trace_id_omitted = public_trace_identity(trace_id)
            if (
                set(proof) == {"schema_id", "canonical_path", "trace_id", "coverage_complete", *required_counts}
                and isinstance(trace_id, str)
                and not trace_id_omitted
                and bounded_trace_id == trace_id
                and bool(trace_id)
                and isinstance(proof.get("coverage_complete"), bool)
                and all(
                    isinstance(proof.get(field), int) and not isinstance(proof.get(field), bool) and 0 <= proof[field] <= MAX_CONTEXT_PACK_COUNT
                    for field in required_counts
                )
            ):
                return proof
    return {}


def select_retrieval_proof_pair(
    root: Any,
    nested: Any,
    compiler: Any,
) -> tuple[dict[str, Any], dict[str, Any]]:
    reason = "a same-origin retrieval proof pair was not available before the outer boundary"
    unavailable = (
        {
            "schema_id": "memory_trust_assessment.v1",
            "canonical_path": "$.memory_trust_assessment",
            "available": False,
            "reason": reason,
        },
        {
            "schema_id": "retrieval_decision_trace.v1",
            "canonical_path": "$.retrieval_decision_trace",
            "available": False,
            "reason": reason,
        },
    )
    for owner, allow_reference in ((root, True), (nested, False), (compiler, False)):
        if not isinstance(owner, dict):
            continue
        if "memory_trust_assessment" not in owner and "retrieval_decision_trace" not in owner:
            continue
        assessment = canonical_retrieval_proof(
            owner.get("memory_trust_assessment"),
            "memory_trust_assessment",
            allow_reference=allow_reference,
        )
        trace = canonical_retrieval_proof(
            owner.get("retrieval_decision_trace"),
            "retrieval_decision_trace",
            allow_reference=allow_reference,
        )
        if assessment and trace and retrieval_proof_pair_valid(assessment, trace):
            return assessment, trace
        return unavailable
    return unavailable


def reconcile_retrieval_proof_pair(
    assessment: dict[str, Any],
    trace: dict[str, Any],
) -> tuple[dict[str, Any], dict[str, Any]]:
    if not assessment or not trace:
        return assessment, trace
    if retrieval_proof_pair_valid(assessment, trace):
        return assessment, trace
    reason = "retrieval proof pair failed reconciliation before the outer boundary"
    return (
        {
            "schema_id": "memory_trust_assessment.v1",
            "canonical_path": "$.memory_trust_assessment",
            "available": False,
            "reason": reason,
        },
        {
            "schema_id": "retrieval_decision_trace.v1",
            "canonical_path": "$.retrieval_decision_trace",
            "available": False,
            "reason": reason,
        },
    )


def bounded_text(value: Any, limit: int) -> str:
    return str(value or "")[: max(0, int(limit))]


def bounded_identity(value: Any, public_field: str = "") -> tuple[str, bool]:
    if value in (None, ""):
        return "", False
    if not isinstance(value, str):
        return "", True
    text = value
    try:
        encoded_bytes = len(text.encode("utf-8"))
    except UnicodeEncodeError:
        return "", True
    if len(text) > MAX_CONTEXT_PACK_IDENTITY_CHARS or encoded_bytes > MAX_CONTEXT_PACK_IDENTITY_CHARS:
        return "", True
    if public_field:
        projected = redact_public_value({public_field: text})
        if not isinstance(projected, dict) or projected.get(public_field) != text:
            return "", True
    return text, False


def project_context_pack_identity_authority(
    value: Any,
    authoritative_fields: dict[str, str],
    *,
    depth: int = 0,
    path: tuple[str, ...] = (),
) -> Any:
    if depth > 64:
        return None
    if isinstance(value, list):
        return [
            project_context_pack_identity_authority(item, authoritative_fields, depth=depth + 1, path=path)
            for item in value
        ]
    if not isinstance(value, dict):
        return value
    proof_paths = {
        ("memory_trust_assessment",),
        ("retrieval_decision_trace",),
        ("context_pack", "memory_trust_assessment"),
        ("context_pack", "retrieval_decision_trace"),
        ("context_compiler", "memory_trust_assessment"),
        ("context_compiler", "retrieval_decision_trace"),
        ("context_pack", "context_compiler", "memory_trust_assessment"),
        ("context_pack", "context_compiler", "retrieval_decision_trace"),
    }
    if path in proof_paths:
        return dict(value)
    structural_forbidden = {
        "hookspecificoutput",
        "messages",
        "toolcalls",
        "functioncall",
        "rawcontextlatticejson",
        "rawprompt",
    }
    projected: dict[str, Any] = {}
    omitted = {
        item
        for item in as_list(value.get("identity_omitted"))
        if item in {"session_id", "agent_id"}
    }
    seen: set[str] = set()
    for key, item in value.items():
        canonical = "".join(character for character in str(key).lower() if character.isalnum())
        if canonical in structural_forbidden:
            continue
        if canonical in {"sessionid", "agentid"}:
            seen.add("session_id" if canonical == "sessionid" else "agent_id")
            continue
        if key == "identity_omitted":
            continue
        projected[key] = project_context_pack_identity_authority(
            item, authoritative_fields, depth=depth + 1, path=(*path, str(key))
        )
    seen.update(omitted)
    for field in seen:
        identity = authoritative_fields.get(field, "")
        if identity:
            projected[field] = identity
            omitted.discard(field)
        else:
            omitted.add(field)
    if omitted:
        projected["identity_omitted"] = sorted(omitted)
    return projected


def public_trace_identity(value: Any) -> tuple[str, bool]:
    trace_id, omitted = bounded_identity(value, "trace_id")
    if omitted or not re.fullmatch(r"rdt_[0-9a-f]{24}", trace_id) or len(trace_id.encode("utf-8")) > MAX_PUBLIC_TRACE_ID_BYTES:
        return "", bool(value)
    return trace_id, False


def bounded_text_list(value: Any, limit: int, item_chars: int = 160) -> list[str]:
    return [bounded_text(item, item_chars) for item in as_list(value)[: max(0, int(limit))] if str(item or "")]


def compact_token_budget(value: Any) -> dict[str, Any]:
    budget = as_dict(value)
    if not budget:
        return {}
    out: dict[str, Any] = {}
    out["schema_id"] = CANONICAL_TOKEN_BUDGET_SCHEMA_ID
    for field in ("active", "tokenizer_exact"):
        if isinstance(budget.get(field), bool):
            out[field] = budget[field]
    for field in (
        "agent_context_budget_tokens",
        "model_context_window_tokens",
        "reserved_response_tokens",
        "already_loaded_tokens",
        "target_context_pack_tokens",
        "ranked_evidence_budget_tokens",
        "ranked_evidence_tokens",
        "used_tokens_estimate",
        "selected_count",
        "omitted_high_value_count",
    ):
        if field in budget:
            out[field], omitted = bounded_nonnegative_int(budget[field])
            if omitted:
                out.setdefault("numeric_fields_omitted", []).append(field)
    for field in ("estimate_method", "calibration_grade", "tokenizer_encoding", "selection_strategy", "compression_level"):
        if budget.get(field) not in (None, ""):
            out[field] = bounded_text(budget[field], 96)
    return out


def reconcile_context_pack_token_budget(payload: dict[str, Any]) -> None:
    context_pack = payload.get("context_pack") if isinstance(payload.get("context_pack"), dict) else {}
    token_budget = compact_token_budget(
        first_dict(payload.get("token_budget"), context_pack.get("token_budget"), context_pack.get("tokenBudget"))
    )
    payload.pop("token_budget", None)
    context_pack.pop("token_budget", None)
    context_pack.pop("tokenBudget", None)
    prompt_sections = context_pack.get("prompt_sections") if isinstance(context_pack.get("prompt_sections"), dict) else {}
    prompt_had_budget = "token_budget" in prompt_sections or "tokenBudget" in prompt_sections
    prompt_sections.pop("token_budget", None)
    prompt_sections.pop("tokenBudget", None)
    if not token_budget:
        return
    token_budget["schema_id"] = CANONICAL_TOKEN_BUDGET_SCHEMA_ID
    token_budget["selected_count"] = len(as_list(context_pack.get("ranked_evidence")))
    payload["token_budget"] = dict(token_budget)
    context_pack["token_budget"] = dict(token_budget)
    if prompt_had_budget:
        prompt_sections["token_budget"] = dict(token_budget)


def compact_items(value: Any, limit: int) -> list[Any]:
    out = []
    for item in as_list(value)[:limit]:
        if isinstance(item, dict):
            compact = {}
            for key in (
                "text",
                "file",
                "source",
                "topic_path",
                "project",
                "score",
                "impact_score",
                "value_density",
                "estimated_tokens",
                "confidence",
                "rank",
                "kind",
                "reason",
                "why_selected",
                "omitted_reason",
                "summary",
                "timestamp",
                "memory_id",
                "relation",
                "edge_direction",
                "seed_memory_id",
            ):
                if key in item and item[key] not in ("", None):
                    value = item[key]
                    if isinstance(value, str):
                        cap = 420 if key in {"text", "summary"} else 240
                        value = bounded_text(value, cap)
                    elif key == "why_selected" and isinstance(value, (list, tuple)):
                        value = bounded_text_list(value, 6, 120)
                    elif isinstance(value, (dict, list, tuple, set)):
                        continue
                    compact[key] = value
            out.append(compact)
        else:
            out.append(bounded_text(item, 360))
    return out


