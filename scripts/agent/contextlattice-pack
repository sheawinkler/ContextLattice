            if isinstance(item, dict):
                text = str(item.get("text") or item.get("summary") or "")[:420]
                kind = str(item.get("kind") or "evidence")
                rank = str(item.get("rank") or "?")
                if text:
                    lines.append(f"- [{kind} #{rank}] {text}")
    else:
        lines.append("- No ranked evidence was returned by this gateway version; use the included context sections and inspect cited files before making claims.")
    return "\n".join(lines)[:5000]


def compact_context_pack(
    raw: dict[str, Any],
    query: str,
    budget_chars: int,
    *,
    identity_authority: dict[str, Any] | None = None,
) -> dict[str, Any]:
    requested_budget_chars, budget_rejected = normalized_context_budget_chars(budget_chars)
    if budget_rejected:
        return failure_payload(query, requested_budget_chars, "invalid_context_budget", 0)
    effective_budget_chars = max(MIN_CONTEXT_PACK_CONTRACT_BUDGET_CHARS, requested_budget_chars)
    session_source = raw.get("session_id")
    agent_source = raw.get("agent_id")
    if identity_authority is not None:
        session_source = identity_authority.get("session_id")
        agent_source = identity_authority.get("agent_id")
    session_id, session_id_omitted = bounded_identity(session_source, "session_id")
    agent_id, agent_id_omitted = bounded_identity(agent_source, "agent_id")
    identity_omitted = [
        field
        for field, value, omitted in (
            ("session_id", session_id, session_id_omitted),
            ("agent_id", agent_id, agent_id_omitted),
        )
        if omitted or (identity_authority is not None and not value)
    ]
    if identity_authority is not None:
        raw = project_context_pack_identity_authority(
            raw,
            {"session_id": session_id, "agent_id": agent_id},
        )
    pack = raw.get("context_pack") if isinstance(raw.get("context_pack"), dict) else {}
    source_coverage = raw.get("source_coverage") or pack.get("sourceCoverage") or {}
    token_budget = compact_token_budget(first_dict(raw.get("token_budget"), pack.get("token_budget"), pack.get("tokenBudget")))
    omitted_high_value_refs = compact_items(
        first_list(raw.get("omitted_high_value_refs"), pack.get("omitted_high_value_refs"), pack.get("omittedHighValueRefs")),
        8,
    )
    facts = compact_items(pack.get("facts"), 8)
    numeric_facts = compact_items(pack.get("numericFacts"), 8)
    results = compact_items(pack.get("results"), 10)
    ranked_evidence = compact_items(pack.get("ranked_evidence") or pack.get("rankedEvidence"), 16)
    graph_neighbors = compact_items(pack.get("graph_neighbors") or pack.get("graphNeighbors"), 6)
    graph_context = pack.get("graph_context") or pack.get("graphContext")
    if not isinstance(graph_context, dict):
        graph_context = {}
    prompt_sections = pack.get("prompt_sections") or pack.get("promptSections")
    if not isinstance(prompt_sections, dict):
        prompt_sections = minimal_prompt_sections(query, "Use the retrieved evidence, inspect files when necessary, and execute the smallest verifiable step.")
    context_compiler = pack.get("context_compiler") or pack.get("contextCompiler") or raw.get("context_compiler")
    if not isinstance(context_compiler, dict):
        context_compiler = minimal_context_compiler("cli_compact_context_pack", len(ranked_evidence))
    else:
        context_compiler = dict(context_compiler)
    memory_trust_assessment, retrieval_decision_trace = select_retrieval_proof_pair(
        raw,
        pack,
        context_compiler,
    )
    memory_trust_assessment, retrieval_decision_trace = reconcile_retrieval_proof_pair(
        memory_trust_assessment,
        retrieval_decision_trace,
    )
    reference_prompt = raw.get("reference_prompt")
    if not isinstance(reference_prompt, str) or not reference_prompt.strip():
        reference_prompt = fallback_reference_prompt(query, prompt_sections, ranked_evidence)
    run_advisor = raw.get("run_advisor") or pack.get("run_advisor") or pack.get("runAdvisor")
    if not isinstance(run_advisor, dict):
        run_advisor = {}
    context_pack_quality = public_context_pack_quality(
        raw.get("context_pack_quality") or pack.get("context_pack_quality") or pack.get("contextPackQuality")
    )
    quality_state_receipt = validated_context_pack_quality_state_receipt(context_pack_quality)
    context_pack: dict[str, Any] = {
        "query": pack.get("query") or raw.get("query") or query,
        "retrieval_mode": raw.get("retrieval_mode") or pack.get("retrievalMode"),
        "retrieval_intent": raw.get("retrieval_intent") or pack.get("retrievalIntent"),
        "source_coverage": source_coverage,
        "token_budget": token_budget,
        "omitted_high_value_refs": omitted_high_value_refs,
        "context_compiler": context_compiler,
        "run_advisor": run_advisor,
        "prompt_sections": prompt_sections,
        "ranked_evidence": ranked_evidence,
        "graph_neighbors": graph_neighbors,
        "graph_context": graph_context,
        "facts": facts,
        "numeric_facts": numeric_facts,
        "citations": compact_items(pack.get("citations"), 12),
        "results": results,
    }
    for camel, snake in CAMEL_TO_SNAKE.items():
        context_pack[snake] = compact_items(pack.get(camel), 12)
    payload = {
        "ok": True,
        "task_summary": query[:240],
        "context_budget_chars": effective_budget_chars,
        "requested_context_budget_chars": requested_budget_chars,
        "budget_floor_applied": requested_budget_chars < MIN_CONTEXT_PACK_CONTRACT_BUDGET_CHARS,
        "clipped": False,
        "agent_runtime": raw.get("agent_runtime") if isinstance(raw.get("agent_runtime"), dict) else {},
        "objective_runtime": raw.get("objective_runtime") if isinstance(raw.get("objective_runtime"), dict) else {},
        "fact_count": len(as_list(pack.get("facts"))),
        "result_count": len(as_list(pack.get("results"))),
        "source_coverage": source_coverage,
        "token_budget": token_budget,
        "omitted_high_value_refs": omitted_high_value_refs,
        "context_compiler": context_compiler,
        "reference_prompt": reference_prompt,
        "run_advisor": run_advisor,
        "warnings": as_list(raw.get("warnings"))[:10],
        "context_pack": context_pack,
        "writeback_required": True,
    }
    if session_id:
        payload["session_id"] = session_id
    if agent_id:
        payload["agent_id"] = agent_id
    if identity_omitted:
        payload["identity_omitted"] = identity_omitted
    if memory_trust_assessment:
        payload["memory_trust_assessment"] = bounded_retrieval_proof(memory_trust_assessment, "memory_trust_assessment")
    if retrieval_decision_trace:
        payload["retrieval_decision_trace"] = bounded_retrieval_proof(retrieval_decision_trace, "retrieval_decision_trace")
    if context_pack_quality:
        payload["context_pack_quality"] = context_pack_quality
        sample_id = str(quality_state_receipt.get("sample_id") or "").strip()
        if sample_id and session_id:
            payload["outcome_report"] = {
                "schema_id": "contextlattice_context_pack_outcome_report.v1",
                "sample_id": sample_id,
                "endpoint": "/telemetry/context-pack-quality/outcome",
                "command": (
                    "contextlattice_agent_adapter outcome "
                    f"--session-id {json.dumps(session_id)} "
                    f"--context-pack-quality-sample-id {json.dumps(sample_id)} "
                    "--first-pass-success true --repair-required false --retry-count 0"
                ),
                "privacy": "stores compact counters only; do not send prompts, completions, source text, or secrets",
            }
    payload = attach_context_pack_contract(payload)
    if context_pack_output_fits(payload, effective_budget_chars):
        return payload
    payload["clipped"] = True
    context_pack["facts"] = facts[:4]
    context_pack["numeric_facts"] = numeric_facts[:4]
    context_pack["citations"] = context_pack["citations"][:6]
    context_pack["results"] = results[:5]
    context_pack["graph_neighbors"] = graph_neighbors[:3]
    for snake in CAMEL_TO_SNAKE.values():
        context_pack[snake] = context_pack[snake][:6]
    if not context_pack_output_fits(payload, effective_budget_chars):
        context_pack["ranked_evidence"] = context_pack["ranked_evidence"][:3]
        context_pack["graph_neighbors"] = context_pack["graph_neighbors"][:1]
        if isinstance(context_pack.get("prompt_sections"), dict):
            context_pack["prompt_sections"]["evidence"] = as_list(context_pack["prompt_sections"].get("evidence"))[:3]
        context_pack["results"] = []
        context_pack["citations"] = []
        context_pack["facts"] = context_pack["facts"][:2]
        context_pack["numeric_facts"] = context_pack["numeric_facts"][:2]
    return finalize_context_pack_payload(payload, requested_budget_chars)


def record_context_pack_quality_pending(project: str, session_id: str, agent_id: str, query: str, payload: dict[str, Any]) -> None:
    session_id, session_id_omitted = bounded_identity(session_id, "session_id")
    agent_id, agent_id_omitted = bounded_identity(agent_id, "agent_id")
    if session_id_omitted or agent_id_omitted:
        return
    quality = validated_context_pack_quality_state_receipt(payload.get("context_pack_quality"))
    sample_id = str(quality.get("sample_id") or "").strip()
    if not sample_id or not session_id:
        return
    state = read_agent_session_state(project)
    state.update(
        {
            "session_id": session_id,
            "project": project,
            "agent_id": agent_id,
            "objective": query,
            "source": "contextlattice-pack",
            "latest_context_pack_quality": {
                "sample_id": sample_id,
                "query_hash": quality.get("query_hash"),
                "quality_score": quality.get("quality_score"),
                "captured_at": quality.get("capturedAt") or quality.get("captured_at") or now_iso(),
                "reported": False,
            },
        }
    )
    write_agent_session_state(project, state)


def record_objective_runtime_attestation(
    project: str,
    session_id: str,
    agent_id: str,
    query: str,
    raw: dict[str, Any],
) -> None:
    runtime = raw.get("objective_runtime") if isinstance(raw.get("objective_runtime"), dict) else {}
    receipt = build_objective_runtime_attestation(
        runtime,
        session_id=session_id,
        project=project,
        agent_id=agent_id,
        runtime_agent="context-pack",
    )
    if not receipt:
        return
    state = read_agent_session_state(project)
    if (
        state.get("session_id") != session_id
        or state.get("project") != project
        or state.get("agent") != "agent-cli"
        or state.get("agent_id") != agent_id
        or state.get("objective") != query
    ):
        return
    state["latest_objective_runtime_attestation"] = receipt
    write_agent_session_state(project, state)


def public_context_pack_quality(value: Any) -> dict[str, Any]:
    quality = as_dict(value)
    if not quality:
        return {}
    projected = redact_public_value(quality)
    return projected if isinstance(projected, dict) else {}


def validated_context_pack_quality_state_receipt(value: Any) -> dict[str, Any]:
    quality = as_dict(value)
    sample_id = str(quality.get("sample_id") or "").strip()
    query_hash = str(quality.get("query_hash") or "").strip().lower()
    quality_score = quality.get("quality_score")
    captured_at = str(quality.get("capturedAt") or quality.get("captured_at") or "").strip()
    try:
        sample_id_bytes = len(sample_id.encode("utf-8"))
    except UnicodeEncodeError:
        return {}
    if not sample_id or len(sample_id) > 200 or sample_id_bytes > 200:
        return {}
    if not sample_id.startswith("cpq_") or any(ch not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-" for ch in sample_id):
        return {}
    if len(query_hash) != 16 or any(ch not in "0123456789abcdef" for ch in query_hash):
        return {}
    if isinstance(quality_score, bool) or not isinstance(quality_score, (int, float)):
        return {}
    if isinstance(quality_score, int):
        if not 0 <= quality_score <= 100:
            return {}
    elif not math.isfinite(quality_score) or not 0 <= quality_score <= 100:
        return {}
    try:
        parsed_at = datetime.fromisoformat(captured_at.replace("Z", "+00:00"))
        if parsed_at.tzinfo is None:
            return {}
    except ValueError:
        return {}
    return {
        "sample_id": sample_id,
        "query_hash": query_hash,
        "quality_score": quality_score,
        "capturedAt": captured_at,
    }


def failure_payload(query: str, budget_chars: int, error: str, attempts: int) -> dict[str, Any]:
    payload = {
        "ok": False,
        "task_summary": query[:240],
        "context_budget_chars": budget_chars,
        "status": "failed_without_retry",
        "retry_policy": "one_shot_no_replay",
        "structured_failure": True,
        "attempts": attempts,
        "error": error[:1000],
        "context_pack": {
            "query": query,
            "retrieval_mode": "",
            "retrieval_intent": "",
            "context_compiler": minimal_context_compiler("failure_payload", 0),
            "prompt_sections": minimal_prompt_sections(
                query,
                "Recover ContextLattice availability, then rerun context package compilation.",
            ),
            "ranked_evidence": [],
            "graph_neighbors": [],
            "graph_context": {},
            "source_coverage": {"configured": [], "returned": [], "complete": False},
            "facts": [],
            "numeric_facts": [],
            "citations": [],
            "results": [],
            "relevant_decisions": [],
            "files_to_read": [],
            "files_to_avoid": [],
            "capabilities_to_use": [],
            "runbooks": [],
            "known_failure_modes": [],
            "commands": [],
            "acceptance_criteria": [],
        },
        "context_compiler": minimal_context_compiler("failure_payload", 0),
        "reference_prompt": "ContextLattice context package compilation failed. Recover the local service, then rerun context compilation before making evidence-backed claims.",
        "source_coverage": {"configured": [], "returned": [], "complete": False},
        "writeback_required": True,
    }
    return finalize_context_pack_payload(payload, budget_chars)


def request_with_retries(path: str, payload: dict[str, Any], timeout: float, retries: int, retry_delay: float) -> tuple[dict[str, Any] | None, str, int]:
    # Kept as a compatibility-shaped helper for callers that still pass the
    # old retry flags. This Python transport has no proof that a failed POST
    # was pre-delivery, so it must never replay the request.
    del retries, retry_delay
    try:
        return request_json_for_validation("POST", path, payload, timeout), "", 1
    except SystemExit as exc:
        return None, str(exc.code), 1
    except Exception as exc:
        return None, str(exc), 1


def trigger_self_heal(event: str) -> None:
    if os.getenv("CONTEXTLATTICE_TRIGGER_SELF_HEAL", "1").strip().lower() in {"0", "false", "no", "off"}:
        return
    script = REPO_ROOT / "scripts" / "orbstack_self_heal.sh"
    if not script.exists():
        return
    try:
        subprocess.Popen(
            ["bash", str(script), "run-once", "--event", event],
            cwd=str(REPO_ROOT),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception:
        return


def main() -> int:
    if any(arg == "--response" or arg.startswith("--response=") for arg in sys.argv[1:]):
        delegate_recall_response(sys.argv[1:])
    parser = argparse.ArgumentParser()
    parser.add_argument("query")
    parser.add_argument("--project", default="contextlattice")
    parser.add_argument("--topic-path", default="")
    parser.add_argument("--mode", default="balanced")
    parser.add_argument("--budget-chars", type=int, default=10000)
    parser.add_argument("--agent-context-budget-tokens", type=int, default=0)
    parser.add_argument("--model-context-window-tokens", type=int, default=0)
    parser.add_argument("--reserved-response-tokens", type=int, default=0)
    parser.add_argument("--already-loaded-tokens", type=int, default=0)
    parser.add_argument("--target-context-pack-tokens", "--budget-tokens", type=int, default=0, dest="target_context_pack_tokens")
    parser.add_argument("--limit", type=int, default=12)
    parser.add_argument("--max-facts", type=int, default=24)
    parser.add_argument("--agent-id", default=os.getenv("CONTEXTLATTICE_AGENT_ID", ""))
    parser.add_argument("--session-id", default=os.getenv("CONTEXTLATTICE_SESSION_ID", ""))
    parser.add_argument("--auto-session", action=argparse.BooleanOptionalAction, default=True)
    parser.add_argument("--blocking", action="store_true", help="Wait synchronously for slow sources in /memory/context-pack.")
    parser.add_argument("--nonblocking", action="store_true", help="Deprecated compatibility flag; fail-open is the default.")
    parser.add_argument("--soft", action="store_true", help="Return exit 0 on unavailable ContextLattice after one bounded request.")
    parser.add_argument("--strict", action="store_true", help="Deprecated compatibility flag; hard failure is the default.")
    parser.add_argument("--retries", type=int, default=0, help="Compatibility flag; legacy pack never replays POST requests.")
    parser.add_argument("--retry-delay", type=float, default=1.0, help="Compatibility flag; legacy pack never replays POST requests.")
    parser.add_argument("--timeout", type=float, default=None)
    parser.add_argument("--pretty", action="store_true")
    args = parser.parse_args()
    requested_budget_chars, budget_rejected = normalized_context_budget_chars(args.budget_chars)
    args.budget_chars = requested_budget_chars
    request_timeout = args.timeout if args.timeout is not None else client_timeout_from_env()

    if budget_rejected:
        failed = failure_payload(args.query, args.budget_chars, "invalid_context_budget", 0)
        effective_budget = max(
            MIN_CONTEXT_PACK_CONTRACT_BUDGET_CHARS,
            int(failed.get("context_budget_chars") or args.budget_chars),
        )
        pretty = bool(args.pretty and context_pack_output_fits(failed, effective_budget, pretty=True))
        if not context_pack_output_fits(failed, effective_budget, pretty=pretty):
            raise ValueError("context pack invalid-budget emission exceeds the effective local output budget")
        emit(failed, pretty)
        return 0 if args.soft else 1

    blocking_slow_sources = bool(args.blocking and not args.nonblocking)
    payload = {
        "query": args.query,
        "project": args.project,
        "projectName": args.project,
        "topic_path": args.topic_path or None,
        "topicPath": args.topic_path or None,
        "retrieval_mode": args.mode,
        "include_grounding": True,
        "include_retrieval_debug": True,
        "combined_sources": True,
        "wait_for_slow_sources": blocking_slow_sources,
        "sync_slow_sources": blocking_slow_sources,
        "limit": args.limit,
        "max_facts": args.max_facts,
    }
    for key, value in (
        ("agent_context_budget_tokens", args.agent_context_budget_tokens),
        ("model_context_window_tokens", args.model_context_window_tokens),
        ("reserved_response_tokens", args.reserved_response_tokens),
        ("already_loaded_tokens", args.already_loaded_tokens),
        ("target_context_pack_tokens", args.target_context_pack_tokens),
    ):
        if int(value or 0) > 0:
            payload[key] = int(value)
    session_id = args.session_id
    if not session_id and args.auto_session:
        session_metadata = {"tool": "contextlattice-pack", "topic_path": args.topic_path, "retrieval_mode": args.mode}
        ensured = ensure_agent_session(
            project=args.project,
            objective=args.query,
            agent_id=args.agent_id,
            agent="agent-cli",
            metadata=session_metadata,
            tags=["auto-session", "context-pack"],
            timeout=min(float(request_timeout), 10.0),
            soft=True,
        )
        session_id = str(ensured.get("session_id") or "")
    if args.agent_id:
        payload["agent_id"] = args.agent_id
    if session_id:
        payload["session_id"] = session_id
    raw, error, attempts = request_with_retries(
        "/memory/context-pack",
        payload,
        request_timeout,
        max(0, args.retries),
        args.retry_delay,
    )
    if raw is None:
        trigger_self_heal("context-pack-failure")
        failed = failure_payload(args.query, args.budget_chars, error, attempts)
        effective_budget = max(
            MIN_CONTEXT_PACK_CONTRACT_BUDGET_CHARS,
            int(failed.get("context_budget_chars") or args.budget_chars or 0),
        )
        pretty = bool(args.pretty and context_pack_output_fits(failed, effective_budget, pretty=True))
        if not context_pack_output_fits(failed, effective_budget, pretty=pretty):
            raise ValueError("context pack failure emission exceeds the effective local output budget")
        emit(failed, pretty)
        return 0 if args.soft else 1
    if (
        not isinstance(raw, dict)
        or raw.get("ok") is not True
        or not isinstance(raw.get("context_pack"), dict)
    ):
        failed = failure_payload(
            args.query,
            args.budget_chars,
            "gateway_context_pack_rejected_or_malformed",
            attempts,
        )
        effective_budget = max(
            MIN_CONTEXT_PACK_CONTRACT_BUDGET_CHARS,
            int(failed.get("context_budget_chars") or args.budget_chars or 0),
        )
        pretty = bool(args.pretty and context_pack_output_fits(failed, effective_budget, pretty=True))
        if not context_pack_output_fits(failed, effective_budget, pretty=pretty):
            raise ValueError("context pack failure emission exceeds the effective local output budget")
        emit(failed, pretty)
        return 0 if args.soft else 1
    try:
        packed = compact_context_pack(
            raw,
            args.query,
            args.budget_chars,
            identity_authority={"session_id": session_id, "agent_id": args.agent_id},
        )
    except Exception:
        packed = failure_payload(
            args.query,
            args.budget_chars,
            "invalid_context_pack_response",
            attempts,
        )
        effective_budget = max(
            MIN_CONTEXT_PACK_CONTRACT_BUDGET_CHARS,
            int(packed.get("context_budget_chars") or args.budget_chars or 0),
        )
        pretty = bool(args.pretty and context_pack_output_fits(packed, effective_budget, pretty=True))
        if not context_pack_output_fits(packed, effective_budget, pretty=pretty):
            raise ValueError("context pack failure emission exceeds the effective local output budget")
        emit(packed, pretty)
        return 0 if args.soft else 1
    effective_budget = max(MIN_CONTEXT_PACK_CONTRACT_BUDGET_CHARS, int(packed.get("context_budget_chars") or args.budget_chars or 0))
    pretty = bool(args.pretty and context_pack_output_fits(packed, effective_budget, pretty=True))
    fits = context_pack_output_fits(packed, effective_budget, pretty=pretty)
    if not fits:
        raise ValueError("context pack emission exceeds the effective local output budget")
    succeeded = (
        packed.get("ok") is True
        and isinstance(packed.get("format_contract"), dict)
        and packed["format_contract"].get("contract_valid") is True
    )
    if succeeded:
        record_objective_runtime_attestation(args.project, session_id, args.agent_id, args.query, raw)
        record_context_pack_quality_pending(args.project, session_id, args.agent_id, args.query, packed)
    emit(packed, pretty)
    return 0 if succeeded or args.soft else 1


if __name__ == "__main__":
    raise SystemExit(main())
