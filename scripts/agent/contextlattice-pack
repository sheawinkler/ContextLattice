def trim_context_pack_lists(context_pack: dict[str, Any], limit: int) -> None:
    for key in (
        "facts",
        "numeric_facts",
        "citations",
        "results",
        "ranked_evidence",
        "graph_neighbors",
        "graphNeighbors",
        *CAMEL_TO_SNAKE.values(),
    ):
        if isinstance(context_pack.get(key), list):
            context_pack[key] = context_pack[key][: max(0, limit)]
    prompt_sections = context_pack.get("prompt_sections")
    if isinstance(prompt_sections, dict):
        for key in ("evidence", "files_to_inspect", "commands", "checks", "risks", "capabilities", "constraints"):
            if isinstance(prompt_sections.get(key), list):
                prompt_sections[key] = prompt_sections[key][: max(0, limit)]


def finalize_context_pack_payload(payload: dict[str, Any], budget_chars: int) -> dict[str, Any]:
    budget_chars = max(1024, int(budget_chars or 0))
    context_pack = payload.get("context_pack") if isinstance(payload.get("context_pack"), dict) else {}
    token_budget = first_dict(payload.get("token_budget"), context_pack.get("token_budget"), context_pack.get("tokenBudget"))
    omitted_high_value_refs = compact_items(
        first_list(
            payload.get("omitted_high_value_refs"),
            context_pack.get("omitted_high_value_refs"),
            context_pack.get("omittedHighValueRefs"),
        ),
        8,
    )
    ranked_evidence = compact_items(
        first_list(context_pack.get("ranked_evidence"), context_pack.get("rankedEvidence")),
        4,
    )
    if token_budget:
        payload["token_budget"] = token_budget
        context_pack["token_budget"] = token_budget
    if omitted_high_value_refs:
        payload["omitted_high_value_refs"] = omitted_high_value_refs
        context_pack["omitted_high_value_refs"] = omitted_high_value_refs
    payload = attach_format_contract("context_pack_response.v1", payload)
    if encoded_len(payload) <= budget_chars:
        return payload

    payload["clipped"] = True
    context_pack = payload.get("context_pack") if isinstance(payload.get("context_pack"), dict) else {}
    coverage = slim_source_coverage(payload.get("source_coverage") or context_pack.get("source_coverage"))
    payload["source_coverage"] = coverage
    context_pack["source_coverage"] = coverage
    advisor = slim_run_advisor(payload.get("run_advisor") or context_pack.get("run_advisor"))
    payload["run_advisor"] = advisor
    context_pack["run_advisor"] = advisor
    payload["warnings"] = as_list(payload.get("warnings"))[:3]
    trim_context_pack_lists(context_pack, 3)
    payload = attach_format_contract("context_pack_response.v1", payload)
    if encoded_len(payload) <= budget_chars:
        return payload

    context_pack = payload.get("context_pack") if isinstance(payload.get("context_pack"), dict) else {}
    trim_context_pack_lists(context_pack, 1)
    context_pack["results"] = []
    context_pack["citations"] = []
    payload["warnings"] = ["ContextLattice context pack clipped to local output budget."]
    payload = attach_format_contract("context_pack_response.v1", payload)
    if encoded_len(payload) <= budget_chars:
        return payload

    advisor = slim_run_advisor(payload.get("run_advisor") or context_pack.get("run_advisor"))
    minimal_pack = {
        "query": context_pack.get("query") or payload.get("task_summary") or "",
        "retrieval_mode": context_pack.get("retrieval_mode") or "",
        "retrieval_intent": context_pack.get("retrieval_intent") or "",
        "source_coverage": coverage,
        "token_budget": token_budget,
        "omitted_high_value_refs": omitted_high_value_refs[:4],
        "context_compiler": context_pack.get("context_compiler") or minimal_context_compiler("minimal_payload", 0),
        "run_advisor": advisor,
        "prompt_sections": minimal_prompt_sections(
            context_pack.get("query") or payload.get("task_summary") or "",
            "ContextLattice clipped this context package to a minimal bounded payload; rerun with a larger budget for ranked evidence.",
        ),
        "ranked_evidence": ranked_evidence[:2],
        "facts": [],
        "numeric_facts": [],
        "citations": [],
        "results": [],
        "graph_neighbors": [],
        "relevant_decisions": [],
        "files_to_read": [],
        "files_to_avoid": [],
        "capabilities_to_use": [],
        "runbooks": [],
        "known_failure_modes": [],
        "commands": [],
        "acceptance_criteria": [],
    }
    minimal = {
        "ok": bool(payload.get("ok", True)),
        "task_summary": str(payload.get("task_summary") or "")[:240],
        "context_budget_chars": budget_chars,
        "clipped": True,
        "session_id": payload.get("session_id") or "",
        "agent_runtime": payload.get("agent_runtime") if isinstance(payload.get("agent_runtime"), dict) else {},
        "objective_runtime": payload.get("objective_runtime") if isinstance(payload.get("objective_runtime"), dict) else {},
        "fact_count": int(payload.get("fact_count") or 0),
        "result_count": int(payload.get("result_count") or 0),
        "source_coverage": coverage,
        "token_budget": token_budget,
        "omitted_high_value_refs": omitted_high_value_refs[:4],
        "warnings": ["ContextLattice context pack clipped to minimal local output budget."],
        "context_pack": minimal_pack,
        "context_compiler": minimal_pack["context_compiler"],
        "run_advisor": advisor,
        "reference_prompt": "ContextLattice clipped this package to a minimal bounded payload. Rerun with a larger budget before making detailed evidence-backed claims.",
        "writeback_required": True,
    }
    minimal = attach_format_contract("context_pack_response.v1", minimal)
    if encoded_len(minimal) <= budget_chars:
        return minimal

    tiny_coverage = {
        "configured": as_list(coverage.get("configured"))[:3] if isinstance(coverage, dict) else [],
        "returned": as_list(coverage.get("returned"))[:3] if isinstance(coverage, dict) else [],
        "complete": bool(coverage.get("complete")) if isinstance(coverage, dict) else False,
    }
    tiny_compiler = minimal_context_compiler("minimal_local_budget", 0)
    tiny_pack = {
        "query": str(context_pack.get("query") or payload.get("task_summary") or "")[:240],
        "retrieval_mode": str(context_pack.get("retrieval_mode") or "")[:80],
        "retrieval_intent": str(context_pack.get("retrieval_intent") or "")[:80],
        "source_coverage": tiny_coverage,
        "token_budget": token_budget,
        "omitted_high_value_refs": omitted_high_value_refs[:2],
        "context_compiler": tiny_compiler,
        "run_advisor": ultra_slim_run_advisor(),
        "prompt_sections": minimal_prompt_sections(
            str(context_pack.get("query") or payload.get("task_summary") or "")[:240],
            "ContextLattice returned a minimal bounded package. Rerun with a larger budget for evidence.",
        ),
        "ranked_evidence": ranked_evidence[:1],
        "facts": [],
        "numeric_facts": [],
        "citations": [],
        "results": [],
        "relevant_decisions": [],
        "files_to_read": [],
        "files_to_avoid": [],
        "capabilities_to_use": [],
        "runbooks": [],
        "known_failure_modes": [],
        "commands": [],
        "acceptance_criteria": [],
    }
    tiny = {
        "ok": bool(payload.get("ok", True)),
        "task_summary": str(payload.get("task_summary") or "")[:120],
        "context_budget_chars": budget_chars,
        "clipped": True,
        "session_id": payload.get("session_id") or "",
        "agent_id": payload.get("agent_id") or "",
        "source_coverage": tiny_coverage,
        "token_budget": token_budget,
        "omitted_high_value_refs": omitted_high_value_refs[:2],
        "warnings": ["ContextLattice context pack clipped to minimal local output budget."],
        "context_pack": tiny_pack,
        "context_compiler": tiny_compiler,
        "run_advisor": tiny_pack["run_advisor"],
        "reference_prompt": "ContextLattice returned a minimal bounded context package. Rerun with a larger budget before making evidence-backed claims.",
        "writeback_required": True,
    }
    tiny = attach_format_contract("context_pack_response.v1", tiny)
    if encoded_len(tiny) <= budget_chars:
        return tiny
    for key in ("task_summary", "context_budget_chars", "clipped", "warnings"):
        tiny.pop(key, None)
    return attach_format_contract("context_pack_response.v1", tiny)


def minimal_context_compiler(strategy: str, ranked_count: int) -> dict[str, Any]:
    return {
        "schema_id": "contextlattice_context_compiler.v1",
        "version": 1,
        "strategy": strategy,
        "intended_use": "return a bounded prompt-ready context packet for the next agent step",
        "recommended_surface": "cli_for_local_agents",
        "ranked_evidence_count": ranked_count,
    }


def minimal_prompt_sections(query: str, next_action: str) -> dict[str, Any]:
    return {
        "objective": query,
        "task": query,
        "next_action": next_action,
        "evidence": [],
        "files_to_inspect": [],
        "commands": [],
        "checks": [],
        "risks": [],
        "capabilities": [],
        "constraints": ["Use cited evidence; rerun context compilation if evidence is missing."],
    }


def fallback_reference_prompt(query: str, prompt_sections: dict[str, Any], ranked_evidence: list[Any]) -> str:
    lines = [
        "Use this ContextLattice compiled context package as the factual packet for the next reasoning step.",
        f"Objective: {str(prompt_sections.get('objective') or query)[:900]}",
        f"Task: {str(prompt_sections.get('task') or query)[:900]}",
        f"Next action: {str(prompt_sections.get('next_action') or 'Use the retrieved evidence, inspect files, and run matching checks.')[:900]}",
        "",
        "Ranked evidence:",
    ]
    if ranked_evidence:
        for item in ranked_evidence[:8]:
            if isinstance(item, dict):
                text = str(item.get("text") or item.get("summary") or "")[:420]
                kind = str(item.get("kind") or "evidence")
                rank = str(item.get("rank") or "?")
                if text:
                    lines.append(f"- [{kind} #{rank}] {text}")
    else:
        lines.append("- No ranked evidence was returned by this gateway version; use the included context sections and inspect cited files before making claims.")
    return "\n".join(lines)[:5000]


def compact_context_pack(raw: dict[str, Any], query: str, budget_chars: int) -> dict[str, Any]:
    pack = raw.get("context_pack") if isinstance(raw.get("context_pack"), dict) else {}
    source_coverage = raw.get("source_coverage") or pack.get("sourceCoverage") or {}
    token_budget = first_dict(raw.get("token_budget"), pack.get("token_budget"), pack.get("tokenBudget"))
    omitted_high_value_refs = compact_items(
        first_list(raw.get("omitted_high_value_refs"), pack.get("omitted_high_value_refs"), pack.get("omittedHighValueRefs")),
        8,
    )
    facts = compact_items(pack.get("facts"), 8)
    numeric_facts = compact_items(pack.get("numericFacts"), 8)
    results = compact_items(pack.get("results"), 10)
    ranked_evidence = compact_items(pack.get("ranked_evidence") or pack.get("rankedEvidence"), 16)
    graph_neighbors = compact_items(pack.get("graph_neighbors") or pack.get("graphNeighbors"), 6)
    graph_context = pack.get("graph_context") or pack.get("graphContext")
    if not isinstance(graph_context, dict):
        graph_context = {}
    prompt_sections = pack.get("prompt_sections") or pack.get("promptSections")
    if not isinstance(prompt_sections, dict):
        prompt_sections = minimal_prompt_sections(query, "Use the retrieved evidence, inspect files when necessary, and execute the smallest verifiable step.")
    context_compiler = pack.get("context_compiler") or pack.get("contextCompiler") or raw.get("context_compiler")
    if not isinstance(context_compiler, dict):
        context_compiler = minimal_context_compiler("cli_compact_context_pack", len(ranked_evidence))
    reference_prompt = raw.get("reference_prompt")
    if not isinstance(reference_prompt, str) or not reference_prompt.strip():
        reference_prompt = fallback_reference_prompt(query, prompt_sections, ranked_evidence)
    run_advisor = raw.get("run_advisor") or pack.get("run_advisor") or pack.get("runAdvisor")
    if not isinstance(run_advisor, dict):
        run_advisor = {}
    context_pack_quality = raw.get("context_pack_quality") or pack.get("context_pack_quality") or pack.get("contextPackQuality")
    if not isinstance(context_pack_quality, dict):
        context_pack_quality = {}
    context_pack: dict[str, Any] = {
        "query": pack.get("query") or raw.get("query") or query,
        "retrieval_mode": raw.get("retrieval_mode") or pack.get("retrievalMode"),
        "retrieval_intent": raw.get("retrieval_intent") or pack.get("retrievalIntent"),
        "source_coverage": source_coverage,
        "token_budget": token_budget,
        "omitted_high_value_refs": omitted_high_value_refs,
        "context_compiler": context_compiler,
        "run_advisor": run_advisor,
        "prompt_sections": prompt_sections,
        "ranked_evidence": ranked_evidence,
        "graph_neighbors": graph_neighbors,
        "graph_context": graph_context,
        "facts": facts,
        "numeric_facts": numeric_facts,
        "citations": compact_items(pack.get("citations"), 12),
        "results": results,
    }
    for camel, snake in CAMEL_TO_SNAKE.items():
        context_pack[snake] = compact_items(pack.get(camel), 12)
    payload = {
        "ok": True,
        "task_summary": query[:240],
        "context_budget_chars": budget_chars,
        "clipped": False,
        "session_id": raw.get("session_id") or "",
        "agent_runtime": raw.get("agent_runtime") if isinstance(raw.get("agent_runtime"), dict) else {},
        "objective_runtime": raw.get("objective_runtime") if isinstance(raw.get("objective_runtime"), dict) else {},
        "fact_count": len(as_list(pack.get("facts"))),
        "result_count": len(as_list(pack.get("results"))),
        "source_coverage": source_coverage,
        "token_budget": token_budget,
        "omitted_high_value_refs": omitted_high_value_refs,
        "context_compiler": context_compiler,
        "reference_prompt": reference_prompt,
        "run_advisor": run_advisor,
        "warnings": as_list(raw.get("warnings"))[:10],
        "context_pack": context_pack,
        "writeback_required": True,
    }
    if context_pack_quality:
        payload["context_pack_quality"] = context_pack_quality
        sample_id = str(context_pack_quality.get("sample_id") or "").strip()
        if sample_id:
            payload["outcome_report"] = {
                "schema_id": "contextlattice_context_pack_outcome_report.v1",
                "sample_id": sample_id,
                "endpoint": "/telemetry/context-pack-quality/outcome",
                "command": (
                    "contextlattice_agent_adapter outcome "
                    f"--session-id {json.dumps(str(raw.get('session_id') or ''))} "
                    f"--context-pack-quality-sample-id {json.dumps(sample_id)} "
                    "--first-pass-success true --repair-required false --retry-count 0"
                ),
                "privacy": "stores compact counters only; do not send prompts, completions, source text, or secrets",
            }
    payload = attach_format_contract("context_pack_response.v1", payload)
    if encoded_len(payload) <= budget_chars:
        return payload
    payload["clipped"] = True
    context_pack["facts"] = facts[:4]
    context_pack["numeric_facts"] = numeric_facts[:4]
    context_pack["citations"] = context_pack["citations"][:6]
    context_pack["results"] = results[:5]
    context_pack["graph_neighbors"] = graph_neighbors[:3]
    for snake in CAMEL_TO_SNAKE.values():
        context_pack[snake] = context_pack[snake][:6]
    if encoded_len(payload) > budget_chars:
        context_pack["ranked_evidence"] = context_pack["ranked_evidence"][:3]
        context_pack["graph_neighbors"] = context_pack["graph_neighbors"][:1]
        if isinstance(context_pack.get("prompt_sections"), dict):
            context_pack["prompt_sections"]["evidence"] = as_list(context_pack["prompt_sections"].get("evidence"))[:3]
        context_pack["results"] = []
        context_pack["citations"] = []
        context_pack["facts"] = context_pack["facts"][:2]
        context_pack["numeric_facts"] = context_pack["numeric_facts"][:2]
    return finalize_context_pack_payload(payload, budget_chars)


def record_context_pack_quality_pending(project: str, session_id: str, agent_id: str, query: str, payload: dict[str, Any]) -> None:
    quality = payload.get("context_pack_quality") if isinstance(payload.get("context_pack_quality"), dict) else {}
    sample_id = str(quality.get("sample_id") or "").strip()
    if not sample_id or not session_id:
        return
    state = read_agent_session_state(project)
    state.update(
        {
            "session_id": session_id,
            "project": project,
            "agent_id": agent_id,
            "objective": query,
            "source": "contextlattice-pack",
            "latest_context_pack_quality": {
                "sample_id": sample_id,
                "query_hash": quality.get("query_hash"),
                "quality_score": quality.get("quality_score"),
                "captured_at": quality.get("capturedAt") or quality.get("captured_at") or now_iso(),
            },
        }
    )
    write_agent_session_state(project, state)


def failure_payload(query: str, budget_chars: int, error: str, attempts: int) -> dict[str, Any]:
    payload = {
        "ok": False,
        "task_summary": query[:240],
        "context_budget_chars": budget_chars,
        "status": "failed_after_retries",
        "structured_failure": True,
        "attempts": attempts,
        "error": error[:1000],
        "context_pack": {
            "query": query,
            "retrieval_mode": "",
            "retrieval_intent": "",
            "context_compiler": minimal_context_compiler("failure_payload", 0),
            "prompt_sections": minimal_prompt_sections(
                query,
                "Recover ContextLattice availability, then rerun context package compilation.",
            ),
            "ranked_evidence": [],
            "graph_neighbors": [],
            "graph_context": {},
            "source_coverage": {"configured": [], "returned": [], "complete": False},
            "facts": [],
            "numeric_facts": [],
            "citations": [],
            "results": [],
            "relevant_decisions": [],
            "files_to_read": [],
            "files_to_avoid": [],
            "capabilities_to_use": [],
            "runbooks": [],
            "known_failure_modes": [],
            "commands": [],
