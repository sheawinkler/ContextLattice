def client_timeout_from_env() -> float:
    try:
        value = float(os.getenv("CONTEXTLATTICE_CLIENT_TIMEOUT_SECS", "").strip())
    except (TypeError, ValueError):
        return DEFAULT_CLIENT_TIMEOUT_SECS
    if not math.isfinite(value) or value <= 0:
        return DEFAULT_CLIENT_TIMEOUT_SECS
    return value


