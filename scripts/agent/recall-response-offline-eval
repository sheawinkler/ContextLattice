def _canonical(value: Any) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True).encode("utf-8")


def _digest(value: Any) -> str:
    return "sha256:" + hashlib.sha256(_canonical(value)).hexdigest()


def _file_digest(path: Path) -> str:
    return "sha256:" + hashlib.sha256(path.read_bytes()).hexdigest()


def _opaque(kind: str, value: str) -> str:
    return "ref_" + hashlib.sha256(f"{kind}\x00{value}".encode("utf-8")).hexdigest()[:24]


def _walk_public(value: Any) -> list[str]:
    violations: list[str] = []

    def visit(node: Any, location: str) -> None:
        if isinstance(node, dict):
            for key, child in node.items():
                key_text = str(key)
                if key_text.lower() in FORBIDDEN_KEYS:
                    violations.append(f"forbidden_key:{location}.{key_text}")
                visit(child, f"{location}.{key_text}")
        elif isinstance(node, list):
            for index, child in enumerate(node):
                visit(child, f"{location}[{index}]")
        elif isinstance(node, str) and PRIVATE_VALUE_RE.search(node):
            violations.append(f"private_value:{location}")

    visit(value, "$")
    return violations


def load_fixture(path: Path) -> dict[str, Any]:
    raw = path.read_bytes()
    if len(raw) > 256 * 1024:
        raise ValueError("fixture exceeds bounded offline evaluation size")
    fixture = json.loads(raw.decode("utf-8"))
    if not isinstance(fixture, dict):
        raise ValueError("fixture must be a JSON object")
    if fixture.get("schema_id") != FIXTURE_SCHEMA_ID:
        raise ValueError("fixture schema_id is not recall_response_eval_fixture.v1")
    if fixture.get("split") not in {"baseline", "holdout"}:
        raise ValueError("fixture split must be baseline or holdout")
    if fixture.get("synthetic") is not True:
        raise ValueError("offline fixture must declare synthetic=true")
    cases = fixture.get("cases")
    if not isinstance(cases, list) or not cases or len(cases) > 64:
        raise ValueError("fixture case count is outside the bounded range")
    violations = _walk_public(fixture)
    if violations:
        raise ValueError("fixture failed public-safe validation: " + ", ".join(violations[:4]))
    ids: set[str] = set()
    for case in cases:
        if not isinstance(case, dict) or not isinstance(case.get("case_id"), str):
            raise ValueError("fixture case is missing case_id")
        case_id = case["case_id"].strip()
        if not case_id or len(case_id.encode("utf-8")) > 160 or "\x00" in case_id:
            raise ValueError("fixture case_id is outside the bounded range")
        if case_id in ids:
            raise ValueError(f"fixture contains duplicate case_id: {case_id}")
        ids.add(case_id)
        request = case.get("request")
        evidence = case.get("evidence")
        expected = case.get("expected")
        if not isinstance(request, dict) or not isinstance(evidence, list) or not isinstance(expected, dict):
            raise ValueError(f"fixture case is incomplete: {case_id}")
        if set(request) != REQUEST_FIELDS or set(expected) != EXPECTED_FIELDS:
            raise ValueError(f"fixture case has an unknown or missing field: {case_id}")
        if any(
            not isinstance(request[field], str)
            or not request[field].strip()
            or len(request[field].encode("utf-8")) > 160
            or "\x00" in request[field]
            for field in REQUEST_FIELDS
        ):
            raise ValueError(f"fixture request is outside the bounded range: {case_id}")
        refs: set[str] = set()
        for row in evidence:
            if not isinstance(row, dict) or set(row) != EVIDENCE_FIELDS:
                raise ValueError(f"evidence row is incomplete: {case_id}")
            for field in ("evidence_ref", "source_ref", "citation_ref", "support", "currentness", "conflict_group"):
                value = row[field]
                if not isinstance(value, str) or len(value.encode("utf-8")) > 160 or "\x00" in value:
                    raise ValueError(f"evidence row is outside the bounded range: {case_id}")
            if not row["evidence_ref"] or not row["source_ref"] or not row["citation_ref"]:
                raise ValueError(f"evidence identity is missing: {case_id}")
            if isinstance(row["rank"], bool) or not isinstance(row["rank"], int) or not 1 <= row["rank"] <= 64:
                raise ValueError(f"evidence rank is invalid: {case_id}")
            if row["support"] not in {"direct", "context", "distractor"}:
                raise ValueError(f"evidence support is invalid: {case_id}")
            if row["currentness"] not in {"current", "stale", "superseded", "unknown"}:
                raise ValueError(f"evidence currentness is invalid: {case_id}")
            numeric_value = row["numeric_value"]
            if numeric_value is not None and (
                isinstance(numeric_value, bool)
                or not isinstance(numeric_value, (int, float))
                or not math.isfinite(float(numeric_value))
            ):
                raise ValueError(f"evidence numeric_value is invalid: {case_id}")
            if row["evidence_ref"] in refs:
                raise ValueError(f"fixture contains duplicate evidence_ref: {case_id}")
            refs.add(row["evidence_ref"])
        for field in ("required_evidence_refs", "acceptable_evidence_refs", "citation_refs", "ranked_evidence_refs", "numeric_values"):
            if not isinstance(expected[field], list):
                raise ValueError(f"fixture expected list is invalid: {case_id}")
        for field in ("required_evidence_refs", "acceptable_evidence_refs", "ranked_evidence_refs"):
            if not all(isinstance(value, str) and value in refs for value in expected[field]):
                raise ValueError(f"fixture expected evidence reference is invalid: {case_id}")
        citation_refs = {row["citation_ref"] for row in evidence}
        if not all(isinstance(value, str) and value in citation_refs for value in expected["citation_refs"]):
            raise ValueError(f"fixture expected citation reference is invalid: {case_id}")
        if any(
            isinstance(value, bool)
            or not isinstance(value, (int, float))
            or not math.isfinite(float(value))
            for value in expected["numeric_values"]
        ):
            raise ValueError(f"fixture expected numeric value is invalid: {case_id}")
        if not isinstance(expected["abstain"], bool):
            raise ValueError(f"fixture abstention label is invalid: {case_id}")
        if isinstance(expected["minimum_source_diversity"], bool) or not isinstance(expected["minimum_source_diversity"], int):
            raise ValueError(f"fixture diversity label is invalid: {case_id}")
        for field in ("status", "correctness", "currentness", "conflict_handling", "next_action", "decision_impact"):
            value = expected[field]
            if not isinstance(value, str) or not value or len(value.encode("utf-8")) > 160 or "\x00" in value:
                raise ValueError(f"fixture expected scalar is invalid: {case_id}")
    return fixture


def _split_cases(baseline: dict[str, Any], holdout: dict[str, Any]) -> list[dict[str, Any]]:
    if baseline.get("split") != "baseline" or holdout.get("split") != "holdout":
        raise ValueError("baseline and holdout files must retain their declared split")
    baseline_ids = {case["case_id"] for case in baseline["cases"]}
    holdout_ids = {case["case_id"] for case in holdout["cases"]}
    if baseline_ids.intersection(holdout_ids):
        raise ValueError("baseline and holdout cases overlap")
    cases: list[dict[str, Any]] = []
    for split, fixture in (("baseline", baseline), ("holdout", holdout)):
        for case in fixture["cases"]:
            copied = dict(case)
            copied["_split"] = split
            cases.append(copied)
    return cases


def _evidence_rows(case: dict[str, Any]) -> list[dict[str, Any]]:
    return sorted(case["evidence"], key=lambda row: (int(row.get("rank", 999)), str(row["evidence_ref"])))


def _static_policy(case: dict[str, Any]) -> dict[str, Any]:
    """Select bounded evidence from request/evidence attributes only.

    Expected labels belong exclusively to scoring. Changing a fixture label
    must not change this projection.
    """

    rows = _evidence_rows(case)
    accounted = [
        row
        for row in rows
        if str(row.get("support")) != "distractor"
    ]
    eligible = [row for row in accounted if str(row.get("currentness")) == "current"]
    conflict_groups = sorted(
        {str(row.get("conflict_group")) for row in accounted if row.get("conflict_group")}
    )
    if conflict_groups:
        selected = [
            row
            for row in eligible
            if str(row.get("conflict_group")) in conflict_groups
        ]
        return {
            "rows": selected[:2],
            "accounted_rows": accounted,
            "status": "verify",
            "abstain": True,
            "next_action": "verify_conflict",
            "decision_impact": "high",
            "conflict_groups": conflict_groups,
        }

    if not eligible:
        if accounted:
            return {
                "rows": [],
                "accounted_rows": accounted,
                "status": "verify",
                "abstain": True,
                "next_action": "verify_currentness",
                "decision_impact": "medium",
                "conflict_groups": [],
            }
        return {
            "rows": [],
            "accounted_rows": [],
            "status": "abstain",
            "abstain": True,
            "next_action": "retrieve_or_verify",
            "decision_impact": "none",
            "conflict_groups": [],
        }

    current_direct = [
        row for row in eligible if str(row.get("support")) == "direct" and str(row.get("currentness")) == "current"
    ]
    if not current_direct:
        return {
            "rows": eligible[:2],
            "accounted_rows": accounted,
            "status": "verify",
            "abstain": True,
            "next_action": "verify_currentness",
            "decision_impact": "medium",
            "conflict_groups": [],
        }

    intent = str(case.get("request", {}).get("intent") or "")
    source_count = len({str(row.get("source_ref")) for row in current_direct[:2]})
    return {
        "rows": current_direct[:2],
        "accounted_rows": accounted,
        "status": "answer",
        "abstain": False,
        "next_action": "verify_before_action",
        "decision_impact": "high" if intent == "numeric" or (intent == "decision" and source_count <= 1) else "medium",
        "conflict_groups": [],
    }


def _scoped_ref(scope_digest: str, kind: str, value: str) -> str:
    normalized = str(value).strip() or "<empty>"
    material = f"{scope_digest}\x00{normalized}".encode("utf-8")
    return f"ref_{kind.strip().lower()}_{hashlib.sha256(material).hexdigest()[:24]}"


def _ordered_unique(values: list[str]) -> list[str]:
    seen: set[str] = set()
    out: list[str] = []
    for value in values:
        if value and value not in seen:
            seen.add(value)
            out.append(value)
    return out


def _stable_response_material(response: dict[str, Any]) -> dict[str, Any]:
    material = copy.deepcopy(response)
    material.pop("continuation_action", None)
    disclosure = material.get("disclosure")
    if isinstance(disclosure, dict):
        disclosure.pop("continuation_action", None)
    return material


def _response_id_for(response: dict[str, Any]) -> str:
    material = _stable_response_material(response)
    for key in ("response_id", "response_digest", "format_contract"):
        material.pop(key, None)
    return "rr_" + hashlib.sha256(_canonical(material)).hexdigest()[:24]


def _response_digest_material(response: dict[str, Any]) -> dict[str, Any]:
    material = _stable_response_material(response)
    material.pop("format_contract", None)
    material.pop("response_digest", None)
    return material


def _restamp_static_response(response: dict[str, Any]) -> dict[str, Any]:
    stamped = copy.deepcopy(response)
    stamped.pop("format_contract", None)
    stamped["response_id"] = _response_id_for(stamped)
    stamped["response_digest"] = _digest(_response_digest_material(stamped))
    return attach_format_contract(CONTRACT_SCHEMA_ID, stamped, load_agent_contracts_registry())


