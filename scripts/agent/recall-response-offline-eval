def _proof_identity_digest(refs: list[str]) -> str:
    return _digest(sorted(set(ref for ref in refs if ref)))


def _non_exclusion_digest(disclosure: dict[str, Any]) -> str:
    return _digest({
        "schema": disclosure["union_schema"],
        "evidence_union": disclosure["evidence_union"],
        "proof_union": disclosure["proof_union"],
        "component_union": disclosure["component_union"],
        "exclusion_refs": disclosure["exclusion_refs"],
        "source_counts": disclosure["source_counts"],
        "union_counts": disclosure["union_counts"],
        "omitted_counts": disclosure["omitted_counts"],
        "source_truncated": disclosure["source_truncated"],
        "union_truncated": disclosure["union_truncated"],
        "continuation_digest": disclosure["continuation_digest"],
        "ablation_witness": disclosure["ablation_witness"],
    })


def _evidence_projection(row: dict[str, Any], scope_digest: str) -> tuple[dict[str, Any], dict[str, Any]]:
    ref_id = _scoped_ref(scope_digest, "evidence", str(row["evidence_ref"]))
    source_ref = _scoped_ref(scope_digest, "source", str(row["source_ref"]))
    content_digest = _digest({
        "evidence_ref": row["evidence_ref"],
        "citation_ref": row["citation_ref"],
        "rank": row["rank"],
        "support": row["support"],
        "currentness": row["currentness"],
        "numeric_value": row["numeric_value"],
    })
    role = "context" if row["support"] == "context" else "support"
    confidence = 0.92 if row["support"] == "direct" else 0.72
    evidence = {
        "ref_id": ref_id,
        "kind": "fact",
        "role": role,
        "status": "current",
        "confidence": confidence,
        "source_ref": source_ref,
        "content_digest": content_digest,
    }
    union = {
        "ref_id": ref_id,
        "item_type": "evidence",
        "kind": "fact",
        "role": role,
        "status": "current",
        "confidence": confidence,
        "protected": False,
        "evidence_binding": {
            "source_ref": source_ref,
            "content_digest": content_digest,
            "binding_authority": "derived",
            "source_bound": False,
        },
    }
    return evidence, union


def _projection_binding_receipt(
    response: dict[str, Any],
    served_surface: Any,
    served_refs: list[str],
    fixture_refs: list[str],
    rows: list[dict[str, Any]],
) -> dict[str, Any]:
    material = {
        "schema_id": PROJECTION_BINDING_SCHEMA_ID,
        "response_identity": str(response.get("response_id") or response.get("cognition_id") or ""),
        "response_digest": str(response.get("response_digest") or response.get("cognition_digest") or ""),
        "served_surface_digest": _digest(served_surface),
        "served_identity_order_digest": _digest(served_refs),
        "served_identity_set_digest": _digest(sorted(set(served_refs))),
        "fixture_identity_order_digest": _digest(fixture_refs),
        "fixture_identity_set_digest": _digest(sorted(set(fixture_refs))),
        "bound_rows_digest": _digest(rows),
        "count": len(rows),
    }
    return {**material, "binding_digest": _digest(material)}


def _static_served_projection_binding(case: dict[str, Any], response: Any) -> dict[str, Any]:
    if not isinstance(response, dict):
        return {"valid": False, "rows": [], "receipt": None}
    scope = response.get("request_scope")
    served = response.get("evidence")
    if not isinstance(scope, dict) or not isinstance(scope.get("scope_digest"), str) or not isinstance(served, list):
        return {"valid": False, "rows": [], "receipt": None}
    scope_digest = str(scope["scope_digest"])
    expected_by_ref: dict[str, tuple[dict[str, Any], dict[str, Any]]] = {}
    for row in _evidence_rows(case):
        expected, _ = _evidence_projection(row, scope_digest)
        expected_by_ref[str(expected["ref_id"])] = (expected, row)
    served_refs: list[str] = []
    fixture_refs: list[str] = []
    rows: list[dict[str, Any]] = []
    seen: set[str] = set()
    for item in served:
        if not isinstance(item, dict):
            return {"valid": False, "rows": [], "receipt": None}
        ref_id = str(item.get("ref_id") or "")
        expected_pair = expected_by_ref.get(ref_id)
        if not ref_id or ref_id in seen or expected_pair is None or _canonical(item) != _canonical(expected_pair[0]):
            return {"valid": False, "rows": [], "receipt": None}
        seen.add(ref_id)
        source_row = copy.deepcopy(expected_pair[1])
        served_refs.append(ref_id)
        fixture_refs.append(str(source_row["evidence_ref"]))
        rows.append(source_row)
    receipt = _projection_binding_receipt(response, served, served_refs, fixture_refs, rows)
    return {"valid": True, "rows": rows, "receipt": receipt}


def _continuous_served_projection_binding(case: dict[str, Any], response: Any) -> dict[str, Any]:
    if not isinstance(response, dict):
        return {"valid": False, "rows": [], "receipt": None}
    policy = _static_policy(case)
    rows = [copy.deepcopy(row) for row in policy["rows"]]
    fixture_refs = [str(row["evidence_ref"]) for row in rows]
    anchor_material = {
        "selected_evidence_refs": fixture_refs,
        "conflict_groups": policy["conflict_groups"],
        "status": policy["status"],
    }
    expected_anchor = _digest(anchor_material)
    observation = response.get("observation")
    progress = response.get("progress")
    loop_guard = progress.get("loop_guard") if isinstance(progress, dict) else None
    if (
        not isinstance(observation, dict)
        or observation.get("source_anchor_digest") != expected_anchor
        or not isinstance(loop_guard, dict)
        or loop_guard.get("source_anchor_digest") != expected_anchor
    ):
        return {"valid": False, "rows": [], "receipt": None}
    receipt = _projection_binding_receipt(
        response,
        {"source_anchor_digest": expected_anchor},
        fixture_refs,
        fixture_refs,
        rows,
    )
    return {"valid": True, "rows": rows, "receipt": receipt}


def _served_projection_binding(case: dict[str, Any], condition: str, response: Any) -> dict[str, Any]:
    if condition == "static_recall_response":
        return _static_served_projection_binding(case, response)
    if condition == "continuous_cognition":
        return _continuous_served_projection_binding(case, response)
    return {"valid": False, "rows": [], "receipt": None}


def _expected_static_conflicts(case: dict[str, Any], response: Any) -> list[dict[str, Any]]:
    if not isinstance(response, dict):
        return []
    scope = response.get("request_scope")
    if not isinstance(scope, dict) or not isinstance(scope.get("scope_digest"), str):
        return []
    scope_digest = str(scope["scope_digest"])
    source_rows = _evidence_rows(case)
    projected_refs = {
        str(row["evidence_ref"]): _evidence_projection(row, scope_digest)[0]["ref_id"]
        for row in source_rows
    }
    groups = sorted({
        str(row.get("conflict_group"))
        for row in source_rows
        if row.get("conflict_group") and row.get("support") != "distractor"
    })
    expected: list[dict[str, Any]] = []
    for group in groups:
        group_rows = [
            row
            for row in source_rows
            if row.get("support") != "distractor" and str(row.get("conflict_group")) == group
        ]
        group_refs = [projected_refs[str(row["evidence_ref"])] for row in group_rows]
        support_refs = [
            projected_refs[str(row["evidence_ref"])]
            for row in group_rows
            if row.get("currentness") == "current"
        ][:1]
        opposition_refs = [ref for ref in group_refs if ref not in support_refs][:8]
        expected.append({
            "conflict_id": _scoped_ref(scope_digest, "conflict", group),
            "kind": "contradiction",
            "status": "unresolved",
            "support_refs": support_refs,
            "opposition_refs": opposition_refs,
            "resolution": "abstain_until_reconciled",
        })
    return expected


def _static_conflict_surface_matches(case: dict[str, Any], response: Any) -> bool:
    if not isinstance(response, dict):
        return False
    expected = _expected_static_conflicts(case, response)
    actual = response.get("conflicts")
    answer = response.get("answer")
    proof_spine = answer.get("proof_spine") if isinstance(answer, dict) else None
    if not isinstance(actual, list) or not isinstance(proof_spine, dict):
        return False
    if any(not item["support_refs"] or not item["opposition_refs"] for item in expected):
        return False
    expected_ids = [item["conflict_id"] for item in expected]
    return _canonical(actual) == _canonical(expected) and proof_spine.get("conflict_refs") == expected_ids


def _build_static_response(case: dict[str, Any], policy: dict[str, Any]) -> dict[str, Any]:
    selected_rows = list(policy["rows"])
    source_rows = _evidence_rows(case)
    request = case["request"]
    abstain = bool(policy["abstain"])
    conflict_groups = list(policy["conflict_groups"])
    as_of = "latest_available"
    temporal_state = "mixed" if conflict_groups else ("current_or_unknown" if abstain else "current")
    evidence_state = "conflicting" if conflict_groups else ("degraded" if abstain else "clean")
    temporal_premise_digest = _digest({
        "as_of": as_of,
        "selection_rule": "evidence_observed_at_or_before_as_of",
        "temporal_state": temporal_state,
    })
    snapshot_digest = _digest({
        "case_ref": _opaque("case", case["case_id"]),
        "source_rows": source_rows,
        "temporal_premise_digest": temporal_premise_digest,
    })
    receipt_digest = _digest([row["citation_ref"] for row in selected_rows])
    query_digest = _digest({"request_ref": request["request_ref"], "intent": request["intent"]})
    workspace_ref = _digest({"workspace": request["scope_ref"]})
    project_ref = _digest({"project": request["scope_ref"]})
    scope_digest = _digest({
        "query_digest": query_digest,
        "workspace_ref": workspace_ref,
        "project_ref": project_ref,
        "session_ref": request["session_ref"],
        "task_ref": request["request_ref"],
        "as_of": as_of,
        "condition": "universal_template",
        "ablation": "none",
        "snapshot_digest": snapshot_digest,
        "receipt_digest": receipt_digest,
        "source_bound": False,
    })
    scope = {
        "scope_digest": scope_digest,
        "query_digest": query_digest,
        "owner_ref": _scoped_ref(scope_digest, "owner", str(request["scope_ref"])),
        "workspace_ref": workspace_ref,
        "project_ref": project_ref,
        "topic_ref": _scoped_ref(scope_digest, "topic", str(request["intent"])),
        "agent_ref": _scoped_ref(scope_digest, "agent", "offline_evaluator"),
        "session_ref": _scoped_ref(scope_digest, "session", str(request["session_ref"])),
        "task_ref": _scoped_ref(scope_digest, "task", str(request["request_ref"])),
        "task_identity_ref": _scoped_ref(scope_digest, "task_identity", str(request["request_ref"])),
        "execution_lane_ref": _scoped_ref(scope_digest, "execution_lane", "offline_fixture"),
        "retrieval_intent": "decision",
        "as_of": as_of,
        "task_class": "offline_fixture_" + str(request["intent"]),
        "temporal_premise_digest": temporal_premise_digest,
        "snapshot_digest": snapshot_digest,
        "receipt_digest": receipt_digest,
        "source_bound": False,
        "condition": "universal_template",
        "ablation": "none",
    }

    eligible_rows = [
        row
        for row in source_rows
        if row["support"] != "distractor" and row["currentness"] == "current"
    ]
    excluded_rows = [row for row in source_rows if row not in eligible_rows]
    projected_by_ref: dict[str, tuple[dict[str, Any], dict[str, Any]]] = {
        str(row["evidence_ref"]): _evidence_projection(row, scope_digest)
        for row in source_rows
    }
    evidence = [copy.deepcopy(projected_by_ref[str(row["evidence_ref"])][0]) for row in selected_rows]
    all_evidence_union = [copy.deepcopy(projected_by_ref[str(row["evidence_ref"])][1]) for row in eligible_rows]
    all_exclusion_refs = [
        projected_by_ref[str(row["evidence_ref"])][0]["ref_id"]
        for row in excluded_rows
    ]
    selected_refs = [row["ref_id"] for row in evidence]
    conflict_refs = [_scoped_ref(scope_digest, "conflict", group) for group in conflict_groups]
    gap_refs = [_scoped_ref(scope_digest, "gap", case["case_id"])] if abstain else []
    # A hard-excluded source remains visible through exclusion accounting. It
    # is never promoted into the proof-support union merely to make that
    # accounting traversable.
    all_proof_refs = _ordered_unique(
        [row["ref_id"] for row in all_evidence_union] + conflict_refs + gap_refs
    )
    evidence_union = all_evidence_union[:32]
    exclusion_refs = all_exclusion_refs[:32]
    proof_union = all_proof_refs[:32]
    omitted_counts = {
        "source": 0,
        "evidence": len(all_evidence_union) - len(evidence_union),
        "exclusions": len(all_exclusion_refs) - len(exclusion_refs),
        "proof": len(all_proof_refs) - len(proof_union),
        "components": 0,
    }
    union_truncated = any(omitted_counts[key] > 0 for key in ("evidence", "exclusions", "proof", "components"))
    source_counts = {"evidence": len(source_rows), "temporal": 0, "proof": 0, "conflicts": 0}
    continuation_digest = _digest({
        "ordered_union_refs": _ordered_unique(all_proof_refs + all_exclusion_refs),
        "source_continuation_digest": _digest({"source_refs": [row["evidence_ref"] for row in source_rows], "source_counts": source_counts}),
        "exclusion_continuation_digest": _digest(all_exclusion_refs),
        "proof_continuation_digest": _digest(all_proof_refs),
        "component_continuation_digest": _digest([]),
    })
    disclosure: dict[str, Any] = {
        "bounded": True,
        "raw_retrieval_included": False,
        "raw_prompt_included": False,
        "paths_included": False,
        "secrets_included": False,
        "inference_boundary": "Metadata and opaque proof references only.",
        "omission_policy": "Classification affects presentation only; safe union membership remains count-, digest-, and continuation-bound.",
        "union_schema": "recall_response.non_exclusion.v1",
        "evidence_union": evidence_union,
        "proof_union": proof_union,
        "component_union": [],
        "omission_ledger": [],
        "union_digest": "",
        "exclusion_refs": exclusion_refs,
        "union_truncated": union_truncated,
        "source_counts": source_counts,
        "source_truncated": False,
        "union_counts": {
            "evidence": len(all_evidence_union),
            "exclusions": len(all_exclusion_refs),
            "proof": len(all_proof_refs),
            "components": 0,
        },
        "omitted_counts": omitted_counts,
        "continuation_digest": continuation_digest,
        "continuation_ref": _scoped_ref(scope_digest, "continuation", continuation_digest),
        "continuation_action": {
            "kind": "owner_cursor_unavailable",
            "method": "",
            "route": "",
            "snapshot_semantics": "not_served",
            "request_contract": "none",
            "scope_digest": scope_digest,
            "request_digest": "",
            "token": "",
            "page": 0,
        },
        "ablation_witness": _default_ablation_witness(),
        "control_union_digest": "",
        "control_proof_identity_digest": "",
        "control_receipt": {},
    }
    disclosure["union_digest"] = _non_exclusion_digest(disclosure)
    proof_identity_digest = _proof_identity_digest(proof_union)
    control_material = {
        "snapshot_digest": snapshot_digest,
        "receipt_digest": receipt_digest,
        "union_digest": disclosure["union_digest"],
        "proof_identity_digest": proof_identity_digest,
        "source_bound": False,
    }
    disclosure["control_union_digest"] = disclosure["union_digest"]
    disclosure["control_proof_identity_digest"] = proof_identity_digest
    disclosure["control_receipt"] = {**control_material, "artifact_digest": _digest(control_material)}

    receipt_ids = [_scoped_ref(scope_digest, "receipt", str(row["citation_ref"])) for row in source_rows]
    coverage_satisfied = not abstain
    proof_refs = _ordered_unique(selected_refs + conflict_refs + gap_refs)[:8]
    state_status = "supported" if str(policy["status"]) == "answer" else str(policy["status"])
    conflicts = []
    for group, conflict_ref in zip(conflict_groups, conflict_refs):
        group_rows = [
            row
            for row in source_rows
            if row["support"] != "distractor" and row.get("conflict_group") == group
        ]
        group_refs = [
            projected_by_ref[str(row["evidence_ref"])][0]["ref_id"]
            for row in group_rows
        ]
        support_refs = [
            projected_by_ref[str(row["evidence_ref"])][0]["ref_id"]
            for row in group_rows
            if row["currentness"] == "current"
        ]
        opposition_refs = [ref for ref in group_refs if ref not in support_refs[:1]]
        conflicts.append({
            "conflict_id": conflict_ref,
            "kind": "contradiction",
            "status": "unresolved",
            "support_refs": support_refs[:1],
            "opposition_refs": opposition_refs[:8],
            "resolution": "abstain_until_reconciled",
        })
    gaps = []
    if abstain:
        gaps.append({
            "code": "verification_required",
            "material": True,
            "reason": "Independent verification is required before action.",
            "required_for_action": True,
        })
    response: dict[str, Any] = {
        "ok": True,
        "schema_id": CONTRACT_SCHEMA_ID,
        "version": 1,
        "request_scope": scope,
        "classification": {
            "jobs": ["verify", "explain"] if abstain else ["look_up"],
            "objects": ["fact", "proof_receipt"],
            "temporal_mode": temporal_state,
            "evidence_state": evidence_state,
            "consequence": "informational",
            "posture": "abstain" if abstain else "advisory",
            "facets": {
                "jobs": ["verify", "explain"] if abstain else ["look_up"],
                "memory_objects": ["fact", "proof_receipt"],
                "temporal_state": temporal_state,
                "evidence_state": evidence_state,
                "consequence": "informational",
            },
        },
        "answer": {
            "summary": "Synthetic bounded evidence response.",
            "answer_mode": "abstention" if abstain else "answer",
            "basis": ["synthetic_fixture", "opaque_proof_refs", "explicit_action_boundary"],
            "claim_refs": selected_refs,
            "components": [],
            "progressive_disclosure": {
                "level": "summary",
                "available_levels": ["summary", "proof_refs", "next_action"],
                "next_level_requires": "independent verification",
            },
            "proof_spine": {
                "primary_result": selected_refs[0] if selected_refs else "",
                "as_of": as_of,
                "temporal_premise_digest": temporal_premise_digest,
                "proof_refs": proof_refs,
                "confidence_basis": ["synthetic_evidence_refs", "closed_source_accounting"],
                "conflict_refs": conflict_refs[:8],
                "gap_refs": gap_refs[:8],
                "memory_boundary": "server_evidence_and_deterministic_inference_only",
                "next_move": "retrieve_or_verify" if abstain else "inspect_proof",
                "receipt_refs": receipt_ids[:8],
                "disclosure": "opaque_refs_only",
                "coverage": [
                    {"obligation": "primary_result", "status": "satisfied" if selected_refs else "unsatisfied", "proof_refs": selected_refs[:8]},
                    {"obligation": "conflict_free", "status": "satisfied" if not conflict_refs else "unsatisfied", "proof_refs": conflict_refs[:8]},
                    {"obligation": "material_gaps_resolved", "status": "satisfied" if not gap_refs else "unsatisfied", "proof_refs": gap_refs[:8]},
                ],
            },
            "composition": {
                "condition": "universal_template",
                "ablation": "none",
                "primary_module": "v1_control",
                "ordered_modules": [],
                "proof_strategy": "shared_bounded_v1",
                "coverage_status": "satisfied" if coverage_satisfied else "unsatisfied",
                "fallback_reason": "" if coverage_satisfied else "unsatisfied_proof_obligation",
            },
        },
        "state": {
            "status": state_status,
            "source_complete": True,
            "evidence_count": len(evidence),
            "conflict_count": len(conflicts),
            "gap_count": len(gaps),
            "retrieval_mode": "bounded",
        },
        "evidence": evidence,
        "confidence": {
            "label": "abstain" if abstain else "advisory",
            "score": 0.0 if abstain else 0.8,
            "basis": ["synthetic_evidence_refs", "closed_source_accounting"],
            "calibrated": False,
        },
        "conflicts": conflicts,
        "gaps": gaps,
        "inferences": [{
            "inference_id": _scoped_ref(scope_digest, "inference", case["case_id"]),
            "claim_ref": "response_state",
            "basis_refs": selected_refs,
            "status": "deterministic_metadata_only",
            "confidence": 0.0,
            "disclosure": "This is response-state metadata, not an independent fact.",
        }],
        "next_action": {
            "kind": "retrieve_or_verify" if abstain else "inspect_proof",
            "label": str(policy["next_action"]),
            "reason": "The response is advisory-only and does not authorize external mutation.",
            "requires_verification": True,
            "authority": "advisory_only",
            "execution_performed": False,
        },
        "action_boundary": {
            "can_act": False,
            "requires_confirmation": True,
            "allowed": ["inspect_proof_refs", "retrieve_missing_sources"],
            "forbidden": ["external_mutation", "credential_access", "raw_memory_export"],
            "reason": "Recall responses provide evidence and advice only; an agent must independently authorize any mutation.",
            "execution_performed": False,
        },
        "disclosure": disclosure,
        "receipt_refs": [
            {"kind": "retrieval", "ref_id": receipt_id, "status": "observed"}
            for receipt_id in receipt_ids
        ],
        "outcome": {"status": "not_attributable", "attributable": False, "receipt_id": "", "execution_performed": False},
        "writeback_required": True,
    }
    return _restamp_static_response(response)


def validate_recall_response(response: Any) -> bool:
    if not isinstance(response, dict) or set(response) != set(RECALL_RESPONSE_FIELDS):
        return False
    if response.get("ok") is not True or response.get("schema_id") != CONTRACT_SCHEMA_ID or response.get("version") != 1:
        return False
    response_id = response.get("response_id")
    digest = response.get("response_digest")
    if not isinstance(response_id, str) or not re.fullmatch(r"rr_[0-9a-f]{24}", response_id):
        return False
    if not isinstance(digest, str) or not re.fullmatch(r"sha256:[0-9a-f]{64}", digest):
        return False
    if _response_id_for(response) != response_id or _digest(_response_digest_material(response)) != digest:
        return False
    registry = load_agent_contracts_registry()
    if validate_agent_contract_payload(CONTRACT_SCHEMA_ID, response, registry):
        return False
    contract = response.get("format_contract")
    if not isinstance(contract, dict) or contract.get("schema_id") != CONTRACT_SCHEMA_ID or contract.get("contract_valid") is not True:
        return False
    if response.get("action_boundary", {}).get("can_act") is not False:
        return False
    disclosure = response.get("disclosure", {})
    if any(disclosure.get(key) is not False for key in ("raw_retrieval_included", "raw_prompt_included", "paths_included", "secrets_included")):
        return False
    if response.get("disclosure", {}).get("bounded") is not True:
        return False
    scope = response.get("request_scope")
    if not isinstance(scope, dict) or set(scope) != {
        "scope_digest", "query_digest", "owner_ref", "workspace_ref", "project_ref", "topic_ref", "agent_ref",
        "session_ref", "task_ref", "task_identity_ref", "execution_lane_ref", "retrieval_intent", "as_of",
        "task_class", "temporal_premise_digest", "snapshot_digest", "receipt_digest", "source_bound", "condition", "ablation",
    }:
        return False
    valid_digest = lambda value: isinstance(value, str) and re.fullmatch(r"sha256:[0-9a-f]{64}", value) is not None
    valid_ref = lambda value: isinstance(value, str) and re.fullmatch(r"ref_[a-z_]+_[0-9a-f]{24}", value) is not None
    if any(not valid_digest(scope.get(key)) for key in ("scope_digest", "query_digest", "workspace_ref", "project_ref", "temporal_premise_digest", "snapshot_digest", "receipt_digest")):
        return False
    if scope.get("source_bound") is not False or scope.get("condition") != "universal_template" or scope.get("ablation") != "none":
        return False
    if any(not valid_ref(scope.get(key)) for key in ("owner_ref", "topic_ref", "agent_ref", "session_ref", "task_ref", "task_identity_ref", "execution_lane_ref")):
        return False

    answer = response.get("answer")
    composition = answer.get("composition") if isinstance(answer, dict) else None
    components = answer.get("components") if isinstance(answer, dict) else None
    proof_spine = answer.get("proof_spine") if isinstance(answer, dict) else None
    if not isinstance(composition, dict) or set(composition) != {
        "condition", "ablation", "primary_module", "ordered_modules", "proof_strategy", "coverage_status", "fallback_reason",
    }:
        return False
    if composition.get("condition") != scope["condition"] or composition.get("ablation") != scope["ablation"] or composition.get("primary_module") != "v1_control" or composition.get("ordered_modules") != [] or components != [] or composition.get("proof_strategy") != "shared_bounded_v1":
        return False
    if not isinstance(proof_spine, dict) or set(proof_spine) != {
        "primary_result", "as_of", "temporal_premise_digest", "proof_refs", "confidence_basis", "conflict_refs",
        "gap_refs", "memory_boundary", "next_move", "receipt_refs", "disclosure", "coverage",
    }:
        return False
    if proof_spine.get("as_of") != scope["as_of"] or proof_spine.get("temporal_premise_digest") != scope["temporal_premise_digest"]:
        return False

    disclosure = response.get("disclosure")
    if not isinstance(disclosure, dict) or set(disclosure) != {
        "bounded", "raw_retrieval_included", "raw_prompt_included", "paths_included", "secrets_included",
        "inference_boundary", "omission_policy", "union_schema", "evidence_union", "proof_union", "component_union",
        "omission_ledger", "union_digest", "exclusion_refs", "union_truncated", "source_counts", "source_truncated",
        "union_counts", "omitted_counts", "continuation_digest", "continuation_ref", "continuation_action",
        "ablation_witness", "control_union_digest", "control_proof_identity_digest", "control_receipt",
    }:
        return False
    if disclosure.get("union_schema") != "recall_response.non_exclusion.v1" or disclosure.get("component_union") != [] or disclosure.get("omission_ledger") != []:
        return False
    evidence_union = disclosure.get("evidence_union")
    proof_union = disclosure.get("proof_union")
    exclusion_refs = disclosure.get("exclusion_refs")
    if not isinstance(evidence_union, list) or not isinstance(proof_union, list) or not isinstance(exclusion_refs, list):
        return False
    if len(evidence_union) > 32 or len(proof_union) > 32 or len(exclusion_refs) > 32:
        return False
    if any(not isinstance(ref, str) or not ref for ref in proof_union + exclusion_refs) or len(set(proof_union)) != len(proof_union) or len(set(exclusion_refs)) != len(exclusion_refs):
        return False
    union_refs: set[str] = set()
    for row in evidence_union:
        if not isinstance(row, dict) or set(row) != {"ref_id", "item_type", "kind", "role", "status", "confidence", "protected", "evidence_binding"}:
            return False
        binding = row.get("evidence_binding")
        if not isinstance(binding, dict) or set(binding) != {"source_ref", "content_digest", "binding_authority", "source_bound"}:
            return False
        if not valid_ref(row.get("ref_id")) or row.get("item_type") != "evidence" or row.get("role") not in {"support", "context"} or row.get("status") != "current" or row.get("protected") is not False:
            return False
        if not valid_ref(binding.get("source_ref")) or not valid_digest(binding.get("content_digest")) or binding.get("binding_authority") != "derived" or binding.get("source_bound") is not False:
            return False
        if row["ref_id"] in union_refs:
            return False
        union_refs.add(row["ref_id"])
    proof_union_set = set(proof_union)
    exclusion_set = set(exclusion_refs)
    if not union_refs.issubset(proof_union_set) or union_refs.intersection(exclusion_set) or proof_union_set.intersection(exclusion_set):
        return False

    evidence = response.get("evidence")
    if not isinstance(evidence, list):
        return False
    visible_refs: set[str] = set()
    union_by_ref = {str(row["ref_id"]): row for row in evidence_union}
    for row in evidence:
        if not isinstance(row, dict) or set(row) != {"ref_id", "kind", "role", "status", "confidence", "source_ref", "content_digest"}:
            return False
        ref_id = row.get("ref_id")
        if ref_id in visible_refs or ref_id not in union_refs or not valid_ref(row.get("source_ref")) or not valid_digest(row.get("content_digest")) or row.get("status") != "current":
            return False
        visible_refs.add(ref_id)
        union_row = union_by_ref[ref_id]
        binding = union_row["evidence_binding"]
        if row != {
            "ref_id": ref_id,
            "kind": union_row["kind"],
            "role": union_row["role"],
            "status": union_row["status"],
            "confidence": union_row["confidence"],
            "source_ref": binding["source_ref"],
            "content_digest": binding["content_digest"],
        }:
            return False
    for key in ("proof_refs", "conflict_refs", "gap_refs", "receipt_refs"):
        refs = proof_spine.get(key)
        if not isinstance(refs, list) or len(refs) > 8 or any(not isinstance(ref, str) or not ref for ref in refs) or len(set(refs)) != len(refs):
            return False
    if not set(proof_spine["proof_refs"]).issubset(proof_union_set) or not visible_refs.issubset(set(proof_spine["proof_refs"])):
        return False
    selected_or_support_proof = {str(row["ref_id"]) for row in evidence}
    selected_or_support_proof.update(str(ref) for ref in proof_spine.get("proof_refs", []))
    if selected_or_support_proof.intersection(exclusion_set):
        return False

    conflicts = response.get("conflicts")
    if not isinstance(conflicts, list) or len(conflicts) > 32:
        return False
    for conflict in conflicts:
        if not isinstance(conflict, dict) or set(conflict) != {
            "conflict_id", "kind", "status", "support_refs", "opposition_refs", "resolution",
        }:
            return False
        support_refs = conflict.get("support_refs")
        opposition_refs = conflict.get("opposition_refs")
        if not isinstance(support_refs, list) or not isinstance(opposition_refs, list):
            return False
        if not support_refs or not opposition_refs:
            return False
        if any(not isinstance(ref, str) or not ref for ref in support_refs + opposition_refs):
            return False
        if len(set(support_refs)) != len(support_refs) or len(set(opposition_refs)) != len(opposition_refs):
            return False
        if set(support_refs).intersection(opposition_refs):
            return False
        if conflict.get("conflict_id") not in proof_union_set or conflict.get("conflict_id") not in proof_spine["conflict_refs"]:
            return False
        if not set(support_refs).issubset(union_refs) or set(support_refs).intersection(exclusion_set):
            return False
        if not set(opposition_refs).issubset(union_refs.union(exclusion_set)):
            return False

    source_counts = disclosure.get("source_counts")
    union_counts = disclosure.get("union_counts")
    omitted_counts = disclosure.get("omitted_counts")
    count_shapes = (
        (source_counts, {"evidence", "temporal", "proof", "conflicts"}),
        (union_counts, {"evidence", "exclusions", "proof", "components"}),
        (omitted_counts, {"source", "evidence", "exclusions", "proof", "components"}),
    )
    for counts, keys in count_shapes:
        if not isinstance(counts, dict) or set(counts) != keys or any(isinstance(value, bool) or not isinstance(value, int) or value < 0 for value in counts.values()):
            return False
    if source_counts["evidence"] != union_counts["evidence"] + union_counts["exclusions"]:
        return False
    if union_counts["evidence"] != len(evidence_union) + omitted_counts["evidence"] or union_counts["exclusions"] != len(exclusion_refs) + omitted_counts["exclusions"] or union_counts["proof"] != len(proof_union) + omitted_counts["proof"] or union_counts["components"] != omitted_counts["components"]:
        return False
    expected_truncated = any(omitted_counts[key] > 0 for key in ("evidence", "exclusions", "proof", "components"))
    if disclosure.get("source_truncated") is not False or omitted_counts["source"] != 0 or disclosure.get("union_truncated") is not expected_truncated:
        return False

    continuation_digest = disclosure.get("continuation_digest")
    continuation_action = disclosure.get("continuation_action")
    if not valid_digest(continuation_digest) or disclosure.get("continuation_ref") != _scoped_ref(scope["scope_digest"], "continuation", continuation_digest):
        return False
    if not isinstance(continuation_action, dict) or set(continuation_action) != {"kind", "method", "route", "snapshot_semantics", "request_contract", "scope_digest", "request_digest", "token", "page"}:
        return False
    if continuation_action != {
        "kind": "owner_cursor_unavailable", "method": "", "route": "", "snapshot_semantics": "not_served",
        "request_contract": "none", "scope_digest": scope["scope_digest"], "request_digest": "", "token": "", "page": 0,
    }:
        return False

    witness = disclosure.get("ablation_witness")
    if not isinstance(witness, dict) or set(witness) != {
        "schema_id", "status", "component_ref", "baseline_component_ref", "component_kind", "baseline_union_digest",
        "baseline_response_identity", "omission_receipt_digest", "expected_failure_stage", "observed_failure_stage", "witness_digest",
    }:
        return False
    if witness.get("schema_id") != "recall_response.synthetic_ablation_witness.v1" or witness.get("status") != "not_applicable" or witness.get("witness_digest") != _digest({key: value for key, value in witness.items() if key != "witness_digest"}):
        return False
    if disclosure.get("union_digest") != _non_exclusion_digest(disclosure) or disclosure.get("control_union_digest") != disclosure.get("union_digest"):
        return False
    expected_proof_digest = _proof_identity_digest(proof_union)
    if disclosure.get("control_proof_identity_digest") != expected_proof_digest:
        return False
    receipt = disclosure.get("control_receipt")
    if not isinstance(receipt, dict) or set(receipt) != {"snapshot_digest", "receipt_digest", "union_digest", "proof_identity_digest", "source_bound", "artifact_digest"}:
        return False
    control_material = {
        "snapshot_digest": scope["snapshot_digest"],
        "receipt_digest": scope["receipt_digest"],
        "union_digest": disclosure["union_digest"],
        "proof_identity_digest": expected_proof_digest,
        "source_bound": False,
    }
    if receipt != {**control_material, "artifact_digest": _digest(control_material)}:
        return False
    state = response.get("state")
    if not isinstance(state, dict) or state.get("evidence_count") != len(evidence) or state.get("conflict_count") != len(response.get("conflicts", [])) or state.get("gap_count") != len(response.get("gaps", [])):
        return False
    if _walk_public(response):
        return False
    max_bytes = int(registry["contracts"][CONTRACT_SCHEMA_ID].get("max_total_json_bytes") or 0)
    return max_bytes > 0 and len(_canonical(response)) <= max_bytes


def _continuous_cognition_digest_material(response: dict[str, Any]) -> dict[str, Any]:
    return {
        key: value
        for key, value in response.items()
        if key not in {"cognition_digest", "format_contract"}
    }


def _build_continuous_cognition_response(
    case: dict[str, Any],
    policy: dict[str, Any],
    operation: str = "observe",
) -> dict[str, Any]:
    if operation not in CONTINUOUS_COGNITION_OPERATIONS:
        raise ValueError(f"unsupported continuous cognition operation: {operation}")
    request = case["request"]
    rows = policy["rows"]
    request_scope = {
        "scope_digest": _digest({"request": request, "operation": operation}),
        "query_digest": _digest({"request_ref": request["request_ref"], "intent": request["intent"]}),
        "workspace_ref": _opaque("workspace", request["scope_ref"]),
        "project_ref": _opaque("project", request["scope_ref"]),
        "topic_ref": _opaque("topic", request["intent"]),
        "agent_ref": _opaque("agent", request["session_ref"]),
        "session_ref": _opaque("session", request["session_ref"]),
        "task_ref": _opaque("task", request["request_ref"]),
        "task_identity_ref": _opaque("task_identity", request["request_ref"]),
        "execution_lane_ref": _opaque("execution_lane", request["scope_ref"]),
        "retrieval_intent": "decision",
        "cycle_ref": _opaque("cycle", case["case_id"]),
    }
    source_anchor_digest = _digest({
        "selected_evidence_refs": _selected_refs(rows),
        "conflict_groups": policy["conflict_groups"],
        "status": policy["status"],
    })
    material_gap = bool(policy["abstain"])
    material_new_proof = bool(rows)
    supported_high_impact_conflict = bool(policy["conflict_groups"]) and policy["decision_impact"] == "high"
    silence_value_inputs = {
        "material_new_proof": material_new_proof,
        "blocked_next_action": material_gap,
        "supported_high_impact_conflict": supported_high_impact_conflict,
        "actionable_gap": material_gap,
        "utility_verified": False,
        "utility_status": "unverified",
        "source_complete": not material_gap,
        "proof_complete": not material_gap,
    }
    silence_value_score = sum(
        int(silence_value_inputs[key])
        for key in (
            "material_new_proof",
            "blocked_next_action",
            "supported_high_impact_conflict",
            "actionable_gap",
        )
    )
    gaps = []
    if material_gap:
        gaps.append({
            "code": "synthetic_evidence_gap",
            "source": "offline_fixture",
            "material": True,
            "detail_ref": _opaque("gap", case["case_id"]),
        })
    decision = "continue"
    if policy["status"] == "verify":
        decision = "investigate"
    elif policy["abstain"]:
        decision = "abstain"
    proof_timeline_ref = _opaque("proof_timeline", source_anchor_digest)
    phase_by_operation = {
        "observe": "frontier", "investigate": "investigation", "status": "status",
        "outcome": "outcome", "evaluate": "evaluation", "rollback": "rollback",
        "retire": "retirement",
    }
    progress_by_operation = {
        "observe": "observed", "investigate": "investigated", "status": "status",
        "outcome": "outcome_projected", "evaluate": "evaluation_projected",
        "rollback": "rollback_advisory", "retire": "retirement_advisory",
    }
    response: dict[str, Any] = {
        "ok": True,
        "schema_id": CONTINUOUS_COGNITION_SCHEMA_ID,
        "version": 1,
        "cognition_id": _opaque("cognition", request_scope["scope_digest"]),
        "operation": operation,
        "phase": phase_by_operation[operation],
        "decision": decision,
        "next_action": str(policy["next_action"]),
        "request_scope": request_scope,
        "observation": {
            "objective_graph_ref": _opaque("objective_graph", request["request_ref"]),
            "session_rollup_ref": _opaque("session_rollup", request["session_ref"]),
            "continuity_zero_ref": _opaque("continuity_zero", request["session_ref"]),
            "proof_timeline_ref": proof_timeline_ref,
            "retrieval_plan_ref": _opaque("retrieval_plan", request["request_ref"]),
            "utility_snapshot_ref": "ref_utility_snapshot_unavailable",
            "lifecycle_proof_ref": "ref_lifecycle_proof_unavailable",
            "source_anchor_digest": source_anchor_digest,
            "source_complete": not material_gap,
            "gaps": gaps,
        },
        "frontier": {
            "frontier_id": _opaque("frontier", source_anchor_digest),
            "objective_state": "active",
            "uncertainty": 1.0 if material_gap else 0.25,
            "next_action_class": str(policy["next_action"]),
            "utility_score": 0.0,
            "expected_utility": {
                "action_change_probability": 0.0,
                "consequence_if_wrong": 0.0,
                "evidence_reliability": 0.0,
                "acquisition_cost": 0.0,
                "score": 0.0,
            },
            "stop_reason": "source_gap" if material_gap else "bounded_frontier",
        },
        "investigation": {
            "state": "not_executed" if operation == "investigate" else "not_requested",
            "mode": "read_only_investigation" if operation == "investigate" else "read_only",
            "context_pack_ref": "ref_context_pack_unavailable",
            "retrieval_receipt_ref": "ref_retrieval_receipt_unavailable",
            "source_coverage": {
                "retrieval_count": 0,
                "compiler_count": 0,
                "evidence_ref_count": 0,
                "scanned_count": 0,
                "truncated": False,
            },
            "mutations_suppressed": True,
            "execution_performed": False,
            "network_calls": 0,
        },
        "activation": {
            "state": "inactive",
            "prep_id": "ref_context_prep_unavailable",
            "approval_ref": "ref_approval_unavailable",
            "authorization_ref": "ref_authorization_unavailable",
            "execution_owner": "external_cli_worker",
            "one_shot": True,
            "gateway_execution_performed": False,
        },
        "outcome": {
            "state": "absent" if operation in {"outcome", "evaluate"} else "not_requested",
            "outcome_ref": "ref_outcome_unavailable",
            "proof_ref": "ref_proof_unavailable",
            "utility_observation_ref": "ref_utility_observation_unavailable",
            "independently_verified": False,
            "causal_eligible": False,
        },
        "evaluation": {
            "state": "unavailable" if operation == "evaluate" else "not_requested",
            "utility_status": "not_evaluated",
            "verified": False,
            "causal_eligible": False,
            "reason": "outcome_evaluation_not_requested",
        },
        "rollback": {
            "state": "not_recommended" if operation == "rollback" else "not_requested",
            "reason_ref": "ref_rollback_reason_unavailable",
            "target_ref": "ref_rollback_target_unavailable",
        },
        "retirement": {
            "state": "not_recommended" if operation == "retire" else "not_requested",
            "reason_ref": "ref_retirement_reason_unavailable",
            "target_ref": "ref_retirement_target_unavailable",
        },
        "progress": {
            "status": progress_by_operation[operation],
            "stage": phase_by_operation[operation],
            "round": 0,
            "max_rounds": 3,
            "proof_timeline_ref": proof_timeline_ref,
            "loop_guard": {
                "cycle_ref": request_scope["cycle_ref"],
                "source_anchor_digest": source_anchor_digest,
                "round": 0,
                "max_rounds": 3,
                "dedupe_decision": "not_persisted",
                "persisted": False,
            },
        },
        "safety": {
            "advisory_only": True,
            "automatic_model_execution": False,
            "automatic_external_mutation": False,
            "runner_dispatch": False,
            "filesystem_mutation": False,
            "gateway_execution_performed": False,
            "requires_explicit_authorization": True,
            "requires_external_worker": True,
            "network_calls": 0,
        },
        "gaps": gaps,
        "silence": {
            "reason": "not_silenced" if silence_value_score >= 1 else "ordinary_silence",
            "value_inputs": silence_value_inputs,
            "value_score": silence_value_score,
            "threshold": 1,
            "policy_version": "continuous_cognition.offline_eval.v1",
            "loop_guard_digest": _digest({
                "cycle_ref": request_scope["cycle_ref"],
                "operation": operation,
                "source_anchor_digest": source_anchor_digest,
            }),
        },
        "writeback_required": True,
    }
    response["cognition_digest"] = _digest(_continuous_cognition_digest_material(response))
    return attach_format_contract(CONTINUOUS_COGNITION_SCHEMA_ID, response, load_agent_contracts_registry())


def validate_continuous_cognition_response(response: Any) -> bool:
    if not isinstance(response, dict):
        return False
    if response.get("ok") is not True or response.get("schema_id") != CONTINUOUS_COGNITION_SCHEMA_ID or response.get("version") != 1:
        return False
    digest = response.get("cognition_digest")
    if not isinstance(digest, str) or not re.fullmatch(r"sha256:[0-9a-f]{64}", digest):
        return False
    if _digest(_continuous_cognition_digest_material(response)) != digest:
        return False
    registry = load_agent_contracts_registry()
    if validate_agent_contract_payload(CONTINUOUS_COGNITION_SCHEMA_ID, response, registry):
        return False
    contract = response.get("format_contract")
    if not isinstance(contract, dict) or contract.get("schema_id") != CONTINUOUS_COGNITION_SCHEMA_ID or contract.get("contract_valid") is not True:
        return False
    safety = response.get("safety", {})
    if safety.get("advisory_only") is not True or any(
        safety.get(key) is not False
        for key in (
            "automatic_model_execution", "automatic_external_mutation", "runner_dispatch",
            "filesystem_mutation", "gateway_execution_performed",
        )
    ):
        return False
    if _walk_public(response):
        return False
    max_bytes = int(registry["contracts"][CONTINUOUS_COGNITION_SCHEMA_ID].get("max_total_json_bytes") or 0)
    return max_bytes > 0 and len(_canonical(response)) <= max_bytes


def _continuous_cognition_operation_matrix(case: dict[str, Any]) -> dict[str, Any]:
    policy = _static_policy(case)
    responses = {
        operation: _build_continuous_cognition_response(case, policy, operation)
        for operation in CONTINUOUS_COGNITION_OPERATIONS
    }
    return {
        "operations": list(CONTINUOUS_COGNITION_OPERATIONS),
        "all_valid": all(validate_continuous_cognition_response(response) for response in responses.values()),
        "all_deterministic": all(
            _canonical(response) == _canonical(_build_continuous_cognition_response(case, policy, operation))
            for operation, response in responses.items()
        ),
        "operation_digests": {
            operation: response["cognition_digest"]
            for operation, response in responses.items()
        },
        "external_execution_claimed": any(
            bool(response["safety"]["gateway_execution_performed"])
            for response in responses.values()
        ),
    }


def _selected_refs(rows: list[dict[str, Any]]) -> list[str]:
    return [str(row["evidence_ref"]) for row in rows]


def _case_metrics(case: dict[str, Any], condition: str, projection: dict[str, Any]) -> dict[str, Any]:
    expected = case["expected"]
    response = projection.get("response")
    binding_valid = True
    if condition in {"static_recall_response", "continuous_cognition"}:
        binding = _served_projection_binding(case, condition, response)
        rows = binding["rows"]
        binding_valid = bool(binding["valid"]) and (
            _canonical(projection.get("rows")) == _canonical(rows)
            and projection.get("served_projection_binding") == binding["receipt"]
        )
    else:
        rows = projection["rows"]
    # Quality and selection metrics describe only what the product actually
    # selected/presented.  accounted_rows is a custody/non-exclusion ledger;
    # it may contain omitted stale, excluded, or continuation-only evidence
    # and must never make a response look correct.
    selected = _selected_refs(rows)
    selected_set = set(selected)
    required = set(expected.get("required_evidence_refs", []))
    acceptable = set(expected.get("acceptable_evidence_refs", []))
    expected_citations = set(expected.get("citation_refs", []))
    citations = {str(row.get("citation_ref")) for row in rows if row.get("citation_ref")}
    precision = (len(selected_set.intersection(acceptable)) / len(selected_set)) if selected_set else (1.0 if not acceptable else 0.0)
    recall = (len(selected_set.intersection(required)) / len(required)) if required else (1.0 if not selected_set else 0.0)
    if expected_citations:
        citation = 1.0 if expected_citations.issubset(citations) and all(row.get("citation_ref") for row in rows if row["evidence_ref"] in required) else 0.0
    else:
        citation = 1.0 if not citations else 0.0
    response_valid = (
        validate_continuous_cognition_response(response)
        if condition == "continuous_cognition"
        else validate_recall_response(response)
    )
    valid = response_valid and binding_valid
    predicted_status = str(projection.get("status") or "")
    predicted_abstain = bool(projection.get("abstain"))
    if expected.get("status") == "answer":
        correctness = 1.0 if required.issubset(selected_set) and predicted_status == "answer" else 0.0
    else:
        correctness = 1.0 if predicted_abstain and predicted_status in {"abstain", "verify"} else 0.0
    expected_currentness = str(expected.get("currentness") or "unknown")
    selected_required_rows = [row for row in rows if row["evidence_ref"] in required]
    currentness_values = {str(row.get("currentness")) for row in selected_required_rows}
    currentness = 1.0 if (not required and expected_currentness == "unknown" and not selected) or (expected_currentness in currentness_values and len(currentness_values) == 1) or (expected_currentness == "contested" and predicted_status == "verify") else 0.0
    conflict_rows = [
        row
        for row in case["evidence"]
        if row.get("conflict_group") and row.get("support") != "distractor"
    ]
    conflict_refs = {row["evidence_ref"] for row in conflict_rows}
    if conflict_refs:
        # A generic conflict marker or a verify/abstain posture is not evidence
        # that the expected contradiction was handled. Only the closed static
        # conflict receipt binds the exact group and its nonempty support and
        # opposition memberships. Contracts without that surface receive no
        # conflict-handling credit for this case.
        conflict = 1.0 if (
            condition == "static_recall_response"
            and predicted_status in {"verify", "abstain"}
            and _static_conflict_surface_matches(case, response)
        ) else 0.0
    else:
        if condition == "static_recall_response":
            conflict = 1.0 if _static_conflict_surface_matches(case, response) else 0.0
        else:
            conflict = 1.0 if not any(row.get("conflict_group") for row in rows) else 0.0
    abstention = 1.0 if predicted_abstain == bool(expected.get("abstain")) else 0.0
    next_action = 1.0 if projection.get("next_action") == expected.get("next_action") else 0.0
    decision_impact = 1.0 if projection.get("decision_impact") == expected.get("decision_impact") else 0.0
    ranked = list(expected.get("ranked_evidence_refs", []))
    if ranked and selected:
        positions = [selected.index(ref) + 1 for ref in ranked if ref in selected]
        rank = 1.0 / min(positions) if positions else 0.0
    else:
        rank = 1.0 if not ranked and not selected else 0.0
    expected_numeric = list(expected.get("numeric_values", []))
    numeric = [row.get("numeric_value") for row in rows if row.get("numeric_value") is not None and not projection.get("abstain")]
    numeric_score = 1.0 if numeric == expected_numeric else 0.0
    minimum_diversity = int(expected.get("minimum_source_diversity", 0) or 0)
    source_count = len({str(row.get("source_ref")) for row in rows})
    if minimum_diversity == 0:
        diversity = 1.0 if source_count == 0 else 0.0
    else:
        diversity = min(1.0, source_count / minimum_diversity)
    public_value = rows if response is None else response
    privacy = 1.0 if not _walk_public(public_value) else 0.0
    determinism = 1.0 if projection.get("deterministic") else 0.0
    response_failure = condition in {"static_recall_response", "continuous_cognition"} and not valid
    return {
        "contract_validity": 1.0 if valid else 0.0,
        "evidence_precision": round(precision, 6),
        "evidence_recall": round(recall, 6),
        "citation_proof_integrity": citation,
        "correctness": correctness,
        "currentness": currentness,
        "conflict_handling": conflict,
        "abstention": abstention,
        "next_action": next_action,
        "decision_impact": decision_impact,
        "rank": round(rank, 6),
        "numeric": numeric_score,
        "diversity": round(diversity, 6),
        "latency_ms": None,
        "tokens_in": None,
        "tokens_out": None,
        "tool_calls": 0,
        "failures": 1 if response_failure else 0,
        "privacy": privacy,
        "determinism": determinism,
        "split": case["_split"],
        "condition": condition,
    }


def _project_case(case: dict[str, Any], condition: str) -> dict[str, Any]:
    if condition == "continuous_cognition":
        policy = _static_policy(case)
        response = _build_continuous_cognition_response(case, policy)
        repeat = _build_continuous_cognition_response(case, policy)
        binding = _served_projection_binding(case, condition, response)
        repeat_binding = _served_projection_binding(case, condition, repeat)
        if not binding["valid"] or not repeat_binding["valid"]:
            raise ValueError("continuous cognition projection is not bound to its served source anchor")
        return {
            "available": True,
            "implemented": True,
            "rows": binding["rows"],
            "accounted_rows": policy["accounted_rows"],
            "response": response,
            "served_projection_binding": binding["receipt"],
            "status": policy["status"],
            "abstain": policy["abstain"],
            "next_action": policy["next_action"],
            "decision_impact": policy["decision_impact"],
            "conflict_groups": policy["conflict_groups"],
            "deterministic": (
                _canonical(response) == _canonical(repeat)
                and _canonical(binding["receipt"]) == _canonical(repeat_binding["receipt"])
            ),
        }
    if condition == "no_recall":
        return {
            "available": True,
            "implemented": True,
            "rows": [],
            "response": None,
            "status": "abstain",
            "abstain": True,
            "next_action": None,
            "decision_impact": "none",
            "conflict_groups": [],
            "deterministic": True,
        }
    if condition == "retrieval_only":
        rows = _evidence_rows(case)
        return {
            "available": True,
            "implemented": True,
            "rows": rows,
            "response": None,
            "status": "retrieved",
            "abstain": False,
            "next_action": None,
            "decision_impact": "none",
            "conflict_groups": sorted({str(row.get("conflict_group")) for row in rows if row.get("conflict_group")}),
            "deterministic": _canonical(rows) == _canonical(_evidence_rows(case)),
        }
    if condition == "static_recall_response":
        policy = _static_policy(case)
        response = _build_static_response(case, policy)
        repeat = _build_static_response(case, policy)
        binding = _served_projection_binding(case, condition, response)
        repeat_binding = _served_projection_binding(case, condition, repeat)
        if not binding["valid"] or not repeat_binding["valid"]:
            raise ValueError("static projection is not bound to served response evidence")
        return {
            "available": True,
            "implemented": True,
            "rows": binding["rows"],
            "accounted_rows": policy["accounted_rows"],
            "response": response,
            "served_projection_binding": binding["receipt"],
            "status": policy["status"],
            "abstain": policy["abstain"],
            "next_action": policy["next_action"],
            "decision_impact": policy["decision_impact"],
            "conflict_groups": policy["conflict_groups"],
            "deterministic": (
                _canonical(response) == _canonical(repeat)
                and _canonical(binding["receipt"]) == _canonical(repeat_binding["receipt"])
            ),
        }
    raise ValueError(f"unsupported offline condition: {condition}")


def _aggregate(case_metrics: dict[str, dict[str, Any]], available: bool) -> tuple[dict[str, float | None], dict[str, int]]:
    metrics: dict[str, float | None] = {}
    denominators: dict[str, int] = {}
    for metric in METRICS:
        values = [float(item[metric]) for item in case_metrics.values() if item.get(metric) is not None]
        denominators[metric] = len(values)
        metrics[metric] = round(sum(values) / len(values), 6) if values and available else None
    return metrics, denominators


def _response_integrity_gate(case_metrics: dict[str, dict[str, Any]], condition: str) -> dict[str, Any]:
    required = condition in {"static_recall_response", "continuous_cognition"}
    failures = sorted(
        case_id
        for case_id, metrics in case_metrics.items()
        if required and (metrics.get("contract_validity") != 1.0 or metrics.get("failures") != 0)
    )
    return {
        "status": "fail" if failures else "pass",
        "required": required,
        "failure_case_ids": failures,
    }


def _evaluate_condition(cases: list[dict[str, Any]], condition: str) -> dict[str, Any]:
    case_results: dict[str, dict[str, Any]] = {}
    projections: dict[str, dict[str, Any]] = {}
    for case in cases:
        projection = _project_case(case, condition)
        response = projection.get("response")
        projections[case["case_id"]] = {
            "selected_evidence_refs": _selected_refs(projection["rows"]),
            "served_projection_binding_digest": (
                projection.get("served_projection_binding", {}).get("binding_digest")
                if isinstance(projection.get("served_projection_binding"), dict)
                else None
            ),
            "status": projection.get("status"),
            "abstain": projection.get("abstain"),
            "next_action": projection.get("next_action"),
            "decision_impact": projection.get("decision_impact"),
            "response_digest": (
                response.get("response_digest") or response.get("cognition_digest")
                if isinstance(response, dict)
                else None
            ),
        }
        case_results[case["case_id"]] = _case_metrics(case, condition, projection)
    available = True
    metrics, denominators = _aggregate(case_results, available)
    split_counts = {
        split: sum(1 for case in cases if case["_split"] == split)
        for split in ("baseline", "holdout")
    }
    predicted_abstention = [
        1.0 if bool(projections[case["case_id"]].get("abstain")) else 0.0
        for case in cases
    ]
    result = {
        "condition": condition,
        "availability": "available",
        "implemented": True,
        "contract_status": {
            "no_recall": "no_response",
            "retrieval_only": "not_a_response_contract",
            "static_recall_response": CONTRACT_SCHEMA_ID,
            "continuous_cognition": CONTINUOUS_COGNITION_SCHEMA_ID,
        }[condition],
        "case_count": len(cases),
        "split_counts": split_counts,
        "case_metrics": case_results,
        "projections": projections,
        "metrics": metrics,
        "metric_denominators": denominators,
        "response_integrity_gate": _response_integrity_gate(case_results, condition),
        "abstention_summary": {
            "posture": "advisory",
            "rate": round(sum(predicted_abstention) / len(predicted_abstention), 6) if predicted_abstention else 0.0,
        },
        "notes": [
            "Offline projections are synthetic and do not establish production utility.",
            "Response conditions are deterministic contract projections, not model quality or causal utility claims.",
        ],
    }
    if condition == "continuous_cognition":
        result["operation_contract_matrix"] = _continuous_cognition_operation_matrix(cases[0])
    return result


def validate_ledger(
    ledger: dict[str, Any],
    baseline: dict[str, Any],
    holdout: dict[str, Any],
    result: dict[str, Any] | None = None,
    fixture_hashes: dict[str, str] | None = None,
) -> dict[str, Any]:
    errors: list[str] = []
    if ledger.get("schema_id") != "contextlattice_eval_ledger.v1":
        errors.append("schema_id")
    if ledger.get("ledger_version") != "recall_response_advisory.v1":
        errors.append("ledger_version")
    if ledger.get("advisory_status", {}).get("posture") != "abstention":
        errors.append("advisory_status.posture")
    utility = ledger.get("advisory_status", {}).get("independent_utility", {})
    if utility.get("status") != "unproven" or utility.get("independently_verified_observations") != 0 or utility.get("causal_pairs") != 0:
        errors.append("independent_utility")
    if ledger.get("activation", {}).get("enabled") is not False:
        errors.append("activation.enabled")
    fixture = ledger.get("fixture_contract", {})
    if fixture.get("baseline_id") != baseline.get("fixture_id") or fixture.get("holdout_id") != holdout.get("fixture_id"):
        errors.append("fixture_contract.ids")
    if fixture.get("synthetic") is not True or fixture.get("raw_local_data") is not False:
        errors.append("fixture_contract.public_safe")
    if ledger.get("conditions") != list(CONDITIONS):
        errors.append("conditions")
    evaluation = ledger.get("evaluation", {})
    if evaluation.get("baseline_cases") != len(baseline.get("cases", [])) or evaluation.get("holdout_cases") != len(holdout.get("cases", [])):
        errors.append("evaluation.case_counts")
    if fixture_hashes is not None and ledger.get("fixture_hashes") != fixture_hashes:
        errors.append("fixture_hashes")
    recorded_operation_matrix = evaluation.get("continuous_cognition_operation_contract_matrix", {})
    if recorded_operation_matrix.get("operations") != list(CONTINUOUS_COGNITION_OPERATIONS):
        errors.append("evaluation.continuous_cognition_operations")
    if any(
        recorded_operation_matrix.get(key) is not expected
        for key, expected in (
            ("all_valid", True),
            ("all_deterministic", True),
            ("external_execution_claimed", False),
        )
    ):
        errors.append("evaluation.continuous_cognition_operation_contract_matrix")
    if result is not None:
        recorded = evaluation.get("static_recall_response_metrics")
        actual = result.get("results", {}).get("static_recall_response", {}).get("metrics")
        if recorded != actual:
            errors.append("evaluation.static_recall_response_metrics")
        recorded_cognition = evaluation.get("continuous_cognition_metrics")
        actual_cognition = result.get("results", {}).get("continuous_cognition", {}).get("metrics")
        if recorded_cognition != actual_cognition:
            errors.append("evaluation.continuous_cognition_metrics")
        actual_operation_matrix = result.get("results", {}).get("continuous_cognition", {}).get("operation_contract_matrix", {})
        for key in ("operations", "all_valid", "all_deterministic", "external_execution_claimed"):
            if recorded_operation_matrix.get(key) != actual_operation_matrix.get(key):
                errors.append("evaluation.continuous_cognition_operation_contract_matrix")
                break
        for condition in ("static_recall_response", "continuous_cognition"):
            gate = result.get("results", {}).get(condition, {}).get("response_integrity_gate", {})
            if gate != {"status": "pass", "required": True, "failure_case_ids": []}:
                errors.append(f"evaluation.{condition}.response_integrity_gate")
    if ledger.get("limitations") in (None, [], ""):
        errors.append("limitations")
    public_violations = [violation for violation in _walk_public(ledger) if not violation.endswith(".tool_calls")]
    if public_violations:
        errors.extend(public_violations[:4])
    return {"status": "pass" if not errors else "fail", "errors": errors}


def _evaluate_loaded(baseline: dict[str, Any], holdout: dict[str, Any]) -> dict[str, Any]:
    cases = _split_cases(baseline, holdout)
    results = {condition: _evaluate_condition(cases, condition) for condition in CONDITIONS}
    registry = load_agent_contracts_registry()
    return {
        "schema_id": EVAL_SCHEMA_ID,
        "eval_version": "1.2.0",
        "fixture_schema_id": FIXTURE_SCHEMA_ID,
        "contract_registry": {
            "registry_id": str(registry.get("registry_id") or "contextlattice_agent_output_contracts"),
            "registry_version": int(registry.get("registry_version") or 0),
        },
        "fixture_metadata": {
            "baseline_id": baseline["fixture_id"],
            "holdout_id": holdout["fixture_id"],
            "baseline_cases": len(baseline["cases"]),
            "holdout_cases": len(holdout["cases"]),
            "synthetic": True,
            "raw_local_data": False,
        },
        "conditions": list(CONDITIONS),
        "results": results,
    }


def evaluate_files(baseline_path: Path = DEFAULT_BASELINE, holdout_path: Path = DEFAULT_HOLDOUT, ledger_path: Path | None = DEFAULT_LEDGER) -> dict[str, Any]:
    baseline_path = Path(baseline_path)
    holdout_path = Path(holdout_path)
    baseline = load_fixture(baseline_path)
    holdout = load_fixture(holdout_path)
    fixture_hashes = {"baseline": _file_digest(baseline_path), "holdout": _file_digest(holdout_path)}
    first = _evaluate_loaded(baseline, holdout)
    second = _evaluate_loaded(baseline, holdout)
    first["deterministic"] = _canonical(first) == _canonical(second)
    first["fixture_metadata"]["fixture_hashes"] = fixture_hashes
    if ledger_path is None:
        first["ledger_check"] = {"status": "not_requested", "errors": []}
    else:
        ledger = json.loads(Path(ledger_path).read_text(encoding="utf-8"))
        first["ledger_check"] = validate_ledger(ledger, baseline, holdout, first, fixture_hashes)
    return first


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--baseline", type=Path, default=DEFAULT_BASELINE)
    parser.add_argument("--holdout", type=Path, default=DEFAULT_HOLDOUT)
    parser.add_argument("--ledger", type=Path, default=DEFAULT_LEDGER)
    parser.add_argument("--check", action="store_true", help="Require the checked-in public ledger to pass validation.")
    parser.add_argument("--pretty", action="store_true")
    args = parser.parse_args()
    try:
        payload = evaluate_files(args.baseline, args.holdout, args.ledger)
    except (OSError, ValueError, TypeError, KeyError, json.JSONDecodeError) as exc:
        print(
            json.dumps(
                {"schema_id": EVAL_SCHEMA_ID, "ok": False, "error": "offline evaluation input validation failed", "error_type": type(exc).__name__},
                sort_keys=True,
            )
        )
        return 1
    print(json.dumps(payload, indent=2 if args.pretty else None, sort_keys=True))
    if args.check and (not payload.get("deterministic") or payload.get("ledger_check", {}).get("status") != "pass"):
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
