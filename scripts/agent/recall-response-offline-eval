def _canonical(value: Any) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True).encode("utf-8")


def _digest(value: Any) -> str:
    return "sha256:" + hashlib.sha256(_canonical(value)).hexdigest()


def _file_digest(path: Path) -> str:
    return "sha256:" + hashlib.sha256(path.read_bytes()).hexdigest()


def _opaque(kind: str, value: str) -> str:
    return "ref_" + hashlib.sha256(f"{kind}\x00{value}".encode("utf-8")).hexdigest()[:24]


def _walk_public(value: Any) -> list[str]:
    violations: list[str] = []

    def visit(node: Any, location: str) -> None:
        if isinstance(node, dict):
            for key, child in node.items():
                key_text = str(key)
                if key_text.lower() in FORBIDDEN_KEYS:
                    violations.append(f"forbidden_key:{location}.{key_text}")
                visit(child, f"{location}.{key_text}")
        elif isinstance(node, list):
            for index, child in enumerate(node):
                visit(child, f"{location}[{index}]")
        elif isinstance(node, str) and PRIVATE_VALUE_RE.search(node):
            violations.append(f"private_value:{location}")

    visit(value, "$")
    return violations


def load_fixture(path: Path) -> dict[str, Any]:
    raw = path.read_bytes()
    if len(raw) > 256 * 1024:
        raise ValueError("fixture exceeds bounded offline evaluation size")
    fixture = json.loads(raw.decode("utf-8"))
    if not isinstance(fixture, dict):
        raise ValueError("fixture must be a JSON object")
    if fixture.get("schema_id") != FIXTURE_SCHEMA_ID:
        raise ValueError("fixture schema_id is not recall_response_eval_fixture.v1")
    if fixture.get("split") not in {"baseline", "holdout"}:
        raise ValueError("fixture split must be baseline or holdout")
    if fixture.get("synthetic") is not True:
        raise ValueError("offline fixture must declare synthetic=true")
    cases = fixture.get("cases")
    if not isinstance(cases, list) or not cases or len(cases) > 64:
        raise ValueError("fixture case count is outside the bounded range")
    violations = _walk_public(fixture)
    if violations:
        raise ValueError("fixture failed public-safe validation: " + ", ".join(violations[:4]))
    ids: set[str] = set()
    for case in cases:
        if not isinstance(case, dict) or not isinstance(case.get("case_id"), str):
            raise ValueError("fixture case is missing case_id")
        case_id = case["case_id"].strip()
        if not case_id or len(case_id.encode("utf-8")) > 160 or "\x00" in case_id:
            raise ValueError("fixture case_id is outside the bounded range")
        if case_id in ids:
            raise ValueError(f"fixture contains duplicate case_id: {case_id}")
        ids.add(case_id)
        request = case.get("request")
        evidence = case.get("evidence")
        expected = case.get("expected")
        if not isinstance(request, dict) or not isinstance(evidence, list) or not isinstance(expected, dict):
            raise ValueError(f"fixture case is incomplete: {case_id}")
        if set(request) != REQUEST_FIELDS or set(expected) != EXPECTED_FIELDS:
            raise ValueError(f"fixture case has an unknown or missing field: {case_id}")
        if any(
            not isinstance(request[field], str)
            or not request[field].strip()
            or len(request[field].encode("utf-8")) > 160
            or "\x00" in request[field]
            for field in REQUEST_FIELDS
        ):
            raise ValueError(f"fixture request is outside the bounded range: {case_id}")
        refs: set[str] = set()
        for row in evidence:
            if not isinstance(row, dict) or set(row) != EVIDENCE_FIELDS:
                raise ValueError(f"evidence row is incomplete: {case_id}")
            for field in ("evidence_ref", "source_ref", "citation_ref", "support", "currentness", "conflict_group"):
                value = row[field]
                if not isinstance(value, str) or len(value.encode("utf-8")) > 160 or "\x00" in value:
                    raise ValueError(f"evidence row is outside the bounded range: {case_id}")
            if not row["evidence_ref"] or not row["source_ref"] or not row["citation_ref"]:
                raise ValueError(f"evidence identity is missing: {case_id}")
            if isinstance(row["rank"], bool) or not isinstance(row["rank"], int) or not 1 <= row["rank"] <= 64:
                raise ValueError(f"evidence rank is invalid: {case_id}")
            if row["support"] not in {"direct", "context", "distractor"}:
                raise ValueError(f"evidence support is invalid: {case_id}")
            if row["currentness"] not in {"current", "stale", "superseded", "unknown"}:
                raise ValueError(f"evidence currentness is invalid: {case_id}")
            numeric_value = row["numeric_value"]
            if numeric_value is not None and (
                isinstance(numeric_value, bool)
                or not isinstance(numeric_value, (int, float))
                or not math.isfinite(float(numeric_value))
            ):
                raise ValueError(f"evidence numeric_value is invalid: {case_id}")
            if row["evidence_ref"] in refs:
                raise ValueError(f"fixture contains duplicate evidence_ref: {case_id}")
            refs.add(row["evidence_ref"])
        for field in ("required_evidence_refs", "acceptable_evidence_refs", "citation_refs", "ranked_evidence_refs", "numeric_values"):
            if not isinstance(expected[field], list):
                raise ValueError(f"fixture expected list is invalid: {case_id}")
        for field in ("required_evidence_refs", "acceptable_evidence_refs", "ranked_evidence_refs"):
            if not all(isinstance(value, str) and value in refs for value in expected[field]):
                raise ValueError(f"fixture expected evidence reference is invalid: {case_id}")
        citation_refs = {row["citation_ref"] for row in evidence}
        if not all(isinstance(value, str) and value in citation_refs for value in expected["citation_refs"]):
            raise ValueError(f"fixture expected citation reference is invalid: {case_id}")
        if any(
            isinstance(value, bool)
            or not isinstance(value, (int, float))
            or not math.isfinite(float(value))
            for value in expected["numeric_values"]
        ):
            raise ValueError(f"fixture expected numeric value is invalid: {case_id}")
        if not isinstance(expected["abstain"], bool):
            raise ValueError(f"fixture abstention label is invalid: {case_id}")
        if isinstance(expected["minimum_source_diversity"], bool) or not isinstance(expected["minimum_source_diversity"], int):
            raise ValueError(f"fixture diversity label is invalid: {case_id}")
        for field in ("status", "correctness", "currentness", "conflict_handling", "next_action", "decision_impact"):
            value = expected[field]
            if not isinstance(value, str) or not value or len(value.encode("utf-8")) > 160 or "\x00" in value:
                raise ValueError(f"fixture expected scalar is invalid: {case_id}")
    return fixture


def _split_cases(baseline: dict[str, Any], holdout: dict[str, Any]) -> list[dict[str, Any]]:
    if baseline.get("split") != "baseline" or holdout.get("split") != "holdout":
        raise ValueError("baseline and holdout files must retain their declared split")
    baseline_ids = {case["case_id"] for case in baseline["cases"]}
    holdout_ids = {case["case_id"] for case in holdout["cases"]}
    if baseline_ids.intersection(holdout_ids):
        raise ValueError("baseline and holdout cases overlap")
    cases: list[dict[str, Any]] = []
    for split, fixture in (("baseline", baseline), ("holdout", holdout)):
        for case in fixture["cases"]:
            copied = dict(case)
            copied["_split"] = split
            cases.append(copied)
    return cases


def _evidence_rows(case: dict[str, Any]) -> list[dict[str, Any]]:
    return sorted(case["evidence"], key=lambda row: (int(row.get("rank", 999)), str(row["evidence_ref"])))


def _static_policy(case: dict[str, Any]) -> dict[str, Any]:
    """Select bounded evidence from request/evidence attributes only.

    Expected labels belong exclusively to scoring. Changing a fixture label
    must not change this projection.
    """

    rows = _evidence_rows(case)
    eligible = [row for row in rows if str(row.get("support")) != "distractor"]
    if not eligible:
        return {
            "rows": [],
            "status": "abstain",
            "abstain": True,
            "next_action": "retrieve_or_verify",
            "decision_impact": "none",
            "conflict_groups": [],
        }

    conflict_groups = sorted({str(row.get("conflict_group")) for row in eligible if row.get("conflict_group")})
    if conflict_groups:
        selected = [row for row in eligible if str(row.get("conflict_group")) in conflict_groups]
        return {
            "rows": selected,
            "status": "verify",
            "abstain": True,
            "next_action": "verify_conflict",
            "decision_impact": "high",
            "conflict_groups": conflict_groups,
        }

    current_direct = [
        row for row in eligible if str(row.get("support")) == "direct" and str(row.get("currentness")) == "current"
    ]
    if not current_direct:
        return {
            "rows": eligible[:2],
            "status": "verify",
            "abstain": True,
            "next_action": "verify_currentness",
            "decision_impact": "medium",
            "conflict_groups": [],
        }

    intent = str(case.get("request", {}).get("intent") or "")
    source_count = len({str(row.get("source_ref")) for row in current_direct[:2]})
    return {
        "rows": current_direct[:2],
        "status": "answer",
        "abstain": False,
        "next_action": "verify_before_action",
        "decision_impact": "high" if intent == "numeric" or (intent == "decision" and source_count <= 1) else "medium",
        "conflict_groups": [],
    }


def _response_digest_material(response: dict[str, Any]) -> dict[str, Any]:
    return {key: value for key, value in response.items() if key not in {"format_contract", "response_digest"}}


def _component_digest(component: dict[str, Any]) -> str:
    return _digest({key: value for key, value in component.items() if key != "component_digest"})


def _build_static_response(case: dict[str, Any], policy: dict[str, Any]) -> dict[str, Any]:
    rows = policy["rows"]
    request = case["request"]
    selected_refs = [row["evidence_ref"] for row in rows]
    receipt_refs = [row["citation_ref"] for row in rows]
    conflict_groups = list(policy["conflict_groups"])
    conflict_refs = [_opaque("conflict", group) for group in conflict_groups]
    abstain = bool(policy["abstain"])
    status = str(policy["status"])
    posture = "abstain" if abstain else "advisory"
    as_of = "latest_available"
    temporal_state = "contested" if conflict_groups else ("unknown" if abstain else "current")
    temporal_premise_digest = _digest({
        "as_of": as_of,
        "selection_rule": "evidence_observed_at_or_before_as_of",
        "temporal_state": temporal_state,
    })
    snapshot_digest = _digest({
        "case_ref": _opaque("case", case["case_id"]),
        "conflict_refs": conflict_refs,
        "selected_refs": selected_refs,
        "status": status,
        "temporal_premise_digest": temporal_premise_digest,
    })
    receipt_digest = _digest(receipt_refs)
    gap_refs = [_opaque("gap", case["case_id"])] if abstain else []
    proof_refs: list[str] = []
    for ref in selected_refs + conflict_refs + gap_refs:
        if ref and ref not in proof_refs and len(proof_refs) < 8:
            proof_refs.append(ref)
    components: list[dict[str, Any]] = []
    for ordinal, row in enumerate(rows, start=1):
        component = {
            "component_ref": row["evidence_ref"],
            "kind": "evidence",
            "ordinal": ordinal,
        }
        component["component_digest"] = _component_digest(component)
        components.append(component)
    evidence = [
        {
            "evidence_ref": row["evidence_ref"],
            "source_ref": row["source_ref"],
            "citation_ref": row["citation_ref"],
            "rank": int(row["rank"]),
            "support_status": row["support"],
            "freshness": row["currentness"],
        }
        for row in rows
    ]
    response: dict[str, Any] = {
        "ok": True,
        "schema_id": CONTRACT_SCHEMA_ID,
        "version": 1,
        "request_scope": {
            "scope_digest": _opaque("scope", str(request["scope_ref"])),
            "query_digest": _opaque("request", str(request["request_ref"])),
            "owner_ref": _opaque("owner", str(request["scope_ref"])),
            "workspace_ref": _opaque("workspace", case["case_id"]),
            "project_ref": _opaque("project", case["case_id"]),
            "topic_ref": _opaque("topic", case["case_id"]),
            "agent_ref": _opaque("agent", case["case_id"]),
            "session_ref": _opaque("session", str(request["session_ref"])),
            "task_ref": _opaque("task", case["case_id"]),
            "task_identity_ref": _opaque("task_identity", case["case_id"]),
            "execution_lane_ref": _opaque("execution_lane", "offline_fixture"),
            "retrieval_intent": str(request["intent"]),
            "as_of": as_of,
            "task_class": "offline_fixture_" + str(request["intent"]),
            "temporal_premise_digest": temporal_premise_digest,
            "snapshot_digest": snapshot_digest,
            "receipt_digest": receipt_digest,
            "condition": "universal_template",
            "ablation": "none",
        },
        "classification": {
            "jobs": ["look_up"],
            "objects": ["fact"],
            "temporal_mode": str(request["intent"]),
            "evidence_state": "contested" if conflict_groups else ("degraded" if abstain else "clean"),
            "consequence": "informational",
            "posture": posture,
            "facets": {
                "jobs": ["look_up"],
                "memory_objects": ["fact"],
                "temporal_state": temporal_state,
                "evidence_state": "contested" if conflict_groups else ("degraded" if abstain else "clean"),
                "consequence": "informational",
            },
        },
        "answer": {
            "summary": "Synthetic bounded evidence response.",
            "answer_mode": "abstention" if abstain else "bounded_evidence",
            "basis": ["synthetic_fixture", "opaque_proof_refs"],
            "claim_refs": selected_refs,
            "components": components,
            "progressive_disclosure": {
                "level": "summary",
                "available_levels": ["summary", "proof_refs", "next_action"],
                "next_level_requires": "independent verification",
            },
            "proof_spine": {
                "primary_result": selected_refs[0] if selected_refs else "",
                "as_of": as_of,
                "temporal_premise_digest": temporal_premise_digest,
                "proof_refs": proof_refs,
                "confidence_basis": ["synthetic_evidence_refs"],
                "conflict_refs": conflict_refs,
                "gap_refs": gap_refs,
                "memory_boundary": "server_evidence_and_deterministic_inference_only",
                "next_move": "verify" if abstain else "review",
                "receipt_refs": receipt_refs[:8],
                "disclosure": "opaque_refs_only",
                "coverage": [
                    {
                        "obligation": "primary_result",
                        "status": "satisfied" if selected_refs else "unsatisfied",
                        "proof_refs": selected_refs[:8],
                    },
                    {
                        "obligation": "conflict_free",
                        "status": "satisfied" if not conflict_refs else "unsatisfied",
                        "proof_refs": conflict_refs[:8],
                    },
                    {
                        "obligation": "material_gaps_resolved",
                        "status": "satisfied" if not gap_refs else "unsatisfied",
                        "proof_refs": gap_refs[:8],
                    },
                ],
            },
            "composition": {
                "condition": "universal_template",
                "ablation": "none",
                "primary_module": "static_recall_response",
                "ordered_modules": ["evidence_selection"] if selected_refs else [],
                "proof_strategy": "shared_bounded_v1",
                "coverage_status": "unsatisfied" if abstain else "satisfied",
                "fallback_reason": "",
            },
        },
        "state": {
            "status": status,
            "source_complete": bool(rows),
            "evidence_count": len(rows),
            "conflict_count": len(conflict_groups),
            "gap_count": 1 if abstain else 0,
            "retrieval_mode": "offline_fixture",
        },
        "evidence": evidence,
        "confidence": {
            "label": "abstain" if abstain else "advisory",
            "score": 0.0 if abstain else 0.8,
            "basis": ["synthetic_evidence_refs"],
            "calibrated": False,
        },
        "conflicts": [
            {
                "conflict_ref": _opaque("conflict", group),
                "evidence_refs": [row["evidence_ref"] for row in rows if row.get("conflict_group") == group],
                "status": "contested",
            }
            for group in conflict_groups
        ],
        "gaps": (
            [{"code": "verification_required", "material": True, "reason": "Independent verification is required before action."}]
            if abstain
            else []
        ),
        "inferences": [
            {
                "inference_id": _opaque("inference", case["case_id"]),
                "claim_ref": "response_state",
                "basis_refs": selected_refs,
                "status": "deterministic_metadata_only",
                "confidence": 0.0,
                "disclosure": "This is response-state metadata, not an independent fact.",
            }
        ],
        "next_action": {
            "kind": "verify" if abstain else "review",
            "label": str(policy["next_action"]),
            "reason": "The response is advisory-only and does not authorize external mutation.",
            "requires_verification": True,
            "authority": "advisory_only",
            "execution_performed": False,
        },
        "action_boundary": {
            "can_act": False,
            "requires_confirmation": True,
            "allowed": ["retrieve_missing_sources", "verify_evidence"],
            "forbidden": ["external_mutation", "credential_access", "raw_memory_export"],
            "reason": "Advisory recall responses never authorize mutation.",
            "execution_performed": False,
        },
        "disclosure": {
            "bounded": True,
            "raw_retrieval_included": False,
            "raw_prompt_included": False,
            "paths_included": False,
            "secrets_included": False,
            "inference_boundary": "Only opaque references and deterministic metadata are returned.",
            "omission_policy": "Unverified or omitted evidence never becomes implicit support.",
        },
        "receipt_refs": receipt_refs,
        "outcome": {
            "status": "not_attributable",
            "attributable": False,
            "receipt_id": "",
            "execution_performed": False,
        },
        "writeback_required": True,
    }
    response["response_id"] = "rr_" + _digest(response).split(":", 1)[1][:24]
    response["response_digest"] = _digest(_response_digest_material(response))
    return attach_format_contract(CONTRACT_SCHEMA_ID, response, load_agent_contracts_registry())


def validate_recall_response(response: Any) -> bool:
    if not isinstance(response, dict) or set(response) != set(RECALL_RESPONSE_FIELDS):
        return False
    if response.get("ok") is not True or response.get("schema_id") != CONTRACT_SCHEMA_ID or response.get("version") != 1:
        return False
    response_id = response.get("response_id")
    digest = response.get("response_digest")
    if not isinstance(response_id, str) or not re.fullmatch(r"rr_[0-9a-f]{24}", response_id):
        return False
    if not isinstance(digest, str) or not re.fullmatch(r"sha256:[0-9a-f]{64}", digest):
        return False
    if _digest(_response_digest_material(response)) != digest:
        return False
    registry = load_agent_contracts_registry()
    if validate_agent_contract_payload(CONTRACT_SCHEMA_ID, response, registry):
        return False
    contract = response.get("format_contract")
    if not isinstance(contract, dict) or contract.get("schema_id") != CONTRACT_SCHEMA_ID or contract.get("contract_valid") is not True:
        return False
    if response.get("action_boundary", {}).get("can_act") is not False:
        return False
    disclosure = response.get("disclosure", {})
    if any(disclosure.get(key) is not False for key in ("raw_retrieval_included", "raw_prompt_included", "paths_included", "secrets_included")):
        return False
    if response.get("disclosure", {}).get("bounded") is not True:
        return False
    if _walk_public(response):
        return False
    max_bytes = int(registry["contracts"][CONTRACT_SCHEMA_ID].get("max_total_json_bytes") or 0)
    return max_bytes > 0 and len(_canonical(response)) <= max_bytes


def _continuous_cognition_digest_material(response: dict[str, Any]) -> dict[str, Any]:
    return {
        key: value
        for key, value in response.items()
        if key not in {"cognition_digest", "format_contract"}
    }


def _build_continuous_cognition_response(
    case: dict[str, Any],
    policy: dict[str, Any],
    operation: str = "observe",
) -> dict[str, Any]:
    if operation not in CONTINUOUS_COGNITION_OPERATIONS:
        raise ValueError(f"unsupported continuous cognition operation: {operation}")
    request = case["request"]
    rows = policy["rows"]
    request_scope = {
        "scope_digest": _digest({"request": request, "operation": operation}),
        "query_digest": _digest({"request_ref": request["request_ref"], "intent": request["intent"]}),
        "workspace_ref": _opaque("workspace", request["scope_ref"]),
        "project_ref": _opaque("project", request["scope_ref"]),
        "topic_ref": _opaque("topic", request["intent"]),
        "agent_ref": _opaque("agent", request["session_ref"]),
        "session_ref": _opaque("session", request["session_ref"]),
        "task_ref": _opaque("task", request["request_ref"]),
        "task_identity_ref": _opaque("task_identity", request["request_ref"]),
        "execution_lane_ref": _opaque("execution_lane", request["scope_ref"]),
        "retrieval_intent": "decision",
        "cycle_ref": _opaque("cycle", case["case_id"]),
    }
    source_anchor_digest = _digest({
        "selected_evidence_refs": _selected_refs(rows),
        "conflict_groups": policy["conflict_groups"],
        "status": policy["status"],
    })
    material_gap = bool(policy["abstain"])
    material_new_proof = bool(rows)
    supported_high_impact_conflict = bool(policy["conflict_groups"]) and policy["decision_impact"] == "high"
    silence_value_inputs = {
        "material_new_proof": material_new_proof,
        "blocked_next_action": material_gap,
        "supported_high_impact_conflict": supported_high_impact_conflict,
        "actionable_gap": material_gap,
        "utility_verified": False,
        "utility_status": "unverified",
        "source_complete": not material_gap,
        "proof_complete": not material_gap,
    }
    silence_value_score = sum(
        int(silence_value_inputs[key])
        for key in (
            "material_new_proof",
            "blocked_next_action",
            "supported_high_impact_conflict",
            "actionable_gap",
        )
    )
    gaps = []
    if material_gap:
        gaps.append({
            "code": "synthetic_evidence_gap",
            "source": "offline_fixture",
            "material": True,
            "detail_ref": _opaque("gap", case["case_id"]),
        })
    decision = "continue"
    if policy["status"] == "verify":
        decision = "investigate"
    elif policy["abstain"]:
        decision = "abstain"
    proof_timeline_ref = _opaque("proof_timeline", source_anchor_digest)
    phase_by_operation = {
        "observe": "frontier", "investigate": "investigation", "status": "status",
        "outcome": "outcome", "evaluate": "evaluation", "rollback": "rollback",
        "retire": "retirement",
    }
    progress_by_operation = {
        "observe": "observed", "investigate": "investigated", "status": "status",
        "outcome": "outcome_projected", "evaluate": "evaluation_projected",
        "rollback": "rollback_advisory", "retire": "retirement_advisory",
    }
    response: dict[str, Any] = {
        "ok": True,
        "schema_id": CONTINUOUS_COGNITION_SCHEMA_ID,
        "version": 1,
        "cognition_id": _opaque("cognition", request_scope["scope_digest"]),
        "operation": operation,
        "phase": phase_by_operation[operation],
        "decision": decision,
        "next_action": str(policy["next_action"]),
        "request_scope": request_scope,
        "observation": {
            "objective_graph_ref": _opaque("objective_graph", request["request_ref"]),
            "session_rollup_ref": _opaque("session_rollup", request["session_ref"]),
            "continuity_zero_ref": _opaque("continuity_zero", request["session_ref"]),
            "proof_timeline_ref": proof_timeline_ref,
            "retrieval_plan_ref": _opaque("retrieval_plan", request["request_ref"]),
            "utility_snapshot_ref": "ref_utility_snapshot_unavailable",
            "lifecycle_proof_ref": "ref_lifecycle_proof_unavailable",
            "source_anchor_digest": source_anchor_digest,
            "source_complete": not material_gap,
            "gaps": gaps,
        },
        "frontier": {
            "frontier_id": _opaque("frontier", source_anchor_digest),
            "objective_state": "active",
            "uncertainty": 1.0 if material_gap else 0.25,
            "next_action_class": str(policy["next_action"]),
            "utility_score": 0.0,
            "expected_utility": {
                "action_change_probability": 0.0,
                "consequence_if_wrong": 0.0,
                "evidence_reliability": 0.0,
                "acquisition_cost": 0.0,
                "score": 0.0,
            },
            "stop_reason": "source_gap" if material_gap else "bounded_frontier",
        },
        "investigation": {
            "state": "not_executed" if operation == "investigate" else "not_requested",
            "mode": "read_only_investigation" if operation == "investigate" else "read_only",
            "context_pack_ref": "ref_context_pack_unavailable",
            "retrieval_receipt_ref": "ref_retrieval_receipt_unavailable",
            "source_coverage": {
                "retrieval_count": 0,
                "compiler_count": 0,
                "evidence_ref_count": 0,
                "scanned_count": 0,
                "truncated": False,
            },
            "mutations_suppressed": True,
            "execution_performed": False,
            "network_calls": 0,
        },
        "activation": {
            "state": "inactive",
            "prep_id": "ref_context_prep_unavailable",
            "approval_ref": "ref_approval_unavailable",
            "authorization_ref": "ref_authorization_unavailable",
            "execution_owner": "external_cli_worker",
            "one_shot": True,
