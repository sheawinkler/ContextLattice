        },
        "retirement": {
            "state": "not_recommended" if operation == "retire" else "not_requested",
            "reason_ref": "ref_retirement_reason_unavailable",
            "target_ref": "ref_retirement_target_unavailable",
        },
        "progress": {
            "status": progress_by_operation[operation],
            "stage": phase_by_operation[operation],
            "round": 0,
            "max_rounds": 3,
            "proof_timeline_ref": proof_timeline_ref,
            "loop_guard": {
                "cycle_ref": request_scope["cycle_ref"],
                "source_anchor_digest": source_anchor_digest,
                "round": 0,
                "max_rounds": 3,
                "dedupe_decision": "not_persisted",
                "persisted": False,
            },
        },
        "safety": {
            "advisory_only": True,
            "automatic_model_execution": False,
