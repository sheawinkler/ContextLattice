#!/usr/bin/env python3
"""Find likely repeated instruction lines across AGENTS.md and skills."""

from __future__ import annotations

import argparse
from collections import defaultdict
from pathlib import Path

from _common import DEFAULT_SCAN_FILES, HOME, REPO_ROOT, emit, normalize_rule, read_text, skill_files


def expected_duplicate(paths: set[str]) -> str | None:
    resolved = {str(Path(path).resolve()) for path in paths}
    hook_pair = {
        str((HOME / ".codex" / "hooks.json").resolve()),
        str((REPO_ROOT / "config" / "codex" / "hooks.json").resolve()),
    }
    if resolved == hook_pair:
        return "live_hook_config_matches_repo_template"

    if len(resolved) == 2:
        system_roots = [
            (HOME / ".codex" / "skills" / ".system").resolve(),
            (HOME / ".codex-pro-2" / "skills" / ".system").resolve(),
        ]
        rels: list[Path] = []
        for path_s in resolved:
            path = Path(path_s)
            matched = False
            for root in system_roots:
                try:
                    rels.append(path.relative_to(root))
                    matched = True
                    break
                except ValueError:
                    continue
            if not matched:
                return None
        if len(set(rels)) == 1:
            return "mirrored_system_skill_across_codex_homes"
    return None


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--pretty", action="store_true")
    parser.add_argument("--min-chars", type=int, default=48)
    parser.add_argument("--include-expected", action="store_true")
    args = parser.parse_args()

    sources = [p for p in DEFAULT_SCAN_FILES if p.exists()] + skill_files()
    hits: dict[str, list[str]] = defaultdict(list)
    for path in sources:
        for line in read_text(path).splitlines():
            norm = normalize_rule(line)
            if len(norm) >= args.min_chars and any(w in norm for w in ("contextlattice", "never", "always", "must", "do not", "run", "write", "test")):
                hits[norm].append(str(path))

    duplicates = []
    expected = []
    for rule, paths in hits.items():
        unique_paths = set(paths)
        if len(unique_paths) <= 1:
            continue
        item = {"rule": rule, "count": len(unique_paths), "paths": sorted(unique_paths)}
        reason = expected_duplicate(unique_paths)
        if reason:
            item["expected"] = reason
            expected.append(item)
        else:
            duplicates.append(item)
    duplicates.sort(key=lambda item: (-item["count"], item["rule"]))
    expected.sort(key=lambda item: (-item["count"], item["rule"]))
    payload = {
        "ok": True,
        "duplicates": duplicates[:200],
        "total_duplicates": len(duplicates),
        "expected_duplicate_count": len(expected),
    }
    if args.include_expected:
        payload["expected_duplicates"] = expected[:200]
    emit(payload, args.pretty)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
