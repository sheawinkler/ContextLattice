#!/usr/bin/env python3
"""Generate typed contract constants from the shared agent contract registry."""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any

SCRIPT_DIR = Path(__file__).resolve().parent
REPO_ROOT = SCRIPT_DIR.parents[1]
REGISTRY_PATH = REPO_ROOT / "config" / "agent_contracts" / "agent_output_contracts.json"
GO_TARGET = REPO_ROOT / "services" / "gateway-go" / "agent_contracts_generated.go"
RUST_TARGET = REPO_ROOT / "crates" / "context_codec" / "src" / "agent_contracts_generated.rs"


def load_registry() -> dict[str, Any]:
    payload = json.loads(REGISTRY_PATH.read_text(encoding="utf-8"))
    if not isinstance(payload, dict) or not isinstance(payload.get("contracts"), dict):
        raise ValueError(f"{REGISTRY_PATH} missing contracts object")
    return payload


def go_name(contract_id: str) -> str:
    parts = re.split(r"[^A-Za-z0-9]+", contract_id)
    return "GeneratedAgentContract" + "".join(part[:1].upper() + part[1:] for part in parts if part)


def go_string(value: str) -> str:
    return json.dumps(value)


def render_go(registry: dict[str, Any]) -> str:
    contracts = registry["contracts"]
    lines = [
        "// Code generated by scripts/agent/generate-agent-contract-types; DO NOT EDIT.",
        "",
        "package main",
        "",
        "type GeneratedAgentContractRef struct {",
        "\tSchemaID string",
        "\tPayloadKind string",
        "\tContractVersion int",
        "\tRequiredOutputMode string",
        "}",
        "",
        f"const GeneratedAgentContractRegistryID = {go_string(str(registry.get('registry_id') or ''))}",
        f"const GeneratedAgentContractRegistryVersion = {int(registry.get('registry_version') or 0)}",
        "",
    ]
    for contract_id in sorted(contracts):
        lines.append(f"const {go_name(contract_id)} = {go_string(contract_id)}")
    lines.extend(["", "var GeneratedAgentContractIDs = []string{"])
    for contract_id in sorted(contracts):
        lines.append(f"\t{go_name(contract_id)},")
    lines.extend(["}", "", "var GeneratedAgentContracts = []GeneratedAgentContractRef{"])
    for contract_id in sorted(contracts):
        contract = contracts[contract_id]
        lines.append("\t{")
        lines.append(f"\t\tSchemaID: {go_name(contract_id)},")
        lines.append(f"\t\tPayloadKind: {go_string(str(contract.get('payload_kind') or ''))},")
        lines.append(f"\t\tContractVersion: {int(contract.get('contract_version') or 0)},")
        lines.append(f"\t\tRequiredOutputMode: {go_string(str(contract.get('required_output_mode') or ''))},")
        lines.append("\t},")
    lines.extend(["}", ""])
    return "\n".join(lines)


def rust_name(contract_id: str) -> str:
    return re.sub(r"[^A-Za-z0-9]+", "_", contract_id).strip("_").upper()


def render_rust(registry: dict[str, Any]) -> str:
    contracts = registry["contracts"]
    lines = [
        "// Code generated by scripts/agent/generate-agent-contract-types; DO NOT EDIT.",
        "",
        "#[derive(Debug, Clone, Copy, PartialEq, Eq)]",
        "pub struct AgentContractRef {",
        "    pub schema_id: &'static str,",
        "    pub payload_kind: &'static str,",
        "    pub contract_version: u32,",
        "    pub required_output_mode: &'static str,",
        "}",
        "",
        f"pub const AGENT_CONTRACT_REGISTRY_ID: &str = {go_string(str(registry.get('registry_id') or ''))};",
        f"pub const AGENT_CONTRACT_REGISTRY_VERSION: u32 = {int(registry.get('registry_version') or 0)};",
        "",
    ]
    for contract_id in sorted(contracts):
        lines.append(f"pub const {rust_name(contract_id)}: &str = {go_string(contract_id)};")
    lines.extend(["", "pub const AGENT_CONTRACT_IDS: &[&str] = &["])
    for contract_id in sorted(contracts):
        lines.append(f"    {rust_name(contract_id)},")
    lines.extend(["];", "", "pub const AGENT_CONTRACTS: &[AgentContractRef] = &["])
    for contract_id in sorted(contracts):
        contract = contracts[contract_id]
        lines.append("    AgentContractRef {")
        lines.append(f"        schema_id: {rust_name(contract_id)},")
        lines.append(f"        payload_kind: {go_string(str(contract.get('payload_kind') or ''))},")
        lines.append(f"        contract_version: {int(contract.get('contract_version') or 0)},")
        lines.append(f"        required_output_mode: {go_string(str(contract.get('required_output_mode') or ''))},")
        lines.append("    },")
    lines.extend(
        [
            "];",
            "",
            "#[cfg(test)]",
            "mod tests {",
            "    use super::*;",
            "",
            "    #[test]",
            "    fn generated_contracts_are_present() {",
            "        assert_eq!(AGENT_CONTRACT_REGISTRY_ID, \"contextlattice_agent_output_contracts\");",
            "        assert_eq!(AGENT_CONTRACT_IDS.len(), AGENT_CONTRACTS.len());",
            "        assert!(AGENT_CONTRACT_IDS.contains(&POLICY_CONTEXT_PACKAGE_V1));",
            "        assert!(AGENT_CONTRACT_IDS.contains(&A2A_READINESS_PROFILE_V1));",
            "        assert!(AGENT_CONTRACT_IDS.contains(&CONTEXT_OVERFLOW_RECOVERY_V1));",
            "    }",
            "}",
            "",
        ]
    )
    return "\n".join(lines)


def maybe_format(path: Path) -> None:
    if path.suffix == ".go":
        subprocess.run(["gofmt", "-w", str(path)], check=False)
    elif path.suffix == ".rs":
        subprocess.run(["rustfmt", str(path)], check=False)


def formatted_content(path: Path, content: str) -> str:
    with tempfile.TemporaryDirectory() as tmp:
        tmp_path = Path(tmp) / path.name
        tmp_path.write_text(content, encoding="utf-8")
        maybe_format(tmp_path)
        return tmp_path.read_text(encoding="utf-8")


def write_if_changed(path: Path, content: str) -> None:
    content = formatted_content(path, content)
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists() and path.read_text(encoding="utf-8") == content:
        return
    path.write_text(content, encoding="utf-8")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--pretty", action="store_true")
    args = parser.parse_args()
    registry = load_registry()
    targets = {
        GO_TARGET: render_go(registry),
        RUST_TARGET: render_rust(registry),
    }
    stale: list[str] = []
    if args.check:
        for path, content in targets.items():
            content = formatted_content(path, content)
            if not path.exists() or path.read_text(encoding="utf-8") != content:
                stale.append(str(path.relative_to(REPO_ROOT)))
        payload = {"ok": not stale, "stale": stale}
        print(json.dumps(payload, indent=2 if args.pretty else None, sort_keys=True))
        return 1 if stale else 0
    for path, content in targets.items():
        write_if_changed(path, content)
    print(json.dumps({"ok": True, "generated": [str(path.relative_to(REPO_ROOT)) for path in targets]}, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
