#!/usr/bin/env python3
"""Write durable agent learning to ContextLattice."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import subprocess
import sys
import time
from pathlib import Path

from _common import HOME, REPO_ROOT, emit, ensure_agent_session, now_iso, read_text, request_json

sys.path.insert(0, str(REPO_ROOT / "scripts"))
from agent_contracts import attach_format_contract  # noqa: E402


KINDS = {"decision", "failure", "command", "assumption", "checkpoint", "runbook"}


def first_env(*names: str, fallback: str = "") -> str:
    for name in names:
        value = os.getenv(name, "").strip()
        if value:
            return value
    return fallback


def contract_writeback_payload(payload: dict[str, object]) -> dict[str, object]:
    return attach_format_contract("writeback_result.v1", payload)


def failure_payload(
    kind: str,
    project: str,
    topic_path: str,
    file_name: str,
    error: str,
    attempts: int,
) -> dict[str, object]:
    return contract_writeback_payload({
        "ok": False,
        "kind": kind,
        "project": project,
        "file": file_name,
        "topic_path": topic_path,
        "status": "failed_after_retries",
        "persisted": False,
        "structured_failure": True,
        "attempts": attempts,
        "error": error[:1000],
    })


def queue_dir() -> Path:
    return Path(os.getenv("CONTEXTLATTICE_WRITEBACK_QUEUE_DIR") or HOME / ".contextlattice" / "writeback_queue")


def enqueue_local_writeback(body: dict[str, object], kind: str, error: str) -> Path:
    root = queue_dir()
    root.mkdir(parents=True, exist_ok=True)
    raw = json.dumps(body, sort_keys=True, separators=(",", ":")).encode("utf-8")
    digest = hashlib.sha256(raw).hexdigest()[:16]
    stamp = now_iso().replace(":", "").replace("-", "")
    target = root / f"{stamp}_{digest}.json"
    tmp = target.with_suffix(".tmp")
    payload = {
        "schema_version": 1,
        "queued_at": now_iso(),
        "kind": kind,
        "last_error": error[:1000],
        "body": body,
    }
    tmp.write_text(json.dumps(payload, sort_keys=True, separators=(",", ":")) + "\n", encoding="utf-8")
    tmp.replace(target)
    return target


def trigger_self_heal(event: str) -> None:
    if os.getenv("CONTEXTLATTICE_TRIGGER_SELF_HEAL", "1").strip().lower() in {"0", "false", "no", "off"}:
        return
    script = REPO_ROOT / "scripts" / "orbstack_self_heal.sh"
    if not script.exists():
        return
    try:
        subprocess.Popen(
            ["bash", str(script), "run-once", "--event", event],
            cwd=str(REPO_ROOT),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception:
        return


def write_with_retries(body: dict[str, object], timeout: float, retries: int, retry_delay: float) -> tuple[dict[str, object] | None, str, int]:
    attempts = max(1, retries + 1)
    last_error = ""
    for attempt in range(1, attempts + 1):
        try:
            return request_json("POST", "/memory/write", body, timeout), "", attempt
        except SystemExit as exc:
            last_error = str(exc.code)
        except Exception as exc:
            last_error = str(exc)
        if attempt < attempts:
            time.sleep(max(0.0, retry_delay) * attempt)
    return None, last_error, attempts


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--project", default="contextlattice")
    parser.add_argument("--topic-path", required=True)
    parser.add_argument("--file", required=True)
    parser.add_argument("--kind", choices=sorted(KINDS), default="checkpoint")
    parser.add_argument("--content", default="")
    parser.add_argument("--content-file", default="")
    parser.add_argument("--stdin", action="store_true")
    parser.add_argument("--timeout", type=float, default=30)
    parser.add_argument("--strict", action="store_true", help="Deprecated compatibility flag; hard failure is the default.")
    parser.add_argument("--retries", type=int, default=3)
    parser.add_argument("--retry-delay", type=float, default=1.0)
    parser.add_argument("--pretty", action="store_true")
    args = parser.parse_args()

    content = args.content
    if args.content_file:
        content = read_text(Path(args.content_file))
    elif args.stdin:
        content = sys.stdin.read()
    content = content.strip()
    if len(content) < 12:
        emit({"ok": False, "error": "content_too_short_for_durable_write"}, args.pretty)
        return 2

    agent_id = first_env("GO_WRITE_DEFAULT_AGENT_ID", "CONTEXTLATTICE_AGENT_ID", "MEMMCP_AGENT_ID", fallback="codex_gpt5")
    session_id = first_env(
        "GO_WRITE_DEFAULT_SESSION_ID",
        "CONTEXTLATTICE_SESSION_ID",
        "MEMMCP_SESSION_ID",
        "LETTA_AUTO_SESSION_ID",
    )
    if not session_id:
        ensured = ensure_agent_session(
            project=args.project,
            objective=content[:240],
            agent_id=agent_id,
            agent="agent-cli",
            metadata={"tool": "writeback", "kind": args.kind, "topic_path": args.topic_path, "file": args.file},
            tags=["auto-session", "writeback", args.kind],
            timeout=min(float(args.timeout), 10.0),
            soft=True,
        )
        session_id = str(ensured.get("session_id") or "")
    if not session_id:
        session_id = "codex-default"

    body = {
        "projectName": args.project,
        "fileName": args.file,
        "topicPath": args.topic_path,
        "content": content,
        "agent_id": agent_id,
        "session_id": session_id,
        "created_at": now_iso(),
        "tags": ["agent-writeback", args.kind],
    }
    result, error, attempts = write_with_retries(body, args.timeout, max(0, args.retries), args.retry_delay)
    if result is None:
        queue_file = enqueue_local_writeback(body, args.kind, error)
        trigger_self_heal("writeback-failure")
        payload = failure_payload(args.kind, args.project, args.topic_path, args.file, error, attempts)
        payload["queued_local"] = True
        payload["queue_file"] = str(queue_file)
        payload = contract_writeback_payload(payload)
        emit(payload, args.pretty)
        return 1
    emit(
        contract_writeback_payload(
            {
                "ok": bool(result.get("ok", True)),
                "kind": args.kind,
                "project": args.project,
                "file": args.file,
                "topic_path": args.topic_path,
                "write": result,
            }
        ),
        args.pretty,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
