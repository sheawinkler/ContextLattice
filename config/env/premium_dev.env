# ContextLattice paid lane development profile (no secrets committed).
# Copy values into runtime env or load via your local env loader.

CONTEXTLATTICE_ENV=development
ORCH_SECURITY_STRICT=false
ORCH_PRODUCTION_REQUIRE_API_KEY=false
SECRETS_STORAGE_MODE=redact

# Entitlements: permissive in dev, strict in production.
GO_V4_ENTITLEMENT_MODE=off
GO_V4_ENTITLEMENT_DEV_ALLOW=true
GO_V4_ENTITLEMENT_KEY=
GO_V4_ENTITLEMENT_ALLOWED_PLANS=team,enterprise
GO_V4_ENTITLEMENT_ALLOWED_ROLES=owner,admin
GO_V4_ENTITLEMENT_PROTECTED_PATHS=/v1/inference/route,/v1/inference/chat,/v1/inference/embedding-policy,/maintenance/storage/run,/maintenance/telemetry/blob-gc,/migration/runtime

# Subscription gates: keep open in development.
DEFAULT_PLAN_ID=starter
REQUIRE_ACTIVE_SUBSCRIPTION=false
PRO_ANALYTICS_ALLOWED_ROLES=owner,admin
CONTEXTLATTICE_ADMIN_API_KEY=
CONTEXTLATTICE_DOWNLOAD_TOKEN_SECRET=
PREMIUM_DOWNLOAD_TOKEN_TTL_MINUTES=120
PREMIUM_DOWNLOAD_MACOS_URL=
PREMIUM_DOWNLOAD_WINDOWS_URL=
PREMIUM_DOWNLOAD_LINUX_URL=
PREMIUM_DOWNLOAD_MACOS_FILENAME=ContextLattice-premium-macOS.dmg
PREMIUM_DOWNLOAD_WINDOWS_FILENAME=ContextLattice-premium-windows-x64.msi
PREMIUM_DOWNLOAD_LINUX_FILENAME=ContextLattice-premium-linux.tar.gz

# Optional Sentrux structural-quality lane (operator-triggered).
CONTEXTLATTICE_SENTRUX_ENABLED=false
CONTEXTLATTICE_SENTRUX_STRICT_GATE=false
CONTEXTLATTICE_SENTRUX_BIN=sentrux
CONTEXTLATTICE_SENTRUX_TARGET_PATH=.
CONTEXTLATTICE_SENTRUX_MODE=check
GO_SENTRUX_TIMEOUT_SECS=20
GO_SENTRUX_MAX_OUTPUT_BYTES=12000

# Billing providers (set keys as needed while testing).
STRIPE_ENABLED=true
APPLE_PAY_ENABLED=true
GOOGLE_PAY_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=

PAYPAL_ENABLED=true
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Coinbase Commerce disabled by default (not in current paid launch scope).
COINBASE_COMMERCE_ENABLED=false
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=

KRAKEN_PAY_ENABLED=true
KRAKEN_PAY_ADDRESS=
KRAKEN_PAY_ASSET=USDC
KRAKEN_PAY_NOTE=ContextLattice subscription

SOLANA_PAY_ENABLED=true
SOLPAY_RECIPIENT=
SOLPAY_SPL_TOKEN=
SOLPAY_LABEL=ContextLattice
SOLPAY_MESSAGE=ContextLattice subscription
SOLPAY_MEMO=contextlattice-subscription
