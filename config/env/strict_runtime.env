ORCH_STORAGE_GOVERNANCE_RETENTION_MULTIPLIER_HIGH=2.5
ORCH_STORAGE_GOVERNANCE_RUN_ON_STARTUP=true
ORCH_STORAGE_GOVERNANCE_SQLITE_LEGACY_PRUNE_ENABLED=true
ORCH_STORAGE_GOVERNANCE_SQLITE_LEGACY_MAX_ROWS=5000
ORCH_STORAGE_GOVERNANCE_SQLITE_LEGACY_MAX_BYTES=536870912
