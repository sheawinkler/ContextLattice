# ContextLattice strict runtime tuning lock.
# Source-of-truth for critical runtime path + retrieval guardrails.
# Do not edit these values in .env directly; update this file instead.

# Runtime cutover defaults (Go + Rust primary, Python fallback legacy)
USE_RUST_CODEC=true
USE_RUST_MEMORY=true
USE_RUST_RETRIEVAL=true
USE_GO_ORCHESTRATOR=true
CONTEXTLATTICE_ENGINE_MODE=service
ORCHESTRATOR_PORT=18075
GO_GATEWAY_HOST_PORT=8075
ORCH_RUST_RETRIEVAL_VECTOR_BACKEND=qdrant_remote
ORCH_RUST_RETRIEVAL_LEXICAL_BACKEND=tantivy_lexical

# Model baseline (B lane)
TASK_MODEL_PROVIDER=ollama
TASK_MODEL=qwen3.5:9b
LETTA_AGENT_MODEL=ollama/qwen3.5:9b
CONTEXTLATTICE_AGENT_ID=codex_gpt5
MEMMCP_AGENT_ID=codex_gpt5
CONTEXT_EXPANSION_ENABLED=true
CONTEXT_EXPANSION_MIN_RESULTS=3
CONTEXT_EXPANSION_MIN_FACTS=3
CONTEXT_EXPANSION_MAX_RESULTS=12
CONTEXT_EXPANSION_MAX_FACTS=24
CONTEXT_EXPANSION_L0_BUDGET_TOKENS=1200
CONTEXT_EXPANSION_L1_BUDGET_TOKENS=800
CONTEXT_EXPANSION_L2_BUDGET_TOKENS=400
CONTEXT_EXPANSION_PROMPT_BUDGET_CHARS=18000
CONTEXT_EXPANSION_TOOL_SLICE_FACTS=6
CONTEXT_EXPANSION_DEEP_ESCALATION_ENABLED=true
CONTEXT_EXPANSION_DEEP_POLL_SECS=8
CONTEXT_EXPANSION_DEEP_POLL_INTERVAL_SECS=1.5

# Retrieval execution policy
GO_RETRIEVAL_STAGED_ENABLED=true
GO_RETRIEVAL_SUBCALL_DISABLE_EXPANSION=true
GO_RETRIEVAL_SUBCALL_DISABLE_AUTO_ESCALATE=true
GO_RETRIEVAL_CONTINUATION_MAX_INFLIGHT=8
GO_RETRIEVAL_LEXICAL_GUARD_ENABLED=true
GO_RETRIEVAL_LEXICAL_GUARD_MIN_COVERAGE=0.55
GO_RETRIEVAL_LEXICAL_GUARD_MIN_RESULTS=1
GO_RETRIEVAL_RUST_QUALITY_FALLBACK_ENABLED=true
GO_RETRIEVAL_RUST_QUALITY_FALLBACK_SOURCES=qdrant,topic_rollups
GO_RETRIEVAL_RUST_QUALITY_FALLBACK_MODE=balanced
ORCH_RETRIEVAL_RUST_QUALITY_FALLBACK_ENABLED=true
ORCH_RETRIEVAL_RUST_QUALITY_FALLBACK_SOURCES=qdrant,topic_rollups
ORCH_RETRIEVAL_RUST_QUALITY_FALLBACK_MODE=balanced
ORCH_RETRIEVAL_SOURCES=qdrant,postgres_pgvector,mongo_raw,mindsdb,topic_rollups,letta,memory_bank
ORCH_RETRIEVAL_INTENT_DECISION_SOURCES=topic_rollups,qdrant,postgres_pgvector,memory_bank,mindsdb,mongo_raw,letta
ORCH_RETRIEVAL_INTENT_OPS_SOURCES=topic_rollups,qdrant,postgres_pgvector,memory_bank,mindsdb,mongo_raw,letta
ORCH_RETRIEVAL_INTENT_RAW_SOURCES=mongo_raw,memory_bank,qdrant,postgres_pgvector,mindsdb,topic_rollups,letta
ORCH_RETRIEVAL_ENABLE_STAGED_FETCH=true
ORCH_RETRIEVAL_SYNC_ASYNC_SPLIT_ENABLED=true
ORCH_RETRIEVAL_SYNC_ASYNC_DEEP_BLOCKING=false
ORCH_RETRIEVAL_SYNC_SLOW_REQUIRES_EXPLICIT=true
ORCH_RETRIEVAL_STRICT_FAST_SYNC_DEFAULT=true
ORCH_RETRIEVAL_FAST_SOURCES=topic_rollups,qdrant,postgres_pgvector
ORCH_RETRIEVAL_SLOW_SOURCES=mindsdb,mongo_raw,letta,memory_bank
ORCH_RETRIEVAL_MEMORY_BANK_DEFAULT_ENABLED=true
ORCH_RETRIEVAL_PGVECTOR_TIMEOUT_SECS=3
ORCH_RETRIEVAL_PGVECTOR_SCAN_LIMIT=320
ORCH_RETRIEVAL_LETTA_TIMEOUT_SECS=60
ORCH_RECALL_E2E_BUDGET_DEEP_SECS=75
ORCH_RECALL_TIMEOUT_ADAPTIVE_SKIP_SOURCES=qdrant,postgres_pgvector,mindsdb,mongo_raw
ORCH_RECALL_EVAL_REFRESH_SOURCES=qdrant,postgres_pgvector,topic_rollups
CONTEXTLATTICE_READ_TIMEOUT_SECS=75
ORCH_RECALL_DEEP_ASYNC_DEFAULT_FOR_DEEP=true
ORCH_RECALL_DEEP_ASYNC_PARTIAL_ENABLED=true
ORCH_RECALL_DEEP_ASYNC_PARTIAL_MODE=fast
ORCH_RECALL_DEEP_ASYNC_PERSIST_ENABLED=true
ORCH_RECALL_DEEP_ASYNC_STORE_BACKEND=mongo
ORCH_RECALL_DEEP_ASYNC_RECOVER_ON_STARTUP=true
ORCH_RETRIEVAL_FAIL_OPEN_TIMEOUT_CONTINUATION_ENABLED=true
ORCH_RETRIEVAL_FAIL_OPEN_TIMEOUT_CONTINUATION_SOURCES=letta,memory_bank,qdrant
ORCH_RETRIEVAL_MONGO_RAW_DEEP_SYNC_ONLY_FOR_RAW_INTENT=true
ORCH_RETRIEVAL_MONGO_RAW_DEEP_ASYNC_WARM_NON_RAW=true
ORCH_QDRANT_FILTERLESS_LIMIT_CAP=96
ORCH_QDRANT_WARMUP_ENABLED=true
ORCH_RETRIEVAL_BACKLOG_GATING_ENABLED=true
ORCH_RETRIEVAL_BACKLOG_GATING_TARGETS=letta
ORCH_RETRIEVAL_BACKLOG_GATING_LETTA_ASYNC_WARM_ENABLED=true
ORCH_RETRIEVAL_BACKLOG_GATING_LETTA_OUTSTANDING_MAX=700
ORCH_RETRIEVAL_BACKLOG_GATING_LETTA_RETRYING_MAX=250
ORCH_RETRIEVAL_LETTA_DEGRADED_TIMEOUT_SECS=45
ORCH_RETRIEVAL_MEMORY_DEGRADED_TIMEOUT_SECS=30
ORCH_RETRIEVAL_PATHWAY_CACHE_BACKEND=redis_mirror
ORCH_RETRIEVAL_PATHWAY_REDIS_URL=redis://lf-redis:6379/0
ORCH_RETRIEVAL_PATHWAY_REDIS_AUTH=change_me
ORCH_PGVECTOR_ENABLED=true
ORCH_PGVECTOR_DSN=postgresql://postgres:postgres@pgvector-db:5432/contextlattice
ORCH_PGVECTOR_TABLE=memory_events
ORCH_PGVECTOR_EMBED_DIM=768
ORCH_PGVECTOR_POOL_MIN_SIZE=1
ORCH_PGVECTOR_POOL_MAX_SIZE=12
ORCH_PGVECTOR_CONNECT_TIMEOUT_SECS=8
ORCH_PGVECTOR_STATEMENT_TIMEOUT_SECS=6
ORCH_PGVECTOR_IVFFLAT_LISTS=100
ORCH_PGVECTOR_PREFER_VECTORSCALE=true
ORCH_PGVECTOR_FANOUT_ENABLED=true
ORCH_MEMORY_BANK_SEARCH_BACKEND=icm_spike
ORCH_MEMORY_BANK_SPIKE_FALLBACK_BACKEND=surrealdb_spike
ORCH_MEMORY_BANK_SPIKE_FALLBACK_BACKENDS=surrealdb_spike,memvid_spike,shodh_spike,quickwit_spike
ORCH_MEMORY_BANK_SPIKE_HTTP_URL=http://memory-bank-spike-rs:8096
ORCH_MEMORY_BANK_SPIKE_SEARCH_ROUTE=/search
ORCH_MEMORY_BANK_SPIKE_TIMEOUT_SECS=1.5
ORCH_MEMORY_BANK_SPIKE_TIMEOUT_SECS_ICM=0.85
ORCH_MEMORY_BANK_SPIKE_FALLBACK_TO_NATIVE=true
ORCH_MEMORY_BANK_SPIKE_EMPTY_RESULT_FALLBACK=true
MEMORY_BANK_SPIKE_RS_EXTERNAL_TIMEOUT_SECS=3
MEMORY_BANK_SPIKE_RS_EXTERNAL_TIMEOUT_SECS_ICM=1
MEMORY_BANK_SPIKE_RS_MEILI_TASK_TIMEOUT_SECS=30
MEMORY_BANK_SPIKE_RS_ICM_URL=http://icm-spike-adapter:8100
MEMORY_BANK_SPIKE_RS_ICM_SEARCH_ROUTE=/search
MEMORY_BANK_SPIKE_RS_ICM_API_KEY=
MEMORY_BANK_SPIKE_RS_SHODH_URL=http://shodh-spike-adapter:8101
MEMORY_BANK_SPIKE_RS_SHODH_SEARCH_ROUTE=/search
MEMORY_BANK_SPIKE_RS_SHODH_API_KEY=
MEMORY_BANK_SPIKE_RS_MEMVID_URL=http://memvid-spike-adapter:8102
MEMORY_BANK_SPIKE_RS_MEMVID_SEARCH_ROUTE=/search
MEMORY_BANK_SPIKE_RS_MEMVID_API_KEY=
MEMORY_BANK_SPIKE_RS_SURREALDB_URL=http://surrealdb-spike-adapter:8103
MEMORY_BANK_SPIKE_RS_SURREALDB_SEARCH_ROUTE=/search
MEMORY_BANK_SPIKE_RS_SURREALDB_API_KEY=

# Telemetry hygiene / retention guardrails
ORCH_MEMORY_BANK_TELEMETRY_GUARD_ENABLED=true
ORCH_MEMORY_BANK_TELEMETRY_TOPIC_PREFIXES=telemetry,metrics,signals,overrides
ORCH_MEMORY_BANK_TELEMETRY_MARKERS=telemetry,metrics,__state__,__stats__,__snapshots__,__health__,__allocations__,_agg-,queue__
ORCH_QDRANT_TELEMETRY_GUARD_ENABLED=true
ORCH_PGVECTOR_TELEMETRY_GUARD_ENABLED=true
ORCH_MINDSDB_TELEMETRY_GUARD_ENABLED=true
ORCH_LETTA_TELEMETRY_GUARD_ENABLED=true
FANOUT_PGVECTOR_RATE_LIMIT_PER_SEC=20
FANOUT_PGVECTOR_BULK_SIZE=16
FANOUT_COALESCE_TARGETS=qdrant,postgres_pgvector,mindsdb,letta,langfuse
ORCH_QDRANT_PAYLOAD_INDEX_HARDEN_ENABLED=true
ORCH_QDRANT_PAYLOAD_INDEX_HARDEN_ON_STARTUP=true
ORCH_QDRANT_PAYLOAD_INDEX_HARDEN_WAIT=false
ORCH_TELEMETRY_DB=memmcp_raw
ORCH_TELEMETRY_COLLECTION=retrieval_telemetry
ORCH_TELEMETRY_PERSIST_ENABLED=true
SINK_RETENTION_ENABLED=true
MINDSDB_LOW_VALUE_RETENTION_HOURS=48
LETTA_LOW_VALUE_RETENTION_HOURS=48
