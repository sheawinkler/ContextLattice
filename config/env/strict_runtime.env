# ContextLattice strict runtime tuning lock.
# Source-of-truth for critical runtime path + retrieval guardrails.
# Do not edit these values in .env directly; update this file instead.

# Runtime cutover defaults (Go + Rust primary, Python fallback legacy)
USE_RUST_CODEC=true
USE_RUST_MEMORY=true
USE_RUST_RETRIEVAL=true
USE_GO_ORCHESTRATOR=true
CONTEXTLATTICE_ENGINE_MODE=service
ORCHESTRATOR_PORT=18075
GO_GATEWAY_HOST_PORT=8075
ORCH_RUST_RETRIEVAL_VECTOR_BACKEND=qdrant_remote
ORCH_RUST_RETRIEVAL_LEXICAL_BACKEND=tantivy_lexical

# Model baseline (B lane)
TASK_MODEL_PROVIDER=auto
ORCH_INFER_PROVIDER=auto
TASK_MODEL=qwen3.5:9b
TASK_OLLAMA_COREML_ON_M_SERIES=true
ORCH_ANE_SIDECAR_ENABLED=true
ORCH_ANE_SIDECAR_URL=http://127.0.0.1:9099
ORCH_ANE_SIDECAR_API_KEY=
ORCH_ANE_SIDECAR_TIMEOUT_SECS=20
ORCH_ANE_SIDECAR_CONNECT_TIMEOUT_SECS=2
ORCH_ANE_SIDECAR_RETRIES=1
ORCH_ANE_SIDECAR_RETRY_BACKOFF_SECS=0.25
ORCH_ANE_SIDECAR_FALLBACK_ENABLED=true
ORCH_ANE_SIDECAR_HEALTH_TTL_SECS=10
ORCH_ANE_SIDECAR_REQUIRE_M_SERIES=true
LETTA_AGENT_MODEL=ollama/qwen3.5:9b
CONTEXTLATTICE_AGENT_ID=codex_gpt5
MEMMCP_AGENT_ID=codex_gpt5
CONTEXT_EXPANSION_ENABLED=true
CONTEXT_EXPANSION_MIN_RESULTS=3
CONTEXT_EXPANSION_MIN_FACTS=3
CONTEXT_EXPANSION_MAX_RESULTS=12
CONTEXT_EXPANSION_MAX_FACTS=24
CONTEXT_EXPANSION_L0_BUDGET_TOKENS=1200
CONTEXT_EXPANSION_L1_BUDGET_TOKENS=800
CONTEXT_EXPANSION_L2_BUDGET_TOKENS=400
CONTEXT_EXPANSION_PROMPT_BUDGET_CHARS=18000
CONTEXT_EXPANSION_TOOL_SLICE_FACTS=6
CONTEXT_EXPANSION_DEEP_ESCALATION_ENABLED=true
CONTEXT_EXPANSION_DEEP_POLL_SECS=8
CONTEXT_EXPANSION_DEEP_POLL_INTERVAL_SECS=1.5

# Retrieval execution policy
GO_RETRIEVAL_STAGED_ENABLED=true
GO_PYTHON_HOT_PATH_OWNERSHIP_MODE=warn
ORCH_PYTHON_HOT_PATH_OWNERSHIP_MODE=warn
GO_RETRIEVAL_SUBCALL_DISABLE_EXPANSION=true
GO_RETRIEVAL_SUBCALL_DISABLE_AUTO_ESCALATE=true
GO_RETRIEVAL_CONTINUATION_MAX_INFLIGHT=8
GO_RETRIEVAL_LEXICAL_GUARD_ENABLED=true
GO_RETRIEVAL_LEXICAL_GUARD_MIN_COVERAGE=0.55
GO_RETRIEVAL_LEXICAL_GUARD_MIN_RESULTS=1
GO_RETRIEVAL_RUST_QUALITY_FALLBACK_ENABLED=true
GO_RETRIEVAL_RUST_QUALITY_FALLBACK_SOURCES=qdrant,topic_rollups
GO_RETRIEVAL_RUST_QUALITY_FALLBACK_MODE=balanced
ORCH_RETRIEVAL_RUST_QUALITY_FALLBACK_ENABLED=true
ORCH_RETRIEVAL_RUST_QUALITY_FALLBACK_SOURCES=qdrant,topic_rollups
ORCH_RETRIEVAL_RUST_QUALITY_FALLBACK_MODE=balanced
DOCKER_VM_RSS_GUARD_ENABLED=true
DOCKER_VM_RSS_GUARD_INTERVAL_SECS=20
DOCKER_VM_RSS_GUARD_ACTION_COOLDOWN_SECS=90
DOCKER_VM_RSS_GUARD_HIGH_GIB=2.0
DOCKER_VM_RSS_GUARD_LOW_GIB=1.2
DOCKER_VM_RSS_GUARD_CONTAINER_HIGH_GIB=20.0
DOCKER_VM_RSS_GUARD_CONTAINER_LOW_GIB=14.0
DOCKER_VM_RSS_GUARD_AUTO_RESUME=true
DOCKER_VM_RSS_GUARD_USE_LAUNCHD=true
DOCKER_VM_RSS_GUARD_LAUNCHD_LABEL=io.contextlattice.docker-vm-rss-guard
DOCKER_VM_RSS_GUARD_TARGET_SERVICES=lancedb-spike-adapter,trieve-spike-adapter,helixdb-spike-adapter,shodh-spike-adapter,memvid-spike-adapter,surrealdb-spike-adapter
# V4 paid entitlement gate defaults (local-safe)
GO_V4_ENTITLEMENT_MODE=off
GO_V4_ENTITLEMENT_DEV_ALLOW=true
GO_V4_ENTITLEMENT_FAILURE_MODE=deny
GO_V4_ENTITLEMENT_ALLOWED_PLANS=team,enterprise
GO_V4_ENTITLEMENT_ALLOWED_ROLES=owner,admin
GO_V4_ENTITLEMENT_KEY=
GO_V4_ENTITLEMENT_PROTECTED_PATHS=/v1/inference/route,/v1/inference/chat,/v1/inference/embedding-policy,/maintenance/storage/run,/maintenance/telemetry/blob-gc,/migration/runtime
GO_V4_MACHINE_BINDING_ENABLED=false
GO_V4_MACHINE_BINDING_FAIL_OPEN=true
GO_V4_MACHINE_BINDING_STATE_PATH=./tmp/gateway-go/machine_binding_state.json
GO_V4_MACHINE_BINDING_HEADER=X-ContextLattice-Machine-ID
GO_V4_MACHINE_BINDING_QUERY_KEYS=machine_id,device_id
GO_V4_MACHINE_BINDING_GRACE_SECS=259200
GO_V4_MACHINE_BINDING_AUTO_BIND=true
GO_V4_MACHINE_BINDING_ALLOW_REBIND_AFTER_GRACE=true
ORCH_RETRIEVAL_SOURCES=qdrant,weaviate,postgres_pgvector,mongo_raw,mindsdb,topic_rollups,letta,memory_bank
ORCH_RETRIEVAL_INTENT_DECISION_SOURCES=topic_rollups,qdrant,weaviate,postgres_pgvector,memory_bank,mindsdb,mongo_raw,letta
ORCH_RETRIEVAL_INTENT_OPS_SOURCES=topic_rollups,qdrant,weaviate,postgres_pgvector,memory_bank,mindsdb,mongo_raw,letta
ORCH_RETRIEVAL_INTENT_RAW_SOURCES=mongo_raw,memory_bank,qdrant,weaviate,postgres_pgvector,mindsdb,topic_rollups,letta
ORCH_RETRIEVAL_ENABLE_STAGED_FETCH=true
ORCH_RETRIEVAL_SYNC_ASYNC_SPLIT_ENABLED=true
ORCH_RETRIEVAL_SYNC_ASYNC_DEEP_BLOCKING=false
ORCH_RETRIEVAL_SYNC_SLOW_REQUIRES_EXPLICIT=true
ORCH_RETRIEVAL_STRICT_FAST_SYNC_DEFAULT=true
ORCH_RETRIEVAL_FAST_SOURCES=topic_rollups,qdrant,weaviate,postgres_pgvector
ORCH_RETRIEVAL_SLOW_SOURCES=mindsdb,mongo_raw,letta,memory_bank
ORCH_WEAVIATE_ENABLED=false
ORCH_RETRIEVAL_WEAVIATE_TIMEOUT_SECS=4
ORCH_RETRIEVAL_MEMORY_BANK_DEFAULT_ENABLED=true
ORCH_RETRIEVAL_PGVECTOR_TIMEOUT_SECS=4
ORCH_RETRIEVAL_PGVECTOR_SCAN_LIMIT=320
ORCH_RETRIEVAL_LETTA_TIMEOUT_SECS=25
ORCH_RECALL_E2E_BUDGET_DEEP_SECS=75
ORCH_RECALL_TIMEOUT_ADAPTIVE_SKIP_SOURCES=qdrant,weaviate,postgres_pgvector,mindsdb,mongo_raw
ORCH_RECALL_EVAL_REFRESH_SOURCES=qdrant,weaviate,postgres_pgvector,topic_rollups
CONTEXTLATTICE_READ_TIMEOUT_SECS=75
ORCH_RECALL_DEEP_ASYNC_DEFAULT_FOR_DEEP=true
ORCH_RECALL_DEEP_ASYNC_PARTIAL_ENABLED=true
ORCH_RECALL_DEEP_ASYNC_PARTIAL_MODE=fast
ORCH_RECALL_DEEP_ASYNC_PERSIST_ENABLED=true
ORCH_RECALL_DEEP_ASYNC_STORE_BACKEND=mongo
ORCH_RECALL_DEEP_ASYNC_RECOVER_ON_STARTUP=true
ORCH_RETRIEVAL_FAIL_OPEN_TIMEOUT_CONTINUATION_ENABLED=true
ORCH_RETRIEVAL_FAIL_OPEN_TIMEOUT_CONTINUATION_SOURCES=letta,memory_bank,qdrant
ORCH_RETRIEVAL_MONGO_RAW_DEEP_SYNC_ONLY_FOR_RAW_INTENT=true
ORCH_RETRIEVAL_MONGO_RAW_DEEP_ASYNC_WARM_NON_RAW=true
ORCH_QDRANT_FILTERLESS_LIMIT_CAP=96
ORCH_QDRANT_WARMUP_ENABLED=true
ORCH_QDRANT_DIMENSION_POLICY=rollover
ORCH_QDRANT_DIMENSION_SUFFIX=__d
ORCH_RETRIEVAL_BACKLOG_GATING_ENABLED=true
ORCH_RETRIEVAL_BACKLOG_GATING_TARGETS=letta
ORCH_RETRIEVAL_BACKLOG_GATING_LETTA_ASYNC_WARM_ENABLED=true
ORCH_RETRIEVAL_BACKLOG_GATING_LETTA_OUTSTANDING_MAX=700
ORCH_RETRIEVAL_BACKLOG_GATING_LETTA_RETRYING_MAX=250
ORCH_RETRIEVAL_LETTA_DEGRADED_TIMEOUT_SECS=45
ORCH_RETRIEVAL_LETTA_TOP_K_FACTOR=2.0
ORCH_RETRIEVAL_LETTA_TOP_K_CAP=24
ORCH_RETRIEVAL_LETTA_TOP_K_FACTOR_FAST=1.25
ORCH_RETRIEVAL_LETTA_TOP_K_FACTOR_BALANCED=1.5
ORCH_RETRIEVAL_LETTA_TOP_K_FACTOR_DEEP=2.0
ORCH_RETRIEVAL_LETTA_TOP_K_CAP_FAST=12
ORCH_RETRIEVAL_LETTA_TOP_K_CAP_BALANCED=18
ORCH_RETRIEVAL_LETTA_TOP_K_CAP_DEEP=24
ORCH_RETRIEVAL_MEMORY_DEGRADED_TIMEOUT_SECS=30
ORCH_RETRIEVAL_PATHWAY_CACHE_BACKEND=redis_mirror
ORCH_RETRIEVAL_PATHWAY_REDIS_URL=redis://lf-redis:6379/0
ORCH_RETRIEVAL_PATHWAY_REDIS_AUTH=change_me
ORCH_PGVECTOR_ENABLED=true
ORCH_PGVECTOR_DSN=postgresql://postgres:postgres@pgvector-db:5432/contextlattice?sslmode=disable
ORCH_PGVECTOR_TABLE=memory_events
ORCH_PGVECTOR_EMBED_DIM=768
ORCH_PGVECTOR_POOL_MIN_SIZE=1
ORCH_PGVECTOR_POOL_MAX_SIZE=12
ORCH_PGVECTOR_CONNECT_TIMEOUT_SECS=8
ORCH_PGVECTOR_STATEMENT_TIMEOUT_SECS=8
ORCH_PGVECTOR_IVFFLAT_LISTS=100
ORCH_PGVECTOR_PREFER_VECTORSCALE=true
ORCH_PGVECTOR_FANOUT_ENABLED=true
ORCH_MEMORY_BANK_SEARCH_BACKEND=shodh_spike
ORCH_MEMORY_BANK_SPIKE_FALLBACK_BACKEND=surrealdb_spike
ORCH_MEMORY_BANK_SPIKE_FALLBACK_BACKENDS=surrealdb_spike,memvid_spike,icm_spike,quickwit_spike
ORCH_MEMORY_BANK_SPIKE_HTTP_URL=http://memory-bank-spike-rs:8096
ORCH_MEMORY_BANK_SPIKE_SEARCH_ROUTE=/search
ORCH_MEMORY_BANK_SPIKE_TIMEOUT_SECS=1.5
ORCH_MEMORY_BANK_SPIKE_TIMEOUT_SECS_ICM=0.85
ORCH_MEMORY_BANK_SPIKE_FALLBACK_TO_NATIVE=true
ORCH_MEMORY_BANK_SPIKE_EMPTY_RESULT_FALLBACK=true
ORCH_MEMORY_BANK_SPIKE_MAX_CHAIN_BACKENDS=3
ORCH_MEMORY_BANK_SPIKE_HEDGE_ENABLED=false
ORCH_MEMORY_BANK_SPIKE_HEDGE_MAX_PARALLEL=2
ORCH_MEMORY_BANK_SPIKE_HEDGE_BACKENDS=shodh_spike,surrealdb_spike
MEMORY_BANK_SPIKE_RS_EXTERNAL_TIMEOUT_SECS=3
MEMORY_BANK_SPIKE_RS_EXTERNAL_TIMEOUT_SECS_ICM=1
MEMORY_BANK_SPIKE_RS_MEILI_TASK_TIMEOUT_SECS=30
MEMORY_BANK_SPIKE_RS_ICM_URL=http://icm-spike-adapter:8100
MEMORY_BANK_SPIKE_RS_ICM_SEARCH_ROUTE=/search
MEMORY_BANK_SPIKE_RS_ICM_API_KEY=
MEMORY_BANK_SPIKE_RS_SHODH_URL=http://shodh-spike-adapter:8101
MEMORY_BANK_SPIKE_RS_SHODH_SEARCH_ROUTE=/search
MEMORY_BANK_SPIKE_RS_SHODH_API_KEY=
MEMORY_BANK_SPIKE_RS_MEMVID_URL=http://memvid-spike-adapter:8102
MEMORY_BANK_SPIKE_RS_MEMVID_SEARCH_ROUTE=/search
MEMORY_BANK_SPIKE_RS_MEMVID_API_KEY=
MEMORY_BANK_SPIKE_RS_SURREALDB_URL=http://surrealdb-spike-adapter:8103
MEMORY_BANK_SPIKE_RS_SURREALDB_SEARCH_ROUTE=/search
MEMORY_BANK_SPIKE_RS_SURREALDB_API_KEY=

# Telemetry hygiene / retention guardrails
ORCH_MEMORY_BANK_TELEMETRY_GUARD_ENABLED=true
ORCH_MEMORY_BANK_TELEMETRY_TOPIC_PREFIXES=telemetry,metrics,signals,overrides
ORCH_MEMORY_BANK_TELEMETRY_MARKERS=telemetry,metrics,__state__,__stats__,__snapshots__,__health__,__allocations__,_agg-,queue__
ORCH_QDRANT_TELEMETRY_GUARD_ENABLED=true
ORCH_PGVECTOR_TELEMETRY_GUARD_ENABLED=true
ORCH_MINDSDB_TELEMETRY_GUARD_ENABLED=true
ORCH_LETTA_TELEMETRY_GUARD_ENABLED=true
ORCH_TELEMETRY_STRICT_SINK_ISOLATION=true
GO_WRITE_INGRESS_ENABLED=true
GO_WRITE_STRICT_REQUIRED_FIELDS=true
GO_WRITE_TELEMETRY_ISOLATION_ENABLED=true
GO_WRITE_TELEMETRY_TOPIC_PREFIXES=telemetry,metrics,signals,overrides,perf,tmp,state,states,snapshots,health,stats,allocations,system_state
GO_WRITE_TELEMETRY_FILE_PATTERNS=index__*.json,*_agg-latest.json,*_agg-*.json,*__agg-*.json,telemetry__*.json,*__state__*.json,*__stats__*.json,*__snapshots__*.json,*__health__*.json,*__allocations__*.json
GO_WRITE_TELEMETRY_MARKERS=telemetry,metrics,__state__,__stats__,__snapshots__,__health__,__allocations__,_agg-,queue__
GO_WRITE_BATCH_CONCURRENCY=4
GO_TELEMETRY_SINK_ENABLED=true
GO_TELEMETRY_CONNECT_TIMEOUT_SECS=5
GO_TELEMETRY_DB=contextlattice_raw
GO_TELEMETRY_EVENTS_COLLECTION=memory_write_telemetry
GO_TELEMETRY_BLOBS_COLLECTION=memory_write_blobs
GO_TELEMETRY_RETENTION_DAYS=75
GO_TELEMETRY_BLOB_COMPRESSION_MIN_BYTES=256
GO_TELEMETRY_CONTENT_PREVIEW_CHARS=240
GO_TELEMETRY_INGEST_TIMEOUT_SECS=8
GO_TELEMETRY_BLOB_GC_ENABLED=true
GO_TELEMETRY_BLOB_GC_INTERVAL_SECS=3600
GO_TELEMETRY_BLOB_GC_GRACE_SECS=86400
GO_TELEMETRY_BLOB_GC_BATCH_LIMIT=500
FANOUT_PGVECTOR_RATE_LIMIT_PER_SEC=20
FANOUT_PGVECTOR_BULK_SIZE=16
FANOUT_COALESCE_TARGETS=qdrant,postgres_pgvector,mindsdb,letta,langfuse
ORCH_QDRANT_PAYLOAD_INDEX_HARDEN_ENABLED=true
ORCH_QDRANT_PAYLOAD_INDEX_HARDEN_ON_STARTUP=true
ORCH_QDRANT_PAYLOAD_INDEX_HARDEN_WAIT=false
ORCH_TELEMETRY_DB=contextlattice_raw
ORCH_TELEMETRY_COLLECTION=retrieval_telemetry
ORCH_TELEMETRY_PERSIST_ENABLED=true
SINK_RETENTION_ENABLED=true
QDRANT_LOW_VALUE_RETENTION_HOURS=1800
MINDSDB_LOW_VALUE_RETENTION_HOURS=1800
LETTA_LOW_VALUE_RETENTION_HOURS=1800
ORCH_RETENTION_TELEMETRY_ONLY=true
ORCH_RETENTION_APPLICATION_STATE_HOURS=1800
ORCH_RETENTION_PROTECTED_TOPIC_PREFIXES=learning,knowledge,projects,runbooks,decisions,architecture
ORCH_RETENTION_PROTECTED_FILE_PATTERNS=*.md,*.markdown,*.rst,*.adoc,*.txt
ORCH_RETENTION_APPLICATION_STATE_FILE_PATTERNS=*__state__*.json,*__stats__*.json,*__snapshots__*.json,*__health__*.json,*__allocations__*.json
ORCH_RETENTION_APPLICATION_STATE_TOPIC_PREFIXES=state,states,snapshots,health,stats,allocations,system_state
ORCH_RETENTION_APPLICATION_STATE_MARKERS=__state__,__stats__,__snapshots__,__health__,__allocations__,snapshot,state,stats
FANOUT_OUTBOX_BACKEND=mongo
ORCH_STORAGE_GOVERNANCE_ENABLED=true
ORCH_STORAGE_GOVERNANCE_INTERVAL_SECS=900
ORCH_STORAGE_GOVERNANCE_WARN_USED_RATIO=0.85
ORCH_STORAGE_GOVERNANCE_HIGH_USED_RATIO=0.92
ORCH_STORAGE_GOVERNANCE_MIN_FREE_GB=40
