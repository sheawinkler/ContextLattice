{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/caveman_mode.sh",
            "timeout": 5,
            "statusMessage": "Loading caveman mode"
          },
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/contextlattice_agent_start.sh",
            "timeout": 25,
            "statusMessage": "Running ContextLattice agent start hooks"
          }
        ]
      }
    ]
  }
}
