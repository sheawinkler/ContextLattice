{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/contextlattice_agent_start.sh",
            "timeout": 90,
            "statusMessage": "Running ContextLattice agent start hooks"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/contextlattice_pre_compaction_write.sh",
            "timeout": 30,
            "statusMessage": "Writing ContextLattice compaction checkpoint"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/contextlattice_post_compaction_read.sh",
            "timeout": 30,
            "statusMessage": "Reading ContextLattice compaction checkpoint"
          }
        ]
      }
    ]
  }
}
