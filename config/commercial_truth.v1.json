  "features": [
    {
      "id": "cli_workflows",
      "buyer_label": "CLI workflows",
      "description": "Install, retrieve context, checkpoint, resume, correct, finish, and diagnose from the command line."
    },
    {
      "id": "local_go_rust_runtime",
      "buyer_label": "Local-first Go/Rust runtime",
      "description": "Run the primary application path locally without a required Python application service."
    },
    {
      "id": "durable_memory",
      "buyer_label": "Durable memory",
      "description": "Persist project-scoped memory and retrieve it through the supported local runtime."
    },
    {
      "id": "staged_retrieval",
      "buyer_label": "Staged retrieval",
      "description": "Use fast retrieval first and bounded continuation for deeper configured sources."
    },
    {
      "id": "agent_session_context",
      "buyer_label": "Agent session context",
      "description": "Package bounded context, checkpoints, and lifecycle state for agent work."
    },
    {
      "id": "dashboard_visibility",
      "buyer_label": "Dashboard visibility",
      "description": "Inspect runtime, retrieval, session, and memory status in the dashboard."
    },
    {
      "id": "premium_artifact_downloads",
      "buyer_label": "Premium artifact downloads",
      "description": "Access entitlement-gated premium download artifacts."
    },
    {
      "id": "premium_runtime_keys",
      "buyer_label": "Signed runtime licenses",
      "description": "Issue signed runtime licenses that remain verifiable offline without contacting a live entitlement service."
    },
    {
      "id": "shared_workspace_controls",
      "buyer_label": "Shared workspace controls",
      "description": "Use existing workspace roles, keys, and shared account controls."
    },
    {
      "id": "pro_analytics",
      "buyer_label": "Plan-gated analytics",
      "description": "Access the existing role- and plan-gated analytics surface."
    },
    {
      "id": "protected_runtime_operations",
      "buyer_label": "Protected runtime operations",
      "description": "Access existing entitlement-protected inference, maintenance, policy, skill, and mesh operations."
    },
    {
      "id": "scim_token_management",
      "buyer_label": "SCIM token management",
      "description": "Issue and manage the existing enterprise SCIM token surface."
    },
    {
      "id": "frontier_semantic_continuity_automation",
      "buyer_label": "Continuity that recognizes the work",
      "description": "Reconnect a new task alias to proven prior work automatically when an exact-first, holdout-locked identity gate is unambiguous."
    },
    {
      "id": "frontier_shared_objective_graph",
      "buyer_label": "The living arc of the mission",
      "description": "See workspace-scoped objectives, branches, dependencies, dead ends, decisions, and outcomes as one durable graph without rewriting its evidence."
    },
    {
      "id": "frontier_shared_decision_provenance",
      "buyer_label": "Decisions with a memory and a witness",
      "description": "Review, approve, and export decision changes against exact immutable evidence with bounded, hash-verifiable pages."
    }
  ],
