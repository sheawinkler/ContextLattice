{
  "adapter_contract": {
    "schema_id": "contextlattice_universal_agent_adapter.v1",
    "version": "2026-06-05",
    "required_phases": [
      "preflight",
      "auto_session",
      "agent_state",
      "context_pack",
      "checkpoint",
      "handoff",
      "completion"
    ],
    "required_exports": [
      "CONTEXTLATTICE_ORCHESTRATOR_URL",
      "MEMMCP_ORCHESTRATOR_URL",
      "CONTEXTLATTICE_AGENT",
      "CONTEXTLATTICE_AGENT_ID",
      "MEMMCP_AGENT_ID",
      "CONTEXTLATTICE_SESSION_ID"
    ],
    "event_route": "/v1/agents/sessions/event",
    "preflight_route": "/v1/agents/preflight",
    "context_pack_route": "/memory/context-pack",
    "checkpoint_route": "/memory/write",
    "handoff_helper": "scripts/agent/compaction-handoff-payload",
    "agent_lifecycle": {
      "schema_id": "contextlattice_agent_lifecycle_state.v1",
      "states": [
        "idle",
        "working",
        "awaiting_user",
        "blocked",
        "done"
      ],
      "authorities": [
        "hook",
        "plugin",
        "self_report",
        "process_probe",
        "manual",
        "none"
      ],
      "ownership_fields": [
        "session_id",
        "agent",
        "agent_id",
        "task_id",
        "repo",
        "worktree",
        "branch",
        "cwd",
        "native_session_id"
      ],
      "separate_lifecycle": "agent_state is the semantic agent lifecycle; retrieval_lifecycle remains source-fetch progress only"
    }
  },
  "profiles": {
    "codex": {
      "agent_id": "codex_gpt5",
      "state_authority": "hook",
      "process_names": [
        "codex"
      ],
      "topic_path": "runbooks/codex-integration",
      "query": "codex preflight connectivity and retrieval",
      "retrieval_mode": "balanced",
      "surfaces": [
        "codex-cli",
        "chatgpt-codex"
      ]
    },
