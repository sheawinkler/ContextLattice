# Copy this file to .env and adjust as needed.
#   cp .env.example .env
#
# Tip (Docker Desktop + external SSD): if you set any *DATA/*STORAGE vars to a path
# under /Volumes, add that path in Docker Desktop -> Settings -> Resources -> File Sharing.
# Critical runtime/tuning keys are lock-managed by scripts/enforce_strict_env.sh
# using config/env/strict_runtime.env.

# Docker Compose profile defaults
# Keep observability enabled by default so Langfuse is available on standard compose startup.
COMPOSE_PROFILES=core,llm,observability
# HOME=  # optional override for Compose (defaults to your shell HOME)

# Host-side Docker VM RSS guard for spike-lab services.
DOCKER_VM_RSS_GUARD_ENABLED=true
DOCKER_VM_RSS_GUARD_INTERVAL_SECS=20
DOCKER_VM_RSS_GUARD_ACTION_COOLDOWN_SECS=90
DOCKER_VM_RSS_GUARD_HIGH_GIB=2.0
DOCKER_VM_RSS_GUARD_LOW_GIB=1.2
DOCKER_VM_RSS_GUARD_CONTAINER_HIGH_GIB=20.0
DOCKER_VM_RSS_GUARD_CONTAINER_LOW_GIB=14.0
DOCKER_VM_RSS_GUARD_AUTO_RESUME=true
DOCKER_VM_RSS_GUARD_USE_LAUNCHD=true
DOCKER_VM_RSS_GUARD_LAUNCHD_LABEL=io.contextlattice.docker-vm-rss-guard
DOCKER_VM_RSS_GUARD_TARGET_SERVICES=lancedb-spike-adapter,trieve-spike-adapter,helixdb-spike-adapter,shodh-spike-adapter,memvid-spike-adapter,surrealdb-spike-adapter

# Core service ports
HOST_BIND_ADDRESS=127.0.0.1
SUPERGW_PORT=59081
MEMORYMCP_HTTP_PORT=59081
SUPERGATEWAY_LOG_LEVEL=none
SUPERGATEWAY_SESSION_TIMEOUT_MS=300000
ORCHESTRATOR_PORT=18075
GO_GATEWAY_HOST_PORT=8075
MCP_HUB_PORT=53130
MCP_PROXY_PORT=9092
DASHBOARD_PORT=3000
DASHBOARD_URL=http://localhost:3000
DASHBOARD_DATABASE_URL=file:/data/dashboard.db
DASHBOARD_NEXTAUTH_SECRET=change_me_64_chars________________________________________
DASHBOARD_AUTH_REQUIRED=false

# Local URLs (optional overrides for scripts/clients)
# Agent default endpoint pin: keep this at orchestrator `:8075` unless intentionally overriding.
CONTEXTLATTICE_ORCHESTRATOR_URL=http://127.0.0.1:8075
MEMMCP_ORCHESTRATOR_URL=http://127.0.0.1:8075
CONTEXTLATTICE_AGENT_ID=codex_gpt5
MEMMCP_AGENT_ID=codex_gpt5
CONTEXTLATTICE_SESSION_ID=codex-default
MEMMCP_SESSION_ID=codex-default
GO_WRITE_DEFAULT_AGENT_ID=codex_gpt5
GO_WRITE_DEFAULT_SESSION_ID=codex-default
GO_WRITE_DEFAULT_TAGS=source:gateway-go
# Required when ORCH_PRODUCTION_REQUIRE_API_KEY=true or CONTEXTLATTICE_ENV=strict.
CONTEXTLATTICE_ORCHESTRATOR_API_KEY=
MEMMCP_ORCHESTRATOR_API_KEY=
# Optional worker-scoped key for role-split tool policy.
CONTEXTLATTICE_WORKER_API_KEY=
SECRETS_STORAGE_MODE=redact
# Security modes: development | production | strict
CONTEXTLATTICE_ENV=production
ORCH_SECURITY_STRICT=false
ORCH_PRODUCTION_REQUIRE_API_KEY=false
ORCH_PUBLIC_STATUS=false
ORCH_PUBLIC_DOCS=false
# Skills quarantine discovery (read-only candidate search; never auto-loads quarantined skills)
ORCH_SKILLS_QUARANTINE_ENABLED=true
ORCH_SKILLS_QUARANTINE_HOST_BIN_DIR=${HOME}/.local/bin
ORCH_SKILLS_INDEX_HOST_ACTIVE_ROOT_DIR=${HOME}/.codex/skills
ORCH_SKILLS_INDEX_HOST_SYSTEM_ROOT_DIR=${HOME}/.codex/skills/.system
ORCH_SKILLS_INDEX_ROOTS=/opt/contextlattice/skills_active:/opt/contextlattice/skills_system
CONTEXTLATTICE_AGENT_CONTRACTS_HOST_DIR=./config/agent_contracts
CONTEXTLATTICE_AGENT_CONTRACTS_PATH=/app/config/agent_contracts/agent_output_contracts.json
ORCH_SKILLS_QUARANTINE_HOST_ROOT_DIR=${HOME}/.codex/skills_quarantine
ORCH_SKILLS_QUARANTINE_SEARCH_CMD=/opt/contextlattice/skills/bin/codex-skills-quarantine-search
ORCH_SKILLS_QUARANTINE_REINDEX_CMD=/opt/contextlattice/skills/bin/codex-skills-quarantine-reindex
ORCH_SKILLS_QUARANTINE_TIMEOUT_SECS=8
ORCH_SKILLS_QUARANTINE_DEFAULT_LIMIT=20
ORCH_SKILLS_QUARANTINE_MAX_LIMIT=100
# Keep reindex explicit/opt-in; search remains default.
ORCH_SKILLS_QUARANTINE_REINDEX_ENABLED=false
CODEX_SKILLS_QUARANTINE_ROOT=/opt/contextlattice/skills_quarantine
CODEX_SKILLS_QUARANTINE_INDEX_DIR=/opt/contextlattice/skills_quarantine/index
CODEX_SKILLS_QUARANTINE_INDEX=/opt/contextlattice/skills_quarantine/index/skills_index.jsonl
# Runtime defaults: Rust+Go primary path, Python fallback as legacy.
USE_RUST_CODEC=true
USE_RUST_MEMORY=true
USE_RUST_RETRIEVAL=true
USE_GO_ORCHESTRATOR=true
CONTEXTLATTICE_ENGINE_MODE=service
CONTEXTLATTICE_ENGINE_URL=http://gateway-go:8091
CONTEXTLATTICE_GO_ORCHESTRATOR_URL=http://orchestrator-go:8090
MIGRATION_SHADOW_DUAL_RUN=true
MIGRATION_CANARY_ENABLED=true
ORCH_HTTP_REQUEST_LOG_SUCCESS_SAMPLE_RATE=0.1
ORCH_HTTP_REQUEST_LOG_SLOW_MS=1500
ORCH_PROMETHEUS_ENABLED=true
ORCH_PROMETHEUS_ENDPOINT=/metrics
ORCH_PROMETHEUS_PUBLIC=false
GO_ORCHESTRATOR_PORT_INTERNAL=8090
GO_GATEWAY_PORT_INTERNAL=8091
MEMORY_BANK_SPIKE_RS_PORT_INTERNAL=8096
GO_RETRIEVAL_STAGED_ENABLED=true
GO_PYTHON_HOT_PATH_OWNERSHIP_MODE=warn
GO_RUNTIME_STRICT_NO_PYTHON=true
ORCH_PYTHON_HOT_PATH_OWNERSHIP_MODE=warn
GO_RETRIEVAL_SUBCALL_DISABLE_EXPANSION=true
GO_RETRIEVAL_SUBCALL_DISABLE_AUTO_ESCALATE=true
GO_RETRIEVAL_CONTINUATION_MAX_INFLIGHT=8
GO_RETRIEVAL_CONTINUATION_MAX_INFLIGHT_PER_SOURCE=2
GO_RETRIEVAL_CONTINUATION_MAX_INFLIGHT_PER_SOURCE_LETTA=2
GO_RETRIEVAL_CONTINUATION_MAX_INFLIGHT_PER_SOURCE_MEMORY_BANK=2
GO_RETRIEVAL_CONTINUATION_DURABLE_MAX_PENDING=2000
GO_RETRIEVAL_CONTINUATION_DURABLE_MAX_PENDING_PER_SOURCE=24
GO_RETRIEVAL_CONTINUATION_TIMEOUT_SECS=45
GO_RETRIEVAL_CONTINUATION_SOURCE_COOLDOWN_SECS=15
GO_RETRIEVAL_CONTINUATION_SOURCE_COOLDOWN_SECS_LETTA=15
GO_RETRIEVAL_CONTINUATION_SOURCE_COOLDOWN_SECS_MEMORY_BANK=15
GO_RETRIEVAL_CONTINUATION_EVENT_HISTORY=32
GO_RETRIEVAL_CONTINUATION_EVENT_TTL_SECS=900
GO_RETRIEVAL_CONTINUATION_SSE_HEARTBEAT_SECS=15
GO_RETRIEVAL_LEXICAL_GUARD_ENABLED=true
GO_RETRIEVAL_LEXICAL_GUARD_MIN_COVERAGE=0.55
GO_RETRIEVAL_LEXICAL_GUARD_MIN_RESULTS=1
GO_RETRIEVAL_ADAPTIVE_TIMEOUT_ENABLED=true
GO_RETRIEVAL_ADAPTIVE_TIMEOUT_MIN_REQUESTS=8
GO_RETRIEVAL_ADAPTIVE_TIMEOUT_WINDOW=128
GO_RETRIEVAL_ADAPTIVE_TIMEOUT_P95_FACTOR=1.4
GO_RETRIEVAL_ADAPTIVE_TIMEOUT_MIN_SCALE=0.6
GO_RETRIEVAL_ADAPTIVE_TIMEOUT_MAX_SCALE=1.8
GO_RETRIEVAL_ADAPTIVE_TIMEOUT_BACKLOG_WEIGHT=0.12
GO_RETRIEVAL_ADAPTIVE_TIMEOUT_BACKLOG_CAP=6
GO_RETRIEVAL_EVENT_BATCH_ENABLED=true
GO_RETRIEVAL_EVENT_BATCH_FLUSH_SECS=3
GO_RETRIEVAL_EVENT_BATCH_SIZE=64
GO_RETRIEVAL_EVENT_BATCH_DROP_LOG_EVERY=100
ORCH_SHARED_HTTP_MAX_CONNECTIONS=120
ORCH_SHARED_HTTP_MAX_KEEPALIVE_CONNECTIONS=60

# Optional services
MINDS_HTTP_PORT=47334
MINDSDB_MCP_PORT=47337
MINDSDB_HTTP_PROXY_PORT=8004
LETTA_PORT=8283
LANGFUSE_PORT=15510
PROMPTFOO_PORT=15500
MEILI_MASTER_KEY=contextlattice_meili_dev_key

# Mongo (inside compose network)
MONGODB_URI=mongodb://mongo:27017

# Qdrant
# Local-first default; cloud can be enabled per user account.
QDRANT_URL=http://qdrant:6333
QDRANT_LOCAL_URL=http://qdrant:6333
QDRANT_USE_CLOUD=false
QDRANT_CLUSTER_ENDPOINT=
QDRANT_API_KEY=
GO_WRITE_QDRANT_FANOUT_MODE=async
GO_WRITE_QDRANT_FANOUT_TIMEOUT_SECS=30
GO_WRITE_QDRANT_FANOUT_ASYNC_MAX_INFLIGHT=2
QDRANT_CLOUD_FALLBACK=false
QDRANT_GRPC_PREFER=true
QDRANT_GRPC_PORT=6334
QDRANT_CLOUD_GRPC_PORT=6334
QDRANT_COLLECTION=contextlattice_notes
ORCH_QDRANT_COLLECTION=contextlattice_notes
ORCH_QDRANT_DIMENSION_POLICY=rollover
ORCH_QDRANT_DIMENSION_SUFFIX=__d
ORCH_QDRANT_SEARCH_HNSW_EF=0
ORCH_QDRANT_SEARCH_EXACT=false
ORCH_QDRANT_SEARCH_INDEXED_ONLY=false
ORCH_QDRANT_SEARCH_MODE_HNSW_EF={"fast":48,"balanced":96,"deep":128}
ORCH_QDRANT_SEARCH_MODE_LIMIT_CAPS={"fast":80,"balanced":120,"deep":180}
ORCH_QDRANT_SEARCH_TIMEOUT_RETRY_ENABLED=true
ORCH_QDRANT_SEARCH_TIMEOUT_RETRY_LIMIT_FACTOR=0.5
ORCH_QDRANT_FILTERLESS_LIMIT_CAP=96
ORCH_QDRANT_WARMUP_ENABLED=true
ORCH_QDRANT_WARMUP_DELAY_SECS=2
ORCH_QDRANT_WARMUP_TIMEOUT_SECS=20
ORCH_QDRANT_WARMUP_LIMIT=8
ORCH_QDRANT_WARMUP_QUERIES="latency baseline,recall quality,orchestrator retrieval,topic rollup index"
ORCH_QDRANT_PAYLOAD_INDEX_HARDEN_ENABLED=true
ORCH_QDRANT_PAYLOAD_INDEX_HARDEN_ON_STARTUP=true
ORCH_QDRANT_PAYLOAD_INDEX_HARDEN_WAIT=false
ORCH_QDRANT_PAYLOAD_INDEX_HARDEN_RETRY_SECS=5
ORCH_QDRANT_PAYLOAD_INDEX_HARDEN_REQUEST_TIMEOUT_SECS=15

# Postgres pgvector (vectorscale-capable lane)
ORCH_PGVECTOR_ENABLED=true
ORCH_PGVECTOR_DSN=postgresql://postgres:postgres@pgvector-db:5432/contextlattice?sslmode=disable
ORCH_PGVECTOR_TABLE=memory_events
ORCH_PGVECTOR_EMBED_DIM=768
ORCH_PGVECTOR_POOL_MIN_SIZE=1
ORCH_PGVECTOR_POOL_MAX_SIZE=12
ORCH_PGVECTOR_CONNECT_TIMEOUT_SECS=8
ORCH_PGVECTOR_STATEMENT_TIMEOUT_SECS=6
ORCH_PGVECTOR_IVFFLAT_LISTS=100
ORCH_PGVECTOR_PREFER_VECTORSCALE=true
ORCH_PGVECTOR_FANOUT_ENABLED=true
ORCH_PGVECTOR_TELEMETRY_GUARD_ENABLED=true

ORCH_RUST_RETRIEVAL_VECTOR_BACKEND=qdrant_remote
ORCH_RUST_RETRIEVAL_LEXICAL_BACKEND=tantivy_lexical
ORCH_RUST_RETRIEVAL_BACKEND_STRICT=false
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_PROVIDER=
OPENAI_API_BASE=

# Orchestrator embedding provider (fastembed-rs | cheap | ollama | openai-compatible)
ORCH_EMBED_PROVIDER=fastembed-rs
ORCH_EMBED_MODEL=BAAI/bge-small-en-v1.5
ORCH_EMBED_DIM=768
ORCH_EMBED_FAIL_OPEN=true
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_MAX_KEYS=50000
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
FASTEMBED_DEFAULT_MODEL=BAAI/bge-small-en-v1.5
FASTEMBED_MAX_BATCH=256
FASTEMBED_MODEL_CACHE=fastembed_model_cache
ORCH_FASTEMBED_RS_BASE_URL=http://fastembed-sidecar:8080
ORCH_FASTEMBED_RS_ROUTE=/embed
ORCH_FASTEMBED_RS_MODEL=BAAI/bge-small-en-v1.5
ORCH_FASTEMBED_RS_TIMEOUT_SECS=2.5
ORCH_ADAPTER_FASTEMBED_RS_REQUIRE_GATE=false
ORCH_ADAPTER_FASTEMBED_RS_GATE_FILE=/app/data/gates/fastembed_gate_latest.json
ORCH_ADAPTER_FASTEMBED_RS_GATE_MAX_AGE_SECS=172800
ORCH_ADAPTER_FASTEMBED_RS_PROMOTE_OVERRIDE=false
ORCH_ADAPTER_FASTEMBED_RS_PROMOTE_REASON=
GATE_REFRESH_BASE_URL=http://gateway-go:8091
GATE_REFRESH_API_KEY=
GATE_REFRESH_PROJECT=contextlattice
GATE_REFRESH_INTERVAL_SECS=1800
GATE_REFRESH_MIN_PAUSE_SECS=30
GATE_REFRESH_FAILURE_RETRY_SECS=45
GATE_REFRESH_TIMEOUT_SECS=45
GATE_REFRESH_RUNS=10
GATE_REFRESH_BASELINE=/app/bench/results/perf_shortlist_matrix_baseline.json
GATE_REFRESH_OUTPUT=/app/data/bench/perf_shortlist_matrix_latest.json
GATE_REFRESH_GATE_OUTPUT=/app/data/gates/fastembed_gate_latest.json
GATE_REFRESH_WARMUPS=1
GATE_REFRESH_REPEATS=3
GATE_REFRESH_AGGREGATE=median
GATE_REFRESH_GATE_SLEEP_SECS=1
GATE_REFRESH_GATE_MIN_IMPROVEMENT_PCT=5
GATE_REFRESH_GATE_MAX_ERROR_REGRESSION=0.005
ORCH_RETRIEVAL_SOURCES=qdrant,weaviate,postgres_pgvector,mongo_raw,mindsdb,topic_rollups,letta,memory_bank
ORCH_RETRIEVAL_INTENT_DEFAULT=decision
ORCH_RETRIEVAL_INTENT_DECISION_SOURCES=topic_rollups,qdrant,weaviate,postgres_pgvector,memory_bank,mindsdb,mongo_raw,letta
