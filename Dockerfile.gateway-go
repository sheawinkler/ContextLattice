FROM golang:1.22-alpine AS build
WORKDIR /src
COPY services/gateway-go/go.mod ./go.mod
COPY services/gateway-go/main.go ./main.go
RUN go mod download && go build -o /out/gateway-go ./main.go

FROM alpine:3.20
WORKDIR /app
COPY --from=build /out/gateway-go /usr/local/bin/gateway-go
EXPOSE 8091
CMD ["gateway-go"]
