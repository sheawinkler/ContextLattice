FROM golang:1.26.4-alpine AS build
WORKDIR /src
COPY services/gateway-go/go.mod services/gateway-go/go.sum ./
RUN go mod download
COPY services/gateway-go/*.go ./
RUN go build -o /out/gateway-go .

FROM alpine:3.20
WORKDIR /app
RUN apk add --no-cache ca-certificates ruby && update-ca-certificates
COPY --from=build /out/gateway-go /usr/local/bin/gateway-go
COPY config/agent_contracts ./config/agent_contracts
EXPOSE 8091
CMD ["gateway-go"]
