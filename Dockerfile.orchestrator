FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ENV MONGO_RAW_ENABLED=false FANOUT_OUTBOX_BACKEND=sqlite
ENV MINDSDB_ENABLED=false ORCH_PGVECTOR_ENABLED=false
ENV SINK_RETENTION_ENABLED=false SIGNAL_REFRESH_ENABLED=false OVERRIDE_REFRESH_ENABLED=false
ENV ORCH_RETRIEVAL_DEFAULT_SOURCES=topic_rollups ORCH_RETRIEVAL_FAST_SOURCES=topic_rollups
ENV TOPIC_ROLLUP_SQLITE_ENABLED=true TOPIC_ROLLUP_SQLITE_FTS_ENABLED=true TOPIC_ROLLUP_SQLITE_VEC_ENABLED=true
WORKDIR /app
COPY services/orchestrator/requirements.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY services/orchestrator/app.py app.py
COPY services/orchestrator/runtime ./runtime
EXPOSE 8075
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8075"]
