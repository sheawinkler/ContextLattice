FROM rust:1-bookworm AS builder

WORKDIR /app
COPY services/fastembed_gate_rs/Cargo.toml ./Cargo.toml
COPY services/fastembed_gate_rs/Cargo.lock ./Cargo.lock
COPY services/fastembed_gate_rs/src ./src
RUN cargo build --release --locked

FROM debian:bookworm-slim
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/fastembed-gate-rs /usr/local/bin/fastembed-gate-rs
CMD ["fastembed-gate-rs"]
