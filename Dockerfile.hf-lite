ARG CONTEXTLATTICE_BUILD_VERSION=development
ARG CONTEXTLATTICE_BUILD_CHANNEL=hf-lite
ARG CONTEXTLATTICE_SOURCE_COMMIT=unknown
ARG CONTEXTLATTICE_SOURCE_TREE=unknown

FROM --platform=$BUILDPLATFORM golang:1.26.11-bookworm AS gateway-builder
WORKDIR /src
COPY services/gateway-go/go.mod services/gateway-go/go.sum ./services/gateway-go/
RUN --mount=type=cache,id=contextlattice-go-mod,target=/go/pkg/mod \
    cd services/gateway-go && go mod download
COPY services/gateway-go ./services/gateway-go
ARG CONTEXTLATTICE_BUILD_VERSION
ARG CONTEXTLATTICE_BUILD_CHANNEL
ARG CONTEXTLATTICE_SOURCE_COMMIT
ARG CONTEXTLATTICE_SOURCE_TREE
ARG TARGETOS
ARG TARGETARCH
RUN --mount=type=cache,id=contextlattice-go-mod,target=/go/pkg/mod \
    --mount=type=cache,id=contextlattice-go-build,target=/root/.cache/go-build \
    cd services/gateway-go && CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath \
    -ldflags "-s -w \
      -X main.contextLatticeBuildVersion=${CONTEXTLATTICE_BUILD_VERSION} \
      -X main.contextLatticeBuildChannel=${CONTEXTLATTICE_BUILD_CHANNEL} \
      -X main.contextLatticeSourceCommit=${CONTEXTLATTICE_SOURCE_COMMIT} \
      -X main.contextLatticeSourceTree=${CONTEXTLATTICE_SOURCE_TREE}" \
    -o /out/contextlattice-gateway-go .

FROM debian:bookworm-slim
ENV PORT=7860
ENV GO_RUNTIME_STRICT_NO_PYTHON=true GO_PYTHON_HOT_PATH_OWNERSHIP_MODE=strict
ENV CONTEXTLATTICE_ENV=development ORCH_SECURITY_STRICT=false ORCH_PRODUCTION_REQUIRE_API_KEY=false SECRETS_STORAGE_MODE=redact
ENV FANOUT_OUTBOX_BACKEND=sqlite MONGO_RAW_ENABLED=false MINDSDB_ENABLED=false ORCH_PGVECTOR_ENABLED=false
ENV GO_RETRIEVAL_NATIVE_QDRANT_ENABLED=false GO_WRITE_QDRANT_FANOUT_MODE=disabled
ENV ORCH_RETRIEVAL_SOURCES=topic_rollups ORCH_RETRIEVAL_DEFAULT_SOURCES=topic_rollups ORCH_RETRIEVAL_FAST_SOURCES=topic_rollups
ENV TOPIC_ROLLUP_SQLITE_ENABLED=true TOPIC_ROLLUP_SQLITE_FTS_ENABLED=true TOPIC_ROLLUP_SQLITE_VEC_ENABLED=true
ENV TOPIC_ROLLUP_SQLITE_PATH=/data/topic_rollups.sqlite3 TASK_DB_PATH=/data/agent_tasks.db
ENV MEMORY_BANK_ROOT=/data/memory
ENV CONTEXTLATTICE_GATEWAY_STATE_ROOT=/data/state/gateway
ENV CONTEXTLATTICE_AGENT_CONTRACTS_PATH=/app/config/agent_contracts/agent_output_contracts.json
ENV FANOUT_OUTBOX_PAYLOAD_BLOB_DIR=/data/fanout_payload_blobs ORCH_STORAGE_GOVERNANCE_DISK_ROOT=/data
ENV ORCH_STORAGE_GOVERNANCE_RUN_ON_STARTUP=true ORCH_STORAGE_GOVERNANCE_ENABLED=true ORCH_STORAGE_GOVERNANCE_INTERVAL_SECS=900
ENV SIGNAL_REFRESH_ENABLED=false OVERRIDE_REFRESH_ENABLED=false SINK_RETENTION_ENABLED=false
ENV ORCH_INTERNAL_RUNTIME=gateway-go ORCH_START_INTERNAL=false

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
COPY --from=gateway-builder /out/contextlattice-gateway-go /usr/local/bin/contextlattice-gateway-go
COPY config/agent_contracts/agent_output_contracts.json /app/config/agent_contracts/agent_output_contracts.json
ARG CONTEXTLATTICE_BUILD_VERSION
ARG CONTEXTLATTICE_BUILD_CHANNEL
ARG CONTEXTLATTICE_SOURCE_COMMIT
ARG CONTEXTLATTICE_SOURCE_TREE
LABEL org.opencontainers.image.title="ContextLattice gateway-go lite" \
      org.opencontainers.image.version="${CONTEXTLATTICE_BUILD_VERSION}" \
      org.opencontainers.image.revision="${CONTEXTLATTICE_SOURCE_COMMIT}" \
      io.contextlattice.source-tree="${CONTEXTLATTICE_SOURCE_TREE}" \
      io.contextlattice.channel="${CONTEXTLATTICE_BUILD_CHANNEL}"
EXPOSE 7860
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl --fail --silent --show-error "http://127.0.0.1:${PORT}/readyz" || exit 1
CMD ["/usr/local/bin/contextlattice-gateway-go"]
