FROM node:24.18.0-bookworm-slim AS build

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY contextlattice-dashboard/package*.json ./
COPY contextlattice-dashboard/.npmrc ./
RUN npm ci
COPY contextlattice-dashboard ./

ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:24.18.0-bookworm-slim AS runtime

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY --from=build /app ./

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOST=0.0.0.0
ENV PORT=3000

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=10 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/public/auth-mode').then(async (response) => { const body = await response.json(); if (!response.ok || body.ok !== true) process.exit(1); }).catch(() => process.exit(1))"

CMD ["sh", "-c", "./node_modules/.bin/prisma db push --accept-data-loss --skip-generate && exec ./node_modules/.bin/next start -H 0.0.0.0 -p ${PORT}"]
