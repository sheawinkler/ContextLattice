FROM node:20-bullseye-slim

WORKDIR /app

COPY contextlattice-dashboard/package*.json ./
COPY contextlattice-dashboard/.npmrc ./
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && npm ci

COPY contextlattice-dashboard ./

ENV NODE_ENV=development
ENV HOST=0.0.0.0
ENV PORT=3000

CMD ["sh", "-c", "npx --yes prisma generate && npx --yes prisma db push --accept-data-loss && npm run dev -- -H 0.0.0.0 -p ${PORT}"]
