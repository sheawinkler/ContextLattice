ARG CONTEXTLATTICE_BUILD_VERSION=development
ARG CONTEXTLATTICE_BUILD_CHANNEL=local
ARG CONTEXTLATTICE_SOURCE_COMMIT=unknown
ARG CONTEXTLATTICE_SOURCE_TREE=unknown

FROM node:24.22.2-bookworm-slim AS build

ARG CONTEXTLATTICE_BUILD_VERSION
ARG CONTEXTLATTICE_BUILD_CHANNEL
ARG CONTEXTLATTICE_SOURCE_COMMIT
ARG CONTEXTLATTICE_SOURCE_TREE

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY contextlattice-dashboard/package*.json ./
COPY contextlattice-dashboard/.npmrc ./
RUN npm ci
COPY contextlattice-dashboard ./

ENV NEXT_TELEMETRY_DISABLED=1
ENV CONTEXTLATTICE_BUILD_VERSION=${CONTEXTLATTICE_BUILD_VERSION}
ENV CONTEXTLATTICE_BUILD_CHANNEL=${CONTEXTLATTICE_BUILD_CHANNEL}
ENV CONTEXTLATTICE_SOURCE_COMMIT=${CONTEXTLATTICE_SOURCE_COMMIT}
ENV CONTEXTLATTICE_SOURCE_TREE=${CONTEXTLATTICE_SOURCE_TREE}
RUN npm run build

FROM node:24.22.2-bookworm-slim AS runtime

ARG CONTEXTLATTICE_BUILD_VERSION
ARG CONTEXTLATTICE_BUILD_CHANNEL
ARG CONTEXTLATTICE_SOURCE_COMMIT
ARG CONTEXTLATTICE_SOURCE_TREE

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY --from=build /app ./

LABEL org.opencontainers.image.version="${CONTEXTLATTICE_BUILD_VERSION}" \
      org.opencontainers.image.revision="${CONTEXTLATTICE_SOURCE_COMMIT}" \
      io.contextlattice.build-channel="${CONTEXTLATTICE_BUILD_CHANNEL}" \
      io.contextlattice.source-tree="${CONTEXTLATTICE_SOURCE_TREE}"

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV CONTEXTLATTICE_BUILD_VERSION=${CONTEXTLATTICE_BUILD_VERSION}
ENV CONTEXTLATTICE_BUILD_CHANNEL=${CONTEXTLATTICE_BUILD_CHANNEL}
ENV CONTEXTLATTICE_SOURCE_COMMIT=${CONTEXTLATTICE_SOURCE_COMMIT}
ENV CONTEXTLATTICE_SOURCE_TREE=${CONTEXTLATTICE_SOURCE_TREE}
ENV HOST=0.0.0.0
ENV PORT=3000

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=10 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/public/auth-mode').then(async (response) => { const body = await response.json(); if (!response.ok || body.ok !== true) process.exit(1); }).catch(() => process.exit(1))"

CMD ["sh", "-c", "./node_modules/.bin/prisma db push --skip-generate && exec ./node_modules/.bin/next start -H 0.0.0.0 -p ${PORT}"]
